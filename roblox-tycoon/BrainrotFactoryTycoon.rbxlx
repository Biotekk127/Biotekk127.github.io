      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">CharacterKit</string>
          <string name="Source"><![CDATA[--[[
	CharacterKit: turns a character definition (src/shared/Characters/*.luau) into a Model.

	A definition's Build(k) / BuildMini(k) only talks to the `k` builder below, so the
	exact same file can be rendered outside Roblox by tools/charlab (keep the transform
	and animation maths here identical to tools/charlab/mockkit.luau).

	Animations are declarative: parts and animated groups carry Anim* attributes and the
	client Animator (src/client/Animator.luau) plays them locally - the server never
	moves anything, so hundreds of animated parts cost no network traffic.
]]

local CollectionService = game:GetService("CollectionService")

local CharacterKit = {}

CharacterKit.AnimatedTag = "BrainrotAnimated"
CharacterKit.RainbowTag = "RainbowCycle"

----------------------------------------------------------------------------------------
-- Maths shared with the Animator
----------------------------------------------------------------------------------------

-- Mirror across the YZ plane (M * cf * M with M = diag(-1, 1, 1)).
function CharacterKit.Mirror(cf: CFrame): CFrame
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end

local function vec(v: { number }?): Vector3
	if v then
		return Vector3.new(v[1], v[2], v[3])
	end
	return Vector3.zero
end

function CharacterKit.LocalTransform(pos: { number }?, rot: { number }?, mirrored: boolean): CFrame
	local r = rot or { 0, 0, 0 }
	local cf = CFrame.new(vec(pos)) * CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
	return if mirrored then CharacterKit.Mirror(cf) else cf
end

export type AnimParams = {
	Type: string,
	Axis: string?,
	Speed: number?,
	Amount: number?,
	Phase: number?,
	Mirror: boolean?,
}

local function axisVector(axis: string?): Vector3
	if axis == "X" then
		return Vector3.xAxis
	elseif axis == "Z" then
		return Vector3.zAxis
	end
	return Vector3.yAxis
end

-- Local animation transform at time t (seconds). Identical to mockkit.animTransform.
function CharacterKit.AnimTransform(anim: AnimParams, t: number): CFrame
	local cycle = 2 * math.pi * ((anim.Speed or 1) * t + (anim.Phase or 0))
	local axis = axisVector(anim.Axis)
	local cf
	if anim.Type == "Spin" then
		cf = CFrame.fromAxisAngle(axis, cycle)
	elseif anim.Type == "Wiggle" then
		cf = CFrame.fromAxisAngle(axis, math.rad(anim.Amount or 15) * math.sin(cycle))
	elseif anim.Type == "Bob" then
		cf = CFrame.new(axis * ((anim.Amount or 0.2) * math.sin(cycle)))
	else
		return CFrame.identity
	end
	return if anim.Mirror then CharacterKit.Mirror(cf) else cf
end

-- Size multiplier for Pulse / Blink part animations. Identical to mockkit.animScale.
function CharacterKit.AnimScale(anim: AnimParams, t: number): Vector3
	if anim.Type == "Pulse" then
		local s = 1 + (anim.Amount or 0.1) * math.sin(2 * math.pi * ((anim.Speed or 1) * t + (anim.Phase or 0)))
		return Vector3.new(s, s, s)
	elseif anim.Type == "Blink" then
		local p = ((anim.Speed or 1) * t + (anim.Phase or 0)) % 1
		return Vector3.new(1, if p < 0.06 then 0.1 else 1, 1)
	end
	return Vector3.one
end

function CharacterKit.ReadAnim(instance: Instance): AnimParams?
	local animType = instance:GetAttribute("AnimType")
	if type(animType) ~= "string" then
		return nil
	end
	return {
		Type = animType,
		Axis = instance:GetAttribute("AnimAxis") :: string?,
		Speed = instance:GetAttribute("AnimSpeed") :: number?,
		Amount = instance:GetAttribute("AnimAmount") :: number?,
		Phase = instance:GetAttribute("AnimPhase") :: number?,
		Mirror = instance:GetAttribute("AnimMirror") == true,
	}
end

local function writeAnim(instance: Instance, anim: any, mirrored: boolean)
	instance:SetAttribute("AnimType", anim.Type)
	instance:SetAttribute("AnimAxis", anim.Axis)
	instance:SetAttribute("AnimSpeed", anim.Speed)
	instance:SetAttribute("AnimAmount", anim.Amount)
	instance:SetAttribute("AnimPhase", anim.Phase)
	if mirrored then
		instance:SetAttribute("AnimMirror", true)
	end
end

----------------------------------------------------------------------------------------
-- Builder
----------------------------------------------------------------------------------------

local SHAPES = {
	Block = Enum.PartType.Block,
	Ball = Enum.PartType.Ball,
	Cylinder = Enum.PartType.Cylinder,
}

local function color(hex: string?): Color3
	local ok, result = pcall(Color3.fromHex, hex or "#a3a2a5")
	return if ok then result else Color3.fromRGB(163, 162, 165)
end

local function material(name: string?): Enum.Material
	local ok, result = pcall(function()
		return (Enum.Material :: any)[name or "SmoothPlastic"]
	end)
	return if ok and result then result else Enum.Material.SmoothPlastic
end

type Frame = { CF: CFrame, Mirrored: boolean, Container: Instance }

local function newBuilder(root: Model)
	local stack: { Frame } = { { CF = CFrame.identity, Mirrored = false, Container = root } }
	local animated = false
	local count = 0
	local k = {}

	local function top(): Frame
		return stack[#stack]
	end

	function k:Part(spec: any)
		local frame = top()
		local shape = spec.Shape or "Block"
		local part: BasePart
		if shape == "Wedge" then
			part = Instance.new("WedgePart")
		else
			local p = Instance.new("Part")
			p.Shape = SHAPES[shape] or Enum.PartType.Block
			if shape == "Ellipsoid" then
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = p
			end
			part = p
		end
		count += 1
		part.Name = spec.Name or ("Part" .. count)
		part.Size = vec(spec.Size)
		part.CFrame = frame.CF * CharacterKit.LocalTransform(spec.Pos, spec.Rot, frame.Mirrored)
		part.Color = color(spec.Color)
		part.Material = material(spec.Material)
		part.Transparency = spec.Transparency or 0
		part.Reflectance = spec.Reflectance or 0
		part.Anchored = true
		part.CanTouch = false
		part.CanQuery = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth

		if spec.Text and type(spec.Text.Text) == "string" then
			local gui = Instance.new("SurfaceGui")
			gui.Face = (Enum.NormalId :: any)[spec.Text.Face or "Front"] or Enum.NormalId.Front
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 50
			gui.LightInfluence = 0
			gui.Parent = part
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextScaled = true
			label.Font = Enum.Font.FredokaOne
			label.Text = spec.Text.Text
			label.TextColor3 = color(spec.Text.Color or "#ffffff")
			label.Parent = gui
		end

		if spec.Anim then
			writeAnim(part, spec.Anim, frame.Mirrored)
			animated = true
		end
		part.Parent = frame.Container
		return part
	end

	function k:Group(spec: any, fn: () -> ())
		local frame = top()
		local cf = frame.CF * CharacterKit.LocalTransform(spec.Pos, spec.Rot, frame.Mirrored)
		local container = frame.Container
		if spec.Anim then
			-- Animated groups become Models whose pivot is the group origin (the joint).
			local group = Instance.new("Model")
			group.Name = spec.Name or "Group"
			writeAnim(group, spec.Anim, frame.Mirrored)
			group.Parent = frame.Container
			group.WorldPivot = cf
			container = group
			animated = true
		end
		table.insert(stack, { CF = cf, Mirrored = frame.Mirrored, Container = container })
		fn()
		table.remove(stack)
	end

	function k:Mirror(fn: () -> ())
		fn()
		local frame = top()
		table.insert(stack, { CF = frame.CF, Mirrored = not frame.Mirrored, Container = frame.Container })
		fn()
		table.remove(stack)
	end

	local function attachmentPart(spec: any, name: string): Part
		local frame = top()
		local p = Instance.new("Part")
		p.Name = name
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.Transparency = 1
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Anchored = true
		p.CFrame = frame.CF * CharacterKit.LocalTransform(spec.Pos, nil, frame.Mirrored)
		p.Parent = frame.Container
		return p
	end

	function k:Light(spec: any)
		local p = attachmentPart(spec, "LightSource")
		local light = Instance.new("PointLight")
		light.Color = color(spec.Color or "#ffffff")
		light.Range = math.clamp(spec.Range or 10, 2, 16)
		light.Brightness = math.clamp(spec.Brightness or 1, 0.2, 3)
		light.Parent = p
	end

	function k:Particles(spec: any)
		local p = attachmentPart(spec, "ParticleSource")
		local emitter = Instance.new("ParticleEmitter")
		local c1 = color(spec.Color or "#ffffff")
		emitter.Color = ColorSequence.new(c1, if spec.Color2 then color(spec.Color2) else c1)
		emitter.Rate = math.clamp(spec.Rate or 4, 0, 30)
		local size = spec.Size or 0.3
		emitter.Size = NumberSequence.new(size, 0)
		local speed = spec.Speed or 1.5
		emitter.Speed = NumberRange.new(speed * 0.6, speed)
		local lifetime = spec.Lifetime or 1.5
		emitter.Lifetime = NumberRange.new(lifetime * 0.7, lifetime)
		local spread = spec.Spread or 30
		emitter.SpreadAngle = Vector2.new(spread, spread)
		emitter.LightEmission = 0.6
		emitter.Transparency = NumberSequence.new(0.1, 1)
		local okDirection, direction = pcall(function()
			return (Enum.NormalId :: any)[spec.Direction or "Top"]
		end)
		emitter.EmissionDirection = if okDirection and direction then direction else Enum.NormalId.Top
		emitter.Parent = p
	end

	function k:_finish(): (boolean, number)
		return animated, count
	end
	return k
end

-- Builds a character. mode "Full" = detailed display model (feet at the pivot),
-- "Mini" = tiny conveyor version (centred on the pivot).
function CharacterKit.Build(def: any, mode: string?): Model
	local model = Instance.new("Model")
	model.Name = def.Name or def.Id or "Character"
	model:SetAttribute("CharacterId", def.Id)
	model:SetAttribute("Rarity", def.Rarity)

	local rootPart = Instance.new("Part")
	rootPart.Name = "Root"
	rootPart.Size = Vector3.new(0.2, 0.2, 0.2)
	rootPart.Transparency = 1
	rootPart.CanCollide = false
	rootPart.CanTouch = false
	rootPart.CanQuery = false
	rootPart.Anchored = true
	rootPart.CFrame = CFrame.identity
	rootPart.Parent = model
	model.PrimaryPart = rootPart

	local builder = newBuilder(model)
	local buildFn = if mode == "Mini" then def.BuildMini else def.Build
	local ok, err = pcall(buildFn, builder)
	if not ok then
		warn(`[CharacterKit] {def.Id} failed to build ({mode or "Full"}): {err}`)
	end
	local animated = builder:_finish()
	if animated and mode ~= "Mini" then
		CollectionService:AddTag(model, CharacterKit.AnimatedTag)
	end
	return model
end

----------------------------------------------------------------------------------------
-- Mutations (Gold / Diamond / Rainbow) recolour a built model
----------------------------------------------------------------------------------------

local GOLD = Color3.fromRGB(255, 196, 40)
local DIAMOND = Color3.fromRGB(150, 235, 255)

function CharacterKit.ApplyMutation(model: Model, mutationName: string?)
	if not mutationName then
		return
	end
	model:SetAttribute("Mutation", mutationName)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 1 then
			if mutationName == "Gold" then
				part.Color = part.Color:Lerp(GOLD, 0.75)
				part.Material = Enum.Material.Foil
			elseif mutationName == "Diamond" then
				part.Color = part.Color:Lerp(DIAMOND, 0.7)
				part.Material = Enum.Material.Glass
				part.Reflectance = 0.25
			elseif mutationName == "Rainbow" then
				part.Material = Enum.Material.Neon
			end
		end
	end
	if mutationName == "Rainbow" then
		CollectionService:AddTag(model, CharacterKit.RainbowTag)
	end
end

-- Height of a built Full model (for placing nameplates above it).
function CharacterKit.Height(model: Model): number
	local cf, size = model:GetBoundingBox()
	local root = model.PrimaryPart
	local base = if root then root.Position.Y else cf.Position.Y - size.Y / 2
	return cf.Position.Y + size.Y / 2 - base
end

return CharacterKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">CharacterRegistry</string>
          <string name="Source"><![CDATA[--[[
	Loads every character definition in Shared/Characters and hands them out by Id.
	A missing or broken file falls back to a placeholder so the game keeps running.
]]

local Items = require(script.Parent.Items)

local CharacterRegistry = {}

local byId: { [string]: any } = {}

local function placeholder(id: string): any
	return {
		Id = id,
		Name = id,
		Rarity = "Common",
		Emoji = "❓",
		Color = "#b4b4c8",
		Tagline = "Coming soon...",
		Lore = "This brainrot is still being sculpted.",
		Build = function(k)
			k:Part({ Name = "Body", Shape = "Ellipsoid", Size = { 3, 4, 3 }, Pos = { 0, 2, 0 }, Color = "#b4b4c8" })
			k:Part({ Name = "Mark", Size = { 1, 1.4, 0.2 }, Pos = { 0, 2.4, -1.5 }, Color = "#1b1b24", Text = { Text = "?", Color = "#ffffff" } })
		end,
		BuildMini = function(k)
			k:Part({ Name = "Body", Shape = "Ellipsoid", Size = { 1.6, 1.8, 1.6 }, Color = "#b4b4c8" })
		end,
	}
end

for _, module in script.Parent:WaitForChild("Characters"):GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, def = pcall(require, module)
		if ok and type(def) == "table" and type(def.Id) == "string" then
			byId[def.Id] = def
		else
			warn(`[CharacterRegistry] Could not load {module.Name}: {if ok then "bad definition" else def}`)
		end
	end
end

function CharacterRegistry.Get(id: string): any
	local def = byId[id]
	if not def then
		def = placeholder(id)
		byId[id] = def
	end
	return def
end

-- Characters in progression order (the order their droppers unlock).
CharacterRegistry.Ordered = {} :: { any }
for _, item in Items.List do
	if item.Type == "Dropper" and item.Character then
		table.insert(CharacterRegistry.Ordered, CharacterRegistry.Get(item.Character))
	end
end

return CharacterRegistry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="5">
        <Properties>
          <string name="Name">Characters</string>
        </Properties>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">BallerinaCappuccina</string>
            <string name="Source"><![CDATA[--[[
	Ballerina Cappuccina (Legendary)
	The prima ballerina of the brainrot opera: a slender dancer whose head is a glossy
	warm-white ceramic CAPPUCCINO CUP (rounded bowl, flared gold-banded rim, handle on her
	left side). The cup is brimming with a white milk-foam ring, a domed brown crema and a
	white latte-art heart, with steam curling up. A cute face is painted on the cup: big
	coffee-brown eyes with long lashes, rosy cheeks and a sweet open smile. She wears a
	fitted sparkly pink bodice with a sweetheart neckline, a fluffy layered pink tutu, pink
	tights and satin pointe shoes with crossed ribbons.

	Pose: en pointe on her right leg (toe on y = 0, on the spin axis) with the left leg in
	passe (knee out to the side, toe at the standing knee) and both arms en couronne
	(a rounded oval above the cup, hands almost touching). Animation: the whole dancer
	slowly PIROUETTES, the tutu tiers flutter, the arms sway (port de bras), the cup
	tilts, steam rises, eyes blink. Legendary flair: orbiting sparkles, gold accents,
	sequins, a soft pink light and glitter.

	Faces -Z. Feet on y = 0. Built only through the CharacterKit builder `k`.
]]

-- Palette ------------------------------------------------------------------------------
local CUP = "#fff8f2" -- warm white glazed ceramic
local CUP_SHADE = "#efe2d8" -- foot ring
local GOLD = "#f2c25a" -- rim bands, sequins
local CREMA = "#c98d5c" -- crema surface
local CREMA_D = "#a86a40" -- darker inner crema
local FOAM = "#fff4e6" -- milk foam / latte art
local STEAM = "#fffaf4"

local SKIN = "#ffdcc8" -- arms, shoulders, neck
local SKIN_D = "#f3c2aa" -- thumbs / shading
local TIGHTS = "#ffbdd3" -- ballet tights (pink)
local SHOE = "#f06fa8" -- satin pointe shoes
local RIBBON = "#dc5a93" -- shoe ribbons
local SOLE = "#c98f72" -- leather sole strip

local BODICE = "#ec5c9a" -- sparkly leotard bodice
local BODICE_D = "#c9437f" -- seams, trims
local TUTU_1 = "#f27fb2" -- under layer
local TUTU_2 = "#fb93c4"
local TUTU_3 = "#ffa6d0"
local TUTU_4 = "#ffb9db" -- top, lightest layer
local SPARK = "#ffe3f1" -- sequins (neon)
local GEM = "#ff4fa3"

local EYE_W = "#fff8ec"
local IRIS = "#6a3b25" -- coffee-brown eyes
local INK = "#2a1a24"
local BROW = "#7a4a36"
local BLUSH = "#ff9db8"
local MOUTH = "#7a2238"
local TONGUE = "#ff86a6"

local UP = { 0, 0, 90 } -- stands a Cylinder upright (axis along Y)

-- Helpers --------------------------------------------------------------------------------
local function lerp(a, b, t)
	return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
end

-- Rotation that points a part's local X axis from a to b (rx = 0).
local function aim(a, b)
	local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	local rz = math.deg(math.asin(dy / len))
	local ry = math.deg(math.atan2(-dz, dx))
	return len, { 0, ry, rz }
end

-- A limb segment between two points: Cylinder (round) or Ellipsoid (tapered, organic).
local function limb(k, name, a, b, d, color, opt)
	opt = opt or {}
	local len, rot = aim(a, b)
	local shape = opt.shape or "Cylinder"
	k:Part({
		Name = name,
		Shape = shape,
		Size = { len * (opt.stretch or 1), d, opt.dz or d },
		Pos = lerp(a, b, 0.5),
		Rot = rot,
		Color = color,
		Material = opt.material,
		Reflectance = opt.reflectance,
		Transparency = opt.transparency,
	})
end

-- A smooth limb: a round cylinder core plus a tapered muscle bulge (no pinched joints).
local function softLimb(k, name, a, b, dCore, dBulge, at, span, color, back)
	limb(k, name, a, b, dCore, color)
	local m1 = lerp(a, b, at - span)
	local m2 = lerp(a, b, at + span)
	if back then
		m1[3] += back
		m2[3] += back
	end
	limb(k, name .. "Muscle", m1, m2, dBulge, color, { shape = "Ellipsoid", stretch = 1.15 })
end

-- Front (or back) surface z of a set of ellipsoids at (x, y).
local function surf(shapes, x, y, back)
	local best = 0
	local bz = 0
	for _, e in shapes do
		local u = (x - e.c[1]) / (e.s[1] / 2)
		local v = (y - e.c[2]) / (e.s[2] / 2)
		local q = 1 - u * u - v * v
		if q > 0 then
			local d = math.sqrt(q) * e.s[3] / 2
			local z = if back then e.c[3] + d else e.c[3] - d
			if math.abs(z) > best then
				best = math.abs(z)
				bz = z
			end
		end
	end
	return bz
end

-- The cappuccino cup profile (head-local): a rounded bowl below BOWL_Y, a straight glazed
-- wall above it and a slightly flared rim. cupR(y) is the outer radius at height y.
local WALL_R = 0.98
local BOWL_Y = 0.72
local BOWL_H = 0.65
local FLARE_Y = 1.5
local function cupR(y)
	if y >= FLARE_Y then
		return 1.0
	end
	if y >= BOWL_Y then
		return WALL_R
	end
	local v = (BOWL_Y - y) / BOWL_H
	return WALL_R * math.sqrt(math.max(0, 1 - v * v))
end
-- Points on the cup surface: theta in degrees from the front (-Z) towards +X.
local function onCup(theta, y, out)
	local a = math.rad(theta)
	local r = cupR(y) + (out or 0)
	return { r * math.sin(a), y, -r * math.cos(a) }
end

-- One tier of tutu ruffles: n wide, overlapping flattened ellipsoids around the hips,
-- tilted down at the rim, with a wavy (alternating) tulle edge.
local function tutuTier(k, n, r, size, tilt, color, offset)
	for i = 0, n - 1 do
		local a = offset + i * 360 / n
		local ra = math.rad(a)
		local ruffle = if i % 2 == 0 then 3 else -3
		k:Part({
			Name = "TutuRuffle",
			Shape = "Ellipsoid",
			Size = size,
			Pos = { r * math.cos(ra), (if i % 2 == 0 then -0.025 else 0.025), -r * math.sin(ra) },
			Rot = { 0, a, -(tilt + ruffle) },
			Color = color,
			Material = "SmoothPlastic",
		})
	end
end

-- Sequins on top of the ruffles of a tier (at every `step`-th ruffle, near the outer edge).
local function tutuSequins(k, n, r, size, tilt, offset, step)
	local A = size[1] / 2
	local T = size[2] / 2
	local u = A * 0.62
	for i = 0, n - 1, step do
		local ruffle = if i % 2 == 0 then 3 else -3
		local t = math.rad(tilt + ruffle)
		local h = T * math.sqrt(1 - (u / A) ^ 2)
		local rr = r + u * math.cos(t) + h * math.sin(t) * 0.3
		local y = (if i % 2 == 0 then -0.025 else 0.025) - u * math.sin(t) + h * math.cos(t)
		local a = math.rad(offset + i * 360 / n)
		local gold = (i / step) % 2 == 0
		k:Part({
			Name = "TutuSequin",
			Shape = "Ball",
			Size = { 0.1, 0.1, 0.1 },
			Pos = { rr * math.cos(a), y, -rr * math.sin(a) },
			Color = if gold then GOLD else SPARK,
			Material = if gold then "Foil" else "Neon",
		})
	end
end

-- Bodice (fitted corset: slim waist, ribcage, low bust) and the upper body shapes.
local TORSO_SHAPES = {
	{ c = { 0, 4.2, 0.01 }, s = { 0.66, 0.74, 0.48 } },
	{ c = { 0, 4.6, 0.01 }, s = { 0.84, 0.84, 0.56 } },
	{ c = { 0, 4.86, 0.0 }, s = { 0.9, 0.36, 0.6 } },
}
local BUST_CUP = { c = { 0.19, 5.0, -0.13 }, s = { 0.4, 0.34, 0.3 } }
local CHEST = { c = { 0, 5.1, 0.03 }, s = { 0.8, 0.5, 0.48 } }
local SHOULDERS = { c = { 0, 5.24, 0.03 }, s = { 1.02, 0.3, 0.44 } }
local BODY_SHAPES = {
	TORSO_SHAPES[1],
	TORSO_SHAPES[2],
	TORSO_SHAPES[3],
	BUST_CUP,
	{ c = { -0.19, 5.0, -0.13 }, s = BUST_CUP.s },
	CHEST,
	SHOULDERS,
}

-- Pointe shoe + crossed ribbons, built in ankle space (foot points along local -Y,
-- instep faces local -Z).
local function pointeShoe(k)
	k:Part({ Name = "Heel", Shape = "Ellipsoid", Size = { 0.25, 0.27, 0.23 }, Pos = { 0, -0.1, 0.09 }, Color = SHOE, Reflectance = 0.08 })
	k:Part({ Name = "ShoeBody", Shape = "Ellipsoid", Size = { 0.31, 0.68, 0.36 }, Pos = { 0, -0.36, -0.01 }, Color = SHOE, Reflectance = 0.08 })
	k:Part({ Name = "Instep", Shape = "Ellipsoid", Size = { 0.27, 0.44, 0.28 }, Pos = { 0, -0.27, -0.08 }, Color = SHOE, Reflectance = 0.08 })
	k:Part({ Name = "ToeBox", Shape = "Ellipsoid", Size = { 0.27, 0.3, 0.3 }, Pos = { 0, -0.59, -0.03 }, Color = SHOE, Reflectance = 0.08 })
	k:Part({ Name = "Platform", Shape = "Cylinder", Size = { 0.06, 0.15, 0.15 }, Pos = { 0, -0.72, -0.03 }, Rot = UP, Color = RIBBON })
	k:Part({ Name = "SoleStrip", Size = { 0.07, 0.42, 0.05 }, Pos = { 0, -0.38, 0.16 }, Color = SOLE, Material = "Leather" })
	k:Part({ Name = "Binding", Shape = "Cylinder", Size = { 0.05, 0.31, 0.31 }, Pos = { 0, -0.03, 0 }, Rot = UP, Color = RIBBON })
	-- ribbons wrapped around the ankle and crossed in front and behind
	k:Part({ Name = "RibbonWrap", Shape = "Cylinder", Size = { 0.05, 0.28, 0.28 }, Pos = { 0, 0.14, 0 }, Rot = UP, Color = RIBBON })
	k:Part({ Name = "RibbonWrap", Shape = "Cylinder", Size = { 0.05, 0.27, 0.27 }, Pos = { 0, 0.36, 0 }, Rot = UP, Color = RIBBON })
	for s = -1, 1, 2 do
		k:Part({ Name = "RibbonCross", Size = { 0.05, 0.3, 0.05 }, Pos = { 0, 0.25, -0.13 }, Rot = { 0, 0, 34 * s }, Color = RIBBON })
		k:Part({ Name = "RibbonCross", Size = { 0.05, 0.3, 0.05 }, Pos = { 0, 0.25, 0.13 }, Rot = { 0, 0, 34 * s }, Color = RIBBON })
	end
end

-- A leg in tights from hip to ankle, with a shaped thigh, knee, calf and shin.
local function leg(k, name, hip, knee, ankle, footRot)
	k:Group({ Name = name }, function()
		softLimb(k, "Thigh", hip, knee, 0.31, 0.44, 0.32, 0.34, TIGHTS)
		k:Part({ Name = "Knee", Shape = "Ball", Size = { 0.29, 0.29, 0.29 }, Pos = knee, Color = TIGHTS })
		softLimb(k, "Shin", knee, ankle, 0.22, 0.33, 0.3, 0.28, TIGHTS, 0.03)
		k:Part({ Name = "Ankle", Shape = "Ball", Size = { 0.22, 0.22, 0.22 }, Pos = ankle, Color = TIGHTS })
		k:Group({ Name = "Foot", Pos = ankle, Rot = footRot }, function()
			pointeShoe(k)
		end)
	end)
end

-- A four-point sparkle (three crossed neon bars) that pulses.
local function sparkle(k, pos, size, color, phase)
	for i = 1, 3 do
		local s = { 0.07, 0.07, 0.07 }
		s[i] = size
		k:Part({
			Name = "Sparkle",
			Size = s,
			Pos = pos,
			Rot = { 0, 45, 0 },
			Color = color,
			Material = "Neon",
			Anim = { Type = "Pulse", Amount = 0.35, Speed = 0.9, Phase = phase },
		})
	end
end

-- Character ------------------------------------------------------------------------------
return {
	Id = "BallerinaCappuccina",
	Name = "Ballerina Cappuccina",
	Rarity = "Legendary",
	Emoji = "🩰",
	Color = "#ff8fc3",
	Tagline = "Pirouettes on one toe and never spills a drop.",
	Lore = "The prima ballerina of the brainrot opera, she spins three hundred pirouettes a night without spilling a single drop of foam. Mi-mi-mi! Her heart (and her latte art) belongs to Cappuccino Assassino.",

	Build = function(k)
		-- The whole dancer pirouettes slowly around her standing toe (y axis).
		k:Group({ Name = "Dancer", Anim = { Type = "Spin", Axis = "Y", Speed = 0.2 } }, function()
			---------------------------------------------------------------- legs
			-- right leg: en pointe, straight, on the spin axis
			leg(k, "StandingLeg", { 0.19, 3.62, 0.02 }, { 0.1, 2.2, -0.03 }, { 0.02, 0.75, 0.0 }, { 0, 0, 0 })
			-- left leg: passe, knee out to the side, pointed toe resting at the standing knee
			leg(k, "PasseLeg", { -0.2, 3.6, 0.0 }, { -1.5, 3.1, -0.3 }, { -0.45, 2.5, -0.33 }, { 0, 0, 60 })

			---------------------------------------------------------------- hips + waist
			k:Part({ Name = "Pelvis", Shape = "Ellipsoid", Size = { 0.86, 0.56, 0.62 }, Pos = { 0, 3.8, 0.02 }, Color = BODICE })
			k:Part({ Name = "Waistband", Shape = "Ellipsoid", Size = { 0.69, 0.1, 0.52 }, Pos = { 0, 4.07, 0.01 }, Color = BODICE_D, Reflectance = 0.1 })
			k:Part({ Name = "WaistGem", Shape = "Ball", Size = { 0.11, 0.11, 0.11 }, Pos = { 0, 4.07, -0.25 }, Color = GEM, Material = "Neon" })

			-- satin bow at the back of the waist
			k:Group({ Name = "BackBow", Pos = { 0, 4.26, surf(TORSO_SHAPES, 0, 4.26, true) + 0.03 } }, function()
				k:Part({ Name = "BowKnot", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Color = BODICE_D, Reflectance = 0.1 })
				k:Mirror(function()
					k:Part({ Name = "BowLoop", Shape = "Ellipsoid", Size = { 0.3, 0.17, 0.08 }, Pos = { 0.15, 0.04, 0.0 }, Rot = { 0, 0, 18 }, Color = BODICE_D, Reflectance = 0.1 })
					k:Part({ Name = "BowTail", Shape = "Ellipsoid", Size = { 0.08, 0.3, 0.05 }, Pos = { 0.08, -0.18, 0.02 }, Rot = { 0, 0, 14 }, Color = BODICE_D, Reflectance = 0.1 })
				end)
			end)

			---------------------------------------------------------------- tutu (fluffy, 4 fluttering tiers)
			-- a soft tulle core fills the gaps so the tutu reads as one fluffy mass
			k:Part({ Name = "TutuCore", Shape = "Ellipsoid", Size = { 2.9, 0.58, 2.9 }, Pos = { 0, 3.7, 0 }, Color = TUTU_1 })
			local UNDER = { 1.36, 0.24, 1.08 }
			local MID = { 1.38, 0.26, 1.08 }
			local UPPER = { 1.26, 0.26, 1.0 }
			k:Group({ Name = "TutuUnder", Pos = { 0, 3.5, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 2, Speed = 0.5, Phase = 0.6 } }, function()
				tutuTier(k, 16, 1.28, UNDER, 24, TUTU_1, 0)
			end)
			k:Group({ Name = "TutuMid", Pos = { 0, 3.66, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 2.5, Speed = 0.5, Phase = 0 } }, function()
				tutuTier(k, 16, 1.24, MID, 14, TUTU_2, 11.25)
				tutuSequins(k, 16, 1.24, MID, 14, 11.25, 4)
			end)
			k:Group({ Name = "TutuUpper", Pos = { 0, 3.82, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 2.5, Speed = 0.5, Phase = 0.3 } }, function()
				tutuTier(k, 14, 1.02, UPPER, 8, TUTU_3, 0)
				tutuSequins(k, 14, 1.02, UPPER, 8, 0, 4)
			end)
			k:Group({ Name = "TutuTop", Pos = { 0, 3.97, 0 }, Anim = { Type = "Bob", Axis = "Y", Amount = 0.025, Speed = 0.5, Phase = 0.15 } }, function()
				tutuTier(k, 10, 0.66, { 0.92, 0.24, 0.74 }, 4, TUTU_4, 18)
			end)

			---------------------------------------------------------------- torso
			for _, e in TORSO_SHAPES do
				k:Part({ Name = "Bodice", Shape = "Ellipsoid", Size = e.s, Pos = e.c, Color = BODICE, Reflectance = 0.05 })
			end
			k:Part({ Name = "Chest", Shape = "Ellipsoid", Size = CHEST.s, Pos = CHEST.c, Color = SKIN })
			k:Part({ Name = "Shoulders", Shape = "Ellipsoid", Size = SHOULDERS.s, Pos = SHOULDERS.c, Color = SKIN })
			k:Mirror(function()
				-- sweetheart neckline cups
				k:Part({ Name = "BustCup", Shape = "Ellipsoid", Size = BUST_CUP.s, Pos = BUST_CUP.c, Color = BODICE, Reflectance = 0.05 })
				k:Part({ Name = "ShoulderCap", Shape = "Ball", Size = { 0.28, 0.28, 0.28 }, Pos = { 0.5, 5.24, 0.03 }, Color = SKIN })
				-- thin straps over the shoulders
				local f = { 0.3, 5.12, surf(BODY_SHAPES, 0.3, 5.12) + 0.01 }
				local t = { 0.33, 5.36, 0.03 }
				local b = { 0.3, 5.12, surf(BODY_SHAPES, 0.3, 5.12, true) - 0.01 }
				limb(k, "Strap", f, t, 0.06, BODICE_D)
				limb(k, "Strap", t, b, 0.06, BODICE_D)
				-- princess seam (boning) running down the bodice
				local s1 = { 0.2, 4.88, surf(BODY_SHAPES, 0.2, 4.88) - 0.005 }
				local s2 = { 0.19, 4.46, surf(BODY_SHAPES, 0.19, 4.46) - 0.005 }
				local s3 = { 0.13, 4.1, surf(BODY_SHAPES, 0.13, 4.1) - 0.005 }
				limb(k, "Seam", s1, s2, 0.05, BODICE_D)
				limb(k, "Seam", s2, s3, 0.05, BODICE_D)
				-- a few neon sparkles sewn on the bodice
				for _, p in { { 0.16, 5.06 }, { 0.3, 4.62 }, { 0.09, 4.36 } } do
					k:Part({ Name = "BodiceSparkle", Shape = "Ball", Size = { 0.07, 0.07, 0.07 }, Pos = { p[1], p[2], surf(BODY_SHAPES, p[1], p[2]) }, Color = SPARK, Material = "Neon" })
				end
				-- pearl trim along the sweetheart neckline
				for _, x in { 0.06, 0.15, 0.24, 0.33 } do
					local u = (x - BUST_CUP.c[1]) / (BUST_CUP.s[1] / 2)
					local y = BUST_CUP.c[2] + BUST_CUP.s[2] / 2 * math.sqrt(math.max(0, 1 - u * u)) - 0.04
					k:Part({ Name = "Pearl", Shape = "Ball", Size = { 0.075, 0.075, 0.075 }, Pos = { x, y, surf(BODY_SHAPES, x, y) }, Color = EYE_W, Reflectance = 0.15 })
				end
			end)
			-- centre-front seam and a heart-shaped brooch at the neckline
			limb(k, "Seam", { 0, 4.9, surf(BODY_SHAPES, 0, 4.9) - 0.005 }, { 0, 4.12, surf(BODY_SHAPES, 0, 4.12) - 0.005 }, 0.05, BODICE_D)
			k:Part({ Name = "Brooch", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = { 0, 4.97, surf(BODY_SHAPES, 0, 4.97) - 0.01 }, Color = GEM, Material = "Neon" })
			-- criss-cross lacing on the back of the bodice
			for j = 0, 2 do
				local y = 4.46 + j * 0.2
				for s = -1, 1, 2 do
					k:Part({ Name = "BackLace", Size = { 0.05, 0.26, 0.05 }, Pos = { 0, y, surf(TORSO_SHAPES, 0, y, true) }, Rot = { 0, 0, 40 * s }, Color = BODICE_D })
				end
			end

			---------------------------------------------------------------- neck
			k:Part({ Name = "Neck", Shape = "Cylinder", Size = { 0.42, 0.3, 0.3 }, Pos = { 0, 5.45, 0.03 }, Rot = UP, Color = SKIN })
			k:Part({ Name = "Choker", Shape = "Cylinder", Size = { 0.07, 0.335, 0.335 }, Pos = { 0, 5.43, 0.03 }, Rot = UP, Color = BODICE_D, Reflectance = 0.1 })
			k:Part({ Name = "ChokerGem", Shape = "Ball", Size = { 0.1, 0.1, 0.1 }, Pos = { 0, 5.41, -0.14 }, Color = GEM, Material = "Neon" })

			---------------------------------------------------------------- arms en couronne
			k:Mirror(function()
				k:Group({ Name = "Arm", Pos = { 0.5, 5.24, 0.03 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 4, Speed = 0.4 } }, function()
					local E = { 1.1, 1.62, -0.34 }
					softLimb(k, "UpperArm", { 0.0, 0.0, 0.0 }, E, 0.21, 0.28, 0.34, 0.28, SKIN)
					k:Part({ Name = "Elbow", Shape = "Ball", Size = { 0.2, 0.2, 0.2 }, Pos = E, Color = SKIN })
					k:Group({ Name = "Forearm", Pos = E, Anim = { Type = "Wiggle", Axis = "Z", Amount = 5, Speed = 0.4, Phase = 0.12 } }, function()
						local W = { -1.0, 1.2, 0.14 }
						softLimb(k, "Forearm", { 0, 0, 0 }, W, 0.17, 0.23, 0.32, 0.26, SKIN)
						k:Part({ Name = "Wrist", Shape = "Ball", Size = { 0.155, 0.155, 0.155 }, Pos = W, Color = SKIN })
						limb(k, "WristRibbon", lerp({ 0, 0, 0 }, W, 0.85), lerp({ 0, 0, 0 }, W, 0.9), 0.19, RIBBON)
						k:Group({ Name = "Hand", Pos = W, Anim = { Type = "Wiggle", Axis = "Z", Amount = 7, Speed = 0.4, Phase = 0.25 } }, function()
							limb(k, "Palm", { 0.02, -0.01, 0 }, { -0.3, 0.08, 0.0 }, 0.13, SKIN, { shape = "Ellipsoid", dz = 0.2, stretch = 1.1 })
							limb(k, "Fingers", { -0.24, 0.07, 0 }, { -0.5, 0.06, 0.0 }, 0.09, SKIN, { shape = "Ellipsoid", dz = 0.17, stretch = 1.1 })
							limb(k, "Thumb", { -0.1, 0.0, -0.08 }, { -0.26, 0.05, -0.12 }, 0.07, SKIN_D, { shape = "Ellipsoid", stretch = 1.15 })
						end)
					end)
				end)
			end)

			---------------------------------------------------------------- the cappuccino cup head
			k:Group({ Name = "Head", Pos = { 0, 5.58, 0.03 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = 0.4, Phase = 0.4 } }, function()
				-- cup body: foot ring, rounded bowl, glazed wall, flared rim, rolled lip
				k:Part({ Name = "FootRing", Shape = "Cylinder", Size = { 0.08, 0.96, 0.96 }, Pos = { 0, 0.04, 0 }, Rot = UP, Color = CUP_SHADE })
				k:Part({ Name = "CupBowl", Shape = "Ellipsoid", Size = { WALL_R * 2, BOWL_H * 2, WALL_R * 2 }, Pos = { 0, BOWL_Y, 0 }, Color = CUP, Reflectance = 0.1 })
				k:Part({ Name = "CupWall", Shape = "Cylinder", Size = { FLARE_Y - BOWL_Y + 0.02, WALL_R * 2, WALL_R * 2 }, Pos = { 0, (BOWL_Y + FLARE_Y) / 2, 0 }, Rot = UP, Color = CUP, Reflectance = 0.1 })
				k:Part({ Name = "CupFlare", Shape = "Cylinder", Size = { 0.12, 2.0, 2.0 }, Pos = { 0, 1.55, 0 }, Rot = UP, Color = CUP, Reflectance = 0.1 })
				k:Part({ Name = "Lip", Shape = "Cylinder", Size = { 0.1, 2.06, 2.06 }, Pos = { 0, 1.63, 0 }, Rot = UP, Color = CUP, Reflectance = 0.12 })
				k:Part({ Name = "GoldBand", Shape = "Cylinder", Size = { 0.05, 2.03, 2.03 }, Pos = { 0, FLARE_Y, 0 }, Rot = UP, Color = GOLD, Material = "Foil" })
				k:Part({ Name = "GoldBand", Shape = "Cylinder", Size = { 0.05, 1.74, 1.74 }, Pos = { 0, 0.4, 0 }, Rot = UP, Color = GOLD, Material = "Foil" })

				-- the cappuccino: white milk-foam ring, domed crema, latte-art heart
				k:Part({ Name = "FoamRim", Shape = "Ellipsoid", Size = { 2.0, 0.26, 2.0 }, Pos = { 0, 1.67, 0 }, Color = FOAM })
				k:Part({ Name = "Crema", Shape = "Ellipsoid", Size = { 1.66, 0.34, 1.66 }, Pos = { 0, 1.69, 0 }, Color = CREMA })
				k:Part({ Name = "CremaInner", Shape = "Ellipsoid", Size = { 1.2, 0.34, 1.2 }, Pos = { 0, 1.7, 0 }, Color = CREMA_D })
				k:Mirror(function()
					k:Part({ Name = "HeartLobe", Shape = "Ellipsoid", Size = { 0.38, 0.07, 0.38 }, Pos = { 0.17, 1.855, 0.08 }, Color = FOAM })
				end)
				k:Part({ Name = "HeartPoint", Size = { 0.34, 0.07, 0.34 }, Pos = { 0, 1.855, -0.1 }, Rot = { 0, 45, 0 }, Color = FOAM })
				-- little foam bubbles around the rim (not over the heart)
				for i = 0, 5 do
					local a = math.rad(30 + i * 60)
					local s = if i % 2 == 0 then 0.12 else 0.09
					k:Part({ Name = "FoamBubble", Shape = "Ball", Size = { s, s, s }, Pos = { 0.86 * math.sin(a), 1.75, -0.86 * math.cos(a) }, Color = FOAM })
				end

				-- glossy highlight streak on the glaze (well to the side of the face)
				k:Group({ Pos = onCup(64, 1.05, 0), Rot = { 0, -64, 0 } }, function()
					k:Part({ Name = "GlazeShine", Shape = "Ellipsoid", Size = { 0.08, 0.62, 0.05 }, Color = "#ffffff", Reflectance = 0.3, Transparency = 0.3 })
				end)

				-- handle on her left (-X) side, turned slightly back: a smooth ear-shaped loop
				k:Group({ Name = "Handle", Rot = { 0, 15, 0 } }, function()
					local pts = {}
					for i = 0, 8 do
						local phi = math.rad(90 - i * 22.5)
						table.insert(pts, { -0.9 - 0.46 * math.cos(phi), 1.0 + 0.38 * math.sin(phi), 0 })
					end
					for i = 1, 8 do
						limb(k, "HandleLoop", pts[i], pts[i + 1], 0.17, CUP, { shape = "Ellipsoid", stretch = 1.45, dz = 0.15, reflectance = 0.1 })
					end
					k:Part({ Name = "ThumbRest", Shape = "Ellipsoid", Size = { 0.26, 0.09, 0.14 }, Pos = { -1.14, 1.42, 0 }, Rot = { 0, 0, -12 }, Color = CUP, Reflectance = 0.1 })
				end)

				-- little pink heart painted on the back of the cup
				k:Group({ Pos = onCup(180, 1.0, 0), Rot = { 0, 180, 0 } }, function()
					k:Mirror(function()
						k:Part({ Name = "BackHeartLobe", Shape = "Ellipsoid", Size = { 0.22, 0.22, 0.06 }, Pos = { 0.08, 0.04, 0 }, Color = TUTU_2 })
					end)
					k:Part({ Name = "BackHeartPoint", Size = { 0.21, 0.21, 0.05 }, Pos = { 0, -0.05, 0 }, Rot = { 0, 0, 45 }, Color = TUTU_2 })
				end)

				-- face ---------------------------------------------------------------
				k:Mirror(function()
					k:Group({ Name = "Eye", Pos = onCup(25, 1.03, 0), Rot = { 0, -25, 0 } }, function()
						local blink = { Type = "Blink", Speed = 0.22, Phase = 0.1 }
						k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.44, 0.54, 0.14 }, Color = EYE_W, Anim = blink })
						k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.31, 0.39, 0.1 }, Pos = { -0.02, -0.03, -0.04 }, Color = IRIS, Anim = blink })
						k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.16, 0.22, 0.08 }, Pos = { -0.02, -0.04, -0.07 }, Color = INK, Anim = blink })
						k:Part({ Name = "Shine", Shape = "Ball", Size = { 0.11, 0.11, 0.11 }, Pos = { 0.04, 0.07, -0.1 }, Color = EYE_W, Anim = blink })
						k:Part({ Name = "Shine2", Shape = "Ball", Size = { 0.05, 0.05, 0.05 }, Pos = { -0.08, -0.1, -0.095 }, Color = EYE_W, Anim = blink })
						-- thin eyeliner that flicks out at the outer corner
						k:Part({ Name = "Liner", Shape = "Ellipsoid", Size = { 0.46, 0.055, 0.08 }, Pos = { 0.0, 0.255, -0.03 }, Rot = { 0, 0, -4 }, Color = INK })
						for j, phi in { 12, 36, 60 } do
							local a = math.rad(phi)
							local len = 0.15 - j * 0.017
							k:Part({
								Name = "Lash",
								Size = { 0.05, len, 0.05 },
								Pos = { (0.22 + len / 2) * math.cos(a), (0.27 + len / 2) * math.sin(a), -0.03 },
								Rot = { 0, 0, phi - 90 },
								Color = INK,
							})
						end
						for _, phi in { -24, -50 } do
							local a = math.rad(phi)
							k:Part({ Name = "LowerLash", Size = { 0.05, 0.08, 0.05 }, Pos = { 0.26 * math.cos(a), 0.31 * math.sin(a), -0.02 }, Rot = { 0, 0, phi - 90 }, Color = INK })
						end
						k:Part({ Name = "Brow", Shape = "Ellipsoid", Size = { 0.28, 0.05, 0.05 }, Pos = { 0.03, 0.4, -0.01 }, Rot = { 0, 0, -10 }, Color = BROW })
					end)
					k:Group({ Name = "Cheek", Pos = onCup(44, 0.8, 0), Rot = { 0, -44, 0 } }, function()
						k:Part({ Name = "Blush", Shape = "Ellipsoid", Size = { 0.28, 0.15, 0.05 }, Color = BLUSH })
					end)
				end)
				k:Group({ Name = "Mouth", Pos = onCup(0, 0.78, 0) }, function()
					k:Part({ Name = "MouthOpen", Shape = "Ellipsoid", Size = { 0.38, 0.22, 0.06 }, Color = MOUTH })
					k:Part({ Name = "Tongue", Shape = "Ellipsoid", Size = { 0.19, 0.08, 0.05 }, Pos = { 0, -0.055, -0.02 }, Color = TONGUE })
					k:Part({ Name = "Teeth", Shape = "Ellipsoid", Size = { 0.24, 0.05, 0.05 }, Pos = { 0, 0.03, -0.018 }, Color = EYE_W })
					k:Part({ Name = "UpperLipCover", Shape = "Ellipsoid", Size = { 0.46, 0.15, 0.07 }, Pos = { 0, 0.085, -0.002 }, Color = CUP })
				end)

				-- steam wisps curling up from the crema
				local function wisp(name, base, pts, phase)
					k:Group({ Name = name, Pos = base, Anim = { Type = "Bob", Axis = "Y", Amount = 0.08, Speed = 0.45, Phase = phase } }, function()
						for j, p in pts do
							k:Part({
								Name = "Steam",
								Shape = "Ellipsoid",
								Size = { p[3], p[4], p[3] },
								Pos = { p[1], p[2], 0 },
								Rot = { 0, 0, p[5] },
								Color = STEAM,
								Transparency = 0.42 + j * 0.1,
								Anim = { Type = "Pulse", Amount = 0.12, Speed = 0.6, Phase = phase + j * 0.15 },
							})
						end
					end)
				end
				-- an S-curl: each puff leans the other way and overlaps the last
				wisp("SteamMid", { 0, 1.92, 0.32 }, { { 0.04, 0.12, 0.13, 0.32, -30 }, { 0.06, 0.36, 0.12, 0.3, 30 }, { -0.02, 0.6, 0.11, 0.28, -30 }, { 0.0, 0.83, 0.09, 0.24, 26 } }, 0)
				k:Mirror(function()
					wisp("SteamSide", { 0.42, 1.88, 0.14 }, { { 0.03, 0.12, 0.12, 0.28, -30 }, { 0.05, 0.35, 0.1, 0.26, 30 }, { -0.01, 0.56, 0.08, 0.22, -26 } }, 0.35)
				end)
			end)
		end)

		---------------------------------------------------------------- legendary flair
		k:Group({ Name = "SparkleOrbit", Anim = { Type = "Spin", Axis = "Y", Speed = 0.3 } }, function()
			local orbit = {
				{ 0, 1.1, GEM }, { 72, 5.2, GOLD }, { 144, 2.4, SPARK }, { 216, 6.8, GEM }, { 288, 8.2, GOLD },
			}
			for i, o in orbit do
				local a = math.rad(o[1])
				sparkle(k, { 2.7 * math.sin(a), o[2], -2.7 * math.cos(a) }, 0.38, o[3], i * 0.2)
			end
		end)
		k:Light({ Pos = { 0, 4.6, -1.2 }, Color = "#ff8cc6", Range = 11, Brightness = 1.2 })
		k:Light({ Pos = { 0, 8.0, -0.6 }, Color = "#ffd9a0", Range = 8, Brightness = 0.8 })
		k:Particles({ Pos = { 0, 7.6, 0.1 }, Color = STEAM, Color2 = "#ffe6d6", Rate = 3, Size = 0.4, Speed = 0.7, Lifetime = 1.6, Spread = 18, Direction = "Top" })
		k:Particles({ Pos = { 0, 3.8, 0 }, Color = "#ff7fbf", Color2 = "#fff1a8", Rate = 5, Size = 0.18, Speed = 1.8, Lifetime = 1.1, Spread = 90, Direction = "Top" })
		k:Particles({ Pos = { 0, 0.12, 0 }, Color = GOLD, Color2 = "#ff9fd0", Rate = 4, Size = 0.16, Speed = 1.2, Lifetime = 1.0, Spread = 70, Direction = "Top" })
	end,

	BuildMini = function(k)
		-- one pink leg en pointe under a puffy two-layer tutu, pink bodice, a rounded cup
		-- head with handle, crema top and big eyes, and both arms raised beside the cup
		k:Part({ Name = "Leg", Shape = "Ellipsoid", Size = { 0.17, 0.92, 0.17 }, Pos = { 0, -0.86, 0 }, Color = SHOE })
		k:Part({ Name = "Tutu", Shape = "Ellipsoid", Size = { 1.95, 0.42, 1.95 }, Pos = { 0, -0.38, 0 }, Color = TUTU_1 })
		k:Part({ Name = "TutuTop", Shape = "Ellipsoid", Size = { 1.4, 0.38, 1.4 }, Pos = { 0, -0.24, 0 }, Color = TUTU_4 })
		k:Part({ Name = "Torso", Shape = "Ellipsoid", Size = { 0.38, 0.58, 0.3 }, Pos = { 0, 0.0, 0 }, Color = BODICE })
		k:Part({ Name = "CupBowl", Shape = "Ellipsoid", Size = { 0.92, 0.46, 0.92 }, Pos = { 0, 0.5, 0 }, Color = CUP })
		k:Part({ Name = "Cup", Shape = "Cylinder", Size = { 0.5, 0.92, 0.92 }, Pos = { 0, 0.77, 0 }, Rot = UP, Color = CUP })
		k:Part({ Name = "Crema", Shape = "Ellipsoid", Size = { 0.88, 0.2, 0.88 }, Pos = { 0, 1.03, 0 }, Color = CREMA })
		k:Part({ Name = "Handle", Shape = "Cylinder", Size = { 0.1, 0.42, 0.42 }, Pos = { -0.5, 0.74, 0.06 }, Rot = { 0, 90, 0 }, Color = CUP })
		k:Mirror(function()
			k:Part({ Name = "Eye", Shape = "Ellipsoid", Size = { 0.16, 0.21, 0.1 }, Pos = { 0.16, 0.78, -0.44 }, Color = INK })
			limb(k, "Arm", { 0.17, 0.16, -0.02 }, { 0.68, 1.2, -0.06 }, 0.13, SKIN, { shape = "Ellipsoid", stretch = 1.08 })
		end)
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">BombardiroCrocodilo</string>
            <string name="Source"><![CDATA[--[[
	Bombardiro Crocodilo (Legendary)
	Canonical look: a green crocodile HEAD (long toothy jaws open, yellow slit-pupil eyes on
	top, scaly bumps, nostril mound) fused onto the front of an olive-drab WWII four-engine
	bomber: riveted fuselage, long wings with four radial engines and black/yellow-tipped
	propellers, glass gun turrets, bombs slung under the belly and wings, a tall swept tail
	fin with stabilisers and the crocodile's own scaly tail sticking out of the tail cone.
	Sits on its landing gear (two main wheels + tail wheel) on y = 0, nose toward -Z.

	Structure: a "Stance" group tilts the whole plane 7 degrees nose-up around the main-wheel
	axles (tail-dragger pose, tail wheel computed to touch y = 0). Inside it, everything above
	the main wheels lives in the "Airframe" group (pivot at the main-gear strut tops) that
	slowly banks. Un-animated offset groups let every part be written in "plane space":
	studs, y up, nose toward -Z, as if the plane sat level.
	Animated: 4 propellers (Spin, phase offsets), lower jaw snap, banking airframe, 4 bombs
	swaying, eye blink, both turrets swivelling, rudder, elevators, crocodile tail, glowing
	engines/exhausts and pulsing nav lights.
]]

-- Palette -----------------------------------------------------------------------------
local OLIVE = "#5d6a32" -- dominant: olive-drab airframe
local OLIVE_DARK = "#454f24" -- panel lines, control surfaces
local OLIVE_LIGHT = "#76844a" -- rivets, highlights
local BELLY_GREY = "#8d927a" -- neutral-grey underside

local CROC = "#4f9d38" -- crocodile skin
local CROC_DARK = "#2e6a26" -- scutes, scales, lip
local CROC_LID = "#3f8a2e" -- heavy reptile eyelids
local CROC_LIGHT = "#72bd4e" -- light scale bumps
local CROC_BELLY = "#d3d886" -- pale throat / jaw underside
local MOUTH = "#a8343f"
local TONGUE = "#de6670"
local TOOTH = "#fff8ec"
local EYE = "#ffd23a"
local PUPIL = "#1b1b24"
local SHINE = "#fffdf5"

local METAL = "#a3a9b1"
local METAL_DARK = "#3b3f47"
local GUNMETAL = "#2b2e35"
local RUBBER = "#24242a"
local PROP = "#26272d"
local PROP_TIP = "#ffcc2e"
local GOLD = "#e8b93a"
local GLASS = "#a6dcff"
local GLASS_DARK = "#36506e"
local GLOW = "#ff8a2a"
local BOMB = "#3c4527"
local BOMB_FIN = "#333b21"
local BOMB_BAND = "#e6c040"
local ITA_GREEN = "#1f9e4a"
local ITA_WHITE = "#f4f1e6"
local ITA_RED = "#d8323c"

-- Layout (plane-space studs) ------------------------------------------------------------
local FY = 2.05 -- fuselage axis height
local FR = 0.8 -- fuselage radius
local WY = FY - 0.38 -- wing plane (low-mid wing)
local WING_X, WING_Z, DIHEDRAL = 0.7, 0.3, 4
local PIVOT_Y = 1.42 -- banking pivot = main gear strut tops (inner nacelle underside)
local GX = 1.5 -- main gear x (under the inner nacelles)
local GZ = 0.05
local AXLE_Y = 0.42 -- main wheel axle height
local PITCH = 7 -- tail-dragger stance: the whole plane pivots nose-up around the main axles
local SHIFT_Z = -0.1 -- nudge forward so the pitched model stays centred in the plot
-- tail wheel centre (plane coordinates) so that, after the pitch, it rests on y = 0
local TW_Z = 1.95
local TW_Y = AXLE_Y + (0.2 - AXLE_Y + math.sin(math.rad(PITCH)) * (TW_Z - GZ)) / math.cos(math.rad(PITCH))

-- Head volumes {cx, cy, cz, semiX, semiY, semiZ}
local SKULL = { 0, FY + 0.14, -1.15, 0.86, 0.5, 0.95 }
local SNOUT = { 0, FY + 0.04, -2.05, 0.64, 0.27, 1.12 }
local LIP = { 0, FY - 0.1, -1.98, 0.68, 0.14, 1.1 }
local LJAW = { 0, FY - 0.42, -1.95, 0.57, 0.19, 1.03 }
local HINGE_Y, HINGE_Z = FY - 0.16, -0.95

local function deg(r)
	return r * 180 / math.pi
end

-- y on the top surface of ellipsoid e at (x, z)
local function topY(e, x, z)
	local a = 1 - ((x - e[1]) / e[4]) ^ 2 - ((z - e[3]) / e[6]) ^ 2
	return e[2] + e[5] * math.sqrt(math.max(a, 0))
end

-- y on the bottom surface of ellipsoid e at (x, z)
local function bottomY(e, x, z)
	local a = 1 - ((x - e[1]) / e[4]) ^ 2 - ((z - e[3]) / e[6]) ^ 2
	return e[2] - e[5] * math.sqrt(math.max(a, 0))
end

-- half-width of ellipsoid e at its equator for a given z
local function halfW(e, z)
	local a = 1 - ((z - e[3]) / e[6]) ^ 2
	return e[4] * math.sqrt(math.max(a, 0))
end

-- point on ellipsoid e in direction (dx, dy, dz) from its centre, pushed `out` along the normal
local function onEll(e, dx, dy, dz, out)
	local len = math.sqrt((dx / e[4]) ^ 2 + (dy / e[5]) ^ 2 + (dz / e[6]) ^ 2)
	local x, y, z = dx / len, dy / len, dz / len
	local nx, ny, nz = x / (e[4] * e[4]), y / (e[5] * e[5]), z / (e[6] * e[6])
	local nl = math.sqrt(nx * nx + ny * ny + nz * nz)
	return { e[1] + x + nx / nl * out, e[2] + y + ny / nl * out, e[3] + z + nz / nl * out }
end

return {
	Id = "BombardiroCrocodilo",
	Name = "Bombardiro Crocodilo",
	Rarity = "Legendary",
	Emoji = "🐊",
	Color = CROC,
	Tagline = "Half crocodile, half bomber, zero chill.",
	Lore = "Nobody knows who taught a crocodile to fly a WWII bomber, and nobody is brave enough to ask. Bombardiro Crocodilo patrols the skies above the factory with four roaring propellers, snapping jaws and a belly full of bombs. Rumour says the bombs are full of pure brainrot.",

	Build = function(k)
		-- Cylinder (axis X) between two points
		local function rod(name, a, b, d, color, material)
			local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
			local len = math.sqrt(dx * dx + dy * dy + dz * dz)
			local ux, uy, uz = dx / len, dy / len, dz / len
			k:Part({
				Name = name,
				Shape = "Cylinder",
				Size = { len, d, d },
				Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
				Rot = { 0, deg(math.atan2(-uz, ux)), deg(math.asin(math.clamp(uy, -1, 1))) },
				Color = color,
				Material = material or "Metal",
			})
		end

		-- Concentric tricolore roundel. Built as cylinders along X, `rot` tilts it.
		local function roundel(name, pos, rot, dia)
			local t = 0.05
			local parts = { { ITA_GREEN, 1 }, { ITA_WHITE, 0.66 }, { ITA_RED, 0.33 } }
			for i, p in parts do
				-- step each disc slightly outward along its local X
				local r = math.rad(rot[3])
				local off = (i - 1) * 0.008
				k:Part({
					Name = name .. i,
					Shape = "Cylinder",
					Size = { t + off * 2, dia * p[2], dia * p[2] },
					Pos = { pos[1] + math.cos(r) * off, pos[2] + math.sin(r) * off, pos[3] },
					Rot = rot,
					Color = p[1],
				})
			end
		end

		-- A bomb hanging from `pos`, swaying fore/aft around the pylon
		local function bomb(name, pos, s, phase, compact)
			k:Group({ Name = name, Pos = pos, Anim = { Type = "Wiggle", Axis = "X", Amount = 7, Speed = 0.55, Phase = phase } }, function()
				local cy = -0.34 * s
				k:Part({ Name = name .. "Pylon", Size = { 0.07, 0.2 * s, 0.34 * s }, Pos = { 0, -0.07 * s, 0 }, Color = METAL_DARK, Material = "Metal" })
				k:Part({ Name = name .. "Body", Shape = "Ellipsoid", Size = { 0.38 * s, 0.38 * s, 0.98 * s }, Pos = { 0, cy, -0.02 * s }, Color = BOMB })
				k:Part({ Name = name .. "Band", Shape = "Cylinder", Size = { 0.07 * s, 0.39 * s, 0.39 * s }, Pos = { 0, cy, -0.22 * s }, Rot = { 0, 90, 0 }, Color = BOMB_BAND })
				if not compact then
					k:Part({ Name = name .. "Fuse", Shape = "Cylinder", Size = { 0.1 * s, 0.09 * s, 0.09 * s }, Pos = { 0, cy, -0.52 * s }, Rot = { 0, 90, 0 }, Color = METAL, Material = "Metal" })
					k:Part({ Name = name .. "TailCone", Shape = "Cylinder", Size = { 0.3 * s, 0.17 * s, 0.17 * s }, Pos = { 0, cy, 0.5 * s }, Rot = { 0, 90, 0 }, Color = BOMB })
				end
				k:Part({ Name = name .. "FinH", Size = { 0.44 * s, 0.05, 0.24 * s }, Pos = { 0, cy, 0.58 * s }, Color = BOMB_FIN })
				k:Part({ Name = name .. "FinV", Size = { 0.05, 0.44 * s, 0.24 * s }, Pos = { 0, cy, 0.58 * s }, Color = BOMB_FIN })
			end)
		end

		-- Fang: a thin wedge whose triangle shows from the side; side teeth are turned 30
		-- degrees toward the front so the triangle also reads from the 3/4 and front views.
		local function tooth(name, pos, h, up, front)
			local rot
			if front then
				rot = if up then { 0, 90, 0 } else { 0, 90, 180 }
			else
				rot = if up then { 0, 30, 0 } else { 0, 30, 180 }
			end
			local size = if front then { 0.13, h, 0.11 } else { 0.07, h, 0.16 }
			k:Part({ Name = name, Shape = "Wedge", Size = size, Pos = pos, Rot = rot, Color = TOOTH })
		end

		-- One radial engine with cowl, glow, hub and a spinning 3-blade propeller.
		-- Written in wing-local coordinates (x outward along the wing).
		local function engine(name, ex, phase)
			local ey = -0.06
			k:Part({ Name = name .. "Nacelle", Shape = "Ellipsoid", Size = { 0.52, 0.5, 1.55 }, Pos = { ex, ey - 0.01, -0.25 }, Color = OLIVE, Material = "Metal" })
			k:Part({ Name = name .. "Cowl", Shape = "Cylinder", Size = { 0.55, 0.6, 0.6 }, Pos = { ex, ey, -0.92 }, Rot = { 0, 90, 0 }, Color = OLIVE, Material = "Metal" })
			k:Part({ Name = name .. "CowlLip", Shape = "Cylinder", Size = { 0.06, 0.63, 0.63 }, Pos = { ex, ey, -1.2 }, Rot = { 0, 90, 0 }, Color = METAL_DARK, Material = "Metal" })
			k:Part({
				Name = name .. "Glow",
				Shape = "Cylinder",
				Size = { 0.05, 0.44, 0.44 },
				Pos = { ex, ey, -1.225 },
				Rot = { 0, 90, 0 },
				Color = GLOW,
				Material = "Neon",
				Anim = { Type = "Pulse", Amount = 0.08, Speed = 1.3, Phase = phase },
			})
			k:Part({ Name = name .. "Hub", Shape = "Ellipsoid", Size = { 0.17, 0.17, 0.26 }, Pos = { ex, ey, -1.3 }, Color = GOLD, Material = "Foil" })
			k:Group({ Name = name .. "Prop", Pos = { ex, ey, -1.28 }, Anim = { Type = "Spin", Axis = "Z", Speed = 1.8, Phase = phase } }, function()
				for i = 0, 2 do
					k:Group({ Name = name .. "Blade" .. i, Rot = { 0, 0, i * 120 + 15 } }, function()
						k:Part({ Name = name .. "Blade", Size = { 0.12, 0.34, 0.05 }, Pos = { 0, 0.24, 0 }, Rot = { 0, 22, 0 }, Color = PROP })
						k:Part({ Name = name .. "BladeTip", Size = { 0.125, 0.1, 0.055 }, Pos = { 0, 0.455, 0 }, Rot = { 0, 22, 0 }, Color = PROP_TIP })
					end)
				end
			end)
			-- turbo exhaust on the outboard side, glowing
			k:Part({ Name = name .. "Exhaust", Shape = "Cylinder", Size = { 0.32, 0.1, 0.1 }, Pos = { ex + 0.2, -0.25, 0.12 }, Rot = { 0, 90, 0 }, Color = METAL_DARK, Material = "Metal" })
			k:Part({
				Name = name .. "ExhaustGlow",
				Shape = "Cylinder",
				Size = { 0.05, 0.09, 0.09 },
				Pos = { ex + 0.2, -0.25, 0.29 },
				Rot = { 0, 90, 0 },
				Color = GLOW,
				Material = "Neon",
				Anim = { Type = "Pulse", Amount = 0.2, Speed = 1.6, Phase = phase + 0.4 },
			})
		end

		---------------------------------------------------------------------------------
		-- Stance: nose-up around the main axles. Inside, coordinates are "plane space".
		---------------------------------------------------------------------------------
		k:Group({ Name = "Stance", Pos = { 0, AXLE_Y, GZ + SHIFT_Z }, Rot = { PITCH, 0, 0 } }, function()
			k:Group({ Name = "PlaneSpace", Pos = { 0, -AXLE_Y, -GZ } }, function()
				---------------------------------------------------------------------------------
				-- Main-gear wheels: they sit exactly on the pitch axis, so they stay put on the ground
				---------------------------------------------------------------------------------
				k:Mirror(function()
					k:Part({ Name = "MainTire", Shape = "Cylinder", Size = { 0.3, 0.84, 0.84 }, Pos = { GX, 0.42, GZ }, Color = RUBBER, Material = "Rubber" })
					k:Part({ Name = "MainHub", Shape = "Cylinder", Size = { 0.32, 0.44, 0.44 }, Pos = { GX, 0.42, GZ }, Color = METAL, Material = "Metal" })
					k:Part({ Name = "MainHubCap", Shape = "Cylinder", Size = { 0.35, 0.16, 0.16 }, Pos = { GX, 0.42, GZ }, Color = GOLD, Material = "Foil" })
					k:Part({ Name = "ForkIn", Size = { 0.06, 0.52, 0.12 }, Pos = { GX - 0.2, 0.68, GZ }, Color = METAL_DARK, Material = "Metal" })
					k:Part({ Name = "ForkOut", Size = { 0.06, 0.52, 0.12 }, Pos = { GX + 0.2, 0.68, GZ }, Color = METAL_DARK, Material = "Metal" })
					k:Part({ Name = "ForkCrown", Size = { 0.46, 0.08, 0.16 }, Pos = { GX, 0.95, GZ }, Color = METAL_DARK, Material = "Metal" })
				end)

				---------------------------------------------------------------------------------
				-- Airframe: everything above the main wheels, slowly banking
				---------------------------------------------------------------------------------
				k:Group({ Name = "Airframe", Pos = { 0, PIVOT_Y, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 2.2, Speed = 0.35 } }, function()
					k:Group({ Name = "AirframeSpace", Pos = { 0, -PIVOT_Y, 0 } }, function()
						-------------------------------------------------------------------------
						-- Fuselage
						-------------------------------------------------------------------------
						k:Part({ Name = "FuselageMid", Shape = "Cylinder", Size = { 2.0, FR * 2, FR * 2 }, Pos = { 0, FY, 0.25 }, Rot = { 0, 90, 0 }, Color = OLIVE, Material = "Metal" })
						k:Part({ Name = "FuselageNose", Shape = "Ellipsoid", Size = { FR * 2, FR * 2, 1.2 }, Pos = { 0, FY, -0.7 }, Color = OLIVE, Material = "Metal" })
						k:Part({ Name = "TailCone", Shape = "Ellipsoid", Size = { 1.58, 1.52, 2.7 }, Pos = { 0, FY + 0.04, 1.0 }, Color = OLIVE, Material = "Metal" })
						k:Part({ Name = "BellyPanel", Shape = "Ellipsoid", Size = { 1.36, 0.42, 2.9 }, Pos = { 0, FY - 0.64, 0.55 }, Color = BELLY_GREY })
						-- panel rings + rivets
						for _, z in { 0.25, 0.95 } do
							k:Part({ Name = "PanelRing", Shape = "Cylinder", Size = { 0.05, FR * 2 + 0.025, FR * 2 + 0.025 }, Pos = { 0, FY, z }, Rot = { 0, 90, 0 }, Color = OLIVE_DARK })
							for _, a in { 25, 90, 155 } do
								local r = math.rad(a)
								k:Part({ Name = "Rivet", Shape = "Ball", Size = { 0.06, 0.06, 0.06 }, Pos = { math.cos(r) * (FR + 0.01), FY + math.sin(r) * (FR + 0.01), z - 0.08 }, Color = OLIVE_LIGHT, Material = "Metal" })
							end
						end
						-- neck collar where crocodile meets bomber
						k:Part({ Name = "NeckCollar", Shape = "Cylinder", Size = { 0.13, FR * 2 + 0.08, FR * 2 + 0.08 }, Pos = { 0, FY, -0.6 }, Rot = { 0, 90, 0 }, Color = OLIVE_DARK, Material = "Metal" })
						for i = 0, 5 do
							local r = math.rad(i * 60 + 30)
							k:Part({ Name = "CollarRivet", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = { math.cos(r) * (FR + 0.045), FY + math.sin(r) * (FR + 0.045), -0.6 }, Color = METAL, Material = "Metal" })
						end

						k:Mirror(function()
							-- cockpit side window (sits on the fuselage curve, 30 degrees up)
							k:Part({
								Name = "CockpitWindow",
								Size = { 0.05, 0.22, 0.5 },
								Pos = { math.cos(math.rad(30)) * FR, FY + math.sin(math.rad(30)) * FR, -0.22 },
								Rot = { 0, 0, 30 },
								Color = GLASS_DARK,
								Material = "Glass",
							})
							-- fuselage roundel
							roundel("FuselageRoundel", { 0.78, FY + 0.2, 0.6 }, { 0, 0, 14.5 }, 0.5)
							-- waist gun window + gun
							k:Part({ Name = "WaistWindow", Size = { 0.05, 0.26, 0.38 }, Pos = { 0.73, FY + 0.15, 1.5 }, Rot = { 0, 0, 10 }, Color = GLASS_DARK, Material = "Glass" })
							rod("WaistGun", { 0.66, FY + 0.12, 1.5 }, { 1.05, FY + 0.06, 1.36 }, 0.06, GUNMETAL)
						end)

						-- top gun turret (swivels)
						k:Group({ Name = "TopTurret", Pos = { 0, FY + FR - 0.04, -0.18 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 28, Speed = 0.25 } }, function()
							k:Part({ Name = "TurretRing", Shape = "Cylinder", Size = { 0.12, 0.7, 0.7 }, Pos = { 0, 0.04, 0 }, Rot = { 0, 0, 90 }, Color = METAL_DARK, Material = "Metal" })
							k:Part({ Name = "TurretDome", Shape = "Ball", Size = { 0.58, 0.58, 0.58 }, Pos = { 0, 0.12, 0 }, Color = GLASS, Material = "Glass", Transparency = 0.35 })
							k:Mirror(function()
								rod("TurretGun", { 0.1, 0.14, -0.2 }, { 0.1, 0.16, -0.66 }, 0.06, GUNMETAL)
							end)
						end)

						-- antenna mast + wire to the fin
						rod("AntennaMast", { 0, FY + FR - 0.02, 0.3 }, { 0, FY + 1.25, 0.42 }, 0.05, METAL_DARK)
						rod("AntennaWire", { 0, FY + 1.25, 0.42 }, { 0, FY + 2.55, 1.76 }, 0.05, METAL_DARK)

						-- ball turret under the belly (swivels)
						k:Group({ Name = "BallTurret", Pos = { 0, FY - 0.7, 1.45 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 40, Speed = 0.2, Phase = 0.5 } }, function()
							k:Part({ Name = "BallMount", Shape = "Cylinder", Size = { 0.12, 0.38, 0.38 }, Pos = { 0, 0, 0 }, Rot = { 0, 0, 90 }, Color = METAL_DARK, Material = "Metal" })
							k:Part({ Name = "BallShell", Shape = "Ball", Size = { 0.5, 0.5, 0.5 }, Pos = { 0, -0.2, 0 }, Color = METAL, Material = "Metal" })
							k:Part({ Name = "BallWindow", Shape = "Ellipsoid", Size = { 0.26, 0.26, 0.1 }, Pos = { 0, -0.2, 0.22 }, Color = GLASS, Material = "Glass", Transparency = 0.2 })
							k:Mirror(function()
								rod("BallGun", { 0.07, -0.24, 0.18 }, { 0.07, -0.34, 0.62 }, 0.05, GUNMETAL)
							end)
						end)

						-- belly bombs
						bomb("BellyBombR", { 0.34, FY - 0.84, 0.3 }, 1, 0)
						bomb("BellyBombL", { -0.34, FY - 0.84, 0.3 }, 1, 0.5)

						-------------------------------------------------------------------------
						-- Crocodile head
						-------------------------------------------------------------------------
						k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { SKULL[4] * 2, SKULL[5] * 2, SKULL[6] * 2 }, Pos = { SKULL[1], SKULL[2], SKULL[3] }, Color = CROC })
						k:Part({ Name = "Snout", Shape = "Ellipsoid", Size = { SNOUT[4] * 2, SNOUT[5] * 2, SNOUT[6] * 2 }, Pos = { SNOUT[1], SNOUT[2], SNOUT[3] }, Color = CROC })
						k:Part({ Name = "UpperLip", Shape = "Ellipsoid", Size = { LIP[4] * 2, LIP[5] * 2, LIP[6] * 2 }, Pos = { LIP[1], LIP[2], LIP[3] }, Color = CROC_DARK })
						k:Part({ Name = "Palate", Shape = "Ellipsoid", Size = { 1.1, 0.1, 1.95 }, Pos = { 0, FY - 0.22, -1.92 }, Color = MOUTH })
						k:Part({ Name = "Throat", Shape = "Ellipsoid", Size = { 1.4, 0.64, 1.25 }, Pos = { 0, FY - 0.44, -0.82 }, Color = CROC_BELLY })

						-- nostril mound
						local ny = topY(SNOUT, 0, -2.85)
						k:Part({ Name = "NostrilMound", Shape = "Ellipsoid", Size = { 0.46, 0.2, 0.4 }, Pos = { 0, ny - 0.02, -2.85 }, Color = CROC })

						-- center scute row on the skull
						for i, z in { -0.95, -0.68 } do
							k:Part({ Name = "HeadScuteMid" .. i, Shape = "Ellipsoid", Size = { 0.16, 0.12, 0.2 }, Pos = { 0, topY(SKULL, 0, z) - 0.01, z }, Color = CROC_DARK })
						end

						k:Mirror(function()
							-- nostrils
							k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.1, 0.06, 0.12 }, Pos = { 0.1, ny + 0.07, -2.9 }, Color = PUPIL })
							-- snout bumps
							for i, z in { -1.6, -2.0, -2.4 } do
								k:Part({ Name = "SnoutBump" .. i, Shape = "Ellipsoid", Size = { 0.14, 0.09, 0.18 }, Pos = { 0.24, topY(SNOUT, 0.24, z) - 0.01, z }, Color = CROC_DARK })
							end
							-- skull scutes behind the eyes
							for i, z in { -0.95, -0.68 } do
								k:Part({ Name = "HeadScute" .. i, Shape = "Ellipsoid", Size = { 0.15, 0.11, 0.19 }, Pos = { 0.26, topY(SKULL, 0.26, z) - 0.01, z }, Color = CROC_DARK })
							end
							-- cheek scales
							-- a row of scales along each cheek and the snout side
							local cheeks = {
								{ SKULL, 1, 0.3, -0.55, CROC_DARK },
								{ SKULL, 1, -0.1, -0.22, CROC_LIGHT },
								{ SKULL, 1, 0.25, 0.12, CROC_DARK },
								{ SKULL, 1, -0.2, 0.45, CROC_LIGHT },
								{ SNOUT, 1, 0.45, 0.05, CROC_DARK },
								{ SNOUT, 1, 0.45, -0.4, CROC_DARK },
							}
							for i, c in cheeks do
								local p = onEll(c[1], c[2], c[3], c[4], -0.035)
								k:Part({ Name = "CheekScale" .. i, Shape = "Ellipsoid", Size = { 0.1, 0.13, 0.16 }, Pos = p, Color = c[5] })
							end

							-- eye: socket, eyeball, slit pupil, highlight, angry brow
							k:Part({ Name = "EyeSocket", Shape = "Ellipsoid", Size = { 0.52, 0.4, 0.56 }, Pos = { 0.4, FY + 0.55, -1.55 }, Color = CROC })
							k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.44, 0.44, 0.44 }, Pos = { 0.41, FY + 0.66, -1.66 }, Color = EYE, Anim = { Type = "Blink", Speed = 0.22 } })
							k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.08, 0.3, 0.06 }, Pos = { 0.485, FY + 0.65, -1.865 }, Rot = { 0, -20, 0 }, Color = PUPIL, Anim = { Type = "Blink", Speed = 0.22 } })
							k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.09, 0.09, 0.09 }, Pos = { 0.36, FY + 0.7, -1.86 }, Color = SHINE, Anim = { Type = "Blink", Speed = 0.22 } })
							-- heavy upper lid wrapping the top of the eyeball, slanted down toward the
							-- middle for the menacing crocodile glare
							k:Part({ Name = "EyeLid", Shape = "Ellipsoid", Size = { 0.49, 0.3, 0.5 }, Pos = { 0.4, FY + 0.8, -1.64 }, Rot = { -8, 0, 16 }, Color = CROC_LID })

							-- upper teeth (pointing down) along the lip
							for i = 1, 6 do
								local z = -1.3 - (i - 1) * 0.31
								local h = if i == 5 then 0.3 else 0.22
								local x = halfW(LIP, z) - 0.07
								tooth("UpperTooth" .. i, { x, bottomY(LIP, x, z) + 0.03 - h / 2, z }, h, false, false)
							end
							tooth("UpperFrontTooth", { 0.13, bottomY(LIP, 0.13, -2.94) + 0.03 - 0.1, -2.94 }, 0.2, false, true)
						end)

						-- lower jaw: hinged at the back of the mouth, open and snapping
						k:Group({ Name = "LowerJaw", Pos = { 0, HINGE_Y, HINGE_Z }, Rot = { -16, 0, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 9, Speed = 0.7 } }, function()
							k:Group({ Name = "JawSpace", Pos = { 0, -HINGE_Y, -HINGE_Z } }, function()
								k:Part({ Name = "Jaw", Shape = "Ellipsoid", Size = { LJAW[4] * 2, LJAW[5] * 2, LJAW[6] * 2 }, Pos = { LJAW[1], LJAW[2], LJAW[3] }, Color = CROC })
								k:Part({ Name = "JawUnder", Shape = "Ellipsoid", Size = { 0.98, 0.26, 1.85 }, Pos = { 0, FY - 0.52, -1.85 }, Color = CROC_BELLY })
								k:Part({ Name = "MouthFloor", Shape = "Ellipsoid", Size = { 0.98, 0.08, 1.85 }, Pos = { 0, FY - 0.25, -1.92 }, Color = MOUTH })
								k:Part({ Name = "Tongue", Shape = "Ellipsoid", Size = { 0.5, 0.12, 0.95 }, Pos = { 0, FY - 0.23, -1.6 }, Color = TONGUE })
								k:Mirror(function()
									for i = 1, 5 do
										local z = -1.45 - (i - 1) * 0.3
										local h = if i == 4 then 0.26 else 0.2
										local x = halfW(LJAW, z) - 0.07
										tooth("LowerTooth" .. i, { x, topY(LJAW, x, z) - 0.03 + h / 2, z }, h, true, false)
									end
									tooth("LowerFrontTooth", { 0.13, topY(LJAW, 0.13, -2.84) - 0.03 + 0.09, -2.84 }, 0.18, true, true)
								end)
							end)
						end)

						-------------------------------------------------------------------------
						-- Wings with engines (dihedral), written once and mirrored
						-------------------------------------------------------------------------
						k:Mirror(function()
							k:Group({ Name = "Wing", Pos = { WING_X, WY, WING_Z }, Rot = { 0, 0, DIHEDRAL } }, function()
								k:Part({ Name = "WingMain", Size = { 2.3, 0.17, 0.98 }, Pos = { 1.15, 0, 0.21 }, Color = OLIVE, Material = "Metal" })
								k:Part({ Name = "WingLeadingEdge", Shape = "Wedge", Size = { 0.17, 2.3, 0.47 }, Pos = { 1.15, 0, -0.515 }, Rot = { 0, 0, -90 }, Color = OLIVE, Material = "Metal" })
								k:Part({ Name = "WingTip", Shape = "Ellipsoid", Size = { 0.3, 0.15, 0.98 }, Pos = { 2.3, 0, 0.21 }, Color = OLIVE, Material = "Metal" })
								k:Part({ Name = "Flap", Size = { 1.0, 0.1, 0.2 }, Pos = { 0.55, -0.01, 0.8 }, Color = OLIVE_DARK })
								k:Part({ Name = "Aileron", Size = { 1.1, 0.1, 0.2 }, Pos = { 1.72, -0.01, 0.8 }, Color = OLIVE_DARK })
								roundel("WingRoundel", { 2.02, 0.09, 0.42 }, { 0, 0, 90 }, 0.46)

								engine("InnerEngine", 0.78, 0)
								engine("OuterEngine", 1.8, 0.31)
								bomb("WingBomb", { 1.29, -0.09, 0.12 }, 0.75, 0.25, true)

								-- exhaust smoke from the inner engines
								k:Particles({ Pos = { 0.98, -0.25, 0.4 }, Color = "#8c8c8c", Color2 = "#ece8df", Rate = 6, Size = 0.35, Speed = 1.4, Lifetime = 1.3, Spread = 12, Direction = "Back" })
							end)

							-- main gear strut, brace and door (move with the airframe)
							rod("GearPiston", { GX, 0.95, GZ }, { GX, 1.16, GZ }, 0.09, METAL, "Foil")
							rod("GearSleeve", { GX, 1.1, GZ }, { GX, 1.46, GZ - 0.02 }, 0.15, METAL_DARK)
							rod("GearBrace", { GX, 1.04, GZ }, { GX, 1.42, 0.42 }, 0.07, METAL_DARK)
						end)

						-- wingtip navigation lights (starboard green on +X, port red on -X)
						local tipX = WING_X + 2.42 * math.cos(math.rad(DIHEDRAL))
						local tipY = WY + 2.42 * math.sin(math.rad(DIHEDRAL))
						k:Part({ Name = "NavLightStarboard", Shape = "Ball", Size = { 0.12, 0.12, 0.12 }, Pos = { tipX - 0.02, tipY, 0.5 }, Color = "#3dff7a", Material = "Neon", Anim = { Type = "Pulse", Amount = 0.25, Speed = 0.8 } })
						k:Part({ Name = "NavLightPort", Shape = "Ball", Size = { 0.12, 0.12, 0.12 }, Pos = { -(tipX - 0.02), tipY, 0.5 }, Color = "#ff3d4a", Material = "Neon", Anim = { Type = "Pulse", Amount = 0.25, Speed = 0.8, Phase = 0.5 } })

						-------------------------------------------------------------------------
						-- Tail: swept fin with tricolore flash, rudder, stabilisers, croc tail
						-------------------------------------------------------------------------
						k:Part({ Name = "FinFront", Shape = "Wedge", Size = { 0.14, 2.45, 1.35 }, Pos = { 0, FY + 0.2 + 1.225, 1.005 }, Color = OLIVE, Material = "Metal" })
						k:Part({ Name = "FinRear", Size = { 0.14, 2.45, 0.55 }, Pos = { 0, FY + 0.2 + 1.225, 1.955 }, Color = OLIVE, Material = "Metal" })
						k:Part({ Name = "FinCap", Shape = "Ellipsoid", Size = { 0.15, 0.24, 0.8 }, Pos = { 0, FY + 2.65, 1.9 }, Color = OLIVE, Material = "Metal" })
						k:Mirror(function()
							for i, c in { ITA_GREEN, ITA_WHITE, ITA_RED } do
								k:Part({ Name = "FinFlash" .. i, Size = { 0.05, 1.0, 0.18 }, Pos = { 0.07, FY + 1.85, 1.77 + (i - 1) * 0.18 }, Color = c })
							end
						end)
						k:Group({ Name = "Rudder", Pos = { 0, FY + 1.5, 2.23 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 12, Speed = 0.4 } }, function()
							k:Part({ Name = "RudderPanel", Size = { 0.12, 2.1, 0.28 }, Pos = { 0, 0, 0.14 }, Color = OLIVE_DARK })
						end)
						k:Mirror(function()
							k:Part({ Name = "StabMain", Size = { 1.1, 0.1, 0.5 }, Pos = { 0.65, FY + 0.16, 1.95 }, Color = OLIVE, Material = "Metal" })
							k:Part({ Name = "StabLeadingEdge", Shape = "Wedge", Size = { 0.1, 1.1, 0.3 }, Pos = { 0.65, FY + 0.16, 1.55 }, Rot = { 0, 0, -90 }, Color = OLIVE, Material = "Metal" })
							k:Part({ Name = "StabTip", Shape = "Ellipsoid", Size = { 0.2, 0.1, 0.5 }, Pos = { 1.2, FY + 0.16, 1.95 }, Color = OLIVE, Material = "Metal" })
							k:Group({ Name = "Elevator", Pos = { 0, FY + 0.16, 2.2 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 8, Speed = 0.4, Phase = 0.25 } }, function()
								k:Part({ Name = "ElevatorPanel", Size = { 1.05, 0.07, 0.2 }, Pos = { 0.65, 0, 0.1 }, Color = OLIVE_DARK })
							end)
						end)

						-- tail cone collar + the crocodile's own tail
						k:Part({ Name = "TailCollar", Shape = "Cylinder", Size = { 0.07, 0.64, 0.64 }, Pos = { 0, FY - 0.02, 2.2 }, Rot = { 0, 90, 0 }, Color = OLIVE_DARK, Material = "Metal" })
						k:Group({ Name = "CrocTail", Pos = { 0, FY - 0.04, 2.12 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 14, Speed = 0.5 } }, function()
							local segs = {
								{ 0.56, 0.5, 0.62, 0, 0.12 },
								{ 0.44, 0.4, 0.52, 0.04, 0.42 },
								{ 0.34, 0.3, 0.44, 0.1, 0.66 },
								{ 0.22, 0.2, 0.28, 0.16, 0.8 },
							}
							for i, s in segs do
								k:Part({ Name = "TailSeg" .. i, Shape = "Ellipsoid", Size = { s[1], s[2], s[3] }, Pos = { 0, s[4], s[5] }, Color = CROC })
								if i < 4 then
									k:Part({ Name = "TailSpike" .. i, Shape = "Wedge", Size = { 0.07, 0.16 - i * 0.02, 0.18 }, Pos = { 0, s[4] + s[2] / 2 + 0.03, s[5] }, Color = CROC_DARK })
								end
							end
							k:Mirror(function()
								for i = 1, 2 do
									local s = segs[i]
									k:Part({ Name = "TailSideSpike" .. i, Shape = "Wedge", Size = { 0.06, 0.12, 0.15 }, Pos = { s[1] * 0.28, s[4] + s[2] * 0.4, s[5] }, Rot = { 0, 0, -25 }, Color = CROC_DARK })
								end
							end)
						end)

						-- tail wheel
						k:Part({ Name = "TailTire", Shape = "Cylinder", Size = { 0.15, 0.4, 0.4 }, Pos = { 0, TW_Y, TW_Z }, Color = RUBBER, Material = "Rubber" })
						k:Mirror(function()
							k:Part({ Name = "TailFork", Size = { 0.05, 0.34, 0.08 }, Pos = { 0.1, TW_Y + 0.14, TW_Z }, Color = METAL_DARK, Material = "Metal" })
						end)
						rod("TailStrut", { 0, TW_Y + 0.3, TW_Z }, { 0, 1.62, 1.82 }, 0.1, METAL_DARK)
					end)
				end)
			end)
		end)

		-- Legendary flair: warm engine glow + face light, golden sparkle
		k:Light({ Pos = { 0, WY, -1.7 }, Color = GLOW, Range = 8, Brightness = 1.2 })
		k:Light({ Pos = { 0, FY + 1.3, -2.3 }, Color = "#ffe39a", Range = 7, Brightness = 0.8 })
		k:Particles({ Pos = { 0, FY + 1.3, -1.0 }, Color = GOLD, Color2 = "#fff3b0", Rate = 3, Size = 0.18, Speed = 0.6, Lifetime = 1.6, Spread = 180, Direction = "Top" })
	end,

	BuildMini = function(k)
		k:Part({ Name = "Fuselage", Shape = "Ellipsoid", Size = { 0.74, 0.72, 1.9 }, Pos = { 0, 0.05, 0.35 }, Color = OLIVE })
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 0.8, 0.4, 1.25 }, Pos = { 0, 0.1, -0.68 }, Color = CROC })
		k:Part({ Name = "TeethRim", Shape = "Ellipsoid", Size = { 0.74, 0.1, 1.12 }, Pos = { 0, -0.06, -0.72 }, Color = TOOTH })
		k:Part({ Name = "LowerJaw", Shape = "Ellipsoid", Size = { 0.62, 0.22, 1.0 }, Pos = { 0, -0.2, -0.66 }, Rot = { -12, 0, 0 }, Color = CROC })
		k:Mirror(function()
			k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.24, 0.24, 0.24 }, Pos = { 0.19, 0.3, -0.7 }, Color = EYE })
			k:Part({ Name = "PropInner", Shape = "Cylinder", Size = { 0.08, 0.38, 0.38 }, Pos = { 0.62, -0.1, -0.05 }, Rot = { 0, 90, 0 }, Color = "#3a3b42", Transparency = 0.4 })
			k:Part({ Name = "PropOuter", Shape = "Cylinder", Size = { 0.08, 0.38, 0.38 }, Pos = { 1.08, -0.1, -0.02 }, Rot = { 0, 90, 0 }, Color = "#3a3b42", Transparency = 0.4 })
		end)
		k:Part({ Name = "Wing", Size = { 2.5, 0.08, 0.5 }, Pos = { 0, -0.1, 0.25 }, Color = OLIVE })
		k:Part({ Name = "Fin", Shape = "Wedge", Size = { 0.08, 0.62, 0.55 }, Pos = { 0, 0.62, 1.0 }, Color = OLIVE })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BonecaAmbalabu</string>
            <string name="Source"><![CDATA[--[[
	Boneca Ambalabu (Common)
	Canonical look: a glossy green frog head with huge bulging eyes and a wide smiling mouth
	line, sitting on top of an upright black car tyre (tread, sidewall, grey rim + hub),
	standing frozen mid-stride on two long, thin, bare human legs with knees, ankles and toes.

	Coordinates: feet on y = 0, faces -Z. The head is built in its own local frame (origin =
	skull centre). The skull/jaw "shell" is tipped nose-down inside that frame, which bends
	the planar mouth ring into a smile when seen from the front; surface details (eyes,
	nostrils, spots) are projected onto the tilted shell.
]]

-- Palette ------------------------------------------------------------------------------
local FROG = "#4fb83a" -- dominant: glossy frog green
local FROG_DARK = "#2f7f2a" -- eyelid ridges
local FROG_SPOT = "#3b9531" -- dorsal mottling
local THROAT = "#d2e37a" -- pale yellow-green chin / throat
local MOUTH = "#1d3519" -- mouth line, nostrils
local EAR = "#3f9a33" -- tympanum disc
local EYE_WHITE = "#fff6dc"
local IRIS = "#e8b22c" -- golden frog iris
local PUPIL = "#1b1b24"
local SHINE = "#fff8ec"

local RUBBER = "#25252d" -- tyre
local RUBBER_DARK = "#1c1c23"
local RUBBER_LIGHT = "#34343e" -- tread blocks / ribs
local RIM = "#b8bdc5"
local RIM_DARK = "#6c717a"
local HUB = "#d6d9de"
local LUG = "#8a8f98"

local SKIN = "#efbd96" -- bare human legs
local SKIN_DARK = "#e2a986"
local NAIL = "#f7dccb"

-- Layout (world studs) -------------------------------------------------------------------
local HIP_Y = 3.935 -- hip joints (top of the legs, inside the tyre bottom)
local TIRE_Y = 5.55 -- tyre centre
local TIRE_R = 1.8 -- tyre radius
local TIRE_W = 1.7 -- tyre width (along Z)
local NECK_Y = 7.1 -- head pivot (where the chin rests on the tread)
local HEAD_C = { 0, 7.95, -0.2 } -- skull centre (origin of the head frame)
local SHELL_TIP = -12 -- nose-down tilt of the skull/jaw shell inside the head frame (deg about X)

-- Head volumes in the head frame {cx, cy, cz, semiX, semiY, semiZ}.
-- Skull and jaw share their X/Z centre and X:Z aspect, so their surfaces meet in a flat
-- ellipse at the jaw's equator: that is exactly where the dark mouth ring sits.
local SKULL = { 0, 0, 0, 1.84, 0.92, 1.55 }
local JAW_Y = -0.42
local JAW_SX = 1.84 * math.sqrt(1 - (JAW_Y / 0.92) ^ 2) -- = skull radius at the mouth line
local JAW = { 0, JAW_Y, 0, JAW_SX, 0.58, JAW_SX * 1.55 / 1.84 }

local function deg(r)
	return r * 180 / math.pi
end

-- Distance along a ray (origin p, unit dir d) to where it leaves ellipsoid e (-1 = miss)
local function exitT(e, px, py, pz, dx, dy, dz)
	local ox, oy, oz = (px - e[1]) / e[4], (py - e[2]) / e[5], (pz - e[3]) / e[6]
	local vx, vy, vz = dx / e[4], dy / e[5], dz / e[6]
	local A = vx * vx + vy * vy + vz * vz
	local B = 2 * (ox * vx + oy * vy + oz * vz)
	local C = ox * ox + oy * oy + oz * oz - 1
	local disc = B * B - 4 * A * C
	if disc < 0 then
		return -1
	end
	return (-B + math.sqrt(disc)) / (2 * A)
end

-- Rotate a vector about X by `a` degrees (same sense as CFrame.Angles(a, 0, 0))
local function rotX(v, a)
	local c, sn = math.cos(math.rad(a)), math.sin(math.rad(a))
	return { v[1], v[2] * c - v[3] * sn, v[2] * sn + v[3] * c }
end

-- Point on the frog-head surface (skull + jaw) seen from (px,py,pz) along (dx,dy,dz),
-- pushed `out` studs outward. Input and output are in the head frame; the shell itself is
-- tilted by SHELL_TIP inside it. Returns position and outward unit normal.
local function headSurface(px, py, pz, dx, dy, dz, out)
	local len = math.sqrt(dx * dx + dy * dy + dz * dz)
	local p = rotX({ px, py, pz }, -SHELL_TIP)
	local d = rotX({ dx / len, dy / len, dz / len }, -SHELL_TIP)
	px, py, pz, dx, dy, dz = p[1], p[2], p[3], d[1], d[2], d[3]
	local t1 = exitT(SKULL, px, py, pz, dx, dy, dz)
	local t2 = exitT(JAW, px, py, pz, dx, dy, dz)
	local e, t = SKULL, t1
	if t2 > t1 then
		e, t = JAW, t2
	end
	local x, y, z = px + dx * t, py + dy * t, pz + dz * t
	local nx = (x - e[1]) / (e[4] * e[4])
	local ny = (y - e[2]) / (e[5] * e[5])
	local nz = (z - e[3]) / (e[6] * e[6])
	local nl = math.sqrt(nx * nx + ny * ny + nz * nz)
	nx, ny, nz = nx / nl, ny / nl, nz / nl
	return rotX({ x + nx * out, y + ny * out, z + nz * out }, SHELL_TIP), rotX({ nx, ny, nz }, SHELL_TIP)
end

-- Rotation that points a Cylinder's axis (local X) along unit vector v
local function axisRot(vx, vy, vz)
	local l = math.sqrt(vx * vx + vy * vy + vz * vz)
	vx, vy, vz = vx / l, vy / l, vz / l
	return { 0, deg(math.atan2(-vz, vx)), deg(math.asin(vy)) }
end

-- Cylinder segment between two points
local function segment(k, name, a, b, diameter, color)
	local vx, vy, vz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local len = math.sqrt(vx * vx + vy * vy + vz * vz)
	k:Part({ Name = name, Shape = "Cylinder", Size = { len, diameter, diameter }, Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 }, Rot = axisRot(vx, vy, vz), Color = color })
end

-- Point on the head surface around the mouth line: azimuth phi (0 = front, + = right),
-- dy = height above the mouth line (shell frame), pushed `out` studs outward
local function mouthPoint(phi, dy, out)
	local o = rotX({ 0, JAW_Y + dy, 0 }, SHELL_TIP)
	local d = rotX({ math.sin(math.rad(phi)), 0, -math.cos(math.rad(phi)) }, SHELL_TIP)
	return (headSurface(o[1], o[2], o[3], d[1], d[2], d[3], out))
end

-- Flat disc (thin Cylinder) lying on the head surface in direction (dx,dy,dz)
local function headDisc(k, name, dx, dy, dz, diameter, thick, sink, color)
	local p, n = headSurface(0, 0.05, 0, dx, dy, dz, sink)
	k:Part({ Name = name, Shape = "Cylinder", Size = { thick, diameter, diameter }, Pos = p, Rot = axisRot(n[1], n[2], n[3]), Color = color, Reflectance = 0.06 })
end

--------------------------------------------------------------------------------------------
-- Tyre (built around its own centre; the axle runs along Z so the hub faces the front)
--------------------------------------------------------------------------------------------
local function buildTire(k)
	local AXLE = { 0, 90, 0 } -- turns a Cylinder's X axis onto Z
	local function disc(name, width, diameter, color, material)
		k:Part({
			Name = name,
			Shape = "Cylinder",
			Size = { width, diameter, diameter },
			Rot = AXLE,
			Color = color,
			Material = material or "Rubber",
		})
	end

	-- big forms
	disc("Tire", TIRE_W, TIRE_R * 2, RUBBER)
	disc("Sidewall", TIRE_W + 0.12, 3.3, RUBBER)
	disc("SidewallGroove", TIRE_W + 0.14, 3.0, RUBBER_DARK)
	disc("SidewallRib", TIRE_W + 0.16, 2.72, RUBBER_LIGHT)
	disc("Bead", TIRE_W + 0.2, 2.42, RUBBER_DARK)
	-- the wheel
	disc("RimFlange", TIRE_W + 0.26, 2.2, RIM, "Metal")
	disc("RimDish", TIRE_W + 0.3, 1.86, RIM_DARK, "Metal")
	disc("HubCap", TIRE_W + 0.4, 0.95, HUB, "Metal")
	disc("CenterCap", TIRE_W + 0.48, 0.42, RIM_DARK, "Metal")

	-- five spokes, visible on both faces (they run straight through the wheel)
	for i = 0, 4 do
		local a = math.rad(90 + i * 72)
		k:Part({
			Name = "Spoke",
			Size = { 0.46, 0.22, TIRE_W + 0.34 },
			Pos = { math.cos(a) * 0.7, math.sin(a) * 0.7, 0 },
			Rot = { 0, 0, deg(a) },
			Color = RIM,
			Material = "Metal",
		})
	end
	-- five lug nuts on the hub cap
	for i = 0, 4 do
		local a = math.rad(90 + 36 + i * 72)
		k:Part({
			Name = "LugNut",
			Shape = "Cylinder",
			Size = { TIRE_W + 0.46, 0.14, 0.14 },
			Pos = { math.cos(a) * 0.3, math.sin(a) * 0.3, 0 },
			Rot = AXLE,
			Color = LUG,
			Material = "Metal",
		})
	end

	-- valve stem poking out of the front of the rim
	local va = math.rad(235)
	k:Part({ Name = "ValveStem", Shape = "Cylinder", Size = { 0.34, 0.1, 0.1 }, Pos = { math.cos(va) * 0.99, math.sin(va) * 0.99, -0.92 }, Rot = AXLE, Color = RUBBER_DARK, Material = "Rubber" })
	k:Part({ Name = "ValveCap", Shape = "Cylinder", Size = { 0.1, 0.13, 0.13 }, Pos = { math.cos(va) * 0.99, math.sin(va) * 0.99, -1.12 }, Rot = AXLE, Color = LUG, Material = "Metal" })

	-- tread: two staggered rows of blocks around the whole circumference
	local N = 10
	for row = 0, 1 do
		local z = if row == 0 then -0.42 else 0.42
		for i = 0, N - 1 do
			local a = math.rad((i + row * 0.5) * 360 / N)
			k:Part({
				Name = "Tread",
				Size = { 0.2, 0.62, 0.74 },
				Pos = { math.cos(a) * TIRE_R, math.sin(a) * TIRE_R, z },
				Rot = { 0, 0, deg(a) },
				Color = RUBBER_LIGHT,
				Material = "Rubber",
			})
		end
	end
end

--------------------------------------------------------------------------------------------
-- Frog head (head frame: origin = skull centre)
--------------------------------------------------------------------------------------------
local function buildHead(k)
	k:Group({ Name = "Shell", Rot = { SHELL_TIP, 0, 0 } }, function()
		k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { SKULL[4] * 2, SKULL[5] * 2, SKULL[6] * 2 }, Pos = { SKULL[1], SKULL[2], SKULL[3] }, Color = FROG, Reflectance = 0.08 })
		k:Part({ Name = "Jaw", Shape = "Ellipsoid", Size = { JAW[4] * 2, JAW[5] * 2, JAW[6] * 2 }, Pos = { JAW[1], JAW[2], JAW[3] }, Color = FROG, Reflectance = 0.06 })

		-- Wide mouth: a thin dark lens one notch bigger than the jaw's equator, so only a
		-- smooth line shows where skull and jaw meet. It is nudged forward so the line is
		-- boldest across the snout and sinks out of sight at the back of the head. The
		-- shell's tilt curves it into a smile.
		local M = 0.085
		k:Part({ Name = "Mouth", Shape = "Ellipsoid", Size = { (JAW[4] + M) * 2, 0.62, (JAW[6] + M) * 2 }, Pos = { 0, JAW_Y, -0.1 }, Color = MOUTH })

		-- Pale chin / throat bulging out of the front-bottom of the jaw; it gently pumps (breathing)
		k:Part({ Name = "Throat", Shape = "Ellipsoid", Size = { 2.5, 0.88, 2.16 }, Pos = { 0, -0.62, -0.42 }, Color = THROAT, Reflectance = 0.05, Anim = { Type = "Pulse", Amount = 0.035, Speed = 0.7, Phase = 0.4 } })
	end)

	-- centre dorsal spot
	headDisc(k, "Spot", 0, 0.62, 0.8, 0.52, 0.08, -0.025, FROG_SPOT)

	k:Mirror(function()
		-- Smile corners: the mouth line hooks upward under each eye
		segment(k, "SmileCorner", mouthPoint(52, 0.0, 0.03), mouthPoint(62, 0.2, 0.0), 0.1, MOUTH)

		-- Nostrils
		local np = headSurface(0, 0.05, 0, 0.17, 0.02, -1, -0.02)
		k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.17, 0.11, 0.12 }, Pos = np, Rot = { 10, 0, 0 }, Color = MOUTH })

		-- Tympanum (round ear drum) behind each eye
		headDisc(k, "Tympanum", 0.95, 0.08, 0.35, 0.62, 0.1, -0.02, EAR)

		-- Dorsal mottling: flat darker patches lying on the skin
		headDisc(k, "Spot", 0.36, 0.85, 0.4, 0.48, 0.08, -0.025, FROG_SPOT)
		headDisc(k, "Spot", 0.74, 0.42, 0.62, 0.4, 0.08, -0.025, FROG_SPOT)

		-- Huge bulging eye
		local EC = { 0.9, 0.81, -0.64 } -- eyeball centre
		local ER = 0.57
		k:Part({ Name = "EyeDome", Shape = "Ball", Size = { 1.34, 1.34, 1.34 }, Pos = { 0.88, 0.73, -0.48 }, Color = FROG, Reflectance = 0.08 })
		k:Part({ Name = "EyeLid", Shape = "Ellipsoid", Size = { 1.2, 0.42, 1.12 }, Pos = { 0.88, 1.13, -0.44 }, Rot = { -12, 0, -6 }, Color = FROG_DARK, Reflectance = 0.06 })
		local BLINK = { Type = "Blink", Speed = 0.28, Phase = 0.3 }
		k:Part({ Name = "Eyeball", Shape = "Ball", Size = { ER * 2, ER * 2, ER * 2 }, Pos = EC, Color = EYE_WHITE, Anim = BLINK })
		-- iris / pupil are flattened lenses sunk into the eyeball: only their front caps show
		local function onEye(yaw, pitch, r)
			local dx = math.sin(math.rad(yaw))
			local dy = math.sin(math.rad(pitch)) * math.cos(math.rad(yaw))
			local dz = -math.cos(math.rad(pitch)) * math.cos(math.rad(yaw))
			return { EC[1] + dx * r, EC[2] + dy * r, EC[3] + dz * r }
		end
		local LOOK = { 10, -16, 0 }
		k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.74, 0.74, 0.32 }, Pos = onEye(16, 10, 0.43), Rot = LOOK, Color = IRIS, Anim = BLINK })
		k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.5, 0.54, 0.28 }, Pos = onEye(16, 10, 0.49), Rot = LOOK, Color = PUPIL, Anim = BLINK })
		k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.15, 0.15, 0.15 }, Pos = onEye(7, 21, 0.61), Color = SHINE, Material = "Neon", Anim = BLINK })
		k:Part({ Name = "EyeShine2", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = onEye(25, 2, 0.62), Color = SHINE, Material = "Neon", Anim = BLINK })
	end)
end

--------------------------------------------------------------------------------------------
-- One long, thin, bare human leg. side = 1 (right, +X) or -1 (left, -X).
-- stride = forward swing at the hip (degrees): the meme is "frozen mid-stride".
--------------------------------------------------------------------------------------------
local function buildLeg(k, side, phase, stride)
	local SWING = 7
	local SPEED = 0.55
	k:Group({
		Name = if side > 0 then "RightLeg" else "LeftLeg",
		Pos = { 0.56 * side, HIP_Y, 0.05 },
		Rot = { stride, 0, 2 * side },
		Anim = { Type = "Wiggle", Axis = "X", Amount = SWING, Speed = SPEED, Phase = phase },
	}, function()
		-- thigh: a straight shaft for a clean line into the knee + an upper-thigh mass
		k:Part({ Name = "ThighMass", Shape = "Ellipsoid", Size = { 0.72, 2.0, 0.76 }, Pos = { 0, -0.55, 0.02 }, Color = SKIN })
		k:Part({ Name = "Thigh", Shape = "Cylinder", Size = { 1.85, 0.48, 0.48 }, Pos = { 0, -1.02, 0 }, Rot = { 0, 0, 90 }, Color = SKIN })

		-- knee bends the opposite way so the foot stays planted (a little knee-dip shuffle)
		k:Group({
			Name = "Knee",
			Pos = { 0, -1.95, 0 },
			Anim = { Type = "Wiggle", Axis = "X", Amount = -SWING * 2, Speed = SPEED, Phase = phase },
		}, function()
			k:Part({ Name = "KneeJoint", Shape = "Ball", Size = { 0.51, 0.51, 0.51 }, Color = SKIN })
			k:Part({ Name = "KneeCap", Shape = "Ellipsoid", Size = { 0.32, 0.36, 0.18 }, Pos = { 0, 0.04, -0.16 }, Color = SKIN })
			k:Part({ Name = "Shin", Shape = "Cylinder", Size = { 1.7, 0.36, 0.36 }, Pos = { 0, -0.85, 0 }, Rot = { 0, 0, 90 }, Color = SKIN })
			k:Part({ Name = "Calf", Shape = "Ellipsoid", Size = { 0.42, 1.3, 0.5 }, Pos = { 0.01 * side, -0.62, 0.08 }, Color = SKIN })

			k:Group({
				Name = "Ankle",
				Pos = { 0, -1.68, 0 },
				Rot = { -stride, -8 * side, -2 * side },
				Anim = { Type = "Wiggle", Axis = "X", Amount = SWING, Speed = SPEED, Phase = phase },
			}, function()
				k:Part({ Name = "AnkleBone", Shape = "Ellipsoid", Size = { 0.4, 0.3, 0.34 }, Pos = { 0.01 * side, -0.02, 0.02 }, Color = SKIN })
				k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 0.58, 0.34, 1.3 }, Pos = { 0.03 * side, -0.15, -0.36 }, Color = SKIN })
				k:Part({ Name = "Heel", Shape = "Ellipsoid", Size = { 0.4, 0.36, 0.44 }, Pos = { 0, -0.14, 0.1 }, Color = SKIN })

				-- toes curl and wiggle around their base knuckle
				k:Group({
					Name = "Toes",
					Pos = { 0, -0.2, -0.86 },
					Anim = { Type = "Wiggle", Axis = "X", Amount = 14, Speed = 1.1, Phase = phase + 0.2 },
				}, function()
					-- inner (big) toe -> outer (little) toe: {x, z, diameter}
					local toes = {
						{ -0.15, -0.12, 0.25 },
						{ -0.01, -0.1, 0.18 },
						{ 0.1, -0.07, 0.165 },
						{ 0.195, -0.03, 0.15 },
						{ 0.27, 0.03, 0.13 },
					}
					for i, t in toes do
						local d = t[3]
						-- toe bottoms rest on the ground (ground is local y = -0.12 here)
						k:Part({ Name = "Toe", Shape = "Ellipsoid", Size = { d, d * 0.9, d * 1.3 }, Pos = { (t[1] + 0.03) * side, -0.12 + d * 0.45, t[2] }, Color = if i == 1 then SKIN else SKIN_DARK })
					end
					k:Part({ Name = "BigToeNail", Shape = "Ellipsoid", Size = { 0.15, 0.05, 0.13 }, Pos = { -0.12 * side, -0.01, -0.21 }, Rot = { 14, 0, 0 }, Color = NAIL })
				end)
			end)
		end)
	end)
end

return {
	Id = "BonecaAmbalabu",
	Name = "Boneca Ambalabu",
	Rarity = "Common",
	Emoji = "🐸",
	Color = FROG,
	Tagline = "Frog head. Car tyre. Human legs. Ambalabu.",
	Lore = "Spotted at dawn strolling down a quiet street: a frog head on a car tyre on two very human legs. Nobody knows where the rest of the frog went, and nobody dares to ask. It never blinks first.",

	Build = function(k)
		-- Legs (written separately so they shuffle out of phase)
		buildLeg(k, 1, 0, 11)
		buildLeg(k, -1, 0.5, -9)

		-- Tyre torso + head sway together around the hips
		k:Group({ Name = "Body", Pos = { 0, HIP_Y, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = 0.4 } }, function()
			k:Group({ Name = "BodyOffset", Pos = { 0, -HIP_Y, 0 } }, function()
				-- the tyre rocks a little on its own axle
				k:Group({ Name = "Wheel", Pos = { 0, TIRE_Y, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 8, Speed = 0.3, Phase = 0.25 } }, function()
					buildTire(k)
				end)

				-- head bobs and tilts on the neck
				k:Group({ Name = "HeadBob", Pos = { 0, NECK_Y, 0 }, Anim = { Type = "Bob", Axis = "Y", Amount = 0.07, Speed = 0.8 } }, function()
					k:Group({ Name = "Head", Anim = { Type = "Wiggle", Axis = "Z", Amount = 7, Speed = 0.35, Phase = 0.1 } }, function()
						k:Group({ Name = "HeadFrame", Pos = { HEAD_C[1], HEAD_C[2] - NECK_Y, HEAD_C[3] } }, function()
							buildHead(k)
						end)
					end)
				end)
			end)
		end)
	end,

	BuildMini = function(k)
		-- long bare legs + feet (legs are ~40% of the height, like the full model)
		k:Mirror(function()
			k:Part({ Name = "Leg", Shape = "Cylinder", Size = { 0.98, 0.2, 0.2 }, Pos = { 0.25, -0.76, 0 }, Rot = { 0, 0, 90 }, Color = SKIN })
			k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 0.26, 0.15, 0.44 }, Pos = { 0.27, -1.255, -0.09 }, Color = SKIN })
		end)
		-- tyre with grey hub, facing front
		k:Part({ Name = "Tire", Shape = "Cylinder", Size = { 0.66, 1.24, 1.24 }, Pos = { 0, 0.06, 0 }, Rot = { 0, 90, 0 }, Color = RUBBER, Material = "Rubber" })
		k:Part({ Name = "Hub", Shape = "Cylinder", Size = { 0.74, 0.6, 0.6 }, Pos = { 0, 0.06, 0 }, Rot = { 0, 90, 0 }, Color = RIM, Material = "Metal" })
		-- frog head
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 1.5, 0.8, 1.3 }, Pos = { 0, 0.86, -0.05 }, Color = FROG })
		k:Mirror(function()
			k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.44, 0.44, 0.44 }, Pos = { 0.36, 1.1, -0.4 }, Color = EYE_WHITE })
			k:Part({ Name = "Pupil", Shape = "Ball", Size = { 0.22, 0.22, 0.22 }, Pos = { 0.39, 1.1, -0.58 }, Color = PUPIL })
		end)
		-- thin dark disc: only its rim pokes out of the head = wrap-around mouth line
		k:Part({ Name = "Mouth", Shape = "Ellipsoid", Size = { 1.42, 0.06, 1.28 }, Pos = { 0, 0.7, -0.1 }, Color = MOUTH })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">BrrBrrPatapim</string>
            <string name="Source"><![CDATA[--[[
	Brr Brr Patapim (Uncommon)
	Canonical look: a forest creature that is half proboscis monkey, half tree. A bark-brown
	wooden head and trunk body wrapped in a dark-green robe of leaves, a tan monkey face with
	tiny beady eyes under heavy brows and a HUGE pendulous pink-orange nose that hangs below
	his chin, a grey-green lichen beard (grey jaw fur + mossy chin), long thin branch arms with
	twig fingers and leaves on the elbows, short legs of entwined roots growing into ENORMOUS bare human feet, and a small
	hat on his leafy head ("il mio cappello e' pieno di Slim").

	Coordinates: feet on y = 0, faces -Z. Parts are written in world coordinates; every
	animated joint is a group placed at the joint with an un-animated "space" group inside
	that shifts back to world space (see `joint`).
]]

-- Palette ------------------------------------------------------------------------------
local BARK = "#6b4a2f" -- dominant: wood
local BARK_DARK = "#4a3221" -- knots, roots
local BARK_LIGHT = "#8c6544" -- knot rims
local HOLE = "#2b1d14"
local MOSS = "#5f8f2c"
local LEAF = "#4c9a33" -- secondary: foliage
local LEAF_LIGHT = "#7cc24a"
local LEAF_DARK = "#2f6e25"
local SKIN = "#e7b08b" -- face + feet
local SKIN_DARK = "#cf8f6a"
local NAIL = "#f8e3d2"
local NOSE = "#e98767" -- accent: the famous nose
local NOSE_LIGHT = "#f6b096"
local NOSTRIL = "#7a3328"
local LICHEN = "#8d9a6c" -- grey-green beard
local EYE_WHITE = "#fff6e6"
local PUPIL = "#1e1612"
local SHINE = "#fff8ec"
local HAT = "#3b2d27"
local HAT_BAND = "#d9a23d"
local SLIME = "#9fe04a"
local SHROOM_CAP = "#c4552f"
local SHROOM_STEM = "#f3e6cc"

-- Helpers ------------------------------------------------------------------------------
local function deg(r)
	return r * 180 / math.pi
end

-- Rotation that points a part's local X axis along (vx, vy, vz); local Z stays horizontal.
local function axisRot(vx, vy, vz)
	local l = math.sqrt(vx * vx + vy * vy + vz * vz)
	vx, vy, vz = vx / l, vy / l, vz / l
	return { 0, deg(math.atan2(-vz, vx)), deg(math.asin(math.clamp(vy, -1, 1))) }
end

local function mid(a, b)
	return { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 }
end

local function dist(a, b)
	local x, y, z = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	return math.sqrt(x * x + y * y + z * z)
end

local function add(a, b, s)
	s = s or 1
	return { a[1] + b[1] * s, a[2] + b[2] * s, a[3] + b[3] * s }
end

-- Cylinder branch from a to b (ends overlap a little so joints stay closed)
local function twig(k, name, a, b, d, color)
	k:Part({
		Name = name,
		Shape = "Cylinder",
		Size = { dist(a, b) + d * 0.5, d, d },
		Pos = mid(a, b),
		Rot = axisRot(b[1] - a[1], b[2] - a[2], b[3] - a[3]),
		Color = color or BARK,
		Material = "Wood",
	})
end

-- Ellipsoid stretched from a to b. w = local Y size, t = local Z size (Z stays horizontal).
local function blob(k, name, a, b, w, t, color, material, anim)
	k:Part({
		Name = name,
		Shape = "Ellipsoid",
		Size = { dist(a, b), w, t },
		Pos = mid(a, b),
		Rot = axisRot(b[1] - a[1], b[2] - a[2], b[3] - a[3]),
		Color = color,
		Material = material or "SmoothPlastic",
		Anim = anim,
	})
end

-- Leaf blade from stem a to tip b. `flat` turns the blade's face toward the horizontal axis.
local function leaf(k, name, a, b, w, color, anim, flat)
	if flat then
		blob(k, name, a, b, 0.09, w, color or LEAF, "SmoothPlastic", anim)
	else
		blob(k, name, a, b, w, 0.09, color or LEAF, "SmoothPlastic", anim)
	end
end

-- Animated joint at world point p; children keep using world coordinates.
local function joint(k, name, p, anim, fn, rot)
	k:Group({ Name = name, Pos = p, Rot = rot, Anim = anim }, function()
		k:Group({ Name = name .. "Space", Pos = { -p[1], -p[2], -p[3] } }, fn)
	end)
end

local function mushroom(k, name, base, h, cap, lean)
	local top = { base[1] + (lean or 0), base[2] + h, base[3] }
	twig(k, name .. "Stem", base, top, cap * 0.32, SHROOM_STEM)
	k:Part({
		Name = name .. "Cap",
		Shape = "Ellipsoid",
		Size = { cap, cap * 0.5, cap },
		Pos = { top[1], top[2] + cap * 0.08, top[3] },
		Rot = { 0, 0, -(lean or 0) * 60 },
		Color = SHROOM_CAP,
	})
end

--------------------------------------------------------------------------------------------
-- Giant bare human foot (local to an ankle group; s = 1 right foot (+X), -1 left foot)
--------------------------------------------------------------------------------------------
local FOOT_X = 1.0
local FOOT_Z = 0.15
local TOES = { -- x offset (toward the outside of the foot), y, z, size x, y, z
	{ -0.47, 0.25, -2.12, 0.56, 0.5, 0.72 }, -- big toe (inner side)
	{ -0.06, 0.21, -2.1, 0.36, 0.4, 0.56 },
	{ 0.22, 0.19, -2.0, 0.32, 0.36, 0.5 },
	{ 0.46, 0.17, -1.88, 0.29, 0.32, 0.46 },
	{ 0.66, 0.15, -1.72, 0.26, 0.28, 0.4 },
}

local FS = 1.1 -- foot scale: these feet are the whole joke

local function buildFoot(k, s)
	k:Group({ Name = "Foot", Pos = { FOOT_X * s, 0, FOOT_Z }, Rot = { 0, -6 * s, 0 } }, function()
		-- local foot space, scaled by FS; x offsets are mirrored by s (positive = outside)
		local function P(x, y, z)
			return { x * s * FS, y * FS, z * FS }
		end
		local function S(x, y, z)
			return { x * FS, y * FS, z * FS }
		end
		k:Part({ Name = "FootSole", Shape = "Ellipsoid", Size = S(1.6, 0.62, 3.15), Pos = P(0, 0.31, -0.72), Color = SKIN })
		local instep = { -0.03, 0.56, -0.2, 0.56, 0.56, 0.875 }
		k:Part({ Name = "FootInstep", Shape = "Ellipsoid", Size = S(1.12, 1.12, 1.75), Pos = P(instep[1], instep[2], instep[3]), Color = SKIN })
		k:Part({ Name = "Heel", Shape = "Ellipsoid", Size = S(1.05, 0.82, 1.0), Pos = P(0, 0.41, 0.5), Color = SKIN })
		for i, t in ipairs(TOES) do
			k:Part({ Name = "Toe" .. i, Shape = "Ellipsoid", Size = S(t[4], t[5], t[6]), Pos = P(t[1], t[2], t[3]), Color = SKIN })
			if i <= 2 then
				k:Part({
					Name = "Toenail" .. i,
					Shape = "Ellipsoid",
					Size = S(t[4] * 0.58, 0.06, t[6] * 0.4),
					Pos = P(t[1], t[2] + t[5] * 0.42, t[3] - t[6] * 0.28),
					Rot = { -26, 0, 0 },
					Color = NAIL,
				})
			end
		end
		-- the root-legs grow into the top of the foot
		local function instepTop(x, z)
			local u, w = (x - instep[1]) / instep[4], (z - instep[3]) / instep[6]
			return instep[2] + instep[5] * math.sqrt(math.max(0, 1 - u * u - w * w))
		end
		k:Part({ Name = "AnkleRoots", Shape = "Ellipsoid", Size = S(0.74, 0.42, 0.74), Pos = P(0, 1.08, 0.05), Color = BARK_DARK, Material = "Wood" })
		for _, r in ipairs({ { 0.4, -0.5 }, { -0.36, -0.7 } }) do
			twig(k, "Root", P(r[1] * 0.3, 1.1, 0.05 + (r[2] - 0.05) * 0.25), P(r[1], instepTop(r[1], r[2]) + 0.02, r[2]), 0.15 * FS, BARK_DARK)
		end
	end)
end

-- Short legs of two entwined roots, crossing at a knotted knee
local function buildLeg(k, s)
	local ankle = { FOOT_X * s, 1.12 * FS, FOOT_Z + 0.05 }
	local knee = { 0.9 * s, 2.08, 0.06 }
	local hip = { 0.5 * s, 3.1, 0.04 }
	local d = { 0.1 * s, 0, 0.09 }
	twig(k, "RootShin", add(ankle, d), add(knee, d, -1), 0.21, BARK)
	twig(k, "RootShin", add(ankle, d, -1), add(knee, d), 0.19, BARK_DARK)
	twig(k, "RootThigh", add(knee, d, -1), add(hip, d), 0.22, BARK)
	twig(k, "RootThigh", add(knee, d), add(hip, d, -1), 0.2, BARK_DARK)
	k:Part({ Name = "KneeKnot", Shape = "Ellipsoid", Size = { 0.44, 0.4, 0.44 }, Pos = knee, Color = BARK_DARK, Material = "Wood" })
end

--------------------------------------------------------------------------------------------
-- Branch arm (right side, mirrored for the left)
--------------------------------------------------------------------------------------------
local SH = { 1.04, 5.0, 0.02 }
local EL = { 1.74, 3.95, -0.15 }
local WR = { 2.18, 2.78, -0.38 }

local function buildArm(k)
	joint(k, "Arm", SH, { Type = "Wiggle", Axis = "Z", Amount = 8, Speed = 0.45 }, function()
		k:Part({ Name = "ShoulderKnot", Shape = "Ball", Size = { 0.42, 0.42, 0.42 }, Pos = SH, Color = BARK_DARK, Material = "Wood" })
		twig(k, "UpperArm", SH, EL, 0.26, BARK)
		joint(k, "Forearm", EL, { Type = "Wiggle", Axis = "X", Amount = 9, Speed = 0.6, Phase = 0.3 }, function()
			k:Part({ Name = "ElbowKnot", Shape = "Ellipsoid", Size = { 0.38, 0.4, 0.38 }, Pos = EL, Color = BARK_DARK, Material = "Wood" })
			leaf(k, "ElbowLeaf", { 1.82, 4.0, -0.15 }, { 2.35, 4.32, -0.05 }, 0.32, LEAF, { Type = "Wiggle", Axis = "X", Amount = 25, Speed = 0.9 })
			leaf(k, "ElbowLeaf", { 1.8, 3.92, -0.05 }, { 2.18, 3.85, 0.38 }, 0.28, LEAF_LIGHT, { Type = "Wiggle", Axis = "X", Amount = 25, Speed = 0.8, Phase = 0.5 })
			twig(k, "LowerArm", EL, WR, 0.21, BARK)
			joint(k, "Hand", WR, { Type = "Wiggle", Axis = "Z", Amount = 10, Speed = 0.9, Phase = 0.6 }, function()
				twig(k, "Finger", WR, { 2.0, 2.2, -0.66 }, 0.1, BARK)
				twig(k, "Finger", WR, { 2.3, 2.16, -0.52 }, 0.1, BARK)
				twig(k, "Thumb", WR, { 1.96, 2.56, -0.86 }, 0.09, BARK)
			end)
		end)
	end)
end

--------------------------------------------------------------------------------------------
-- Head: tree-bark skull, tan monkey face, beady eyes, giant nose, leafy crown and hat
--------------------------------------------------------------------------------------------
local function buildNose(k)
	-- the whole nose swings like a pendulum from its root between the eyes
	joint(k, "Nose", { 0, 7.0, -1.05 }, { Type = "Wiggle", Axis = "Z", Amount = 5, Speed = 0.7 }, function()
		blob(k, "NoseBridge", { 0, 7.12, -0.98 }, { 0, 6.12, -1.42 }, 0.5, 0.48, NOSE)
		blob(k, "NoseBody", { 0, 6.82, -1.1 }, { 0, 5.2, -1.66 }, 0.82, 0.86, NOSE)
		joint(k, "NoseTip", { 0, 6.1, -1.45 }, { Type = "Wiggle", Axis = "X", Amount = 6, Speed = 1.1, Phase = 0.3 }, function()
			k:Part({ Name = "NoseBulb", Shape = "Ellipsoid", Size = { 1.22, 1.2, 1.06 }, Pos = { 0, 5.45, -1.7 }, Color = NOSE })
			k:Part({ Name = "NoseShine", Shape = "Ellipsoid", Size = { 0.18, 0.3, 0.08 }, Pos = { 0.24, 5.8, -2.08 }, Rot = { 33, -21, 0 }, Color = NOSE_LIGHT })
			k:Mirror(function()
				k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.2, 0.06, 0.14 }, Pos = { 0.22, 4.97, -1.94 }, Rot = { 33, 0, 20 }, Color = NOSTRIL })
			end)
		end)
	end)
end

local function buildHat(k)
	local P = { 0.12, 8.22, 0.14 }
	joint(k, "Hat", P, { Type = "Wiggle", Axis = "Z", Amount = 5, Speed = 0.7, Phase = 0.2 }, function()
		k:Part({ Name = "HatBrim", Shape = "Cylinder", Size = { 0.09, 1.5, 1.5 }, Pos = { P[1], 8.26, P[3] }, Rot = { 0, 0, 90 }, Color = HAT, Material = "Fabric" })
		k:Part({ Name = "HatCrown", Shape = "Cylinder", Size = { 0.62, 0.92, 0.92 }, Pos = { P[1], 8.6, P[3] }, Rot = { 0, 0, 90 }, Color = HAT, Material = "Fabric" })
		k:Part({ Name = "HatBand", Shape = "Cylinder", Size = { 0.15, 0.96, 0.96 }, Pos = { P[1], 8.38, P[3] }, Rot = { 0, 0, 90 }, Color = HAT_BAND, Material = "Fabric" })
		k:Part({ Name = "Slim", Shape = "Ellipsoid", Size = { 1.08, 0.42, 1.08 }, Pos = { P[1], 8.93, P[3] }, Color = SLIME, Material = "Glass", Anim = { Type = "Pulse", Amount = 0.06, Speed = 0.6 } })
		k:Part({ Name = "SlimOverflow", Shape = "Ellipsoid", Size = { 0.5, 0.42, 0.46 }, Pos = { P[1] + 0.3, 8.84, P[3] - 0.3 }, Rot = { 0, 0, -20 }, Color = SLIME, Material = "Glass" })
	end, { -6, 0, -10 })
end

local function buildHead(k)
	joint(k, "Head", { 0, 5.45, 0.05 }, { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = 0.45, Phase = 0.15 }, function()
		k:Part({ Name = "Neck", Shape = "Cylinder", Size = { 0.7, 1.0, 1.0 }, Pos = { 0, 5.5, 0.12 }, Rot = { 0, 0, 90 }, Color = BARK_DARK, Material = "Wood" })
		k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { 2.35, 2.25, 2.1 }, Pos = { 0, 6.75, 0.1 }, Color = BARK, Material = "Wood" })
		k:Part({ Name = "Face", Shape = "Ellipsoid", Size = { 1.8, 1.75, 0.85 }, Pos = { 0, 6.6, -0.72 }, Color = SKIN })
		-- grey-green "old man's beard" lichen: his grey jaw fur and mossy chin in one
		k:Part({ Name = "LichenBeard", Shape = "Ellipsoid", Size = { 2.05, 1.05, 1.4 }, Pos = { 0, 5.92, -0.38 }, Color = LICHEN, Material = "Grass" })
		k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { 1.45, 0.85, 0.8 }, Pos = { 0, 5.95, -0.82 }, Color = SKIN })
		k:Mirror(function()
			k:Part({ Name = "Cheek", Shape = "Ellipsoid", Size = { 0.5, 0.4, 0.26 }, Pos = { 0.62, 6.32, -0.98 }, Rot = { 0, -25, 0 }, Color = SKIN })
			k:Part({ Name = "Ear", Shape = "Ellipsoid", Size = { 0.24, 0.5, 0.42 }, Pos = { 1.18, 6.8, 0.1 }, Color = SKIN_DARK })
			k:Part({ Name = "EarInner", Shape = "Ellipsoid", Size = { 0.08, 0.32, 0.24 }, Pos = { 1.29, 6.8, 0.08 }, Color = NOSTRIL })
			k:Part({ Name = "Brow", Shape = "Ellipsoid", Size = { 0.7, 0.22, 0.34 }, Pos = { 0.44, 7.34, -0.98 }, Rot = { 0, -18, -12 }, Color = BARK_DARK, Material = "Wood" })
			-- tiny beady eyes
			k:Part({ Name = "EyeSocket", Shape = "Ellipsoid", Size = { 0.44, 0.38, 0.1 }, Pos = { 0.42, 7.02, -1.02 }, Rot = { 0, -20, 0 }, Color = SKIN_DARK })
			k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.3, 0.28, 0.14 }, Pos = { 0.42, 7.02, -1.06 }, Rot = { 0, -20, 0 }, Color = EYE_WHITE, Anim = { Type = "Blink", Speed = 0.3 } })
			k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.2, 0.22, 0.08 }, Pos = { 0.41, 7.01, -1.12 }, Rot = { 0, -20, 0 }, Color = PUPIL, Anim = { Type = "Blink", Speed = 0.3 } })
			k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.07, 0.07, 0.07 }, Pos = { 0.44, 7.07, -1.16 }, Color = SHINE, Anim = { Type = "Blink", Speed = 0.3 } })
		end)
		-- bark grooves running down the back of the wooden head
		for _, a in ipairs({ -38, 0, 38 }) do
			local ra = math.rad(180 + a)
			k:Part({
				Name = "BarkRidge",
				Shape = "Ellipsoid",
				Size = { 0.16, 1.05, 0.16 },
				Pos = { 1.12 * math.sin(ra), 6.6, 0.1 - 1.03 * math.cos(ra) },
				Rot = { 0, a, 0 },
				Color = BARK_DARK,
				Material = "Wood",
			})
		end
		buildNose(k)

		-- leafy crown
		-- bushy canopy of leaf clumps on top of the head
		k:Part({ Name = "CrownLeaves", Shape = "Ellipsoid", Size = { 1.95, 0.85, 1.85 }, Pos = { 0, 7.85, 0.15 }, Color = LEAF_DARK, Material = "Grass" })
		for i, a in ipairs({ 0, 72, 144, 216, 288 }) do
			local ra = math.rad(a)
			local big = i % 2 == 1
			k:Part({
				Name = "LeafClump",
				Shape = "Ellipsoid",
				Size = if big then { 0.9, 0.66, 0.8 } else { 0.8, 0.6, 0.72 },
				Pos = { 0.74 * math.sin(ra), 7.86 + (if big then 0.06 else 0), 0.15 - 0.7 * math.cos(ra) },
				Rot = { 0, -a, if big then 10 else -8 },
				Color = if big then LEAF else LEAF_LIGHT,
				Material = "Grass",
			})
		end
		leaf(k, "CrownSprig", { -0.6, 8.05, 0.2 }, { -1.25, 8.5, 0.38 }, 0.32, LEAF_LIGHT, { Type = "Wiggle", Axis = "X", Amount = 20, Speed = 0.6, Phase = 0.4 })
		leaf(k, "CrownSprig", { 0.3, 8.1, 0.7 }, { 0.5, 8.55, 1.25 }, 0.32, LEAF, { Type = "Wiggle", Axis = "X", Amount = 20, Speed = 0.8, Phase = 0.7 }, true)

		buildHat(k)
	end)
end

--------------------------------------------------------------------------------------------
-- Trunk body under an open robe of leaves (sways gently from the hips like a tree)
--------------------------------------------------------------------------------------------
-- right half of the leafy robe {cx, cy, cz, semiX, semiY, semiZ}; mirrored for the left
local ROBE = { 0.5, 4.2, 0.15, 0.72, 1.2, 0.98 }

-- point on the robe surface at azimuth a (0 = front, 90 = outside) and height y, pushed out
local function robePoint(a, y, out)
	local e = ROBE
	local f = math.sqrt(math.max(0, 1 - ((y - e[2]) / e[5]) ^ 2))
	local ra = math.rad(a)
	return {
		e[1] + (e[4] * f + out) * math.sin(ra),
		y,
		e[3] - (e[6] * f + out) * math.cos(ra),
	}
end

-- overlapping leaf "shingle" lying on the robe, its tip flared out from the surface
local function shingle(k, a, y, size, color, roll, flare)
	k:Group({ Name = "Shingle", Pos = robePoint(a, y, 0.02), Rot = { 0, -a, 0 } }, function()
		k:Part({ Name = "RobeLeaf", Shape = "Ellipsoid", Size = size, Rot = { flare or 14, 0, roll }, Color = color })
	end)
end

local ROBE_LEAVES = { -- azimuth, height, colour, roll in the robe plane
	{ 26, 4.6, LEAF, 16 },
	{ 82, 4.75, LEAF_LIGHT, -14 },
	{ 58, 3.75, MOSS, -20 },
	{ 138, 4.2, LEAF, 18 },
	{ 176, 3.85, LEAF_LIGHT, -12 },
	{ 16, 3.6, LEAF_LIGHT, 8 },
}

local function buildTrunk(k)
	joint(k, "Trunk", { 0, 2.95, 0 }, { Type = "Wiggle", Axis = "Z", Amount = 2.5, Speed = 0.35 }, function()
		k:Part({ Name = "RootFlare", Shape = "Ellipsoid", Size = { 1.8, 0.9, 1.55 }, Pos = { 0, 3.08, 0.03 }, Color = BARK_DARK, Material = "Wood" })
		k:Part({ Name = "TrunkCore", Shape = "Ellipsoid", Size = { 1.65, 2.6, 1.65 }, Pos = { 0, 4.1, 0 }, Color = BARK, Material = "Wood" })
		-- knot hole belly button on the bark showing between the robe halves
		k:Part({ Name = "KnotRim", Shape = "Ellipsoid", Size = { 0.42, 0.6, 0.2 }, Pos = { 0, 3.95, -0.78 }, Color = BARK_LIGHT, Material = "Wood" })
		k:Part({ Name = "KnotHole", Shape = "Ellipsoid", Size = { 0.22, 0.36, 0.08 }, Pos = { 0, 3.95, -0.86 }, Color = HOLE })

		k:Mirror(function()
			k:Part({ Name = "LeafRobe", Shape = "Ellipsoid", Size = { ROBE[4] * 2, ROBE[5] * 2, ROBE[6] * 2 }, Pos = { ROBE[1], ROBE[2], ROBE[3] }, Color = LEAF_DARK, Material = "Grass" })
			for _, c in ipairs(ROBE_LEAVES) do
				shingle(k, c[1], c[2], { 0.5, 1.35, 0.13 }, c[3], c[4], 20)
			end
			-- pointed leaves hanging from the robe's hem
			for i, a in ipairs({ 22, 80, 140 }) do
				local top = robePoint(a, 3.35, -0.06)
				local ra = math.rad(a)
				local tip = { top[1] + 0.25 * math.sin(ra), 2.72 - 0.06 * i, top[3] - 0.25 * math.cos(ra) }
				leaf(k, "HemLeaf", top, tip, 0.42, if i % 2 == 0 then LEAF_LIGHT else LEAF, nil, true)
			end
		end)

		-- leafy collar around the neck (open at the front for the nose)
		for i, a in ipairs({ 80, 180, 280 }) do
			local ra = math.rad(a)
			local sa, ca = math.sin(ra), math.cos(ra)
			leaf(k, "CollarLeaf", { 0.45 * sa, 5.3, 0.1 - 0.42 * ca }, { 1.0 * sa, 5.55, 0.1 - 0.92 * ca }, 0.62, if i % 2 == 0 then LEAF_LIGHT else LEAF, nil, true)
		end

		-- a cluster of mushrooms sprouting from his right shoulder
		mushroom(k, "Mushroom", { 1.0, 5.08, 0.3 }, 0.42, 0.52, 0.05)
		mushroom(k, "Mushroom", { 0.76, 5.12, 0.55 }, 0.28, 0.34, -0.06)

		-- little branch growing out of the back
		twig(k, "BackBranch", { 0.2, 4.4, 0.8 }, { 0.6, 5.05, 1.35 }, 0.18, BARK)
		leaf(k, "BackLeaf", { 0.6, 5.05, 1.35 }, { 0.85, 5.45, 1.55 }, 0.32, LEAF_LIGHT, { Type = "Wiggle", Axis = "X", Amount = 20, Speed = 0.7, Phase = 0.2 })

		k:Mirror(function()
			buildArm(k)
		end)
		buildHead(k)
	end)
end

return {
	Id = "BrrBrrPatapim",
	Name = "Brr Brr Patapim",
	Rarity = "Uncommon",
	Emoji = "🌳",
	Color = "#5f8f2c",
	Tagline = "Brr brr! His hat is full of Slim.",
	Lore = "Half proboscis monkey, half forest tree, all feet. Patapim stomps through the woods on his giant bare feet, wiggling his enormous nose at anyone who wanders by. Nobody knows what Slim is, but it is definitely in his hat.",

	Build = function(k)
		-- left foot plants, right foot taps along to the "brr brr" (pivoting on its heel)
		buildFoot(k, -1)
		joint(k, "TappingFoot", { FOOT_X, 0.02, FOOT_Z + 1.02 * FS }, { Type = "Wiggle", Axis = "X", Amount = 3.5, Speed = 0.9 }, function()
			buildFoot(k, 1)
		end, { 3.5, 0, 0 })
		buildLeg(k, -1)
		buildLeg(k, 1)

		buildTrunk(k)

		-- a few leaves drift up off his crown
		k:Particles({ Pos = { 0, 8.1, 0.2 }, Color = LEAF_LIGHT, Color2 = MOSS, Rate = 3, Size = 0.22, Speed = 0.8, Lifetime = 1.8, Spread = 50, Direction = "Top" })
	end,

	BuildMini = function(k)
		k:Mirror(function()
			k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 0.7, 0.4, 1.3 }, Pos = { 0.39, -1.13, -0.26 }, Rot = { 0, -8, 0 }, Color = SKIN })
			k:Part({ Name = "Arm", Shape = "Cylinder", Size = { 0.8, 0.13, 0.13 }, Pos = { 0.7, -0.5, -0.08 }, Rot = axisRot(0.53, -0.55, -0.15), Color = BARK, Material = "Wood" })
			k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.15, 0.15, 0.15 }, Pos = { 0.19, 0.5, -0.5 }, Color = PUPIL })
		end)
		k:Part({ Name = "Body", Shape = "Ellipsoid", Size = { 0.95, 1.05, 0.85 }, Pos = { 0, -0.55, 0.05 }, Color = LEAF, Material = "Grass" })
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 1.15, 1.05, 1.0 }, Pos = { 0, 0.38, 0.06 }, Color = BARK, Material = "Wood" })
		k:Part({ Name = "Face", Shape = "Ellipsoid", Size = { 0.86, 0.82, 0.42 }, Pos = { 0, 0.33, -0.3 }, Color = SKIN })
		k:Part({ Name = "Nose", Shape = "Ellipsoid", Size = { 0.5, 0.95, 0.46 }, Pos = { 0, -0.08, -0.62 }, Rot = { -12, 0, 0 }, Color = NOSE })
		k:Part({ Name = "Leaves", Shape = "Ellipsoid", Size = { 1.15, 0.5, 1.05 }, Pos = { 0, 0.88, 0.1 }, Color = LEAF_LIGHT, Material = "Grass" })
		k:Part({ Name = "Hat", Shape = "Cylinder", Size = { 0.3, 0.62, 0.62 }, Pos = { 0.05, 1.18, 0.1 }, Rot = { 0, 0, 90 }, Color = HAT })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">CappuccinoAssassino</string>
            <string name="Source"><![CDATA[--[[
	Cappuccino Assassino (Rare)
	Canonical look: a white ceramic cappuccino cup as the HEAD (side handle, brown crema with
	a white latte-art heart on top, faint steam), a black ninja cloth tied around the top of
	the cup, angry eyes + brows on the cup, a slim black ninja body (sash, wrapped wrists and
	shins, split-toe ninja boots) and TWO katanas, one in each hand, in a crouched stance.

	Rare flair (never changes the design): gleaming Neon katana edges + glints, steam
	particles, one soft warm light over the cup.

	Coordinates: feet on y = 0, faces -Z, right hand at +X. Animated joints use a group whose
	origin is the joint plus an un-animated "frame" group that shifts back, so every part
	inside is still written in world coordinates.
]]

-- Palette ------------------------------------------------------------------------------
local CUP = "#f5efe4" -- dominant head: warm white ceramic
local CUP_SHADE = "#e3d8c6" -- foot ring, handle pads
local CUP_HI = "#fffdf8" -- glaze highlights
local CREMA = "#b0703f" -- coffee crema
local FOAM = "#fff7ea" -- latte-art heart
local FOAM_CREAM = "#ecd8b8" -- foam bubbles

local NINJA = "#25252f" -- dominant body: tinted black
local NINJA_DARK = "#191920"
local NINJA_LIGHT = "#363645" -- lapels, knee pads, folds
local SCARF = "#2c2c38"
local WRAP = "#4b4b5a" -- bandage wraps
local WRAP_LIGHT = "#62627a"
local SASH = "#7a4a2b" -- coffee-brown sash (secondary)
local SASH_DARK = "#5a341d"
local LEATHER = "#4e3220"
local SOLE = "#121218"

local STEEL = "#cdd6e0"
local STEEL_DARK = "#8d97a5"
local GLEAM = "#e6f4ff" -- Neon edge (accent)
local GOLD = "#c9a046"
local ITO = "#1d1d27" -- katana handle wrap
local SAME = "#efe4cc" -- handle diamonds
local IRON = "#3a3a46"

local LINE = "#1b1b24" -- eye rims, brows, mouth
local EYE_WHITE = "#fffaf0"
local IRIS = "#7a2a1c"
local PUPIL = "#121217"
local SHINE = "#ffffff"
local STEAM = "#ffffff"

local CHAIN = "#565b69" -- kusari mesh undershirt
local ENGRAVE = "#2b2f3a" -- swirl engraved in the forehead plate

-- Layout (world studs) -------------------------------------------------------------------
-- The upper body is written upright and then dropped + leaned forward as a whole (Stance),
-- which turns the pose into a low crouched assassin stance.
local HIPC = { 0, 3.35, 0 } -- upper-body pivot (before the stance drop)
local DROP = 0.38 -- how far the whole upper body sinks into the crouch
local LEAN = -7 -- forward lean of the upper body (degrees about X)
local NECK = { 0, 5.62, -0.06 } -- head pivot
local CZ = -0.08 -- cup axis z
local CUP_R = 1.35 -- cup radius (straight upper wall)
local BOWL_Y = 7.15 -- centre of the round bowl / start of the straight wall
local BOWL_SY = 1.25 -- bowl depth (bottom at 5.9)
local CUP_TOP = 8.4
local BAND_Y = 8.1 -- ninja cloth tied around the cup
local BAND_H = 0.44

-- Torso volumes {cx, cy, cz, ax, ay, az}
local CHEST = { 0, 4.72, -0.04, 0.7, 0.675, 0.45 }
local UPCHEST = { 0, 5.02, -0.04, 0.81, 0.39, 0.42 }
local WAIST = { 0, 3.95, 0, 0.5, 0.375, 0.36 }
local PELVIS = { 0, 3.4, 0.02, 0.575, 0.31, 0.41 }

-- Limb joints (right side; legs are mirrored)
local R_SHOULDER = { 0.72, 5.12, -0.05 }
local R_ELBOW = { 1.38, 4.55, -0.42 }
local R_HAND = { 1.78, 5.15, -0.92 }
local R_BLADE = { 0.41, 0.9, 0.14 } -- raised katana direction

local L_SHOULDER = { -0.72, 5.12, -0.05 }
local L_ELBOW = { -1.36, 4.42, 0.0 }
local L_HAND = { -1.55, 4.32, -0.76 }
local L_BLADE = { -0.45, -0.82, -0.35 } -- low-guard katana direction

-- legs are built in final (crouched) coordinates
local HIP = { 0.42, 2.93, 0.02 }
local KNEE = { 1.14, 1.72, -0.58 }
local ANKLE = { 1.2, 0.58, -0.04 }

-- Helpers --------------------------------------------------------------------------------
local function deg(r)
	return r * 180 / math.pi
end

local function sub(a, b)
	return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
end

local function vlen(v)
	return math.sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3])
end

local function lerp(a, b, t)
	return { a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, a[3] + (b[3] - a[3]) * t }
end

-- Rotation (degrees) that points a part's local +Y along direction d
local function aimY(d)
	local l = vlen(d)
	local x, y, z = d[1] / l, d[2] / l, d[3] / l
	return { deg(math.atan2(z, y)), 0, deg(math.asin(-x)) }
end

-- Animated joint: rotates/bobs around p, children keep world coordinates
local function joint(k, name, p, anim, fn)
	k:Group({ Name = name, Pos = p, Anim = anim }, function()
		k:Group({ Name = name .. "Frame", Pos = { -p[1], -p[2], -p[3] } }, fn)
	end)
end

-- Static pivot: rotates children by rot around p, then shifts them by off (world coords kept)
local function pivot(k, name, p, rot, off, fn)
	k:Group({ Name = name, Pos = { p[1] + off[1], p[2] + off[2], p[3] + off[3] }, Rot = rot }, function()
		k:Group({ Name = name .. "Frame", Pos = { -p[1], -p[2], -p[3] } }, fn)
	end)
end

-- Group whose local +Y runs from a to b; fn(L) builds along it
local function seg(k, name, a, b, fn)
	local d = sub(b, a)
	k:Group({ Name = name, Pos = a, Rot = aimY(d) }, function()
		fn(vlen(d))
	end)
end

-- Rounded limb part between two points
local function bone(k, name, a, b, w, d, color, material, shape, extra)
	local v = sub(b, a)
	k:Part({
		Name = name,
		Shape = shape or "Ellipsoid",
		Size = { w, vlen(v) + (extra or 0), d or w },
		Pos = lerp(a, b, 0.5),
		Rot = aimY(v),
		Color = color,
		Material = material or "Fabric",
	})
end

-- Flat cloth strip from a to b, twisted about its length so it reads from several sides
local function ribbon(k, name, a, b, w, color, twist, extra)
	local v = sub(b, a)
	k:Group({ Name = name, Pos = lerp(a, b, 0.5), Rot = aimY(v) }, function()
		k:Part({ Name = name, Size = { w, vlen(v) + (extra or 0.08), 0.05 }, Rot = { 0, twist, 0 }, Color = color, Material = "Fabric" })
	end)
end

-- Front (side = -1) or back (side = 1) surface z of the torso at (x, y)
local function torsoZ(x, y, side)
	local best = nil
	for _, e in ipairs({ CHEST, UPCHEST, WAIST, PELVIS }) do
		local f = ((x - e[1]) / e[4]) ^ 2 + ((y - e[2]) / e[5]) ^ 2
		if f < 1 then
			local z = e[3] + side * e[6] * math.sqrt(1 - f)
			if best == nil or z * side > best * side then
				best = z
			end
		end
	end
	return best or 0
end

-- Strap that hugs the torso through a list of {x, y} points
local function strap(k, name, pts, side, out, w, color)
	for i = 1, #pts - 1 do
		local a = { pts[i][1], pts[i][2], torsoZ(pts[i][1], pts[i][2], side) + side * out }
		local b = { pts[i + 1][1], pts[i + 1][2], torsoZ(pts[i + 1][1], pts[i + 1][2], side) + side * out }
		bone(k, name, a, b, w, 0.06, color, "Leather", "Block", 0.06)
	end
end

-- Cup surface radius at height y (round bowl below BOWL_Y, straight wall above)
local function cupRadius(y)
	if y >= BOWL_Y then
		return CUP_R
	end
	local f = (BOWL_Y - y) / BOWL_SY
	return CUP_R * math.sqrt(math.max(0, 1 - f * f))
end

-- Point on the cup surface at height y and angle a (0 = front, + toward +X), pushed `out`
-- along the normal. Returns position and a rotation whose local -Z faces outward.
local function cupFrame(y, a, out)
	local r = cupRadius(y)
	local ar = math.rad(a)
	local tilt = 0
	if y < BOWL_Y then
		tilt = deg(math.atan2((BOWL_Y - y) / (BOWL_SY * BOWL_SY), r / (CUP_R * CUP_R)))
	end
	local tr = math.rad(tilt)
	local nx, ny, nz = math.sin(ar) * math.cos(tr), -math.sin(tr), -math.cos(ar) * math.cos(tr)
	return { r * math.sin(ar) + nx * out, y + ny * out, CZ - r * math.cos(ar) + nz * out }, { -tilt, -a, 0 }
end

--------------------------------------------------------------------------------------------
-- Katana, built along local +Y from the grip centre (spine at +X, edge at -X, flats face Z)
--------------------------------------------------------------------------------------------
local function katana(k, glintPhase, sparkle)
	-- handle (tsuka)
	k:Part({ Name = "Kashira", Shape = "Cylinder", Size = { 0.08, 0.21, 0.21 }, Pos = { 0, -0.52, 0 }, Rot = { 0, 0, 90 }, Color = GOLD, Material = "Foil" })
	k:Part({ Name = "Tsuka", Shape = "Cylinder", Size = { 0.84, 0.17, 0.17 }, Pos = { 0, -0.08, 0 }, Rot = { 0, 0, 90 }, Color = ITO, Material = "Fabric" })
	for _, y in ipairs({ -0.36, -0.16 }) do
		k:Part({ Name = "TsukaDiamond", Size = { 0.09, 0.09, 0.2 }, Pos = { 0, y, 0 }, Rot = { 0, 0, 45 }, Color = SAME })
	end
	k:Part({ Name = "Fuchi", Shape = "Cylinder", Size = { 0.07, 0.2, 0.2 }, Pos = { 0, 0.34, 0 }, Rot = { 0, 0, 90 }, Color = GOLD, Material = "Foil" })
	-- guard (tsuba): gold rim around a dark iron centre
	k:Part({ Name = "Tsuba", Shape = "Cylinder", Size = { 0.05, 0.54, 0.54 }, Pos = { 0, 0.4, 0 }, Rot = { 0, 0, 90 }, Color = GOLD, Material = "Foil" })
	k:Part({ Name = "TsubaIron", Shape = "Cylinder", Size = { 0.08, 0.42, 0.42 }, Pos = { 0, 0.4, 0 }, Rot = { 0, 0, 90 }, Color = IRON, Material = "Metal" })
	-- blade: steel body, gleaming Neon cutting edge, dark fuller groove, wedge tip
	k:Part({ Name = "Blade", Size = { 0.22, 2.3, 0.06 }, Pos = { 0, 1.6, 0 }, Color = STEEL, Material = "Metal", Reflectance = 0.3 })
	k:Part({ Name = "BladeTip", Shape = "Wedge", Size = { 0.06, 0.4, 0.22 }, Pos = { 0, 2.95, 0 }, Rot = { 0, 90, 0 }, Color = STEEL, Material = "Metal", Reflectance = 0.3 })
	k:Part({ Name = "EdgeGleam", Size = { 0.05, 2.3, 0.07 }, Pos = { -0.095, 1.6, 0 }, Color = GLEAM, Material = "Neon" })
	k:Part({ Name = "Bohi", Size = { 0.05, 1.8, 0.07 }, Pos = { 0.05, 1.35, 0 }, Color = STEEL_DARK, Material = "Metal" })
	-- pulsing glint near the tip + a sparkle emitter on the raised blade (Rare flair)
	if sparkle then
		k:Particles({ Pos = { 0, 1.9, 0 }, Color = GLEAM, Color2 = "#ffffff", Rate = 2, Size = 0.14, Speed = 0.25, Lifetime = 0.7, Spread = 180 })
		k:Part({ Name = "Glint", Shape = "Ball", Size = { 0.12, 0.12, 0.12 }, Pos = { -0.07, 2.62, 0 }, Color = SHINE, Material = "Neon", Anim = { Type = "Pulse", Amount = 0.35, Speed = 0.7, Phase = glintPhase } })
	end
	-- gloved fist around the handle
	k:Part({ Name = "Fist", Shape = "Ellipsoid", Size = { 0.38, 0.44, 0.36 }, Pos = { 0, 0.11, 0 }, Color = NINJA, Material = "Fabric" })
	k:Part({ Name = "Thumb", Shape = "Ball", Size = { 0.15, 0.15, 0.15 }, Pos = { 0.08, 0.3, -0.12 }, Color = NINJA, Material = "Fabric" })
end

--------------------------------------------------------------------------------------------
-- Arm: shoulder -> elbow -> hand, with wrist wraps and a katana in the fist
--------------------------------------------------------------------------------------------
local function arm(k, name, side, S, E, H, bladeDir, shoulderAnim, elbowAnim, wristAnim, glintPhase)
	joint(k, name, S, shoulderAnim, function()
		k:Part({ Name = "Shoulder", Shape = "Ellipsoid", Size = { 0.56, 0.52, 0.54 }, Pos = S, Color = NINJA, Material = "Fabric" })
		bone(k, "Sleeve", S, E, 0.47, 0.47, NINJA, "Fabric", "Ellipsoid", 0.2)
		joint(k, name .. "Forearm", E, elbowAnim, function()
			k:Part({ Name = "Elbow", Shape = "Ball", Size = { 0.36, 0.36, 0.36 }, Pos = E, Color = NINJA, Material = "Fabric" })
			seg(k, "Forearm", E, H, function(L)
				k:Part({ Name = "ForearmCore", Shape = "Ellipsoid", Size = { 0.38, L + 0.1, 0.38 }, Pos = { 0, L * 0.45, 0 }, Color = NINJA, Material = "Fabric" })
				-- tekko: dark iron arm guard strapped on the outside of the forearm
				k:Part({ Name = "Tekko", Shape = "Ellipsoid", Size = { 0.14, L * 0.5, 0.3 }, Pos = { side * 0.16, L * 0.36, 0 }, Color = IRON, Material = "Metal", Reflectance = 0.1 })
				for i, f in ipairs({ 0.62, 0.79 }) do
					local tilt = if i % 2 == 0 then -10 else 10
					k:Part({ Name = "WristWrap", Shape = "Cylinder", Size = { 0.12, 0.39, 0.39 }, Pos = { 0, L * f, 0 }, Rot = { tilt, 0, 90 }, Color = if i == 2 then WRAP_LIGHT else WRAP, Material = "Fabric" })
				end
			end)
			joint(k, name .. "Katana", H, wristAnim, function()
				k:Group({ Name = name .. "Blade", Pos = H, Rot = aimY(bladeDir) }, function()
					katana(k, glintPhase, glintPhase == 0)
				end)
			end)
		end)
	end)
end

--------------------------------------------------------------------------------------------
-- Cup head (world coordinates, built inside the head joint)
--------------------------------------------------------------------------------------------
local function cupHead(k)
	-- big forms: round bowl + straight wall + rim + foot ring
	k:Part({ Name = "CupBowl", Shape = "Ellipsoid", Size = { CUP_R * 2, BOWL_SY * 2, CUP_R * 2 }, Pos = { 0, BOWL_Y, CZ }, Color = CUP, Reflectance = 0.06 })
	k:Part({ Name = "CupWall", Shape = "Cylinder", Size = { CUP_TOP - BOWL_Y, CUP_R * 2, CUP_R * 2 }, Pos = { 0, (CUP_TOP + BOWL_Y) / 2, CZ }, Rot = { 0, 0, 90 }, Color = CUP, Reflectance = 0.06 })
	k:Part({ Name = "CupLip", Shape = "Cylinder", Size = { 0.1, CUP_R * 2 + 0.1, CUP_R * 2 + 0.1 }, Pos = { 0, CUP_TOP + 0.03, CZ }, Rot = { 0, 0, 90 }, Color = CUP_HI, Reflectance = 0.06 })
	k:Part({ Name = "CupFoot", Shape = "Cylinder", Size = { 0.16, 1.3, 1.3 }, Pos = { 0, 5.87, CZ }, Rot = { 0, 0, 90 }, Color = CUP_SHADE })

	-- coffee: domed crema with a lighter centre and a flat white latte-art heart
	-- (two round lobes at the back, the point toward the front, a pulled line through it)
	k:Part({ Name = "Crema", Shape = "Ellipsoid", Size = { 2.6, 0.28, 2.6 }, Pos = { 0, 8.41, CZ }, Color = CREMA })
	k:Part({ Name = "CremaRing", Shape = "Ellipsoid", Size = { 2.0, 0.26, 2.0 }, Pos = { 0, 8.425, CZ }, Color = "#c58552" })
	k:Mirror(function()
		k:Part({ Name = "HeartLobe", Shape = "Cylinder", Size = { 0.05, 0.76, 0.76 }, Pos = { 0.27, 8.56, CZ + 0.18 }, Rot = { 0, 0, 90 }, Color = FOAM })
	end)
	k:Part({ Name = "HeartPoint", Size = { 0.72, 0.05, 0.72 }, Pos = { 0, 8.56, CZ - 0.08 }, Rot = { 0, 45, 0 }, Color = FOAM })
	k:Part({ Name = "HeartPull", Size = { 0.05, 0.05, 0.9 }, Pos = { 0, 8.585, CZ - 0.1 }, Color = "#d29a68" })
	for _, a in ipairs({ 65, 235 }) do
		local ar = math.rad(a)
		k:Part({ Name = "FoamBubble", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = { math.sin(ar) * 1.02, 8.48, CZ - math.cos(ar) * 1.02 }, Color = FOAM_CREAM })
	end

	-- handle on the left side (-X): a smooth C-loop of short overlapping cylinders
	local HCX, HCY, HR = -1.4, 7.5, 0.4
	local segLen = 2 * HR * math.sin(math.rad(15)) + 0.05
	for i = 0, 5 do
		local m = math.rad(105 + i * 30)
		k:Part({ Name = "Handle", Shape = "Cylinder", Size = { segLen, 0.23, 0.23 }, Pos = { HCX + math.cos(m) * HR, HCY + math.sin(m) * HR, CZ }, Rot = { 0, 0, deg(m) + 90 }, Color = CUP, Reflectance = 0.06 })
	end
	k:Part({ Name = "HandlePadTop", Shape = "Ellipsoid", Size = { 0.26, 0.28, 0.32 }, Pos = { -cupRadius(HCY + HR) - 0.04, HCY + HR, CZ }, Color = CUP_SHADE })
	k:Part({ Name = "HandlePadLow", Shape = "Ellipsoid", Size = { 0.26, 0.28, 0.32 }, Pos = { -cupRadius(HCY - HR) - 0.04, HCY - HR, CZ }, Color = CUP_SHADE })

	-- ninja headband tied around the cup, with a big steel forehead plate engraved with a swirl
	k:Part({ Name = "NinjaBand", Shape = "Cylinder", Size = { BAND_H, CUP_R * 2 + 0.08, CUP_R * 2 + 0.08 }, Pos = { 0, BAND_Y, CZ }, Rot = { 0, 0, 90 }, Color = NINJA_DARK, Material = "Fabric" })
	k:Part({ Name = "BandFold", Shape = "Cylinder", Size = { 0.12, CUP_R * 2 + 0.12, CUP_R * 2 + 0.12 }, Pos = { 0, BAND_Y - 0.1, CZ }, Rot = { 5, 0, 90 }, Color = NINJA, Material = "Fabric" })
	for _, a in ipairs({ -17, 0, 17 }) do
		local p, r = cupFrame(BAND_Y, a, 0.07)
		k:Part({ Name = "BandPlate", Size = { if a == 0 then 0.44 else 0.42, 0.36, 0.05 }, Pos = p, Rot = r, Color = STEEL, Material = "Metal", Reflectance = 0.25 })
	end
	k:Mirror(function()
		for _, y in ipairs({ BAND_Y + 0.12, BAND_Y - 0.12 }) do
			local p, r = cupFrame(y, 23, 0.1)
			k:Part({ Name = "PlateRivet", Shape = "Ball", Size = { 0.07, 0.07, 0.07 }, Pos = p, Rot = r, Color = STEEL_DARK, Material = "Metal" })
		end
	end)
	do
		-- engraved spiral (equal-length strokes along r = a + b*t)
		local p, r = cupFrame(BAND_Y, 0, 0.1)
		k:Group({ Name = "Swirl", Pos = p, Rot = r }, function()
			local a, tmax, n = 0.02, 7.85, 7
			local b = 0.13 / tmax
			local total = a * tmax + b * tmax * tmax / 2
			local function at(s)
				local t = (-a + math.sqrt(a * a + 2 * b * total * s)) / b
				local rr = a + b * t
				return rr * math.cos(t), rr * math.sin(t)
			end
			for i = 1, n do
				local x1, y1 = at((i - 1) / n)
				local x2, y2 = at(i / n)
				local dx, dy = x2 - x1, y2 - y1
				k:Part({ Name = "SwirlStroke", Size = { math.sqrt(dx * dx + dy * dy) + 0.04, 0.05, 0.05 }, Pos = { (x1 + x2) / 2, (y1 + y2) / 2, 0 }, Rot = { 0, 0, deg(math.atan2(dy, dx)) }, Color = ENGRAVE, Material = "Metal" })
			end
		end)
	end
	-- knot at the back
	local knot, kr = cupFrame(BAND_Y, 180, 0.1)
	k:Part({ Name = "BandKnot", Shape = "Ellipsoid", Size = { 0.36, 0.34, 0.26 }, Pos = knot, Rot = kr, Color = NINJA_DARK, Material = "Fabric" })
	k:Mirror(function()
		k:Part({ Name = "KnotLoop", Shape = "Ellipsoid", Size = { 0.34, 0.2, 0.14 }, Pos = { 0.25, knot[2] + 0.07, knot[3] - 0.02 }, Rot = { 0, 0, 25 }, Color = NINJA, Material = "Fabric" })
	end)
	-- fluttering tails
	joint(k, "BandTails", knot, { Type = "Wiggle", Axis = "Y", Amount = 14, Speed = 0.55, Phase = 0.1 }, function()
		joint(k, "TailA", knot, { Type = "Wiggle", Axis = "X", Amount = 10, Speed = 0.8, Phase = 0 }, function()
			local a1 = { knot[1] + 0.25, knot[2] - 0.4, knot[3] + 0.6 }
			local a2 = { knot[1] + 0.5, knot[2] - 0.85, knot[3] + 1.05 }
			ribbon(k, "BandTail", knot, a1, 0.25, NINJA_DARK, 40, 0.1)
			ribbon(k, "BandTailEnd", a1, a2, 0.23, NINJA_DARK, 60, 0.06)
		end)
		joint(k, "TailB", knot, { Type = "Wiggle", Axis = "X", Amount = 12, Speed = 0.8, Phase = 0.35 }, function()
			local b1 = { knot[1] - 0.15, knot[2] - 0.55, knot[3] + 0.5 }
			local b2 = { knot[1] - 0.35, knot[2] - 1.05, knot[3] + 0.82 }
			ribbon(k, "BandTail", knot, b1, 0.25, NINJA_DARK, -40, 0.1)
			ribbon(k, "BandTailEnd", b1, b2, 0.23, NINJA_DARK, -60, 0.06)
		end)
	end)

	-- angry face: big eyes (rim, white, red-brown iris, pupil, shine) under slanted lids + V brows
	local BLINK = { Type = "Blink", Speed = 0.28, Phase = 0.15 }
	k:Mirror(function()
		local p, r = cupFrame(7.28, 21, 0)
		k:Group({ Name = "Eye", Pos = p, Rot = r }, function()
			k:Part({ Name = "EyeRim", Shape = "Ellipsoid", Size = { 0.84, 0.72, 0.1 }, Color = LINE })
			k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.72, 0.6, 0.12 }, Pos = { 0, -0.01, -0.03 }, Color = EYE_WHITE, Anim = BLINK })
			k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.33, 0.37, 0.08 }, Pos = { -0.05, -0.07, -0.08 }, Color = IRIS, Anim = BLINK })
			k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.17, 0.21, 0.06 }, Pos = { -0.05, -0.07, -0.11 }, Color = PUPIL, Anim = BLINK })
			k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.09, 0.09, 0.09 }, Pos = { 0.02, 0.0, -0.13 }, Color = SHINE, Material = "Neon", Anim = BLINK })
			k:Part({ Name = "AngryLid", Size = { 0.92, 0.22, 0.06 }, Pos = { -0.02, 0.28, -0.07 }, Rot = { 0, 0, 22 }, Color = LINE })
		end)
		local bp, br = cupFrame(7.73, 19, 0)
		k:Part({ Name = "Brow", Size = { 0.8, 0.19, 0.1 }, Pos = bp, Rot = { br[1], br[2], 24 }, Color = LINE })
	end)
	do
		local p, r = cupFrame(6.6, 0, 0)
		k:Group({ Name = "Mouth", Pos = p, Rot = r }, function()
			k:Part({ Name = "MouthMid", Size = { 0.24, 0.08, 0.07 }, Pos = { 0, 0.02, 0 }, Color = LINE })
			k:Mirror(function()
				k:Part({ Name = "MouthSide", Size = { 0.22, 0.08, 0.07 }, Pos = { 0.19, -0.015, 0.005 }, Rot = { 0, 0, -24 }, Color = LINE })
			end)
		end)
	end

	-- steam: two thin curling wisps (overlapping translucent ellipsoids along an S-curve),
	-- steam particles and a warm light (Rare flair)
	local function wisp(x0, z0, y0, dir, phase)
		local pts = {}
		for i = 0, 4 do
			local t = i / 4
			pts[i + 1] = { x0 + dir * 0.13 * math.sin(t * math.pi * 1.6), y0 + t * 0.85, z0 + 0.06 * t }
		end
		for i = 1, 4 do
			local a, b = pts[i], pts[i + 1]
			local v = sub(b, a)
			local w = 0.17 - i * 0.022
			k:Part({
				Name = "SteamWisp",
				Shape = "Ellipsoid",
				Size = { w, vlen(v) + 0.12, w },
				Pos = lerp(a, b, 0.5),
				Rot = aimY(v),
				Color = STEAM,
				Transparency = 0.4 + i * 0.09,
				Anim = { Type = "Bob", Axis = "Y", Amount = 0.06, Speed = 0.5, Phase = phase + i * 0.1 },
			})
		end
	end
	wisp(-0.45, CZ + 0.35, 8.66, 1, 0)
	wisp(0.48, CZ + 0.25, 8.64, -1, 0.5)
	k:Particles({ Pos = { 0, 8.7, CZ }, Color = "#ffffff", Color2 = "#f1e4cf", Rate = 3, Size = 0.35, Speed = 0.8, Lifetime = 1.8, Spread = 18, Direction = "Top" })
	k:Light({ Pos = { 0, 9.0, CZ - 0.4 }, Color = "#ffe2b8", Range = 9, Brightness = 0.8 })
end

--------------------------------------------------------------------------------------------
-- Torso, sash, jacket hem, straps and the crossed scabbards on the back (pre-stance coords)
--------------------------------------------------------------------------------------------
local function torso(k)
	local function vol(name, e, color)
		k:Part({ Name = name, Shape = "Ellipsoid", Size = { e[4] * 2, e[5] * 2, e[6] * 2 }, Pos = { e[1], e[2], e[3] }, Color = color, Material = "Fabric" })
	end
	vol("Chest", CHEST, NINJA)
	vol("UpperChest", UPCHEST, NINJA)
	vol("Waist", WAIST, NINJA)
	vol("Pelvis", PELVIS, NINJA)
	k:Part({ Name = "Neck", Shape = "Cylinder", Size = { 0.55, 0.44, 0.44 }, Pos = { 0, 5.6, -0.06 }, Rot = { 0, 0, 90 }, Color = NINJA_DARK, Material = "Fabric" })
	-- wrapped neck scarf the cup rests on, with a fluttering tail
	k:Part({ Name = "Scarf", Shape = "Ellipsoid", Size = { 1.06, 0.46, 0.9 }, Pos = { 0, 5.62, -0.06 }, Color = SCARF, Material = "Fabric" })
	k:Part({ Name = "ScarfFold", Shape = "Ellipsoid", Size = { 1.1, 0.12, 0.94 }, Pos = { 0, 5.5, -0.06 }, Rot = { 6, 0, 0 }, Color = NINJA_LIGHT, Material = "Fabric" })
	local SCK = { 0.12, 5.6, 0.36 }
	joint(k, "ScarfTail", SCK, { Type = "Wiggle", Axis = "X", Amount = 14, Speed = 0.6, Phase = 0.45 }, function()
		ribbon(k, "ScarfTail", SCK, { 0.3, 5.1, 0.82 }, 0.27, SCARF, 35, 0.08)
	end)

	-- kusari mesh undershirt in the V of the crossed gi lapels
	k:Part({ Name = "Undershirt", Shape = "Ellipsoid", Size = { 0.46, 0.62, 0.08 }, Pos = { 0, 5.0, torsoZ(0, 5.0, -1) + 0.02 }, Color = CHAIN, Material = "DiamondPlate" })
	k:Mirror(function()
		strap(k, "Lapel", { { 0.36, 5.3 }, { 0.17, 4.98 }, { -0.04, 4.6 } }, -1, 0.015, 0.18, NINJA_LIGHT)
	end)

	-- diagonal leather bandolier over the right shoulder, carrying a steel shuriken
	strap(k, "ChestStrap", { { 0.52, 5.14 }, { 0.22, 4.7 }, { -0.12, 4.2 }, { -0.42, 3.84 } }, -1, 0.04, 0.17, LEATHER)
	do
		local x, y = 0.31, 4.84
		local z = torsoZ(x, y, -1) - 0.1
		k:Part({ Name = "Shuriken", Size = { 0.42, 0.1, 0.05 }, Pos = { x, y, z }, Rot = { 0, 0, 45 }, Color = STEEL, Material = "Metal", Reflectance = 0.2 })
		k:Part({ Name = "Shuriken", Size = { 0.42, 0.1, 0.05 }, Pos = { x, y, z }, Rot = { 0, 0, -45 }, Color = STEEL, Material = "Metal", Reflectance = 0.2 })
		k:Part({ Name = "ShurikenHub", Shape = "Cylinder", Size = { 0.07, 0.13, 0.13 }, Pos = { x, y, z - 0.01 }, Rot = { 0, 90, 0 }, Color = IRON, Material = "Metal" })
	end
	strap(k, "BackStrap", { { 0.52, 5.14 }, { 0.0, 4.4 }, { -0.45, 3.84 } }, 1, 0.04, 0.17, LEATHER)

	-- coffee-brown sash with a front knot and fluttering ends
	k:Part({ Name = "Sash", Shape = "Ellipsoid", Size = { 1.14, 0.36, 0.86 }, Pos = { 0, 3.74, 0.0 }, Color = SASH, Material = "Fabric" })
	local SK = { -0.3, 3.72, -0.43 }
	k:Part({ Name = "SashKnot", Shape = "Ellipsoid", Size = { 0.28, 0.26, 0.17 }, Pos = SK, Color = SASH, Material = "Fabric" })
	joint(k, "SashTails", SK, { Type = "Wiggle", Axis = "X", Amount = 12, Speed = 0.7, Phase = 0.25 }, function()
		bone(k, "SashTail", SK, { -0.42, 3.1, -0.6 }, 0.16, 0.05, SASH, "Fabric", "Block", 0.06)
		bone(k, "SashTail", SK, { -0.2, 3.18, -0.58 }, 0.15, 0.05, SASH_DARK, "Fabric", "Block", 0.06)
	end)

	-- jacket hem: two crossed front flaps and a back flap hanging from under the sash
	local function hem(name, top, w, len, rx, rz, phase)
		joint(k, name, top, { Type = "Wiggle", Axis = "X", Amount = 4, Speed = 0.55, Phase = phase }, function()
			k:Group({ Name = name .. "Drape", Pos = top, Rot = { rx, 0, rz } }, function()
				k:Part({ Name = name, Size = { w, len, 0.06 }, Pos = { 0, -len / 2, 0 }, Color = NINJA, Material = "Fabric" })
				k:Part({ Name = name .. "Trim", Size = { w + 0.02, 0.08, 0.08 }, Pos = { 0, -len + 0.04, 0 }, Color = NINJA_LIGHT, Material = "Fabric" })
			end)
		end)
	end
	hem("HemRight", { 0.22, 3.64, torsoZ(0.22, 3.64, -1) - 0.03 }, 0.46, 0.66, 20, 5, 0.1)
	hem("HemLeft", { -0.22, 3.64, torsoZ(-0.22, 3.64, -1) - 0.07 }, 0.46, 0.66, 20, -5, 0.35)
	hem("HemBack", { 0, 3.64, torsoZ(0, 3.64, 1) + 0.03 }, 0.96, 0.66, -14, 0, 0.6)

	-- leather pouch on the back of the sash
	k:Part({ Name = "Pouch", Size = { 0.34, 0.3, 0.16 }, Pos = { 0.36, 3.62, 0.46 }, Rot = { 0, 22, 0 }, Color = LEATHER, Material = "Leather" })
	k:Part({ Name = "PouchFlap", Size = { 0.36, 0.12, 0.19 }, Pos = { 0.36, 3.74, 0.47 }, Rot = { 0, 22, 0 }, Color = SASH_DARK, Material = "Leather" })

	-- two empty scabbards crossed on the back
	local function saya(name, top, bot)
		local d = sub(bot, top)
		k:Group({ Name = name, Pos = top, Rot = aimY(d) }, function()
			local L = vlen(d)
			k:Part({ Name = "Saya", Size = { 0.2, L, 0.13 }, Pos = { 0, L / 2, 0 }, Color = NINJA_DARK, Material = "SmoothPlastic", Reflectance = 0.12 })
			k:Part({ Name = "Koiguchi", Size = { 0.24, 0.12, 0.17 }, Pos = { 0, 0.06, 0 }, Color = GOLD, Material = "Foil" })
			k:Part({ Name = "Kojiri", Size = { 0.24, 0.14, 0.17 }, Pos = { 0, L - 0.05, 0 }, Color = GOLD, Material = "Foil" })
			k:Part({ Name = "Sageo", Size = { 0.23, 0.06, 0.16 }, Pos = { 0, L * 0.24, 0 }, Color = SASH, Material = "Fabric" })
		end)
	end
	saya("SayaA", { 0.66, 5.72, 0.46 }, { -0.5, 3.66, 0.54 })
	saya("SayaB", { -0.66, 5.72, 0.58 }, { 0.5, 3.66, 0.66 })
end

--------------------------------------------------------------------------------------------
-- Leg (right side, mirrored; final crouched coords): baggy pants gathered under the knee,
-- wrapped shin (kyahan), split-toe tabi boot
--------------------------------------------------------------------------------------------
local function leg(k)
	bone(k, "Thigh", HIP, KNEE, 0.6, 0.6, NINJA, "Fabric", "Ellipsoid", 0.3)
	local kd = sub(ANKLE, KNEE)
	local kl = vlen(kd)
	local below = { KNEE[1] + kd[1] / kl * 0.2, KNEE[2] + kd[2] / kl * 0.2, KNEE[3] + kd[3] / kl * 0.2 }
	bone(k, "PantsBalloon", lerp(HIP, KNEE, 0.5), below, 0.72, 0.72, NINJA, "Fabric", "Ellipsoid", 0.12)
	k:Part({ Name = "Knee", Shape = "Ball", Size = { 0.48, 0.48, 0.48 }, Pos = KNEE, Color = NINJA, Material = "Fabric" })
	k:Part({ Name = "KneePad", Shape = "Ellipsoid", Size = { 0.42, 0.46, 0.18 }, Pos = { KNEE[1] + 0.03, KNEE[2] + 0.04, KNEE[3] - 0.25 }, Rot = { -12, -18, 0 }, Color = NINJA_LIGHT, Material = "Fabric" })
	seg(k, "Shin", KNEE, ANKLE, function(L)
		k:Part({ Name = "ShinCore", Shape = "Cylinder", Size = { L, 0.4, 0.4 }, Pos = { 0, L / 2, 0 }, Rot = { 0, 0, 90 }, Color = NINJA, Material = "Fabric" })
		for i, f in ipairs({ 0.3, 0.52, 0.74 }) do
			local tilt = if i % 2 == 0 then -9 else 9
			k:Part({ Name = "ShinWrap", Shape = "Cylinder", Size = { 0.13, 0.47, 0.47 }, Pos = { 0, L * f, 0 }, Rot = { tilt, 0, 90 }, Color = if i % 2 == 0 then WRAP_LIGHT else WRAP, Material = "Fabric" })
		end
	end)
	k:Part({ Name = "TabiAnkle", Shape = "Cylinder", Size = { 0.34, 0.46, 0.46 }, Pos = { ANKLE[1] + 0.02, 0.5, ANKLE[3] - 0.03 }, Rot = { 0, 0, 90 }, Color = NINJA_DARK, Material = "Fabric" })
	k:Group({ Name = "Boot", Pos = { 1.24, 0.22, -0.28 }, Rot = { 0, -14, 0 } }, function()
		k:Part({ Name = "Tabi", Shape = "Ellipsoid", Size = { 0.54, 0.44, 1.0 }, Pos = { 0.02, 0, 0.02 }, Color = NINJA_DARK, Material = "Fabric" })
		k:Part({ Name = "BigToe", Shape = "Ellipsoid", Size = { 0.2, 0.26, 0.36 }, Pos = { -0.16, -0.06, -0.38 }, Color = NINJA_DARK, Material = "Fabric" })
		k:Part({ Name = "ToeSplit", Size = { 0.05, 0.18, 0.22 }, Pos = { -0.06, -0.06, -0.42 }, Color = LINE })
		k:Part({ Name = "Sole", Shape = "Ellipsoid", Size = { 0.58, 0.1, 1.06 }, Pos = { 0.0, -0.17, 0.0 }, Color = SOLE, Material = "Rubber" })
	end)
end

return {
	Id = "CappuccinoAssassino",
	Name = "Cappuccino Assassino",
	Rarity = "Rare",
	Emoji = "☕",
	Color = "#b0703f",
	Tagline = "Two katanas, one espresso shot, zero mercy.",
	Lore = "Cappuccino Assassino strikes before your coffee gets cold. He trained for years in a hidden cafe and only fights for the last biscotto. If you hear a faint hiss of steam behind you, it is already too late.",

	Build = function(k)
		-- legs stay planted in a wide crouch
		k:Mirror(function()
			leg(k)
		end)

		-- the whole upper body sinks into the crouch and leans forward, then bobs in a ready stance
		pivot(k, "Stance", HIPC, { LEAN, 0, 0 }, { 0, -DROP, 0 }, function()
			joint(k, "UpperBody", HIPC, { Type = "Bob", Axis = "Y", Amount = 0.045, Speed = 0.55, Phase = 0 }, function()
				torso(k)

				arm(k, "RightArm", 1, R_SHOULDER, R_ELBOW, R_HAND, R_BLADE,
					{ Type = "Wiggle", Axis = "X", Amount = 6, Speed = 0.5, Phase = 0 },
					{ Type = "Wiggle", Axis = "Z", Amount = 6, Speed = 0.5, Phase = 0.2 },
					{ Type = "Wiggle", Axis = "Z", Amount = 16, Speed = 0.6, Phase = 0.1 },
					0)
				arm(k, "LeftArm", -1, L_SHOULDER, L_ELBOW, L_HAND, L_BLADE,
					{ Type = "Wiggle", Axis = "X", Amount = 5, Speed = 0.5, Phase = 0.5 },
					{ Type = "Wiggle", Axis = "Y", Amount = 6, Speed = 0.5, Phase = 0.7 },
					{ Type = "Wiggle", Axis = "Y", Amount = 12, Speed = 0.6, Phase = 0.6 },
					0.5)

				joint(k, "Head", NECK, { Type = "Wiggle", Axis = "Z", Amount = 3.5, Speed = 0.45, Phase = 0.2 }, function()
					cupHead(k)
				end)
			end)
		end)
	end,

	BuildMini = function(k)
		-- cappuccino cup head with the ninja cloth and angry eyes
		k:Part({ Name = "CupBowl", Shape = "Ellipsoid", Size = { 1.44, 1.1, 1.44 }, Pos = { 0, 0.55, 0 }, Color = CUP })
		k:Part({ Name = "CupWall", Shape = "Cylinder", Size = { 0.55, 1.44, 1.44 }, Pos = { 0, 0.825, 0 }, Rot = { 0, 0, 90 }, Color = CUP })
		k:Part({ Name = "Crema", Shape = "Ellipsoid", Size = { 1.34, 0.18, 1.34 }, Pos = { 0, 1.1, 0 }, Color = CREMA })
		k:Part({ Name = "NinjaBand", Shape = "Cylinder", Size = { 0.2, 1.5, 1.5 }, Pos = { 0, 0.96, 0 }, Rot = { 0, 0, 90 }, Color = NINJA_DARK, Material = "Fabric" })
		k:Part({ Name = "Handle", Shape = "Cylinder", Size = { 0.14, 0.52, 0.52 }, Pos = { -0.76, 0.66, 0 }, Rot = { 0, 90, 0 }, Color = CUP })
		k:Mirror(function()
			k:Part({ Name = "AngryEye", Shape = "Ellipsoid", Size = { 0.34, 0.17, 0.1 }, Pos = { 0.25, 0.66, -0.68 }, Rot = { 0, -20, 22 }, Color = LINE })
		end)
		-- slim ninja body on crouched legs
		k:Part({ Name = "Body", Shape = "Ellipsoid", Size = { 0.78, 0.92, 0.62 }, Pos = { 0, -0.38, 0 }, Color = NINJA, Material = "Fabric" })
		k:Mirror(function()
			k:Part({ Name = "Leg", Shape = "Ellipsoid", Size = { 0.28, 0.66, 0.32 }, Pos = { 0.3, -0.97, -0.02 }, Rot = { 0, 0, 16 }, Color = NINJA_DARK, Material = "Fabric" })
		end)
		-- two katanas: one raised, one held low
		k:Part({ Name = "KatanaR", Size = { 0.11, 1.57, 0.06 }, Pos = { 0.75, 0.28, -0.22 }, Rot = { 0, 0, -30.6 }, Color = "#e2e9f1", Material = "Metal", Reflectance = 0.35 })
		k:Part({ Name = "KatanaL", Size = { 0.11, 1.24, 0.06 }, Pos = { -0.78, -0.85, -0.26 }, Rot = { 0, 0, -50 }, Color = "#e2e9f1", Material = "Metal", Reflectance = 0.35 })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ChimpanziniBananini</string>
            <string name="Source"><![CDATA[--[[
	Chimpanzini Bananini (Epic)
	Canonical look: a big glossy yellow banana standing upright on short chimp legs, with a
	gentle banana curve (the flower-end tip swings forward at the bottom). The top of the
	peel is split into four strips that fold over and droop outward (cream inner side
	showing, yellow edges, brown curled tips); one strip still carries the brown banana
	stem. Out of the opening pops a green chimp: green fur, a peach heart-shaped face with
	a big muzzle and toothy grin, huge round ears, a fur tuft on the crown and long monkey
	arms (right one waving). A curly monkey tail pokes out of the peel at the back.
	Epic flair: glossy banana-shine streaks, twinkling neon glints, golden sparkles (one
	stream trails off the waving hand), a warm banana glow, a green rim light and a gentle
	whole-body sway.

	Coordinates: feet on y = 0, faces -Z, right hand at +X.
]]

-- Palette ------------------------------------------------------------------------------
local YEL = "#ffd93a" -- dominant: banana yellow
local YEL_DEEP = "#eab21e" -- ridges / peel edge shade
local YEL_SHINE = "#fff7cc" -- glossy shine streaks
local CREAM = "#fff1bd" -- inside of the peel
local PEEL_BROWN = "#7a4b22" -- tips, sugar spots
local PEEL_BROWN_DARK = "#43280f"
local STEM = "#7c5f2a"
local STEM_DARK = "#4d3818"
local GLINT = "#fffbe2"

local FUR = "#5c8a2b" -- secondary: the green chimp
local FUR_DARK = "#3f6420"
local FUR_LIGHT = "#79a83b"
local SKIN = "#e8b18c" -- face / ears / hands / feet
local SKIN_LIGHT = "#f5cfaa" -- muzzle
local SKIN_DARK = "#c98a69" -- brow, wrinkles, palms, feet
local SOLE = "#a86a4c"
local EAR_IN = "#dc8b7c"
local BLUSH = "#f39a8c"
local LIP = "#b86a5a"

local EYE = "#fff8ec"
local IRIS = "#7a4519"
local PUPIL = "#1b1b24"
local SHINE = "#fffdf4"
local MOUTH = "#4a1c22"
local TEETH = "#fff8ec"
local TONGUE = "#e5707c"

-- Layout (world studs) -------------------------------------------------------------------
local RIM_Y = 5.45 -- top of the banana where the peel splits
local UP_R = 1.37 -- radius of the upper (cylindrical) banana section
local UP_Z = -0.04
local UP_BOT = 3.3
local TILT = 7 -- banana curve: the lower belly leans so its tip swings forward
-- Banana body volume { cx, cy, cz, semiX, semiY, semiZ, tiltX }: one smooth, glossy belly
-- that tapers down into the brown flower-end tip; above UP_BOT it becomes a cylinder.
local BELLY = { 0, 3.3, 0.02, 1.46, 2.42, 1.42, TILT }

local LIFT = 0.12 -- how far the chimp torso rises out of the peel (above the old layout)
local NECK = { 0, 6.25 + LIFT, -0.15 } -- head pivot
local HEAD_S = 1.1 -- the head is modelled at 1.0 and scaled up by this
-- Head volumes (head-local, unscaled, relative to NECK)
local CRAN = { 0, 1.0, 0.08, 1.08, 0.98, 0.98 }
local FACE_R = { 0.31, 1.06, -0.66, 0.43, 0.43, 0.27 } -- right half of the heart-shaped face
local MUZ = { 0, 0.44, -0.82, 0.7, 0.47, 0.5 }
local BROW_R = { 0.32, 1.42, -0.8, 0.36, 0.14, 0.24 } -- right half of the arched brow ridge
local MOUTH_E = { 0, 0.26, -1.06, 0.5, 0.17, 0.26 }

-- Math helpers ---------------------------------------------------------------------------
local function rad(d)
	return d * math.pi / 180
end
local function deg(r)
	return r * 180 / math.pi
end
local function vadd(a, b)
	return { a[1] + b[1], a[2] + b[2], a[3] + b[3] }
end
local function vsub(a, b)
	return { a[1] - b[1], a[2] - b[2], a[3] - b[3] }
end
local function vmul(a, s)
	return { a[1] * s, a[2] * s, a[3] * s }
end
local function vlen(a)
	return math.sqrt(a[1] * a[1] + a[2] * a[2] + a[3] * a[3])
end
local function vunit(a)
	local l = vlen(a)
	if l < 1e-9 then
		return { 0, 1, 0 }
	end
	return { a[1] / l, a[2] / l, a[3] / l }
end
local function vcross(a, b)
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end
local function lerp(a, b, t)
	return a + (b - a) * t
end
-- rotate a vector about the X axis (same sense as CFrame.Angles(rx, 0, 0))
local function rotXv(v, d)
	local c, s = math.cos(rad(d)), math.sin(rad(d))
	return { v[1], v[2] * c - v[3] * s, v[2] * s + v[3] * c }
end

-- Euler angles (degrees, CFrame.Angles order X then Y then Z) of the rotation whose
-- columns are the local axes x, y, z.
local function euler(x, y, z)
	local sb = math.clamp(z[1], -1, 1)
	if math.abs(sb) > 0.99995 then
		return { 0, deg(math.asin(sb)), deg(math.atan2(x[2], y[2])) }
	end
	return { deg(math.atan2(-z[2], z[3])), deg(math.asin(sb)), deg(math.atan2(-y[1], x[1])) }
end

-- Rotation with local X along dir (cylinders, long ellipsoids)
local function alongX(dir, up)
	local x = vunit(dir)
	local z = vcross(x, up or { 0, 1, 0 })
	if vlen(z) < 1e-4 then
		z = vcross(x, { 0, 0, -1 })
	end
	z = vunit(z)
	return euler(x, vcross(z, x), z)
end

-- Rotation with local Y along dir; local Z leans toward `back`
local function alongY(dir, back)
	local y = vunit(dir)
	local x = vcross(y, back or { 0, 0, 1 })
	if vlen(x) < 1e-4 then
		x = vcross(y, { 1, 0, 0 })
	end
	x = vunit(x)
	return euler(x, y, vcross(x, y))
end

-- Rotation whose Front (-Z) face looks along the outward normal n, rolled by `roll` degrees
local function facing(n, roll)
	local z = vunit(vmul(n, -1))
	local x = vcross({ 0, 1, 0 }, z)
	if vlen(x) < 1e-4 then
		x = { 1, 0, 0 }
	end
	x = vunit(x)
	local y = vcross(z, x)
	if roll and roll ~= 0 then
		local c, s = math.cos(rad(roll)), math.sin(rad(roll))
		x, y = vadd(vmul(x, c), vmul(y, s)), vadd(vmul(x, -s), vmul(y, c))
	end
	return euler(x, y, z)
end

-- Ellipsoid volumes may carry an optional 7th entry: a tilt about X in degrees.
-- Outward normal of an ellipsoid volume at point p
local function ellNormal(e, p)
	local q = rotXv(vsub(p, e), -(e[7] or 0))
	return vunit(rotXv({ q[1] / (e[4] * e[4]), q[2] / (e[5] * e[5]), q[3] / (e[6] * e[6]) }, e[7] or 0))
end

-- Point on an ellipsoid along LOCAL direction d from its centre, pushed `out` along the normal
local function onEll(e, d, out)
	local s = math.sqrt((d[1] / e[4]) ^ 2 + (d[2] / e[5]) ^ 2 + (d[3] / e[6]) ^ 2)
	local p = vadd(e, rotXv({ d[1] / s, d[2] / s, d[3] / s }, e[7] or 0))
	local n = ellNormal(e, p)
	return vadd(p, vmul(n, out or 0)), n
end

-- Point on the FRONT (-Z) surface of an (untilted) ellipsoid at a given x, y
local function frontOf(e, x, y, out)
	local u = 1 - ((x - e[1]) / e[4]) ^ 2 - ((y - e[2]) / e[5]) ^ 2
	local p = { x, y, e[3] - e[6] * math.sqrt(math.max(u, 0)) }
	local n = ellNormal(e, p)
	return vadd(p, vmul(n, out or 0)), n
end

-- Distance along a ray to where it leaves ellipsoid e (-1 = miss)
local function exitT(e, o, d)
	local ol = rotXv(vsub(o, e), -(e[7] or 0))
	local dl = rotXv(d, -(e[7] or 0))
	local ox, oy, oz = ol[1] / e[4], ol[2] / e[5], ol[3] / e[6]
	local vx, vy, vz = dl[1] / e[4], dl[2] / e[5], dl[3] / e[6]
	local A = vx * vx + vy * vy + vz * vz
	local B = 2 * (ox * vx + oy * vy + oz * vz)
	local C = ox * ox + oy * oy + oz * oz - 1
	local disc = B * B - 4 * A * C
	if disc < 0 then
		return -1
	end
	return (-B + math.sqrt(disc)) / (2 * A)
end

-- Outer banana surface at height y, angle phi (0 = back/+Z, 90 = +X, 180 = front/-Z)
local function bananaAt(y, phi, out)
	local d = { math.sin(rad(phi)), 0, math.cos(rad(phi)) }
	local o = { 0, y, 0 }
	local best = exitT(BELLY, o, d)
	local n = if best > 0 then ellNormal(BELLY, vadd(o, vmul(d, best))) else d
	if y >= UP_BOT and y <= RIM_Y then
		-- circle of radius UP_R centred at z = UP_Z
		local b = d[3] * -UP_Z
		local t = -b + math.sqrt(b * b - (UP_Z * UP_Z - UP_R * UP_R))
		if t > best then
			best = t
			n = d
		end
	end
	local p = vadd(o, vmul(d, best))
	return vadd(p, vmul(n, out or 0)), n
end

-- A kit wrapper that scales every position and size by s around the current group origin
-- (used to build the head at a friendlier, bigger scale).
local function scaledKit(real, s)
	local function sc(v)
		return if v then { v[1] * s, v[2] * s, v[3] * s } else nil
	end
	local function copy(spec)
		local c = {}
		for key, v in spec do
			c[key] = v
		end
		c.Pos = sc(spec.Pos)
		return c
	end
	return {
		Part = function(_, spec)
			local c = copy(spec)
			c.Size = sc(spec.Size)
			return real:Part(c)
		end,
		Group = function(_, spec, fn)
			return real:Group(copy(spec), fn)
		end,
		Mirror = function(_, fn)
			return real:Mirror(fn)
		end,
		Light = function(_, spec)
			return real:Light(copy(spec))
		end,
		Particles = function(_, spec)
			return real:Particles(copy(spec))
		end,
	}
end

return {
	Id = "ChimpanziniBananini",
	Name = "Chimpanzini Bananini",
	Rarity = "Epic",
	Emoji = "🐒",
	Color = YEL,
	Tagline = "Half chimp, half banana, fully unpeeled.",
	Lore = "Looks like an ordinary banana until someone peels it - then a grinning chimp pops out and waves. "
		.. "Nobody knows where the banana ends and the monkey begins, and Chimpanzini refuses to explain. "
		.. "Its favourite snack is, worryingly, bananas.",

	Build = function(k)
		local K0 = k -- the real kit; `k` is swapped for a scaled wrapper while the head is built

		-- Small builders that need k --------------------------------------------------
		local function rod(a, b, d, color, name, mat)
			local dir = vsub(b, a)
			k:Part({
				Name = name,
				Shape = "Cylinder",
				Size = { vlen(dir), d, d },
				Pos = vmul(vadd(a, b), 0.5),
				Rot = alongX(dir),
				Color = color,
				Material = mat,
			})
		end
		-- Ellipsoid stretched between a and b (organic limbs, fingers, tail)
		local function limb(a, b, w, color, name, mat, extra)
			local dir = vsub(b, a)
			k:Part({
				Name = name,
				Shape = "Ellipsoid",
				Size = { vlen(dir) + w * (extra or 0.6), w, w },
				Pos = vmul(vadd(a, b), 0.5),
				Rot = alongX(dir),
				Color = color,
				Material = mat or "Fabric",
			})
		end
		-- Flat-ish part lying on a surface (p, n from a surface helper)
		local function decal(p, n, size, color, name, roll, extra)
			local spec = {
				Name = name,
				Shape = "Ellipsoid",
				Size = size,
				Pos = p,
				Rot = facing(n, roll),
				Color = color,
			}
			if extra then
				for key, v in extra do
					spec[key] = v
				end
			end
			k:Part(spec)
		end
		-- Fur tuft sticking out of a surface along direction dir
		local function tuft(p, dir, w, h, color, name)
			k:Part({
				Name = name or "FurTuft",
				Shape = "Ellipsoid",
				Size = { w, h, w },
				Pos = vadd(p, vmul(vunit(dir), h * 0.3)),
				Rot = alongY(dir),
				Color = color,
				Material = "Fabric",
			})
		end

		--------------------------------------------------------------------------------
		-- Legs and feet (short chimp legs poking out of the banana bottom)
		--------------------------------------------------------------------------------
		k:Mirror(function()
			local hip = { 0.56, 1.3, -0.02 }
			local knee = { 0.8, 0.8, -0.14 }
			local ankle = { 0.76, 0.42, -0.04 }
			limb(hip, knee, 0.58, FUR, "Thigh")
			limb(knee, ankle, 0.5, FUR, "Shin")
			tuft(vadd(knee, { 0.12, 0.02, -0.12 }), { 0.5, 0.3, -0.6 }, 0.22, 0.34, FUR_LIGHT, "KneeTuft")
			-- shaggy fur fringe where the leg meets the bare chimp foot
			k:Part({ Name = "AnkleFur", Shape = "Ellipsoid", Size = { 0.6, 0.22, 0.6 }, Pos = { 0.76, 0.5, -0.06 }, Color = FUR_DARK, Material = "Fabric" })
			tuft({ 0.98, 0.46, -0.16 }, { 0.6, -0.5, -0.4 }, 0.16, 0.26, FUR_DARK, "AnkleTuft")
			k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 0.62, 0.36, 0.98 }, Pos = { 0.77, 0.24, -0.18 }, Color = SKIN_DARK })
			k:Part({ Name = "Sole", Shape = "Ellipsoid", Size = { 0.66, 0.14, 1.06 }, Pos = { 0.77, 0.08, -0.2 }, Color = SOLE })
			k:Part({ Name = "Heel", Shape = "Ellipsoid", Size = { 0.5, 0.3, 0.4 }, Pos = { 0.77, 0.16, 0.22 }, Color = SKIN_DARK })
			-- Toes on a little tapping joint
			k:Group({ Name = "Toes", Pos = { 0.77, 0.09, -0.64 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 7, Speed = 0.7, Phase = 0.2 } }, function()
				for i, tx in { -0.1, 0.05, 0.2 } do
					k:Part({ Name = "Toe", Shape = "Ellipsoid", Size = { 0.16, 0.15, if i == 3 then 0.24 else 0.3 }, Pos = { tx, 0.0, -0.17 + (if i == 3 then 0.03 else 0) }, Color = SKIN })
				end
				-- opposable big toe on the inner side
				k:Part({ Name = "BigToe", Shape = "Ellipsoid", Size = { 0.19, 0.16, 0.36 }, Pos = { -0.3, 0.0, 0.1 }, Rot = { 0, 40, 0 }, Color = SKIN })
			end)
		end)

		--------------------------------------------------------------------------------
		-- Everything above the legs sways gently on the hips (BananaSway pivots at y = 1)
		--------------------------------------------------------------------------------
		k:Group({ Name = "BananaSway", Pos = { 0, 1.0, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 2.2, Speed = 0.4, Phase = 0.15 } }, function()
			k:Group({ Name = "Body", Pos = { 0, -1.0, 0 } }, function() -- back to world coordinates
				------------------------------------------------------------------------
				-- Banana body
				------------------------------------------------------------------------
				local GLOSS = 0.08
				k:Part({ Name = "BananaBelly", Shape = "Ellipsoid", Size = { BELLY[4] * 2, BELLY[5] * 2, BELLY[6] * 2 }, Pos = { BELLY[1], BELLY[2], BELLY[3] }, Rot = { TILT, 0, 0 }, Color = YEL, Reflectance = GLOSS })
				k:Part({ Name = "BananaUpper", Shape = "Cylinder", Size = { RIM_Y - UP_BOT, UP_R * 2, UP_R * 2 }, Pos = { 0, (RIM_Y + UP_BOT) / 2, UP_Z }, Rot = { 0, 0, 90 }, Color = YEL, Reflectance = GLOSS })
				-- The brown flower-end tip of the banana, at the bottom of the curve
				do
					local p, n = onEll(BELLY, { 0, -1, 0.12 }, -0.05)
					k:Part({ Name = "TipNub", Shape = "Ellipsoid", Size = { 0.46, 0.46, 0.3 }, Pos = p, Rot = facing(n, 0), Color = PEEL_BROWN })
					k:Part({ Name = "TipEnd", Shape = "Ellipsoid", Size = { 0.24, 0.24, 0.2 }, Pos = vadd(p, vmul(n, 0.12)), Rot = facing(n, 0), Color = PEEL_BROWN_DARK })
				end
				-- Peel lip and the cream inside of the opening
				k:Part({ Name = "PeelLip", Shape = "Cylinder", Size = { 0.12, UP_R * 2 + 0.08, UP_R * 2 + 0.08 }, Pos = { 0, RIM_Y - 0.02, UP_Z }, Rot = { 0, 0, 90 }, Color = YEL_DEEP })
				k:Part({ Name = "PeelInside", Shape = "Cylinder", Size = { 0.08, UP_R * 2 - 0.16, UP_R * 2 - 0.16 }, Pos = { 0, RIM_Y + 0.03, UP_Z }, Rot = { 0, 0, 90 }, Color = CREAM })

				-- Ridges (5 like a real banana). A flat facet faces the front, so no ridge
				-- runs down the middle like a costume zip.
				local RIDGE_Y = { 1.3, 2.3, 3.3, 4.35, 5.4 }
				for _, phi in { 0, 72, 144, 216, 288 } do
					for i = 1, #RIDGE_Y - 1 do
						local a = bananaAt(RIDGE_Y[i], phi, 0)
						local b = bananaAt(RIDGE_Y[i + 1], phi, 0)
						local m = bananaAt((RIDGE_Y[i] + RIDGE_Y[i + 1]) / 2, phi, 0)
						-- slide the chord toward the surface so the ridge hugs the peel
						local off = vmul(vsub(m, vmul(vadd(a, b), 0.5)), 0.6)
						rod(vadd(a, off), vadd(b, off), 0.1, YEL_DEEP, "PeelRidge")
					end
				end

				-- Sugar spots (little brown freckles a ripe banana has)
				for _, s in {
					{ 205, 2.2, 0.2 }, { 172, 3.95, 0.14 }, { 120, 2.7, 0.17 }, { 196, 4.8, 0.12 },
					{ 300, 2.45, 0.18 }, { 20, 4.05, 0.15 }, { 345, 3.0, 0.2 }, { 70, 1.85, 0.14 },
				} do
					local p, n = bananaAt(s[2], s[1], 0)
					decal(p, n, { s[3], s[3] * 0.8, 0.06 }, PEEL_BROWN, "SugarSpot", s[1] * 0.3)
				end

				-- Glossy banana-shine: one long highlight following the curve of the belly
				-- (screen-left, where the key light hits) plus a short echo.
				for _, s in { { 1.95, 2.95, 163, 0.14 }, { 2.85, 3.95, 164, 0.18 }, { 3.85, 4.95, 165, 0.14 }, { 2.5, 3.4, 153, 0.07 } } do
					local a = bananaAt(s[1], s[3], 0)
					local b = bananaAt(s[2], s[3], 0)
					local m, n = bananaAt((s[1] + s[2]) / 2, s[3], 0.005)
					local len = vlen(vsub(b, a)) + 0.25
					k:Part({ Name = "BananaShine", Shape = "Ellipsoid", Size = { s[4], len, 0.05 }, Pos = m, Rot = alongY(vsub(b, a), vmul(n, -1)), Color = YEL_SHINE, Reflectance = 0.35 })
				end
				-- Twinkling neon glints (Epic flair)
				for i, g in { { 4.75, 172, 0.44 }, { 2.25, 212, 0.32 }, { 3.6, 330, 0.34 } } do
					local p, n = bananaAt(g[1], g[2], 0.03)
					k:Group({ Name = "Glint", Pos = p, Rot = facing(n, 0) }, function()
						for _, r in { 0, 90 } do
							k:Part({
								Name = "GlintRay",
								Shape = "Ellipsoid",
								Size = { g[3], 0.07, 0.05 },
								Rot = { 0, 0, r },
								Color = GLINT,
								Material = "Neon",
								Anim = { Type = "Pulse", Amount = 0.35, Speed = 0.8, Phase = i * 0.37 },
							})
						end
					end)
				end

				------------------------------------------------------------------------
				-- Peel strips: hinged on the rim, folded over and drooping outward with
				-- the cream inside showing, yellow edges, brown curled tips.
				------------------------------------------------------------------------
				-- each segment: { alpha (deg from straight up, + = outward), length, width }
				local PETAL = {
					{ 30, 0.26, 1.16 },
					{ 100, 0.3, 1.14 },
					{ 150, 0.55, 1.04 },
					{ 168, 0.8, 0.84 },
					{ 176, 0.7, 0.56 },
				}
				local function peelFlap(phi, phase, scale, withStem)
					local hinge = { 1.3 * math.sin(rad(phi)), RIM_Y - 0.05, UP_Z + 1.3 * math.cos(rad(phi)) }
					k:Group({ Name = "PeelFlap", Pos = hinge, Rot = { 0, phi, 0 } }, function()
						k:Group({ Name = "PeelSway", Anim = { Type = "Wiggle", Axis = "X", Amount = 6, Speed = 0.55, Phase = phase } }, function()
							local y, z = 0, 0
							local th = 0.15
							local lastA = 0
							for _, seg in PETAL do
								local a, L, w = seg[1], seg[2] * scale, seg[3] * scale
								local dy, dz = math.cos(rad(a)), math.sin(rad(a))
								local mid = { 0, y + dy * L / 2, z + dz * L / 2 }
								local nc = { 0, math.sin(rad(a)), -math.cos(rad(a)) } -- cream (inner) side
								local over = if L > 0.4 then 0.45 else 0.3
								k:Part({ Name = "PeelOuter", Shape = "Ellipsoid", Size = { w, L + over, th }, Pos = mid, Rot = { a, 0, 0 }, Color = YEL, Reflectance = 0.06 })
								k:Part({ Name = "PeelInner", Shape = "Ellipsoid", Size = { w * 0.8, L + over - 0.06, th * 0.6 }, Pos = vadd(mid, vmul(nc, th * 0.32)), Rot = { a, 0, 0 }, Color = CREAM })
								y, z = y + dy * L, z + dz * L
								lastA = a
							end
							if withStem then
								-- this strip kept the banana's stem: a yellow collar and a woody stalk
								local sa = lastA - 14
								local sd = { 0, math.cos(rad(sa)), math.sin(rad(sa)) }
								local base = { 0, y + 0.06, z }
								k:Part({ Name = "StemCollar", Shape = "Ellipsoid", Size = { 0.42, 0.26, 0.3 }, Pos = base, Rot = { sa, 0, 0 }, Color = YEL_DEEP })
								rod(base, vadd(base, vmul(sd, 0.5)), 0.22, STEM, "Stem", "Wood")
								k:Part({ Name = "StemEnd", Shape = "Cylinder", Size = { 0.1, 0.28, 0.28 }, Pos = vadd(base, vmul(sd, 0.52)), Rot = alongX(sd), Color = STEM_DARK, Material = "Wood" })
							else
								-- brown tip, curling outward
								local ta = lastA - 30
								local dy, dz = math.cos(rad(ta)), math.sin(rad(ta))
								k:Part({ Name = "PeelTip", Shape = "Ellipsoid", Size = { 0.34 * scale, 0.42, 0.13 }, Pos = { 0, y - 0.02 + dy * 0.1, z + dz * 0.1 }, Rot = { ta, 0, 0 }, Color = PEEL_BROWN })
							end
						end)
					end)
				end
				peelFlap(140, 0.0, 1.0) -- front right
				peelFlap(220, 0.5, 1.0) -- front left
				peelFlap(40, 0.25, 0.96, true) -- back right (stem end)
				peelFlap(320, 0.75, 0.96) -- back left

				------------------------------------------------------------------------
				-- Chimp torso popping out of the peel
				------------------------------------------------------------------------
				k:Part({ Name = "Chest", Shape = "Ellipsoid", Size = { 2.24, 1.4, 1.8 }, Pos = { 0, 5.72 + LIFT, -0.05 }, Color = FUR, Material = "Fabric", Anim = { Type = "Pulse", Amount = 0.02, Speed = 0.5 } })
				k:Mirror(function()
					k:Part({ Name = "Shoulder", Shape = "Ball", Size = { 0.76, 0.76, 0.76 }, Pos = { 0.97, 5.96 + LIFT, -0.12 }, Color = FUR, Material = "Fabric" })
					tuft({ 0.42, 5.75 + LIFT, -0.88 }, { 0.3, -0.9, -0.5 }, 0.24, 0.36, FUR_DARK, "ChestFur")
				end)
				tuft({ 0, 5.68 + LIFT, -0.92 }, { 0, -1, -0.45 }, 0.26, 0.4, FUR_LIGHT, "ChestFur")
				-- Fluffy fur ring where the chimp meets the peel
				for i = 0, 5 do
					local a = rad(i * 60 + 30)
					local dir = { math.sin(a), 0, math.cos(a) }
					local p = { dir[1] * 1.0, RIM_Y + 0.1, -0.05 + dir[3] * 0.8 }
					tuft(p, { dir[1], 0.9, dir[3] }, 0.36, 0.42, if i % 2 == 0 then FUR_DARK else FUR, "RimFluff")
				end

				------------------------------------------------------------------------
				-- Arms
				------------------------------------------------------------------------
				local function hand(s, wristDir, palmFwd, curl)
					-- built at the wrist; wristDir = forearm direction, palmFwd = palm normal
					local d = vunit(wristDir)
					local side = vunit(vcross(palmFwd, d)) -- across the palm
					k:Part({ Name = "Palm", Shape = "Ellipsoid", Size = { 0.44, 0.48, 0.2 }, Pos = vmul(d, 0.2), Rot = alongY(d, vmul(palmFwd, -1)), Color = SKIN_DARK })
					k:Part({ Name = "HandBack", Shape = "Ellipsoid", Size = { 0.4, 0.36, 0.12 }, Pos = vadd(vmul(d, 0.16), vmul(palmFwd, -0.07)), Rot = alongY(d, vmul(palmFwd, -1)), Color = FUR_DARK, Material = "Fabric" })
					for i = 1, 4 do
						local off = (i - 2.5) * 0.1
						local spread = (i - 2.5) * 0.2
						local base = vadd(vmul(d, 0.36), vmul(side, off * s))
						local fdir = vunit(vadd(vadd(d, vmul(side, spread * s)), vmul(palmFwd, curl)))
						local len = if i == 1 or i == 4 then 0.26 else 0.32
						limb(base, vadd(base, vmul(fdir, len)), 0.1, SKIN, "Finger", "SmoothPlastic", 0.5)
					end
					local tb = vadd(vmul(d, 0.14), vmul(side, -0.2 * s))
					local tdir = vunit(vadd(vadd(d, vmul(side, -1.0 * s)), vmul(palmFwd, 0.3)))
					limb(tb, vadd(tb, vmul(tdir, 0.26)), 0.11, SKIN, "Thumb", "SmoothPlastic", 0.5)
				end

				-- Right arm: raised high and waving hello
				k:Group({ Name = "RightArm", Pos = { 1.0, 5.98 + LIFT, -0.12 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 12, Speed = 0.8 } }, function()
					local elbow = { 0.6, 0.82, -0.16 }
					limb({ 0, 0, 0 }, elbow, 0.5, FUR, "UpperArm")
					tuft(vadd(elbow, { 0.14, -0.06, 0.02 }), { 1, -0.4, 0.2 }, 0.2, 0.32, FUR_LIGHT, "ElbowTuft")
					k:Group({ Name = "RightForearm", Pos = elbow, Anim = { Type = "Wiggle", Axis = "Z", Amount = 20, Speed = 0.8, Phase = 0.2 } }, function()
						local wrist = { 0.1, 0.92, -0.08 }
						limb({ 0, 0, 0 }, wrist, 0.45, FUR, "Forearm")
						k:Part({ Name = "WristFur", Shape = "Ellipsoid", Size = { 0.46, 0.18, 0.46 }, Pos = vmul(wrist, 0.9), Rot = alongY(wrist), Color = FUR_LIGHT, Material = "Fabric" })
						k:Group({ Name = "RightHand", Pos = wrist }, function()
							hand(1, { 0.08, 1, 0 }, { 0, 0, -1 }, 0.05)
							-- golden sparkles trail off the waving hand (Epic flair)
							k:Particles({ Pos = { 0.05, 0.55, 0 }, Color = "#fff6a8", Color2 = "#ffc928", Rate = 3, Size = 0.18, Speed = 0.7, Lifetime = 1.1, Spread = 60, Direction = "Top" })
						end)
					end)
				end)

				-- Left arm: hanging long and loose like a chimp, swinging gently
				k:Group({ Name = "LeftArm", Pos = { -1.0, 5.94 + LIFT, -0.12 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 9, Speed = 0.6, Phase = 0.3 } }, function()
					local elbow = { -0.72, -0.7, -0.16 }
					limb({ 0, 0, 0 }, elbow, 0.5, FUR, "UpperArm")
					tuft(vadd(elbow, { -0.12, 0.0, 0.1 }), { -0.6, -0.2, 0.8 }, 0.2, 0.32, FUR_LIGHT, "ElbowTuft")
					k:Group({ Name = "LeftForearm", Pos = elbow, Anim = { Type = "Wiggle", Axis = "X", Amount = 10, Speed = 0.6, Phase = 0.45 } }, function()
						local wrist = { -0.3, -0.82, -0.12 }
						limb({ 0, 0, 0 }, wrist, 0.45, FUR, "Forearm")
						k:Part({ Name = "WristFur", Shape = "Ellipsoid", Size = { 0.46, 0.18, 0.46 }, Pos = vmul(wrist, 0.9), Rot = alongY(wrist), Color = FUR_LIGHT, Material = "Fabric" })
						k:Group({ Name = "LeftHand", Pos = wrist }, function()
							hand(-1, { -0.3, -1, -0.1 }, { 1, 0, 0 }, 0.45)
						end)
					end)
				end)

				------------------------------------------------------------------------
				-- Monkey tail curling out of the back of the peel
				------------------------------------------------------------------------
				k:Group({ Name = "Tail", Pos = { 0, 2.5, 1.22 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 18, Speed = 0.6 } }, function()
					local pts = { { 0, 0, 0 }, { 0.05, 0.05, 0.42 }, { 0.12, 0.36, 0.74 }, { 0.17, 0.8, 0.86 }, { 0.17, 1.2, 0.74 }, { 0.1, 1.42, 0.48 }, { 0.03, 1.36, 0.27 } }
					for i = 1, #pts - 1 do
						local d = lerp(0.26, 0.15, (i - 1) / (#pts - 2))
						limb(pts[i], pts[i + 1], d, FUR, "TailSeg", "Fabric", 0.9)
					end
					k:Part({ Name = "TailTip", Shape = "Ellipsoid", Size = { 0.2, 0.24, 0.2 }, Pos = pts[#pts], Color = FUR_DARK, Material = "Fabric" })
				end)

				------------------------------------------------------------------------
				-- Head (modelled at 1.0, built at HEAD_S through a scaled kit wrapper)
				------------------------------------------------------------------------
				k:Group({ Name = "HeadBob", Pos = NECK, Anim = { Type = "Bob", Axis = "Y", Amount = 0.05, Speed = 1.0 } }, function()
					k = scaledKit(K0, HEAD_S)
					k:Group({ Name = "Head", Anim = { Type = "Wiggle", Axis = "Z", Amount = 6, Speed = 0.5 } }, function()
						k:Part({ Name = "Cranium", Shape = "Ellipsoid", Size = { CRAN[4] * 2, CRAN[5] * 2, CRAN[6] * 2 }, Pos = { CRAN[1], CRAN[2], CRAN[3] }, Color = FUR, Material = "Fabric" })
						k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { MUZ[4] * 2, MUZ[5] * 2, MUZ[6] * 2 }, Pos = { MUZ[1], MUZ[2], MUZ[3] }, Color = SKIN_LIGHT })

						-- Mouth: wide toothy chimp grin framed by darker lips
						k:Part({ Name = "Lips", Shape = "Ellipsoid", Size = { MOUTH_E[4] * 2 + 0.12, MOUTH_E[5] * 2 + 0.1, MOUTH_E[6] * 2 }, Pos = { MOUTH_E[1], MOUTH_E[2], MOUTH_E[3] + 0.035 }, Color = LIP })
						k:Part({ Name = "Mouth", Shape = "Ellipsoid", Size = { MOUTH_E[4] * 2, MOUTH_E[5] * 2, MOUTH_E[6] * 2 }, Pos = { MOUTH_E[1], MOUTH_E[2], MOUTH_E[3] }, Color = MOUTH })
						for i = -2, 2 do
							local x = i * 0.14
							local p, n = frontOf(MOUTH_E, x, 0.315 + math.abs(i) * 0.014, -0.01)
							decal(p, n, { 0.13, 0.13, 0.06 }, TEETH, "Tooth", i * 4)
						end
						do
							local p, n = frontOf(MOUTH_E, 0, 0.17, -0.01)
							decal(p, n, { 0.36, 0.14, 0.07 }, TONGUE, "Tongue", 0)
						end
						local noseP, noseN = frontOf(MUZ, 0, 0.74, -0.04)
						decal(noseP, noseN, { 0.4, 0.2, 0.16 }, SKIN, "Nose", 0)

						k:Mirror(function()
							-- heart-shaped upper face
							k:Part({ Name = "FaceMask", Shape = "Ellipsoid", Size = { FACE_R[4] * 2, FACE_R[5] * 2, FACE_R[6] * 2 }, Pos = { FACE_R[1], FACE_R[2], FACE_R[3] }, Color = SKIN })
							-- big expressive eyes (all blink together)
							local blink = { Type = "Blink", Speed = 0.3, Phase = 0.1 }
							k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.46, 0.56, 0.22 }, Pos = { 0.31, 1.08, -0.9 }, Color = EYE, Anim = blink })
							k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.31, 0.36, 0.08 }, Pos = { 0.29, 1.05, -1.0 }, Color = IRIS, Anim = blink })
							k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.16, 0.19, 0.06 }, Pos = { 0.29, 1.05, -1.035 }, Color = PUPIL, Anim = blink })
							k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.09, 0.09, 0.09 }, Pos = { 0.345, 1.12, -1.06 }, Color = SHINE, Material = "Neon", Anim = blink })
							k:Part({ Name = "EyeShine2", Shape = "Ball", Size = { 0.05, 0.05, 0.05 }, Pos = { 0.245, 0.99, -1.055 }, Color = SHINE, Anim = blink })
							-- arched chimp brow ridge with happy, raised eyebrows
							k:Part({ Name = "BrowRidge", Shape = "Ellipsoid", Size = { BROW_R[4] * 2, BROW_R[5] * 2, BROW_R[6] * 2 }, Pos = { BROW_R[1], BROW_R[2], BROW_R[3] }, Rot = { 0, 0, 6 }, Color = SKIN })
							local b1, n1 = frontOf(BROW_R, 0.22, 1.5, -0.03)
							decal(b1, n1, { 0.26, 0.1, 0.08 }, FUR_DARK, "Eyebrow", 22, { Material = "Fabric" })
							local b2, n2 = frontOf(BROW_R, 0.44, 1.5, -0.03)
							decal(b2, n2, { 0.26, 0.1, 0.08 }, FUR_DARK, "Eyebrow", -20, { Material = "Fabric" })
							-- upturned grin corners
							local mp, mn = frontOf(MUZ, 0.43, 0.34, -0.005)
							decal(mp, mn, { 0.17, 0.075, 0.06 }, MOUTH, "MouthCorner", 32)
							-- lower fangs peeking up at the sides of the grin
							local tp, tn = frontOf(MOUTH_E, 0.25, 0.15, -0.01)
							decal(tp, tn, { 0.1, 0.11, 0.06 }, TEETH, "LowerTooth", 0)
							-- nostrils, smile creases, blush
							local np, nn = frontOf(MUZ, 0.1, 0.72, -0.01)
							decal(np, nn, { 0.09, 0.065, 0.05 }, PEEL_BROWN_DARK, "Nostril", 20)
							local cp, cn = frontOf(MUZ, 0.53, 0.46, -0.01)
							decal(cp, cn, { 0.18, 0.05, 0.05 }, SKIN_DARK, "SmileCrease", 60)
							local blp, bln = frontOf(MUZ, 0.5, 0.62, -0.01)
							decal(blp, bln, { 0.24, 0.13, 0.05 }, BLUSH, "Blush", 0)
							-- big round chimp ears that twitch
							k:Group({ Name = "Ear", Pos = { 1.02, 1.05, 0.12 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 8, Speed = 0.45, Phase = 0.3 } }, function()
								k:Part({ Name = "EarOuter", Shape = "Ellipsoid", Size = { 0.24, 0.8, 0.7 }, Pos = { 0.12, 0, 0 }, Rot = { 0, 25, 0 }, Color = SKIN })
								k:Part({ Name = "EarInner", Shape = "Ellipsoid", Size = { 0.1, 0.56, 0.46 }, Pos = { 0.19, 0, -0.04 }, Rot = { 0, 25, 0 }, Color = EAR_IN })
								k:Part({ Name = "EarFold", Shape = "Ellipsoid", Size = { 0.08, 0.24, 0.12 }, Pos = { 0.22, -0.1, -0.08 }, Rot = { 0, 25, 0 }, Color = SKIN_DARK })
							end)
							-- fur sideburns framing the face
							for _, d in { { 0.92, -0.15, -0.5 }, { 0.82, -0.45, -0.45 }, { 0.62, -0.72, -0.42 } } do
								local p, n = onEll(CRAN, d, -0.05)
								tuft(p, vadd(n, { 0, -0.6, 0 }), 0.26, 0.44, FUR, "Sideburn")
							end
						end)

						-- chunky fur tuft on the crown: a forward quiff with side tufts swept back
						for _, t in {
							{ { 0, 1, -0.25 }, { 0, 1, -0.7 }, 0.34, 0.62, FUR_LIGHT },
							{ { 0.3, 0.95, -0.05 }, { 0.5, 1, 0.3 }, 0.3, 0.5, FUR },
							{ { -0.3, 0.95, -0.05 }, { -0.5, 1, 0.3 }, 0.3, 0.5, FUR },
							{ { 0.12, 0.85, 0.4 }, { 0.2, 0.7, 1 }, 0.3, 0.52, FUR_DARK },
							{ { -0.14, 0.85, 0.42 }, { -0.25, 0.7, 1 }, 0.3, 0.48, FUR },
						} do
							local p = onEll(CRAN, t[1], -0.06)
							tuft(p, t[2], t[3], t[4], t[5], "HairTuft")
						end
					end)
					k = K0
				end)
			end)
		end)

		--------------------------------------------------------------------------------
		-- Epic flair: banana glow, green rim light and golden sparkles
		--------------------------------------------------------------------------------
		k:Light({ Pos = { 0, 4.6, -2.3 }, Color = "#ffe08a", Range = 10, Brightness = 1.2 })
		k:Light({ Pos = { 0, 8.6, 1.4 }, Color = "#d9ff8f", Range = 7, Brightness = 0.7 })
		k:Particles({ Pos = { 0, 5.6, -0.2 }, Color = "#fff6a8", Color2 = "#ffcf2e", Rate = 5, Size = 0.22, Speed = 1.2, Lifetime = 1.6, Spread = 70, Direction = "Top" })
		k:Particles({ Pos = { 0, 3.0, 0 }, Color = "#ffe45c", Color2 = "#fff8d0", Rate = 3, Size = 0.16, Speed = 0.6, Lifetime = 2, Spread = 180, Direction = "Top" })
	end,

	BuildMini = function(k)
		-- Lifted slightly so the tilted banana stays inside the mini size limit.
		k:Group({ Name = "MiniLift", Pos = { 0, 0.09, 0 } }, function()
			-- curved banana body with a brown tip, cream peel strips drooping outward, and the
			-- green chimp head popping out of the top
			k:Part({ Name = "Banana", Shape = "Ellipsoid", Size = { 1.26, 1.78, 1.18 }, Pos = { 0, -0.43, 0.02 }, Rot = { 7, 0, 0 }, Color = YEL })
			k:Part({ Name = "BananaTip", Shape = "Ellipsoid", Size = { 0.28, 0.28, 0.28 }, Pos = { 0, -1.17, -0.08 }, Color = PEEL_BROWN })
			k:Part({ Name = "PeelInside", Shape = "Cylinder", Size = { 0.1, 1.08, 1.08 }, Pos = { 0, 0.12, 0 }, Rot = { 0, 0, 90 }, Color = CREAM })
			k:Part({ Name = "FlapRight", Shape = "Ellipsoid", Size = { 0.42, 0.96, 0.13 }, Pos = { 0.47, -0.16, -0.43 }, Rot = facing(vunit({ 0.7, -0.32, -0.7 }), 0), Color = CREAM })
			k:Part({ Name = "FlapLeft", Shape = "Ellipsoid", Size = { 0.42, 0.96, 0.13 }, Pos = { -0.47, -0.16, -0.43 }, Rot = facing(vunit({ -0.7, -0.32, -0.7 }), 0), Color = CREAM })
			k:Part({ Name = "FlapBack", Shape = "Ellipsoid", Size = { 0.46, 0.96, 0.14 }, Pos = { 0, -0.12, 0.66 }, Rot = facing(vunit({ 0, -0.32, 1 }), 0), Color = CREAM })
			k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 1.04, 0.96, 0.94 }, Pos = { 0, 0.72, -0.05 }, Color = FUR })
			k:Part({ Name = "Ears", Shape = "Ellipsoid", Size = { 1.42, 0.4, 0.18 }, Pos = { 0, 0.72, 0 }, Color = SKIN })
			k:Part({ Name = "Face", Shape = "Ellipsoid", Size = { 0.76, 0.62, 0.3 }, Pos = { 0, 0.71, -0.43 }, Color = SKIN })
			k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { 0.6, 0.36, 0.3 }, Pos = { 0, 0.48, -0.55 }, Color = SKIN_LIGHT })
			k:Part({ Name = "EyeL", Shape = "Ellipsoid", Size = { 0.14, 0.18, 0.06 }, Pos = { -0.16, 0.78, -0.59 }, Color = PUPIL })
			k:Part({ Name = "EyeR", Shape = "Ellipsoid", Size = { 0.14, 0.18, 0.06 }, Pos = { 0.16, 0.78, -0.59 }, Color = PUPIL })
		end)
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">FrigoCamelo</string>
            <string name="Source"><![CDATA[--[[
	Frigo Camelo (Epic)
	Canonical look ("Frigo Camello Buffo Fardello", @ofuscabreno, Feb 2025; the Steal a
	Brainrot model): a camel whose body is an upright white refrigerator. The camel's LONG
	tan neck and head rise out of the top of the fridge (heavy droopy eyelids, long lashes,
	big floppy split lips, small round ears), and two camel legs stomp around underneath in
	giant wheat-coloured work boots. Cold vapour drifts from its mouth ("Che freddo qui
	dentro..."). Proud but exhausted.

	Fridge: freezer door on top, main door below (ajar, glowing cool blue, food inside),
	chrome handles + hinges, badge plate, frost, snow and icicles (Epic flair), condenser
	coil and a power-cord "tail" on the back.

	Coordinates: feet on y = 0, faces -Z. Parts that animate are written in world
	coordinates inside "pivot" groups (joint group + inverse offset), except the head, eyes
	and limbs which are written in their own local frames.
]]

-- Palette ------------------------------------------------------------------------------
local FRIDGE = "#f4f1e8" -- dominant: warm white enamel
local DOOR = "#fbf8f0"
local SEAM = "#6f6d6a"
local GASKET = "#8e939b"
local CHROME = "#e2e7ee"
local CHROME_DARK = "#98a1ad"
local LINER = "#d4efff" -- fridge interior
local GLOW = "#8fe0ff" -- cool interior light (Neon accent)
local ICE = "#c4ecff"
local FROST = "#f4fbff"
local DARK = "#2a2b33"
local COIL = "#34353d"

local FUR = "#c4935f" -- secondary: sandy camel tan
local FUR_DARK = "#8f6239"
local FUR_LIGHT = "#e0c193"
local FUR_MID = "#ad7c4b"
local MUZZLE = "#dcc39d"
local LIP = "#bf9468"
local MOUTH = "#3a2321"
local TEETH = "#f3e6c2"
local NOSTRIL = "#4a3022"
local EAR_IN = "#d9a58a"
local EYE_WHITE = "#fff8ec"
local IRIS = "#6b3d1f"
local PUPIL = "#1b1b24"
local SHINE = "#ffffff"
local LID = "#a9784a"
local LASH = "#2b1d17"
local CALLUS = "#7d5f49"

local BOOT = "#e3a43a" -- accent: golden wheat nubuck work boots
local BOOT_DARK = "#c2832a"
local COLLAR = "#4e3222"
local SOLE = "#3c2a20"
local WELT = "#9a6a35"
local LACE = "#7d5130"
local EYELET = "#d8b25a"

local RED = "#e8463e"
local YELLOW = "#ffd23a"
local BLUE = "#3f8cff"
local PAPER = "#fff8ec"

-- Layout (world studs) ------------------------------------------------------------------
local FX = 1.3 -- fridge half width
local FZ0 = -0.95 -- cabinet front plane (doors sit in front of it)
local FZ1 = 1.0 -- cabinet back plane
local FB = 2.75 -- fridge bottom
local FT = 6.35 -- fridge top (cabinet); a rounded top cap sits on it
local R = 0.25 -- rounded vertical corner radius
local FH = FT - FB
local FY = (FB + FT) / 2
local DT = 0.26 -- door thickness
local CAP = 0.14 -- top cap thickness
local CAV_B, CAV_T, CAV_Z = FB + 0.35, FB + 2.28, -0.05 -- main compartment cavity
local MAIN_B, MAIN_T = FB + 0.27, FB + 2.31 -- main door
local FRZ_B, FRZ_T = FB + 2.39, FT - 0.03 -- freezer door
local SEAM_Y = (MAIN_T + FRZ_B) / 2

local HIP_Y = 2.9
local NECK0 = { 0, FT + CAP, -0.26 } -- neck base on top of the fridge
local J = { 0, 8.15, -0.92 } -- head joint
local HS = 1.22 -- head scale

local function deg(r)
	return r * 180 / math.pi
end

-- Rotation that points a Cylinder's axis (local X) along vector v
local function axisRot(vx, vy, vz)
	local l = math.sqrt(vx * vx + vy * vy + vz * vz)
	vx, vy, vz = vx / l, vy / l, vz / l
	return { 0, deg(math.atan2(-vz, vx)), deg(math.asin(vy)) }
end

-- Rotation that turns a part's front (-Z) to face unit normal n
local function faceRot(n, rz)
	return { deg(math.atan2(n[2], -n[3])), deg(-math.asin(n[1])), rz or 0 }
end

-- Cylinder segment between two points
local function segment(k, name, a, b, diameter, color, material, extra)
	local vx, vy, vz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local len = math.sqrt(vx * vx + vy * vy + vz * vz)
	k:Part({
		Name = name,
		Shape = "Cylinder",
		Size = { len + (extra or diameter * 0.5), diameter, diameter },
		Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
		Rot = axisRot(vx, vy, vz),
		Color = color,
		Material = material or "SmoothPlastic",
	})
end

-- Upright cylinder (round in XZ)
local function post(k, name, pos, height, diameter, color, material, extra)
	local spec = {
		Name = name,
		Shape = "Cylinder",
		Size = { height, diameter, diameter },
		Pos = pos,
		Rot = { 0, 0, 90 },
		Color = color,
		Material = material or "SmoothPlastic",
	}
	if extra then
		for key, v in extra do
			spec[key] = v
		end
	end
	k:Part(spec)
end

-- Joint group whose contents are written in world coordinates
local function pivot(k, name, pos, anim, fn)
	k:Group({ Name = name, Pos = pos, Anim = anim }, function()
		k:Group({ Name = name .. "Offset", Pos = { -pos[1], -pos[2], -pos[3] } }, fn)
	end)
end

-- Point on an (unrotated) ellipsoid E = {cx, cy, cz, ax, ay, az} along direction u from its
-- centre, pushed `out` along the surface normal. Returns position and unit normal.
local function surf(E, ux, uy, uz, out)
	local l = math.sqrt(ux * ux + uy * uy + uz * uz)
	ux, uy, uz = ux / l, uy / l, uz / l
	local t = 1 / math.sqrt((ux / E[4]) ^ 2 + (uy / E[5]) ^ 2 + (uz / E[6]) ^ 2)
	local px, py, pz = ux * t, uy * t, uz * t
	local nx, ny, nz = px / (E[4] * E[4]), py / (E[5] * E[5]), pz / (E[6] * E[6])
	local nl = math.sqrt(nx * nx + ny * ny + nz * nz)
	nx, ny, nz = nx / nl, ny / nl, nz / nl
	return { E[1] + px + nx * out, E[2] + py + ny * out, E[3] + pz + nz * out }, { nx, ny, nz }
end

-- Head-space helpers (head parts are authored unscaled, then scaled by HS)
local function hv(v)
	return { v[1] * HS, v[2] * HS, v[3] * HS }
end
local function hpart(k, spec)
	spec.Size = hv(spec.Size)
	if spec.Pos then
		spec.Pos = hv(spec.Pos)
	end
	k:Part(spec)
end

--------------------------------------------------------------------------------------------
-- Fridge cabinet (static shell, cavity, food, back, frost)
--------------------------------------------------------------------------------------------
local function buildCabinet(k)
	-- rounded vertical corners + side walls
	k:Mirror(function()
		post(k, "CornerFront", { FX - R, FY, FZ0 + R }, FH, R * 2, FRIDGE)
		post(k, "CornerBack", { FX - R, FY, FZ1 - R }, FH, R * 2, FRIDGE)
		k:Part({ Name = "SideWall", Size = { R, FH, (FZ1 - R) - (FZ0 + R) }, Pos = { FX - R / 2, FY, (FZ0 + FZ1) / 2 }, Color = FRIDGE })
		-- rubber seals where the camel legs come out of the bottom
		post(k, "HipSeal", { 0.62, FB - 0.03, 0.1 }, 0.07, 0.74, GASKET, "Rubber")
	end)
	-- back half (solid), freezer block and plinth in front of it, cavity between
	k:Part({ Name = "CabinetBack", Size = { 2 * (FX - R), FH, FZ1 - CAV_Z }, Pos = { 0, FY, (FZ1 + CAV_Z) / 2 }, Color = FRIDGE })
	k:Part({ Name = "FreezerBlock", Size = { 2 * (FX - R), FT - CAV_T, CAV_Z - FZ0 }, Pos = { 0, (FT + CAV_T) / 2, (FZ0 + CAV_Z) / 2 }, Color = FRIDGE })
	k:Part({ Name = "Plinth", Size = { 2 * (FX - R), CAV_B - FB, CAV_Z - FZ0 }, Pos = { 0, (FB + CAV_B) / 2, (FZ0 + CAV_Z) / 2 }, Color = FRIDGE })

	-- rounded top cap (bullnose front edge flush with the door fronts)
	local capZ0 = FZ0 - DT
	k:Part({ Name = "TopCap", Size = { 2 * FX - 0.04, CAP, FZ1 - 0.05 - (capZ0 + CAP / 2) }, Pos = { 0, FT + CAP / 2, (FZ1 - 0.05 + capZ0 + CAP / 2) / 2 }, Color = FRIDGE })
	k:Part({ Name = "TopCapNose", Shape = "Cylinder", Size = { 2 * FX - 0.04, CAP, CAP }, Pos = { 0, FT + CAP / 2, capZ0 + CAP / 2 }, Color = FRIDGE })

	-- interior (seen through the ajar door; the door hinges on +X so the gap is at -X)
	local cavH = CAV_T - CAV_B
	local cavY = (CAV_B + CAV_T) / 2
	k:Part({ Name = "LinerBack", Size = { 1.7, cavH, 0.05 }, Pos = { 0, cavY, CAV_Z - 0.025 }, Color = LINER })
	k:Part({ Name = "LinerSide", Size = { 0.26, cavH, 0.55 }, Pos = { -0.93, cavY, -0.33 }, Color = LINER })
	k:Part({ Name = "FridgeLamp", Size = { 1.3, 0.06, 0.14 }, Pos = { 0, CAV_T - 0.04, -0.45 }, Color = GLOW, Material = "Neon" })
	k:Part({ Name = "GlowStrip", Size = { 0.05, cavH - 0.2, 0.08 }, Pos = { -0.79, cavY, -0.5 }, Color = GLOW, Material = "Neon" })
	local S1, S2 = CAV_B + 0.66, CAV_B + 1.32
	for _, y in { S1, S2 } do
		k:Part({ Name = "GlassShelf", Size = { 1.62, 0.06, 0.62 }, Pos = { 0, y, -0.37 }, Color = "#d6f2ff", Material = "Glass", Transparency = 0.3 })
	end
	-- food
	k:Part({ Name = "MilkCarton", Size = { 0.3, 0.5, 0.3 }, Pos = { -0.5, CAV_B + 0.25, -0.35 }, Color = "#fbfbf6" })
	k:Part({ Name = "MilkBand", Size = { 0.32, 0.12, 0.32 }, Pos = { -0.5, CAV_B + 0.36, -0.35 }, Color = BLUE })
	k:Part({ Name = "Cheese", Shape = "Wedge", Size = { 0.42, 0.24, 0.34 }, Pos = { -0.48, S1 + 0.15, -0.35 }, Rot = { 0, 180, 0 }, Color = "#ffcf4a" })
	k:Part({ Name = "Apple", Shape = "Ball", Size = { 0.26, 0.26, 0.26 }, Pos = { -0.05, S1 + 0.16, -0.4 }, Color = RED })
	post(k, "Bottle", { -0.52, S2 + 0.28, -0.38 }, 0.5, 0.18, "#3fae6a", "Glass")
	post(k, "Jar", { -0.14, S2 + 0.16, -0.38 }, 0.26, 0.26, "#ff9a3c")

	-- seam between freezer and main compartment
	k:Part({ Name = "DoorSeam", Size = { 2.5, 0.07, 0.08 }, Pos = { 0, SEAM_Y, FZ0 - 0.03 }, Color = SEAM })

	-- kick-plate vent grille under the main door
	k:Part({ Name = "Grille", Size = { 1.9, 0.2, 0.05 }, Pos = { 0, FB + 0.13, FZ0 - 0.02 }, Color = DARK })
	for i = 0, 2 do
		k:Part({ Name = "GrilleSlat", Size = { 0.5, 0.05, 0.05 }, Pos = { 0, FB + 0.07 + i * 0.06, FZ0 - 0.045 }, Color = CHROME_DARK, Material = "Metal" })
	end

	-- barrel hinges on the right (+X) edge
	for _, y in { FRZ_T + 0.02, SEAM_Y, MAIN_B - 0.02 } do
		post(k, "Hinge", { FX - 0.02, y, FZ0 - 0.07 }, 0.24, 0.16, CHROME, "Metal", { Reflectance = 0.2 })
	end

	-- frost overflowing the front edge: an ice rim with icicles hanging from it
	local iz = capZ0 + 0.06
	k:Part({ Name = "IceRim", Shape = "Ellipsoid", Size = { 2.4, 0.12, 0.16 }, Pos = { 0, FT - 0.02, iz }, Color = ICE, Material = "Ice", Transparency = 0.15, Reflectance = 0.15 })
	local icicles = { { -0.98, 0.3 }, { -0.52, 0.46 }, { -0.05, 0.24 }, { 0.42, 0.52 }, { 0.9, 0.34 } }
	for _, ic in icicles do
		local x, len = ic[1], ic[2]
		k:Part({ Name = "IcicleRoot", Shape = "Ellipsoid", Size = { 0.15, 0.2, 0.12 }, Pos = { x, FT - 0.12, iz }, Color = ICE, Material = "Ice", Transparency = 0.1, Reflectance = 0.15 })
		k:Part({ Name = "Icicle", Shape = "Ellipsoid", Size = { 0.08, len, 0.08 }, Pos = { x, FT - 0.16 - len / 2 + 0.03, iz }, Color = ICE, Material = "Ice", Transparency = 0.1, Reflectance = 0.15 })
	end
	-- snow drifts on the top corners
	k:Part({ Name = "SnowDrift", Shape = "Ellipsoid", Size = { 0.8, 0.22, 0.62 }, Pos = { -0.82, FT + CAP + 0.02, capZ0 + 0.42 }, Rot = { 0, 15, 0 }, Color = FROST, Material = "Snow" })
	k:Part({ Name = "SnowDrift", Shape = "Ellipsoid", Size = { 0.62, 0.18, 0.5 }, Pos = { 0.88, FT + CAP + 0.01, 0.62 }, Rot = { 0, -20, 0 }, Color = FROST, Material = "Snow" })

	-- energy sticker on the right side
	k:Part({ Name = "EnergySticker", Size = { 0.05, 0.34, 0.5 }, Pos = { FX + 0.01, FB + 0.75, 0.45 }, Color = CHROME, Material = "Metal", Text = { Text = "A+++", Color = "#2f9e5a", Face = "Right" } })

	-- back: serpentine condenser coil (horizontal tubes, end headers, thin vertical wires)
	local cy0, cy1 = FB + 0.85, FT - 0.55
	for i = 0, 3 do
		local y = cy0 + (cy1 - cy0) * i / 3
		k:Part({ Name = "CoilTube", Shape = "Cylinder", Size = { 1.76, 0.09, 0.09 }, Pos = { 0, y, FZ1 + 0.05 }, Color = COIL, Material = "Metal" })
	end
	for _, x in { -0.88, 0.88 } do
		post(k, "CoilHeader", { x, (cy0 + cy1) / 2, FZ1 + 0.05 }, cy1 - cy0 + 0.09, 0.11, COIL, "Metal")
	end
	for _, x in { -0.45, 0, 0.45 } do
		post(k, "CoilWire", { x, (cy0 + cy1) / 2, FZ1 + 0.11 }, cy1 - cy0 + 0.3, 0.05, COIL, "Metal")
	end
	k:Part({ Name = "Compressor", Shape = "Ellipsoid", Size = { 0.7, 0.42, 0.34 }, Pos = { 0.35, FB + 0.38, FZ1 + 0.06 }, Color = DARK, Material = "Metal" })
end

--------------------------------------------------------------------------------------------
-- Doors. Both hinge on the +X edge; door-local x runs from 0 (hinge) to -2*FX (free edge).
--------------------------------------------------------------------------------------------
local function doorSlab(k, name, h)
	k:Part({ Name = name, Size = { 2 * FX - DT, h, DT }, Pos = { -FX, 0, -DT / 2 }, Color = DOOR })
	post(k, name .. "EdgeHinge", { -DT / 2, 0, -DT / 2 }, h, DT, DOOR)
	post(k, name .. "EdgeFree", { -(2 * FX - DT / 2), 0, -DT / 2 }, h, DT, DOOR)
end

local function handle(k, y, len)
	local x = -(2 * FX - 0.3)
	post(k, "HandleBar", { x, y, -DT - 0.17 }, len, 0.12, CHROME, "Metal", { Reflectance = 0.3 })
	for _, s in { -1, 1 } do
		k:Part({ Name = "HandlePost", Size = { 0.09, 0.09, 0.18 }, Pos = { x, y + s * (len / 2 - 0.08), -DT - 0.08 }, Color = CHROME_DARK, Material = "Metal" })
	end
end

local function buildFreezerDoor(k)
	local h = FRZ_T - FRZ_B
	k:Group({ Name = "FreezerDoor", Pos = { FX, (FRZ_B + FRZ_T) / 2, FZ0 } }, function()
		doorSlab(k, "FreezerDoor", h)
		handle(k, -h / 2 + 0.38, 0.5)
		local fz = -DT - 0.02
		-- badge plate (generic, not a brand)
		k:Part({ Name = "Badge", Size = { 0.72, 0.2, 0.05 }, Pos = { -FX, 0.24, fz }, Color = CHROME, Material = "Metal", Reflectance = 0.25, Text = { Text = "FRIGO", Color = "#2d5f8a", Face = "Front" } })
		-- digital thermometer
		k:Part({ Name = "TempDisplay", Size = { 0.46, 0.2, 0.05 }, Pos = { -FX, -0.14, fz }, Color = DARK, Text = { Text = "-18°", Color = GLOW, Face = "Front" } })
		k:Part({ Name = "PowerLed", Shape = "Ball", Size = { 0.07, 0.07, 0.07 }, Pos = { -FX - 0.33, -0.14, fz }, Color = GLOW, Material = "Neon", Anim = { Type = "Pulse", Amount = 0.35, Speed = 0.7 } })
		-- neon snowflake emblem
		for i = 0, 2 do
			k:Part({ Name = "Snowflake", Size = { 0.44, 0.06, 0.05 }, Pos = { -0.55, 0.02, fz - 0.005 }, Rot = { 0, 0, i * 60 }, Color = GLOW, Material = "Neon", Anim = { Type = "Pulse", Amount = 0.12, Speed = 0.5, Phase = 0.3 } })
		end
		-- frosted-over corner (Epic ice flair)
		k:Part({ Name = "FrostPatch", Shape = "Ellipsoid", Size = { 0.8, 0.5, 0.05 }, Pos = { -(2 * FX - 0.42), h / 2 - 0.2, fz + 0.005 }, Color = "#e8f8ff", Material = "Ice", Transparency = 0.2, Reflectance = 0.1 })
	end)
end

local function buildMainDoor(k)
	local h = MAIN_T - MAIN_B
	-- hinge pivot at the back corner of the door; the door hangs open
	k:Group({ Name = "MainDoorHinge", Pos = { FX, (MAIN_B + MAIN_T) / 2, FZ0 }, Rot = { 0, -17, 0 } }, function()
		k:Group({ Name = "MainDoor", Anim = { Type = "Wiggle", Axis = "Y", Amount = 5, Speed = 0.3 } }, function()
			doorSlab(k, "MainDoor", h)
			handle(k, h / 2 - 0.5, 0.7)
			-- inside of the door
			k:Part({ Name = "DoorLiner", Size = { 2.2, h - 0.2, 0.05 }, Pos = { -FX, 0, 0.025 }, Color = LINER })
			k:Part({ Name = "DoorGasket", Size = { 0.06, h - 0.12, 0.06 }, Pos = { -(2 * FX - 0.16), 0, 0.03 }, Color = GASKET, Material = "Rubber" })
			k:Part({ Name = "BinLip", Size = { 1.35, 0.16, 0.05 }, Pos = { -1.4, -0.49, 0.3 }, Color = "#eef8ff", Material = "Glass", Transparency = 0.3 })
			k:Part({ Name = "BinFloor", Size = { 1.35, 0.05, 0.3 }, Pos = { -1.4, -0.57, 0.15 }, Color = "#eef8ff" })
			post(k, "DoorBottle", { -1.85, -0.33, 0.15 }, 0.44, 0.17, "#3fae6a", "Glass")
			post(k, "JuiceBottle", { -2.08, -0.35, 0.15 }, 0.4, 0.17, "#ffb13b")
			-- fridge magnets + a kid's drawing of Frigo Camelo on the front
			local fz = -DT - 0.02
			k:Part({ Name = "Drawing", Size = { 0.6, 0.72, 0.05 }, Pos = { -0.82, 0.12, fz }, Rot = { 0, 0, -5 }, Color = PAPER })
			k:Part({ Name = "DrawingFridge", Size = { 0.2, 0.26, 0.05 }, Pos = { -0.84, -0.03, fz - 0.01 }, Rot = { 0, 0, -5 }, Color = "#9fd4ff" })
			k:Part({ Name = "DrawingNeck", Size = { 0.05, 0.22, 0.05 }, Pos = { -0.81, 0.2, fz - 0.01 }, Rot = { 0, 0, -12 }, Color = FUR_DARK })
			k:Part({ Name = "DrawingHead", Shape = "Ellipsoid", Size = { 0.14, 0.09, 0.05 }, Pos = { -0.74, 0.31, fz - 0.01 }, Color = FUR_DARK })
			k:Part({ Name = "DrawingMagnet", Shape = "Cylinder", Size = { 0.06, 0.13, 0.13 }, Pos = { -0.86, 0.45, fz - 0.035 }, Rot = { 0, 90, 0 }, Color = BLUE })
			for _, s in { -1, 1 } do
				k:Part({ Name = "HeartLobe", Shape = "Ellipsoid", Size = { 0.15, 0.15, 0.05 }, Pos = { -1.62 + s * 0.055, 0.6, fz - 0.02 }, Color = RED })
			end
			k:Part({ Name = "HeartTip", Size = { 0.13, 0.13, 0.05 }, Pos = { -1.62, 0.535, fz - 0.02 }, Rot = { 0, 0, 45 }, Color = RED })
			k:Part({ Name = "PizzaMagnet", Shape = "Wedge", Size = { 0.05, 0.3, 0.24 }, Pos = { -1.6, -0.4, fz - 0.02 }, Rot = { 0, -90, 0 }, Color = YELLOW })
			k:Part({ Name = "Pepperoni", Shape = "Cylinder", Size = { 0.05, 0.07, 0.07 }, Pos = { -1.6, -0.45, fz - 0.05 }, Rot = { 0, 90, 0 }, Color = RED })
		end)
	end)
end

--------------------------------------------------------------------------------------------
-- Power cord "tail" at the back
--------------------------------------------------------------------------------------------
local function buildCord(k)
	local base = { -0.5, FB + 0.45, FZ1 + 0.05 }
	k:Group({ Name = "PowerCord", Pos = base, Anim = { Type = "Wiggle", Axis = "Z", Amount = 12, Speed = 0.45, Phase = 0.6 } }, function()
		local pts = { { 0, 0, 0 }, { 0, -0.15, 0.38 }, { 0.06, -0.75, 0.48 }, { 0.08, -1.18, 0.24 } }
		for i = 1, #pts - 1 do
			segment(k, "Cord", pts[i], pts[i + 1], 0.07, DARK, "Rubber", 0.06)
		end
		local p = pts[#pts]
		k:Part({ Name = "Plug", Size = { 0.18, 0.22, 0.14 }, Pos = { p[1], p[2] - 0.1, p[3] }, Color = DARK, Material = "Rubber" })
		for _, s in { -1, 1 } do
			k:Part({ Name = "PlugPin", Shape = "Cylinder", Size = { 0.16, 0.05, 0.05 }, Pos = { p[1] + s * 0.05, p[2] - 0.27, p[3] }, Rot = { 0, 0, 90 }, Color = CHROME, Material = "Metal" })
		end
	end)
end

--------------------------------------------------------------------------------------------
-- Neck (long, smooth, tapering capsule chain), hump
--------------------------------------------------------------------------------------------
local NECK = { NECK0, { 0, FT + 0.7, -0.33 }, { 0, FT + 1.2, -0.5 }, { 0, FT + 1.58, -0.72 }, J }
local NECK_D = { 0.84, 0.74, 0.66, 0.6 }

local function buildNeck(k)
	for i = 1, #NECK - 1 do
		local a, b = NECK[i], NECK[i + 1]
		segment(k, "Neck", a, b, NECK_D[i], FUR, "SmoothPlastic", 0)
		if i > 1 then
			k:Part({ Name = "NeckJoint", Shape = "Ball", Size = { NECK_D[i], NECK_D[i], NECK_D[i] }, Pos = a, Color = FUR })
		end
	end
	-- dark mane ridge down the back of the neck (overlapping, flush with the neck)
	for i = 1, 4 do
		local a, b = NECK[i], NECK[i + 1]
		local dy, dz = b[2] - a[2], b[3] - a[3]
		local len = math.sqrt(dy * dy + dz * dz)
		k:Part({ Name = "Mane", Shape = "Ellipsoid", Size = { 0.26, len + 0.2, 0.26 }, Pos = { 0, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 + NECK_D[i] * 0.4 }, Rot = { deg(math.atan2(dz, dy)), 0, 0 }, Color = FUR_DARK, Material = "Fabric" })
	end
	-- shaggy throat beard on the front of the lower neck
	for i, t in { { 0.25, 0.42, 0.5 }, { 0.62, 0.36, 0.44 } } do
		local a, b = NECK[i], NECK[i + 1]
		local y = a[2] + (b[2] - a[2]) * 0.5
		local z = a[3] + (b[3] - a[3]) * 0.5 - NECK_D[i] * 0.4
		k:Part({ Name = "ThroatFur", Shape = "Ellipsoid", Size = { t[2], t[3], 0.28 }, Pos = { 0, y - t[1] * 0.3, z }, Rot = { 12, 0, 0 }, Color = FUR_MID, Material = "Fabric" })
	end
end

local function buildNeckBase(k)
	-- rubber gasket collar where the neck pokes through the fridge top
	post(k, "NeckGasket", { NECK0[1], FT + CAP + 0.03, NECK0[3] }, 0.06, 1.14, GASKET, "Rubber")
	post(k, "NeckSeal", { NECK0[1], FT + CAP + 0.1, NECK0[3] }, 0.12, 0.96, GASKET, "Rubber")
	-- small dromedary hump behind the neck
	k:Part({ Name = "Hump", Shape = "Ellipsoid", Size = { 1.1, 0.8, 1.0 }, Pos = { 0, FT + CAP + 0.02, 0.48 }, Color = FUR })
	k:Part({ Name = "HumpTuft", Shape = "Ellipsoid", Size = { 0.58, 0.22, 0.58 }, Pos = { 0, FT + CAP + 0.36, 0.52 }, Color = FUR_DARK, Material = "Fabric" })
end

--------------------------------------------------------------------------------------------
-- Head (local to the head joint; authored unscaled, scaled by HS)
--------------------------------------------------------------------------------------------
local E_CRAN = { 0, 0.3, 0.05, 0.47, 0.43, 0.52 }
local E_FACE = { 0, 0.17, -0.58, 0.35, 0.34, 0.66 }
local E_MUZ = { 0, -0.06, -1.18, 0.34, 0.33, 0.42 }

local function ell(k, name, E, color, material)
	hpart(k, { Name = name, Shape = "Ellipsoid", Size = { E[4] * 2, E[5] * 2, E[6] * 2 }, Pos = { E[1], E[2], E[3] }, Color = color, Material = material })
end

local function buildEye(k)
	local ER = 0.23
	local c, n = surf(E_CRAN, 0.62, 0.25, -0.75, -0.07)
	k:Group({ Name = "Eye", Pos = hv(c), Rot = faceRot(n) }, function()
		local BLINK = { Type = "Blink", Speed = 0.22, Phase = 0.35 }
		local function onEye(yaw, pitch, depth)
			local r = ER + depth
			return { math.sin(math.rad(yaw)) * math.cos(math.rad(pitch)) * r, math.sin(math.rad(pitch)) * r, -math.cos(math.rad(yaw)) * math.cos(math.rad(pitch)) * r }
		end
		hpart(k, { Name = "Eyeball", Shape = "Ball", Size = { ER * 2, ER * 2, ER * 2 }, Color = EYE_WHITE, Anim = BLINK })
		hpart(k, { Name = "Iris", Shape = "Ellipsoid", Size = { 0.3, 0.32, 0.08 }, Pos = onEye(-24, -8, -0.025), Rot = { -8, 24, 0 }, Color = IRIS, Anim = BLINK })
		hpart(k, { Name = "Pupil", Shape = "Ellipsoid", Size = { 0.17, 0.19, 0.06 }, Pos = onEye(-24, -8, 0.0), Rot = { -8, 24, 0 }, Color = PUPIL, Anim = BLINK })
		hpart(k, { Name = "EyeShine", Shape = "Ball", Size = { 0.075, 0.075, 0.075 }, Pos = onEye(-34, -3, 0.02), Color = SHINE, Material = "Neon", Anim = BLINK })
		hpart(k, { Name = "EyeShine2", Shape = "Ball", Size = { 0.045, 0.045, 0.045 }, Pos = onEye(-14, -16, 0.02), Color = SHINE, Material = "Neon", Anim = BLINK })
		-- heavy, droopy upper lid (half closed: proud but tired)
		hpart(k, { Name = "UpperLid", Shape = "Ellipsoid", Size = { ER * 2 + 0.06, 0.32, ER * 2 + 0.05 }, Pos = { 0, 0.13, 0.0 }, Rot = { 0, 0, -12 }, Color = LID })
		hpart(k, { Name = "LowerLid", Shape = "Ellipsoid", Size = { ER * 2 + 0.02, 0.1, ER * 2 - 0.04 }, Pos = { 0, -0.2, 0.0 }, Color = FUR_LIGHT })
		hpart(k, { Name = "Brow", Shape = "Ellipsoid", Size = { 0.52, 0.1, 0.22 }, Pos = { 0.02, 0.36, 0.03 }, Rot = { 0, 0, -16 }, Color = FUR_DARK, Material = "Fabric" })
		-- long lashes hanging from the outer half of the lid rim, curling down and out
		for _, phi in { 8, 34, 60 } do
			local s, co = math.sin(math.rad(phi)), math.cos(math.rad(phi))
			local r = ER + 0.035
			local yb = -0.02 - 0.05 * s
			local base = hv({ r * s, yb, -r * co })
			local tip = hv({ r * s + 0.03 + 0.07 * s, yb - 0.1 + 0.03 * s, -r * co - 0.05 * co })
			segment(k, "Lash", base, tip, 0.05, LASH, "SmoothPlastic", 0.0)
		end
	end)
end

local function buildEar(k)
	local p = surf(E_CRAN, 0.55, 0.78, 0.4, -0.06)
	k:Group({ Name = "Ear", Pos = hv(p), Rot = { -18, 0, -38 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 16, Speed = 0.45, Phase = 0.1 } }, function()
		hpart(k, { Name = "EarOuter", Shape = "Ellipsoid", Size = { 0.26, 0.36, 0.14 }, Pos = { 0, 0.14, 0 }, Color = FUR })
		hpart(k, { Name = "EarInner", Shape = "Ellipsoid", Size = { 0.15, 0.24, 0.05 }, Pos = { 0, 0.14, -0.06 }, Color = EAR_IN })
	end)
end

local function buildHead(k)
	ell(k, "Cranium", E_CRAN, FUR)
	ell(k, "Face", E_FACE, FUR)
	ell(k, "Muzzle", E_MUZ, MUZZLE)
	-- roman-nose bridge: the camel's long arched snout line
	hpart(k, { Name = "NoseBridge", Shape = "Ellipsoid", Size = { 0.38, 0.22, 0.86 }, Pos = { 0, 0.36, -0.86 }, Color = FUR_MID })
	hpart(k, { Name = "ThroatLatch", Shape = "Ellipsoid", Size = { 0.62, 0.62, 0.66 }, Pos = { 0, 0.0, 0.08 }, Color = FUR })

	-- woolly topknot between the ears
	hpart(k, { Name = "Topknot", Shape = "Ellipsoid", Size = { 0.44, 0.24, 0.42 }, Pos = surf(E_CRAN, 0, 1, 0.12, -0.06), Color = FUR_DARK, Material = "Fabric" })
	for _, t in { { 0.13, 0.95, -0.2, 0.22 }, { -0.12, 0.96, -0.24, 0.2 } } do
		local p = surf(E_CRAN, t[1], t[2], t[3], -0.04)
		hpart(k, { Name = "Forelock", Shape = "Ball", Size = { t[4], t[4], t[4] }, Pos = p, Color = FUR_DARK, Material = "Fabric" })
	end

	k:Mirror(function()
		buildEye(k)
		buildEar(k)
		-- slit nostrils on top of the muzzle
		local np, nn = surf(E_MUZ, 0.34, 0.45, -0.82, -0.015)
		hpart(k, { Name = "Nostril", Shape = "Ellipsoid", Size = { 0.17, 0.05, 0.1 }, Pos = np, Rot = faceRot(nn, 28), Color = NOSTRIL })
		-- split, floppy upper lip lobes with buck teeth peeking out under them
		hpart(k, { Name = "UpperLip", Shape = "Ellipsoid", Size = { 0.42, 0.34, 0.46 }, Pos = { 0.16, -0.27, -1.4 }, Color = LIP })
		hpart(k, { Name = "Tooth", Size = { 0.1, 0.12, 0.05 }, Pos = { 0.058, -0.42, -1.57 }, Color = TEETH })
	end)

	-- chewing lower jaw: side-to-side grind around a pivot behind the mouth
	local JP = { 0, -0.2, -0.55 }
	k:Group({ Name = "JawChew", Pos = hv(JP), Anim = { Type = "Wiggle", Axis = "Y", Amount = 7, Speed = 1.1 } }, function()
		k:Group({ Name = "JawOpen", Anim = { Type = "Wiggle", Axis = "X", Amount = 4, Speed = 1.1, Phase = 0.25 } }, function()
			k:Group({ Name = "JawOffset", Pos = hv({ -JP[1], -JP[2], -JP[3] }) }, function()
				hpart(k, { Name = "JawUnder", Shape = "Ellipsoid", Size = { 0.56, 0.3, 1.0 }, Pos = { 0, -0.31, -0.98 }, Color = FUR })
				hpart(k, { Name = "LowerLip", Shape = "Ellipsoid", Size = { 0.54, 0.24, 0.44 }, Pos = { 0, -0.52, -1.38 }, Color = LIP })
				hpart(k, { Name = "MouthLine", Shape = "Ellipsoid", Size = { 0.58, 0.05, 0.44 }, Pos = { 0, -0.43, -1.4 }, Color = MOUTH })
				hpart(k, { Name = "ChinTuft", Shape = "Ellipsoid", Size = { 0.24, 0.2, 0.22 }, Pos = { 0, -0.6, -1.18 }, Color = FUR_DARK, Material = "Fabric" })
			end)
		end)
	end)

	-- cold breath
	k:Particles({ Pos = hv({ 0, -0.35, -1.75 }), Color = "#eaf8ff", Color2 = "#bfe6ff", Rate = 4, Size = 0.25, Speed = 0.8, Lifetime = 1.6, Spread = 25, Direction = "Front" })
end

--------------------------------------------------------------------------------------------
-- Camel leg in a giant wheat work boot. Written for the right (+X) side; mirrored.
--------------------------------------------------------------------------------------------
local BG = -0.65 -- ground, relative to the ankle
local VAMP_C = { 0, 0.04, -0.28 } -- sloped lacing panel (ellipsoid tilted back 35 degrees)
local VAMP_A = 35

-- point on the front of the vamp: v = position along its long axis, x = sideways
local function vampFront(v, x, out)
	local a = math.rad(VAMP_A)
	local zl = -(0.31 + out) * math.sqrt(math.max(0, 1 - (x / 0.42) ^ 2))
	return { x, VAMP_C[2] + math.cos(a) * v - math.sin(a) * zl, VAMP_C[3] + math.sin(a) * v + math.cos(a) * zl }
end

local function buildBoot(k)
	-- chunky lug sole with rounded toe + stitched welt
	k:Part({ Name = "Sole", Size = { 0.98, 0.2, 1.05 }, Pos = { 0, BG + 0.1, -0.12 }, Color = SOLE, Material = "Rubber" })
	post(k, "SoleToe", { 0, BG + 0.1, -0.64 }, 0.2, 0.98, SOLE, "Rubber")
	k:Part({ Name = "Welt", Size = { 1.0, 0.07, 1.07 }, Pos = { 0, BG + 0.235, -0.12 }, Color = WELT, Material = "Leather" })
	post(k, "WeltToe", { 0, BG + 0.235, -0.64 }, 0.07, 1.0, WELT, "Leather")
	-- upper: shaft at the back, sloped vamp in front, round toe box + darker toe cap
	post(k, "Shaft", { 0, 0.0, 0.14 }, 1.08, 0.82, BOOT, "Fabric")
	k:Part({ Name = "Vamp", Shape = "Ellipsoid", Size = { 0.84, 1.15, 0.62 }, Pos = VAMP_C, Rot = { VAMP_A, 0, 0 }, Color = BOOT, Material = "Fabric" })
	k:Part({ Name = "ToeBox", Shape = "Ellipsoid", Size = { 0.92, 0.6, 0.9 }, Pos = { 0, BG + 0.44, -0.58 }, Color = BOOT, Material = "Fabric" })
	k:Part({ Name = "ToeCap", Shape = "Ellipsoid", Size = { 0.94, 0.48, 0.56 }, Pos = { 0, BG + 0.39, -0.78 }, Color = BOOT_DARK, Material = "Fabric" })
	k:Part({ Name = "HeelCounter", Shape = "Ellipsoid", Size = { 0.88, 0.56, 0.5 }, Pos = { 0, BG + 0.48, 0.36 }, Color = BOOT_DARK, Material = "Fabric" })
	-- puffy padded leather collar, fur spilling out of it, small pull tab
	k:Part({ Name = "Collar", Shape = "Ellipsoid", Size = { 0.98, 0.3, 0.94 }, Pos = { 0, 0.55, 0.12 }, Color = COLLAR, Material = "Leather" })
	k:Part({ Name = "FurCuff", Shape = "Ellipsoid", Size = { 0.58, 0.26, 0.58 }, Pos = { 0, 0.72, 0.1 }, Color = FUR_DARK, Material = "Fabric" })
	k:Part({ Name = "PullTab", Size = { 0.14, 0.16, 0.06 }, Pos = { 0, 0.66, 0.6 }, Color = COLLAR, Material = "Leather" })
	-- tongue + criss-cross laces down the sloped front
	local tp = vampFront(0.12, 0, -0.02)
	k:Part({ Name = "Tongue", Size = { 0.32, 1.0, 0.08 }, Pos = tp, Rot = { VAMP_A, 0, 0 }, Color = BOOT, Material = "Fabric" })
	for i = 0, 2 do
		local v = -0.28 + i * 0.25
		for _, sx in { -1, 1 } do
			k:Part({ Name = "Eyelet", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = vampFront(v, sx * 0.18, 0.0), Color = EYELET, Material = "Foil" })
		end
		k:Part({ Name = "Lace", Size = { 0.36, 0.06, 0.06 }, Pos = vampFront(v + 0.03, 0, 0.05), Rot = { VAMP_A, 0, if i % 2 == 0 then 12 else -12 }, Color = LACE })
	end
	-- bow at the top
	for _, sx in { -1, 1 } do
		k:Part({ Name = "BowLoop", Shape = "Ellipsoid", Size = { 0.2, 0.11, 0.06 }, Pos = vampFront(0.5, sx * 0.11, 0.06), Rot = { VAMP_A, 0, sx * 25 }, Color = LACE })
	end
end

local function buildLeg(k)
	local SW, SP = 3, 0.5
	k:Group({ Name = "Leg", Pos = { 0.62, HIP_Y, 0.1 }, Anim = { Type = "Wiggle", Axis = "X", Amount = SW, Speed = SP } }, function()
		k:Part({ Name = "Thigh", Shape = "Ellipsoid", Size = { 0.6, 1.3, 0.66 }, Pos = { 0, -0.42, 0 }, Color = FUR })
		k:Group({ Name = "Knee", Pos = { 0, -0.95, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = -SW * 2, Speed = SP } }, function()
			k:Part({ Name = "KneeKnob", Shape = "Ball", Size = { 0.46, 0.46, 0.46 }, Pos = { 0, 0, -0.02 }, Color = FUR })
			k:Part({ Name = "KneeCallus", Shape = "Ellipsoid", Size = { 0.32, 0.3, 0.2 }, Pos = { 0, -0.01, -0.15 }, Color = CALLUS, Material = "Fabric" })
			k:Part({ Name = "Shin", Shape = "Ellipsoid", Size = { 0.34, 1.05, 0.38 }, Pos = { 0, -0.5, 0.02 }, Color = FUR })
			k:Group({ Name = "Ankle", Pos = { 0, -1.3, 0 }, Rot = { 0, -6, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = SW, Speed = SP } }, function()
				buildBoot(k)
			end)
		end)
	end)
end

return {
	Id = "FrigoCamelo",
	Name = "Frigo Camelo",
	Rarity = "Epic",
	Emoji = "🐪",
	Color = FUR,
	Tagline = "Che freddo qui dentro... half camel, all fridge.",
	Lore = "Frigo Camelo wanders the streets of Rome, Paris and Milan in his favourite giant boots, puffing little clouds of frost. Nobody knows why a camel traded its body for a fridge, but his milk is always cold and his snacks never spoil. Please close the door.",

	Build = function(k)
		k:Mirror(function()
			buildLeg(k)
		end)

		-- fridge, neck and head sway together on the hips
		pivot(k, "Body", { 0, HIP_Y, 0 }, { Type = "Wiggle", Axis = "Z", Amount = 1.5, Speed = 0.4 }, function()
			buildCabinet(k)
			buildFreezerDoor(k)
			buildMainDoor(k)
			buildCord(k)
			buildNeckBase(k)

			-- long neck sways side to side and nods
			pivot(k, "NeckSway", NECK0, { Type = "Wiggle", Axis = "Z", Amount = 4, Speed = 0.3 }, function()
				pivot(k, "NeckNod", NECK0, { Type = "Wiggle", Axis = "X", Amount = 3, Speed = 0.42, Phase = 0.2 }, function()
					buildNeck(k)
					-- head held proudly, snout slightly raised
					k:Group({ Name = "HeadLook", Pos = J, Rot = { 6, 0, 0 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 7, Speed = 0.2 } }, function()
						k:Group({ Name = "Head", Anim = { Type = "Wiggle", Axis = "X", Amount = 4, Speed = 0.5, Phase = 0.4 } }, function()
							buildHead(k)
						end)
					end)
				end)
			end)

			k:Light({ Pos = { -0.3, CAV_B + 1.1, -0.6 }, Color = GLOW, Range = 7, Brightness = 1.6 })
			k:Light({ Pos = { 0, FT + 0.8, -1.6 }, Color = "#bfefff", Range = 9, Brightness = 0.8 })
			k:Particles({ Pos = { -1.15, CAV_B + 0.9, -1.25 }, Color = "#dff6ff", Color2 = "#9fdcff", Rate = 5, Size = 0.4, Speed = 0.5, Lifetime = 2, Spread = 30, Direction = "Bottom" })
			k:Particles({ Pos = { 0, FT + 0.25, -0.2 }, Color = "#ffffff", Color2 = GLOW, Rate = 3, Size = 0.15, Speed = 0.6, Lifetime = 2.5, Spread = 80, Direction = "Top" })
		end)
	end,

	BuildMini = function(k)
		-- white fridge body with freezer seam and handle
		k:Part({ Name = "Fridge", Size = { 1.1, 1.25, 0.95 }, Pos = { 0, -0.14, 0.12 }, Color = FRIDGE })
		k:Part({ Name = "Seam", Size = { 1.12, 0.06, 0.97 }, Pos = { 0, 0.16, 0.12 }, Color = SEAM })
		k:Part({ Name = "Handle", Size = { 0.09, 0.36, 0.1 }, Pos = { -0.4, -0.08, -0.38 }, Color = CHROME, Material = "Metal" })
		-- long neck + camel head with droopy lips
		k:Part({ Name = "Neck", Shape = "Ellipsoid", Size = { 0.34, 0.9, 0.36 }, Pos = { 0, 0.72, -0.08 }, Rot = { -18, 0, 0 }, Color = FUR })
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 0.5, 0.46, 0.92 }, Pos = { 0, 1.07, -0.45 }, Color = FUR })
		k:Part({ Name = "Lips", Shape = "Ellipsoid", Size = { 0.4, 0.3, 0.36 }, Pos = { 0, 0.96, -0.86 }, Color = LIP })
		-- one dark rod through the head: its end caps bulge out as both eyes
		k:Part({ Name = "Eyes", Shape = "Cylinder", Size = { 0.6, 0.16, 0.16 }, Pos = { 0, 1.15, -0.5 }, Color = PUPIL })
		-- dromedary hump behind the neck
		k:Part({ Name = "Hump", Shape = "Ellipsoid", Size = { 0.6, 0.42, 0.55 }, Pos = { 0, 0.5, 0.3 }, Color = FUR })
		k:Mirror(function()
			k:Part({ Name = "Leg", Shape = "Cylinder", Size = { 0.4, 0.17, 0.17 }, Pos = { 0.28, -0.92, 0.12 }, Rot = { 0, 0, 90 }, Color = FUR })
			k:Part({ Name = "Boot", Shape = "Ellipsoid", Size = { 0.4, 0.36, 0.62 }, Pos = { 0.28, -1.17, 0.0 }, Color = BOOT })
		end)
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">LaVaccaSaturnoSaturnita</string>
            <string name="Source"><![CDATA[--[[
	La Vacca Saturno Saturnita (Secret)
	Canonical look: a black-and-white Holstein cow head (pink snout with nostrils, little
	ivory horns, floppy ears, big eyes) popping out of the top of the planet SATURN, which is
	its whole body: a big beige / tan / orange banded sphere wrapped in wide tilted rings
	(beige inner rings, pale-blue outer ring). It stands on two bare human legs with big feet.

	Secret flair (never changes the design): glowing ring rim, orbiting moons, twinkling
	stars, a ForceField aura, Glass inner ring, a Foil moon, 2 lights, 3 particle emitters.

	Coordinates: feet on y = 0, faces -Z. Most parts are written in world coordinates by
	nesting an un-animated "offset" group inside each animated joint group.
]]

-- Palette ------------------------------------------------------------------------------
local COW = "#fff8ec" -- warm white hide
local COW_SHADE = "#efe4d4"
local PATCH = "#211e27" -- Holstein black patches (tinted dark)
local PINK = "#f3a7b6" -- snout
local PINK_DARK = "#d97b93"
local PINK_LIGHT = "#fbc8d1"
local NOSTRIL = "#8a3550"
local NOSTRIL_IN = "#4a1626"
local MOUTH = "#44192a"
local TONGUE = "#e8687f"
local EYE_WHITE = "#fffaf0"
local EYE_RIM = "#2a2530"
local IRIS = "#5b3420"
local PUPIL = "#141218"
local SHINE = "#fffdf6"
local HORN = "#f1e4c6"
local HORN_MID = "#dcc497"
local HORN_TIP = "#9a7a55"

local SKIN = "#f4cbb0" -- bare human legs (warm pinkish skin, not wood)
local SKIN_DARK = "#e2ad91"
local SKIN_LIGHT = "#f9dcc8"
local NAIL = "#fde9df"

-- Saturn bands, pole -> equator. Steal a Brainrot's cow-Saturn reads beige / white / blue,
-- so the planet is soft butterscotch-beige with only gentle orange accents.
local BAND = {
	"#cbc6b4", -- polar cap (pale grey-beige, faintly cool)
	"#dcbf94", -- tan
	"#f3e6ca", -- cream
	"#e3b47e", -- butterscotch
	"#f7ecd4", -- light cream
	"#d99c62", -- soft orange accent belt
	"#efdcb5", -- sand
	"#ead0a0", -- golden-beige equator
}
local RING_C = { "#dccaa6", "#cfbb96" } -- beige inner ring (Glass)
local RING_B = { "#a9cff2", "#9dc4ec", "#b8d9f6" } -- the big pale-blue main ring
local RING_A = { "#7fa9dc", "#7299d0" } -- deeper blue outer ring (Ice)
local RING_GLOW = "#c8eeff"
local STAR = "#fff3b0"
local STAR_BLUE = "#cfe9ff"
local AURA = "#b9a8ff"

-- Layout (world studs) -------------------------------------------------------------------
local PC = { 0, 4.55, 0 } -- planet centre
local PR = 1.95 -- planet radius (polar)
local HIP = { 0, 2.85, 0 } -- body sway pivot
local NECK = { 0, 6.55, -0.25 } -- head nod pivot
local JAW_HINGE = { 0, 6.62, -0.72 }
local HEAD_SCALE = 1.12 -- head modelled at 1:1, built 12% bigger around the neck

-- Head volumes {cx, cy, cz, semiX, semiY, semiZ}
local SKULL = { 0, 7.5, -0.3, 1.02, 0.9, 0.95 }
local FACE = { 0, 7.08, -0.82, 0.86, 0.7, 0.76 }
local MUZZLE = { 0, 6.84, -1.36, 0.82, 0.5, 0.56 }
local JAW = { 0, 6.44, -1.1, 0.62, 0.26, 0.5 }
local NECKV = { 0, 6.42, -0.2, 0.86, 0.55, 0.82 }

-- Ring tilt (front edge dips toward the viewer, rises to the viewer's right)
local RING_ROT = { -24, 0, -15 }

------------------------------------------------------------------------------------------
-- Math helpers
------------------------------------------------------------------------------------------
local function deg(r)
	return r * 180 / math.pi
end

local function unit(x, y, z)
	local l = math.sqrt(x * x + y * y + z * z)
	return x / l, y / l, z / l
end

-- Rotation whose local -Z points along unit vector n (flat details lying on a surface)
local function faceRot(nx, ny, nz, spin)
	return { deg(math.atan2(ny, -nz)), deg(math.asin(-nx)), spin or 0 }
end

-- Rotation that points a Cylinder's axis (local X) along vector v
local function axisRot(vx, vy, vz)
	vx, vy, vz = unit(vx, vy, vz)
	return { 0, deg(math.atan2(-vz, vx)), deg(math.asin(vy)) }
end

-- Distance along a ray (origin p, unit dir d) to where it leaves ellipsoid e (-1 = miss)
local function exitT(e, px, py, pz, dx, dy, dz)
	local ox, oy, oz = (px - e[1]) / e[4], (py - e[2]) / e[5], (pz - e[3]) / e[6]
	local vx, vy, vz = dx / e[4], dy / e[5], dz / e[6]
	local A = vx * vx + vy * vy + vz * vz
	local B = 2 * (ox * vx + oy * vy + oz * vz)
	local C = ox * ox + oy * oy + oz * oz - 1
	local disc = B * B - 4 * A * C
	if disc < 0 then
		return -1
	end
	return (-B + math.sqrt(disc)) / (2 * A)
end

-- Outer surface point of a union of ellipsoids, seen from p along d, pushed `out` studs.
local function surface(list, px, py, pz, dx, dy, dz, out)
	dx, dy, dz = unit(dx, dy, dz)
	local best, bt = list[1], -1
	for _, e in list do
		local t = exitT(e, px, py, pz, dx, dy, dz)
		if t > bt then
			best, bt = e, t
		end
	end
	local x, y, z = px + dx * bt, py + dy * bt, pz + dz * bt
	local nx, ny, nz = unit((x - best[1]) / (best[4] * best[4]), (y - best[2]) / (best[5] * best[5]), (z - best[3]) / (best[6] * best[6]))
	return { x + nx * out, y + ny * out, z + nz * out }, { nx, ny, nz }
end

-- A smooth "cap" patch that hugs ellipsoid e: a slightly shrunken copy of e pushed toward
-- direction u, so only a cap of angular radius `alpha` pokes out (follows the curvature).
local function capPatch(k, name, e, ux, uy, uz, alpha, s, color, material)
	ux, uy, uz = unit(ux, uy, uz)
	local ca = math.cos(math.rad(alpha))
	local o = ca - math.sqrt(ca * ca - 1 + s * s)
	k:Part({
		Name = name,
		Shape = "Ellipsoid",
		Size = { 2 * e[4] * s, 2 * e[5] * s, 2 * e[6] * s },
		Pos = { e[1] + ux * o * e[4], e[2] + uy * o * e[5], e[3] + uz * o * e[6] },
		Color = color,
		Material = material or "SmoothPlastic",
	})
end

-- Cylinder segment between two points
local function segment(k, name, a, b, diameter, color, material)
	local vx, vy, vz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local len = math.sqrt(vx * vx + vy * vy + vz * vz)
	k:Part({
		Name = name,
		Shape = "Cylinder",
		Size = { len + diameter * 0.35, diameter, diameter },
		Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
		Rot = axisRot(vx, vy, vz),
		Color = color,
		Material = material or "SmoothPlastic",
	})
end

-- Rotation that points an Ellipsoid's local Y along unit-ish vector u (limbs, tails)
local function upRot(ux, uy, uz)
	ux, uy, uz = unit(ux, uy, uz)
	return { deg(math.atan2(uz, uy)), 0, deg(-math.asin(ux)) }
end

-- Smooth organic limb: a chain of heavily overlapping round beads along a polyline.
-- pts = { {x, y, z, radius}, ... }. Overlap 2.6x hides every bead's tapering ends.
local function loft(k, name, pts, color, material)
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local vx, vy, vz = a[1] - b[1], a[2] - b[2], a[3] - b[3]
		local len = math.sqrt(vx * vx + vy * vy + vz * vz)
		local r = math.max(a[4], b[4])
		k:Part({
			Name = name,
			Shape = "Ellipsoid",
			Size = { r * 2, len * 2.6, r * 2 },
			Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
			Rot = upRot(vx, vy, vz),
			Color = color,
			Material = material or "SmoothPlastic",
		})
	end
end

-- Animated joint whose children are written in world coordinates
local function joint(k, name, p, anim, fn, rot)
	k:Group({ Name = name, Pos = p, Rot = rot, Anim = anim }, function()
		k:Group({ Name = name .. "Offset", Pos = { -p[1], -p[2], -p[3] } }, fn)
	end)
end

-- A builder proxy that uniformly scales everything built through it (every Pos and Size,
-- relative to the frame it is used in). Lets the head be sized as one unit.
local function scaled(k, f)
	local proxy = {}
	local function sv(v)
		if v == nil then
			return nil
		end
		return { v[1] * f, v[2] * f, v[3] * f }
	end
	local function copy(spec)
		local c = {}
		for key, val in spec do
			c[key] = val
		end
		c.Pos = sv(spec.Pos)
		return c
	end
	function proxy:Part(spec)
		local c = copy(spec)
		c.Size = sv(spec.Size)
		k:Part(c)
	end
	function proxy:Group(spec, fn)
		k:Group(copy(spec), fn)
	end
	function proxy:Mirror(fn)
		k:Mirror(fn)
	end
	return proxy
end

-- 3D twinkle star: three crossed Neon bars that pulse
local function star(k, name, pos, size, color, phase, speed)
	for axis = 1, 3 do
		local sz = { size * 0.2, size * 0.2, size * 0.2 }
		sz[axis] = size
		k:Part({
			Name = name,
			Shape = "Ellipsoid",
			Size = sz,
			Pos = pos,
			Color = color,
			Material = "Neon",
			Anim = { Type = "Pulse", Amount = 0.35, Speed = speed or 0.8, Phase = phase },
		})
	end
end

------------------------------------------------------------------------------------------
-- Saturn: a sphere built from concentric stacked band layers. Layer i is a little wider and
-- flatter than the one below it, so it only shows in a band |latitude| < THETA[i].
------------------------------------------------------------------------------------------
local THETA = { 66, 55, 46, 37, 28, 19, 9 }
local BAND_STEP = 0.022

local function planetLayers()
	local layers = { { a = PR, b = PR } }
	for i, th in THETA do
		local prev = layers[i]
		local a = PR + i * BAND_STEP
		local t = math.tan(math.rad(th))
		local invB2 = 1 / (prev.b * prev.b) + (1 / (prev.a * prev.a) - 1 / (a * a)) / (t * t)
		table.insert(layers, { a = a, b = 1 / math.sqrt(invB2) })
	end
	return layers
end
local LAYERS = planetLayers()

-- Radius of the banded planet's outer surface at latitude `lat` (degrees)
local function planetRadius(lat)
	local c, s = math.cos(math.rad(lat)), math.sin(math.rad(lat))
	local best = 0
	for _, L in LAYERS do
		local d = 1 / math.sqrt(c * c / (L.a * L.a) + s * s / (L.b * L.b))
		best = math.max(best, d)
	end
	return best
end

-- Point + outward direction on the planet at latitude / azimuth (azimuth 0 = front, -Z)
local function onPlanet(lat, az, out)
	local r = planetRadius(lat) + (out or 0)
	local cl = math.cos(math.rad(lat))
	local nx, ny, nz = math.sin(math.rad(az)) * cl, math.sin(math.rad(lat)), -math.cos(math.rad(az)) * cl
	return { PC[1] + nx * r, PC[2] + ny * r, PC[3] + nz * r }, nx, ny, nz
end

local function buildPlanet(k)
	for i, L in LAYERS do
		k:Part({
			Name = if i == 1 then "Planet" else "Band" .. (i - 1),
			Shape = if i == 1 then "Ball" else "Ellipsoid",
			Size = { L.a * 2, L.b * 2, L.a * 2 },
			Pos = PC,
			Color = BAND[i],
			Material = "SmoothPlastic",
		})
	end

	-- storms: flat ovals lying on the bands
	local storms = {
		{ 37, -38, 0.62, 0.34, "#fbf1dc" }, -- great white spot (north orange band)
		{ -37, 30, 0.5, 0.28, "#fbf1dc" },
		{ -18, -70, 0.36, 0.2, "#c88d58" },
		{ 18, 75, 0.4, 0.22, "#c88d58" },
		{ -27, 160, 0.48, 0.26, "#fbf1dc" },
	}
	for _, s in storms do
		local p, nx, ny, nz = onPlanet(s[1], s[2], -0.01)
		k:Part({ Name = "Storm", Shape = "Ellipsoid", Size = { s[3], s[4], 0.08 }, Pos = p, Rot = faceRot(nx, ny, nz), Color = s[5] })
	end

	-- cosmic aura shell
	k:Part({
		Name = "Aura",
		Shape = "Ball",
		Size = { 4.3, 4.3, 4.3 },
		Pos = PC,
		Color = AURA,
		Material = "ForceField",
		Transparency = 0.88,
		Anim = { Type = "Pulse", Amount = 0.025, Speed = 0.45 },
	})
end

------------------------------------------------------------------------------------------
-- Rings (built in the ring's own tilted frame; the ring plane is local y = 0)
------------------------------------------------------------------------------------------
local function ringBand(k, name, rIn, rOut, n, thick, colors, material, transparency)
	local rc = (rIn + rOut) / 2
	local L = 2 * rOut * math.tan(math.pi / n) + 0.004
	for i = 0, n - 1 do
		local a = (i + 0.5) / n * 2 * math.pi
		k:Part({
			Name = name,
			Size = { rOut - rIn, thick, L },
			Pos = { rc * math.cos(a), 0, rc * math.sin(a) },
			Rot = { 0, -deg(a), 0 },
			Color = colors[i % #colors + 1],
			Material = material or "SmoothPlastic",
			Transparency = transparency or 0,
		})
	end
end

local function buildRings(k)
	-- concentric bands, each one colour so the ring reads as smooth sheets (not tiles):
	-- beige glassy C ring, two-tone pale-blue B ring, Cassini gap, deeper-blue A ring, glow rim
	ringBand(k, "RingC", 2.2, 2.44, 24, 0.07, { RING_C[1] }, "Glass", 0.3)
	ringBand(k, "RingB", 2.44, 2.62, 28, 0.1, { RING_B[3] }, "SmoothPlastic", 0)
	ringBand(k, "RingB", 2.62, 2.82, 30, 0.1, { RING_B[1] }, "SmoothPlastic", 0)
	ringBand(k, "RingA", 2.89, 3.04, 32, 0.09, { RING_A[1] }, "Ice", 0)
	ringBand(k, "RingGlow", 3.04, 3.1, 32, 0.06, { RING_GLOW }, "Neon", 0)

	-- little ice boulders riding on the bright ring
	for i = 0, 7 do
		local a = math.rad(10 + i * 45 + (i % 3) * 7)
		local r = 2.56 + (i % 3) * 0.08
		local sz = 0.1 + (i % 4) * 0.025
		k:Part({
			Name = "RingRock",
			Size = { sz, sz * 0.8, sz * 1.1 },
			Pos = { r * math.cos(a), 0.06 + sz * 0.3, r * math.sin(a) },
			Rot = { i * 37, i * 53, i * 29 },
			Color = if i % 2 == 0 then "#eef3f8" else "#c3cdd9",
			Material = "Glacier",
		})
	end

	-- twinkling stardust glints riding on the bright ring
	for i = 0, 3 do
		local a = math.rad(25 + i * 90)
		star(k, "RingStar", { 2.64 * math.cos(a), 0.1, 2.64 * math.sin(a) }, 0.34, if i % 2 == 0 then STAR else STAR_BLUE, i * 0.23, 0.9)
	end
end

------------------------------------------------------------------------------------------
-- Moons orbiting in (and just above / below) the ring plane
------------------------------------------------------------------------------------------
local function moon(k, name, r, off, d, color, material, craterColor, speed, phase)
	k:Group({ Name = name .. "Orbit", Anim = { Type = "Spin", Axis = "Y", Speed = speed, Phase = phase } }, function()
		k:Group({ Name = name, Pos = { r, off, 0 }, Rot = { 20, 0, 30 } }, function()
			k:Part({ Name = name .. "Body", Shape = "Ball", Size = { d, d, d }, Color = color, Material = material })
			local craters = { { 0.3, 0.4, -0.86, 0.32 }, { -0.5, -0.2, -0.84, 0.24 }, { 0.6, -0.5, 0.62, 0.28 } }
			for _, c in craters do
				local nx, ny, nz = unit(c[1], c[2], c[3])
				local cd = d * c[4]
				k:Part({
					Name = name .. "Crater",
					Shape = "Ellipsoid",
					Size = { cd, cd, math.max(0.05, cd * 0.3) },
					Pos = { nx * d * 0.47, ny * d * 0.47, nz * d * 0.47 },
					Rot = faceRot(nx, ny, nz),
					Color = craterColor,
					Material = material,
				})
			end
		end)
	end)
end

------------------------------------------------------------------------------------------
-- Cow head (world coordinates at 1:1; Build scales it up by HEAD_SCALE around the neck)
------------------------------------------------------------------------------------------
local HEAD_VOLS = { SKULL, FACE }
local BLINK = { Type = "Blink", Speed = 0.24, Phase = 0.15 }

local function buildEye(k, s)
	local p, n = surface(HEAD_VOLS, s * 0.4, 7.72, -0.4, s * 0.22, 0.04, -1, -0.02)
	k:Group({ Name = "Eye", Pos = p, Rot = faceRot(n[1], n[2], n[3]) }, function()
		k:Part({ Name = "EyeRim", Shape = "Ellipsoid", Size = { 0.7, 0.8, 0.26 }, Pos = { 0, 0, 0.05 }, Color = EYE_RIM })
		k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.6, 0.7, 0.3 }, Pos = { 0, 0, 0 }, Color = EYE_WHITE, Anim = BLINK })
		k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.42, 0.5, 0.12 }, Pos = { -s * 0.03, -0.04, -0.12 }, Color = IRIS, Anim = BLINK })
		k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.24, 0.3, 0.08 }, Pos = { -s * 0.03, -0.04, -0.17 }, Color = PUPIL, Anim = BLINK })
		k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = { -s * 0.1, 0.1, -0.2 }, Color = SHINE, Material = "Neon", Anim = BLINK })
		k:Part({ Name = "EyeShine2", Shape = "Ball", Size = { 0.07, 0.07, 0.07 }, Pos = { s * 0.06, -0.14, -0.19 }, Color = SHINE, Material = "Neon", Anim = BLINK })
		-- sleepy-content upper lid
		k:Part({ Name = "EyeLid", Shape = "Ellipsoid", Size = { 0.66, 0.22, 0.33 }, Pos = { 0, 0.34, -0.01 }, Rot = { 0, 0, s * 5 }, Color = if s > 0 then PATCH else COW, Anim = BLINK })
		-- three lashes flicking out of the outer corner of the lid
		for j = 0, 2 do
			local ad = -2 + j * 20
			local a = math.rad(ad)
			k:Part({
				Name = "Lash",
				Size = { 0.05, 0.17, 0.05 },
				Pos = { s * (0.3 + math.cos(a) * 0.06), 0.1 + math.sin(a) * 0.1, -0.1 },
				Rot = { 0, 0, s * (ad - 90) },
				Color = EYE_RIM,
				Anim = BLINK,
			})
		end
	end)
end

local function buildEar(k, s, phase, dark)
	local root = { s * 0.9, 7.66, -0.2 }
	k:Group({
		Name = if s > 0 then "RightEar" else "LeftEar",
		Pos = root,
		Rot = { 0, s * 14, 0 },
		Anim = { Type = "Wiggle", Axis = "Z", Amount = 12, Speed = 0.55, Phase = phase },
	}, function()
		k:Part({ Name = "EarRoot", Shape = "Ellipsoid", Size = { 0.42, 0.34, 0.42 }, Pos = { s * 0.08, 0, 0 }, Color = if dark then PATCH else COW })
		k:Part({ Name = "Ear", Shape = "Ellipsoid", Size = { 1.05, 0.44, 0.6 }, Pos = { s * 0.5, -0.08, 0 }, Rot = { 0, 0, s * -16 }, Color = if dark then PATCH else COW })
		k:Part({ Name = "EarInner", Shape = "Ellipsoid", Size = { 0.78, 0.27, 0.16 }, Pos = { s * 0.52, -0.1, -0.24 }, Rot = { 0, 0, s * -16 }, Color = PINK })
		-- fluffy fur tufts in the ear opening
		k:Part({ Name = "EarFluff", Shape = "Ellipsoid", Size = { 0.26, 0.14, 0.12 }, Pos = { s * 0.3, -0.08, -0.31 }, Rot = { 0, 0, s * 10 }, Color = COW })
		k:Part({ Name = "EarFluff", Shape = "Ellipsoid", Size = { 0.2, 0.11, 0.1 }, Pos = { s * 0.34, -0.15, -0.3 }, Rot = { 0, 0, s * -25 }, Color = COW_SHADE })
		if not dark then
			-- black ear tip
			k:Part({ Name = "EarTip", Shape = "Ellipsoid", Size = { 0.34, 0.3, 0.5 }, Pos = { s * 0.88, -0.19, 0.02 }, Rot = { 0, 0, s * -16 }, Color = PATCH })
		end
	end)
end

local function buildHorn(k)
	-- smooth curved horn: overlapping tapered ellipsoid beads along a quadratic curve
	local P0, C, P2 = { 0.55, 8.05, -0.3 }, { 1.08, 8.26, -0.3 }, { 1.24, 8.95, -0.44 }
	local function at(t)
		local a, b, c = (1 - t) * (1 - t), 2 * (1 - t) * t, t * t
		return { a * P0[1] + b * C[1] + c * P2[1], a * P0[2] + b * C[2] + c * P2[2], a * P0[3] + b * C[3] + c * P2[3] }
	end
	local N = 5
	local COLS = { HORN, HORN, "#ead9b2", HORN_MID, HORN_TIP }
	for i = 1, N do
		local t0, t1 = (i - 1) / N, i / N
		local a, b = at(t0), at(t1)
		local vx, vy, vz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
		local len = math.sqrt(vx * vx + vy * vy + vz * vz)
		local d = 0.36 - 0.25 * (i - 1) / (N - 1)
		k:Part({
			Name = "Horn",
			Shape = "Ellipsoid",
			Size = { len * 2.6, d, d }, -- 2.6 keeps the tip under the 9.5 height limit
			Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
			Rot = axisRot(vx, vy, vz),
			Color = COLS[i],
		})
	end
	-- keratin ring where the horn meets the skull
	k:Part({ Name = "HornBase", Shape = "Ellipsoid", Size = { 0.2, 0.44, 0.44 }, Pos = { 0.6, 8.08, -0.3 }, Rot = axisRot(1, 0.45, 0), Color = HORN_MID })
end

-- Blue collar round the base of the neck with a swinging golden cowbell under the chin
local COLLAR = "#3f6fcf"
local GOLD = "#e8c25a"
local GOLD_DARK = "#a9802e"

local function buildCollar(k)
	local Y, CZ, R = 6.4, -0.2, 0.9
	-- one leather disc hugging the neck at its widest point: reads as a strap all round
	k:Part({ Name = "Collar", Shape = "Cylinder", Size = { 0.17, R * 2, R * 2 }, Pos = { 0, Y, CZ }, Rot = { 0, 0, 90 }, Color = COLLAR, Material = "Leather" })
	-- gold studs everywhere except under the chin (front) and the buckle (back)
	for j = 1, 9 do
		local a = math.rad(-90 + j * 36)
		if j ~= 5 then
			k:Part({ Name = "CollarStud", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = { (R + 0.01) * math.cos(a), Y, CZ + (R + 0.01) * math.sin(a) }, Color = GOLD, Material = "Foil" })
		end
	end
	-- buckle at the back of the neck
	k:Part({ Name = "Buckle", Size = { 0.26, 0.22, 0.05 }, Pos = { 0, Y, CZ + R + 0.01 }, Color = GOLD, Material = "Foil" })
	k:Part({ Name = "BuckleHole", Size = { 0.16, 0.12, 0.05 }, Pos = { 0, Y, CZ + R + 0.025 }, Color = COLLAR, Material = "Leather" })
	k:Part({ Name = "BucklePin", Size = { 0.05, 0.14, 0.05 }, Pos = { 0, Y, CZ + R + 0.04 }, Color = GOLD_DARK, Material = "Foil" })
	-- short strap dropping from under the chin to the bell loop
	segment(k, "BellStrap", { 0, 6.3, -1.2 }, { 0, 6.15, -1.44 }, 0.08, COLLAR, "Leather")

	-- the bell swings like a pendulum from its loop
	local LOOP = { 0, 6.13, -1.46 }
	joint(k, "Bell", LOOP, { Type = "Wiggle", Axis = "Z", Amount = 10, Speed = 0.8, Phase = 0.1 }, function()
		k:Part({ Name = "BellLoop", Shape = "Ball", Size = { 0.1, 0.1, 0.1 }, Pos = LOOP, Color = GOLD_DARK, Material = "Foil" })
		k:Part({ Name = "BellDome", Shape = "Ellipsoid", Size = { 0.28, 0.22, 0.28 }, Pos = { 0, 6.05, -1.52 }, Color = GOLD, Material = "Foil" })
		k:Part({ Name = "BellBody", Shape = "Cylinder", Size = { 0.2, 0.3, 0.3 }, Pos = { 0, 5.96, -1.52 }, Rot = { 0, 0, 90 }, Color = GOLD, Material = "Foil" })
		k:Part({ Name = "BellBand", Shape = "Cylinder", Size = { 0.05, 0.32, 0.32 }, Pos = { 0, 6.0, -1.52 }, Rot = { 0, 0, 90 }, Color = GOLD_DARK, Material = "Foil" })
		k:Part({ Name = "BellLip", Shape = "Cylinder", Size = { 0.06, 0.37, 0.37 }, Pos = { 0, 5.86, -1.52 }, Rot = { 0, 0, 90 }, Color = GOLD, Material = "Foil" })
		k:Part({ Name = "BellClapper", Shape = "Ball", Size = { 0.11, 0.11, 0.11 }, Pos = { 0, 5.81, -1.52 }, Color = "#5a4320", Material = "Metal" })
	end)
end

local function buildHead(k)
	-- big forms
	k:Part({ Name = "Neck", Shape = "Ellipsoid", Size = { NECKV[4] * 2, NECKV[5] * 2, NECKV[6] * 2 }, Pos = { NECKV[1], NECKV[2], NECKV[3] }, Color = COW })
	k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { SKULL[4] * 2, SKULL[5] * 2, SKULL[6] * 2 }, Pos = { SKULL[1], SKULL[2], SKULL[3] }, Color = COW })
	k:Part({ Name = "Face", Shape = "Ellipsoid", Size = { FACE[4] * 2, FACE[5] * 2, FACE[6] * 2 }, Pos = { FACE[1], FACE[2], FACE[3] }, Color = COW })
	k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { MUZZLE[4] * 2, MUZZLE[5] * 2, MUZZLE[6] * 2 }, Pos = { MUZZLE[1], MUZZLE[2], MUZZLE[3] }, Color = PINK })
	capPatch(k, "MuzzleTop", MUZZLE, 0, 0.75, -0.65, 30, 0.9, PINK_LIGHT)

	-- Holstein patches (smooth caps hugging the head)
	capPatch(k, "EyePatch", SKULL, 0.52, 0.2, -0.83, 37, 0.86, PATCH)
	capPatch(k, "EyePatch2", SKULL, 0.85, 0.45, -0.35, 32, 0.86, PATCH)
	capPatch(k, "EyePatch3", FACE, 0.62, 0.45, -0.65, 22, 0.88, PATCH)
	capPatch(k, "CrownPatch", SKULL, -0.55, 0.62, 0.55, 30, 0.86, PATCH)
	capPatch(k, "BackPatch", SKULL, 0.35, 0.05, 1, 26, 0.86, PATCH)
	capPatch(k, "CheekSpot", FACE, -0.72, -0.1, -0.68, 17, 0.9, PATCH)
	capPatch(k, "ForeheadSpot", SKULL, -0.2, 0.7, -0.68, 11, 0.9, PATCH)

	-- forelock tuft between the horns
	local fringe = { { 0, 1, -0.42, 0.42, 0 }, { 0.3, 0.95, -0.3, 0.3, 35 }, { -0.28, 0.95, -0.34, 0.3, -30 }, { 0.08, 0.88, -0.62, 0.26, 12 } }
	for _, f in fringe do
		local fp, fn = surface(HEAD_VOLS, 0, 7.5, -0.3, f[1], f[2], f[3], -0.03)
		k:Part({ Name = "Fringe", Shape = "Ellipsoid", Size = { f[4], f[4] * 1.25, 0.13 }, Pos = fp, Rot = faceRot(fn[1], fn[2], fn[3], f[5]), Color = PATCH })
	end

	-- nostrils + muzzle freckles
	k:Mirror(function()
		local p, n = surface({ MUZZLE }, 0.3, 6.92, -1.3, 0.25, 0.12, -1, -0.025)
		k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.3, 0.19, 0.12 }, Pos = p, Rot = faceRot(n[1], n[2], n[3], -20), Color = NOSTRIL })
		local p2 = surface({ MUZZLE }, 0.3, 6.92, -1.3, 0.25, 0.12, -1, 0.0)
		k:Part({ Name = "NostrilHole", Shape = "Ellipsoid", Size = { 0.17, 0.1, 0.08 }, Pos = p2, Rot = faceRot(n[1], n[2], n[3], -20), Color = NOSTRIL_IN, Anim = { Type = "Pulse", Amount = 0.12, Speed = 0.5 } })
		local fr = { { 0.55, 0.05, -0.83 }, { 0.68, -0.2, -0.7 } }
		for _, f in fr do
			local fp, fn = surface({ MUZZLE }, 0, 6.84, -1.36, f[1], f[2], f[3], -0.012)
			k:Part({ Name = "Freckle", Shape = "Ellipsoid", Size = { 0.09, 0.09, 0.05 }, Pos = fp, Rot = faceRot(fn[1], fn[2], fn[3]), Color = PINK_DARK })
		end
		buildHorn(k)
	end)

	-- mouth seam + inside
	k:Part({ Name = "MouthInside", Shape = "Ellipsoid", Size = { 0.98, 0.2, 0.72 }, Pos = { 0, 6.52, -1.22 }, Color = MOUTH })
	-- content little smile wrapping round the bottom of the snout (corners curl up)
	local smile = {}
	for i = 0, 6 do
		local f = i / 3 - 1
		local phi = math.rad(f * 58)
		table.insert(smile, (surface({ MUZZLE }, 0, 6.62 + 0.1 * f * f, -1.3, math.sin(phi), -0.5 + 0.28 * f * f, -math.cos(phi), -0.015)))
	end
	for i = 1, 6 do
		segment(k, "Smile", smile[i], smile[i + 1], 0.06, MOUTH)
	end

	-- chewing jaw: hinge nods (X) while it grinds side to side (Y) like a real cow
	joint(k, "JawChew", JAW_HINGE, { Type = "Wiggle", Axis = "X", Amount = 6, Speed = 1.1 }, function()
		joint(k, "JawGrind", JAW_HINGE, { Type = "Wiggle", Axis = "Y", Amount = 5, Speed = 0.55, Phase = 0.3 }, function()
			k:Part({ Name = "Jaw", Shape = "Ellipsoid", Size = { JAW[4] * 2, JAW[5] * 2, JAW[6] * 2 }, Pos = { JAW[1], JAW[2], JAW[3] }, Color = PINK_LIGHT })
			-- tongue tip poking out of the corner of the chewing mouth
			k:Part({ Name = "Tongue", Shape = "Ellipsoid", Size = { 0.3, 0.11, 0.24 }, Pos = { 0.38, 6.43, -1.56 }, Rot = { 0, 25, -18 }, Color = TONGUE })
			k:Part({ Name = "ChinTuft", Shape = "Ellipsoid", Size = { 0.34, 0.14, 0.24 }, Pos = { 0, 6.21, -1.18 }, Color = COW_SHADE })
		end)
	end)

	-- eyes and ears
	buildEye(k, 1)
	buildEye(k, -1)
	buildEar(k, 1, 0, true)
	buildEar(k, -1, 0.37, false)

	buildCollar(k)
end

------------------------------------------------------------------------------------------
-- Tail (swishes from the back of the planet)
------------------------------------------------------------------------------------------
local function buildTail(k)
	-- springs from the lower back of the planet and hangs in a lazy S down to a black tuft
	local root = onPlanet(-6, 180, -0.08)
	local T1, T2 = { 0, 3.98, 2.42 }, { 0.03, 3.5, 2.56 }
	local T3 = { 0.06, 3.1, 2.48 }
	joint(k, "Tail", root, { Type = "Wiggle", Axis = "Z", Amount = 14, Speed = 0.6 }, function()
		k:Part({ Name = "TailRoot", Shape = "Ellipsoid", Size = { 0.34, 0.3, 0.22 }, Pos = root, Color = COW_SHADE })
		loft(k, "Tail", { { root[1], root[2], root[3], 0.12 }, { T1[1], T1[2], T1[3], 0.11 }, { T2[1], T2[2], T2[3], 0.1 } }, COW)
		-- a Holstein tail is white with a black band near the bottom
		joint(k, "TailTip", T2, { Type = "Wiggle", Axis = "Z", Amount = 18, Speed = 0.6, Phase = 0.2 }, function()
			loft(k, "Tail", { { T2[1], T2[2], T2[3], 0.1 }, { T3[1], T3[2], T3[3], 0.09 } }, COW)
			k:Part({ Name = "TailBand", Shape = "Ellipsoid", Size = { 0.2, 0.22, 0.2 }, Pos = { T3[1], T3[2] + 0.04, T3[3] }, Color = PATCH })
			-- swishy tuft: long hair locks fanning down from the tip
			local tuft = { { 0, 0, 0, 0, 0 }, { 0.08, 0.02, 0.03, 0, 14 }, { -0.08, 0.02, 0.03, 0, -14 }, { 0.02, 0.0, -0.08, -12, 4 }, { -0.03, 0.01, 0.09, 12, -6 } }
			for _, t in tuft do
				k:Part({
					Name = "TailTuft",
					Shape = "Ellipsoid",
					Size = { 0.18, 0.5, 0.18 },
					Pos = { T3[1] + t[1], T3[2] - 0.22 + t[2], T3[3] + t[3] },
					Rot = { t[4], 0, t[5] },
					Color = PATCH,
				})
			end
		end)
	end)
end

------------------------------------------------------------------------------------------
-- Bare human legs with big feet
------------------------------------------------------------------------------------------
local function buildFoot(k, s)
	local fx = s * 0.84
	k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 0.86, 0.5, 1.62 }, Pos = { fx, 0.25, -0.33 }, Color = SKIN })
	k:Part({ Name = "Instep", Shape = "Ellipsoid", Size = { 0.62, 0.42, 0.95 }, Pos = { fx - s * 0.02, 0.4, -0.22 }, Color = SKIN })
	k:Part({ Name = "Heel", Shape = "Ellipsoid", Size = { 0.6, 0.42, 0.5 }, Pos = { fx - s * 0.02, 0.21, 0.28 }, Color = SKIN_DARK })
	-- inner (big) toe -> little toe: {dx, z, diameter}
	local toes = { { -0.27, -1.12, 0.32 }, { -0.09, -1.14, 0.24 }, { 0.06, -1.09, 0.22 }, { 0.2, -1.01, 0.2 }, { 0.32, -0.9, 0.17 } }
	for i, t in toes do
		local d = t[3]
		local x = fx + s * t[1]
		k:Part({ Name = "Toe", Shape = "Ball", Size = { d, d, d }, Pos = { x, d / 2, t[2] }, Color = if i == 1 then SKIN else SKIN_LIGHT })
		k:Part({ Name = "ToeNail", Shape = "Ellipsoid", Size = { d * 0.6, math.max(0.05, d * 0.22), d * 0.5 }, Pos = { x, d * 0.86, t[2] - d * 0.17 }, Rot = { 20, 0, 0 }, Color = NAIL })
	end
end

local function buildLeg(k, s)
	-- hip (hidden inside the planet) -> thigh -> knee -> calf -> ankle, slight knock-knee
	loft(k, "Leg", {
		{ s * 0.7, 3.25, 0.0, 0.37 },
		{ s * 0.75, 2.4, -0.02, 0.35 },
		{ s * 0.78, 1.58, -0.04, 0.255 },
		{ s * 0.8, 0.98, 0.01, 0.235 },
		{ s * 0.8, 0.56, 0.05, 0.16 },
	}, SKIN)
	-- soft secondary forms (same skin tone so the leg stays one smooth piece)
	k:Part({ Name = "KneeCap", Shape = "Ellipsoid", Size = { 0.28, 0.32, 0.18 }, Pos = { s * 0.78, 1.56, -0.22 }, Color = SKIN })
	k:Part({ Name = "KneeCrease", Shape = "Ellipsoid", Size = { 0.28, 0.05, 0.08 }, Pos = { s * 0.78, 1.55, 0.2 }, Color = SKIN_DARK })
	k:Part({ Name = "Calf", Shape = "Ellipsoid", Size = { 0.44, 0.8, 0.4 }, Pos = { s * 0.8, 1.14, 0.07 }, Rot = { -4, 0, 0 }, Color = SKIN })
	k:Part({ Name = "Achilles", Shape = "Ellipsoid", Size = { 0.18, 0.56, 0.18 }, Pos = { s * 0.8, 0.62, 0.14 }, Color = SKIN })
	k:Part({ Name = "AnkleBone", Shape = "Ellipsoid", Size = { 0.08, 0.13, 0.13 }, Pos = { s * 0.95, 0.5, 0.05 }, Color = SKIN })
	k:Part({ Name = "AnkleBone", Shape = "Ellipsoid", Size = { 0.08, 0.13, 0.13 }, Pos = { s * 0.65, 0.54, 0.05 }, Color = SKIN })
	if s > 0 then
		-- the right foot taps along to the music of the spheres (pivot behind the heel,
		-- pre-tilted so the toes only ever lift, never dig into the ground)
		joint(k, "FootTap", { s * 0.84, 0.0, 0.56 }, { Type = "Wiggle", Axis = "X", Amount = 5, Speed = 0.9 }, function()
			buildFoot(k, s)
		end, { 5, 0, 0 })
	else
		buildFoot(k, s)
	end
end

return {
	Id = "LaVaccaSaturnoSaturnita",
	Name = "La Vacca Saturno Saturnita",
	Rarity = "Secret",
	Emoji = "🐄",
	Color = "#e29b5c",
	Tagline = "Half cow, half planet, fully in orbit. Mooo-n!",
	Lore = "One night a cow jumped over the moon, overshot, and landed on Saturn. Now she IS Saturn: rings, moons and all, chewing cud at the edge of the galaxy on two very human feet. Her milk comes from the Milky Way.",

	Build = function(k)
		buildLeg(k, 1)
		buildLeg(k, -1)

		-- the whole planet sways gently on the hips
		joint(k, "Body", HIP, { Type = "Wiggle", Axis = "Z", Amount = 1.6, Speed = 0.35 }, function()
			buildPlanet(k)
			buildTail(k)

			-- rings + moons in the tilted ring frame
			k:Group({ Name = "RingFrame", Pos = PC, Rot = RING_ROT }, function()
				-- the whole ring system wobbles a touch like a lazy hula hoop
				k:Group({ Name = "RingWobble", Anim = { Type = "Wiggle", Axis = "Z", Amount = 2.5, Speed = 0.25, Phase = 0.4 } }, function()
					k:Group({ Name = "RingSpin", Anim = { Type = "Spin", Axis = "Y", Speed = 0.1 } }, function()
						buildRings(k)
					end)
					moon(k, "MoonA", 2.55, 0.6, 0.56, "#c9c6cf", "Slate", "#9d98a6", 0.16, 0.1)
					moon(k, "MoonB", 2.65, -0.58, 0.46, "#e8c56a", "Foil", "#c79b3c", 0.11, 0.55)
					moon(k, "MoonC", 2.5, 0.45, 0.34, "#b7c9ff", "Glass", "#8aa0e0", 0.22, 0.8)
				end)
			end)

			-- head nods on the neck
			joint(k, "Head", NECK, { Type = "Wiggle", Axis = "X", Amount = 4, Speed = 0.45, Phase = 0.2 }, function()
				-- the head is modelled at 1:1 and scaled up around the neck as one unit
				k:Group({ Name = "HeadScale", Pos = { NECK[1] * (1 - HEAD_SCALE), NECK[2] * (1 - HEAD_SCALE), NECK[3] * (1 - HEAD_SCALE) } }, function()
					buildHead(scaled(k, HEAD_SCALE))
				end)
			end)

			-- slow halo of twinkling stars around the head
			k:Group({ Name = "StarHalo", Pos = { 0, 8.25, -0.2 }, Anim = { Type = "Spin", Axis = "Y", Speed = 0.07 } }, function()
				local halo = { { 30, 0.35, 0.5 }, { 120, -0.1, 0.38 }, { 210, 0.5, 0.45 }, { 300, 0.05, 0.36 } }
				for i, h in halo do
					local a = math.rad(h[1])
					star(k, "HaloStar", { 2.35 * math.cos(a), h[2], 2.35 * math.sin(a) }, h[3], if i % 2 == 0 then STAR_BLUE else STAR, i * 0.27, 0.7)
				end
			end)
		end)

		k:Light({ Pos = { 0, 7.6, -2.2 }, Color = "#ffe6c2", Range = 10, Brightness = 1 })
		k:Light({ Pos = { 0, 4.2, -2.9 }, Color = "#9fc8ff", Range = 9, Brightness = 0.9 })
		k:Particles({ Pos = PC, Color = "#ffffff", Color2 = "#a9d4ff", Rate = 6, Size = 0.16, Speed = 0.5, Lifetime = 2.5, Spread = 180 })
		k:Particles({ Pos = { 0, 8.9, -0.3 }, Color = "#fff3b0", Color2 = "#ffffff", Rate = 3, Size = 0.24, Speed = 0.8, Lifetime = 1.6, Spread = 60, Direction = "Top" })
		k:Particles({ Pos = { 0, 0.25, 0 }, Color = "#b9a8ff", Color2 = "#6fb6ff", Rate = 4, Size = 0.3, Speed = 0.6, Lifetime = 1.8, Spread = 90, Direction = "Top" })
	end,

	BuildMini = function(k)
		-- Saturn body: beige planet in a tilted pale-blue ring (the game's blue / beige / white)
		k:Part({ Name = "Planet", Shape = "Ball", Size = { 1.3, 1.3, 1.3 }, Pos = { 0, -0.2, 0 }, Color = "#e7c48f" })
		k:Part({ Name = "Ring", Shape = "Cylinder", Size = { 0.07, 2.6, 2.6 }, Pos = { 0, -0.2, 0 }, Rot = { -22, 0, 75 }, Color = RING_B[1] })
		-- Holstein cow head: white, black spot, pink snout, ears, two eyes, ivory horns
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 0.92, 0.78, 0.84 }, Pos = { 0, 0.68, -0.12 }, Color = COW })
		k:Part({ Name = "Ears", Shape = "Ellipsoid", Size = { 1.5, 0.24, 0.3 }, Pos = { 0, 0.8, -0.06 }, Color = COW_SHADE })
		k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { 0.7, 0.42, 0.42 }, Pos = { 0, 0.5, -0.5 }, Color = PINK })
		k:Part({ Name = "Patch", Shape = "Ellipsoid", Size = { 0.4, 0.36, 0.34 }, Pos = { 0.3, 0.94, -0.28 }, Color = PATCH })
		k:Mirror(function()
			k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.17, 0.17, 0.17 }, Pos = { 0.19, 0.8, -0.48 }, Color = PUPIL })
			k:Part({ Name = "Horn", Shape = "Ellipsoid", Size = { 0.13, 0.38, 0.13 }, Pos = { 0.31, 1.1, -0.12 }, Rot = { 0, 0, -32 }, Color = HORN })
			k:Part({ Name = "Leg", Shape = "Cylinder", Size = { 0.62, 0.2, 0.2 }, Pos = { 0.25, -0.98, -0.04 }, Rot = { 0, 0, 90 }, Color = SKIN })
		end)
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">LiriliLarila</string>
            <string name="Source"><![CDATA[--[[
	Lirilì Larilà (Common)
	The desert elephant-cactus: a big blue-grey elephant head with floppy pink-lined ears,
	a long wrinkled trunk with a pink tip and two little tusks, sitting on a fluted green
	saguaro body bristling with pale spines. Two stubby grey elephant legs stand in
	oversized brown leather sandals. A golden pocket watch dangles from its right cactus
	arm - it can stop time - and a pink saguaro blossom sits on the left arm.

	Faces -Z. Feet on y = 0. Built only through the CharacterKit builder `k`.
]]

-- Palette ------------------------------------------------------------------------------
local GREY = "#8a96a8" -- elephant skin (blue-grey, like the meme)
local GREY_D = "#646f82" -- lids, brows
local GREY_W = "#77839a" -- soft skin wrinkles
local PINK = "#f0a3b1" -- inner ears, trunk tip
local LIP = "#b98892" -- lower lip under the trunk
local IVORY = "#f4ead4" -- tusks, toenails
local CACTUS = "#58a844" -- cactus ribs and arms (dominant green)
local CACTUS_D = "#3d8433" -- cactus grooves / core
local SPINE = "#fff3c8" -- warm white-yellow spines
local LEATHER = "#a5692f" -- sandal straps
local LEATHER_M = "#7f4c22" -- ankle straps
local LEATHER_D = "#5a3517" -- sandal soles
local GOLD = "#e3b94c" -- pocket watch
local CLOCKFACE = "#fff8ec"
local INK = "#1e1a24"
local EYE_W = "#fff8ec"
local FLOWER = "#ff7fb2"
local FLOWER_C = "#ffd34d"

local UP = { 0, 0, 90 } -- rotation that stands a Cylinder upright (axis along Y)
local FWD = { 0, 90, 0 } -- rotation that points a Cylinder along Z (faces front)

-- A spine rod pushed straight through a round body: ONE part gives TWO spines, poking out
-- at angle theta and at theta + 180 (theta in degrees around Y, from the front (-Z) towards
-- +X). r = surface radius at that height, tilt = how far the theta end points upward.
local function spineRod(k, cx, y, cz, r, theta, tilt, stick)
	k:Part({
		Name = "Spines",
		Shape = "Cylinder",
		Size = { 2 * r + 2 * (stick or 0.3), 0.07, 0.07 },
		Pos = { cx, y, cz },
		Rot = { 0, 90 - theta, tilt or 0 },
		Color = SPINE,
	})
end

-- Saguaro body: 10 fluted ribs around a darker core.
local RIBS = 10
local RIB_R, RIB_W, RIB_H, RIB_Y = 0.9, 0.62, 5.0, 4.4
local function ribAngle(i)
	return i * (360 / RIBS) + 18
end
-- radius of the rib ridge at height y (ribs are ellipsoids, so they taper top and bottom)
local function ribSurface(y)
	local dy = (y - RIB_Y) / (RIB_H * 0.5)
	return RIB_R + RIB_W * 0.5 * math.sqrt(math.max(0, 1 - dy * dy))
end
-- Spine rods: { rib index 0..4 (the rod also exits on rib +5), height, tilt }.
-- Front ribs (0 and 9) stay below the trunk; side ribs (2 and 7) stay clear of the arms.
local BODY_SPINES = {
	{ 0, 2.45, 14 }, -- front-right  / back-left
	{ 0, 3.35, -12 },
	{ 4, 2.95, -14 }, -- back-right  / front-left
	{ 1, 2.3, 10 }, -- right-front  / left-back
	{ 1, 4.55, -10 },
	{ 3, 3.95, 12 }, -- right-back   / left-front
	{ 3, 5.35, -12 },
	{ 2, 2.35, 8 }, -- right side   / left side
	{ 2, 5.15, -8 },
	{ 1, 3.45, 14 },
	{ 4, 4.15, 10 },
}

-- One saguaro arm. side = 1 (+X, right) or -1 (-X, left). `extra` builds props in arm space.
local ARM_ROOT = 0.85
local ARM_REACH = 1.35
local ARM_D = 0.82
local function cactusArm(k, side, name, y, up, phase, extra)
	k:Group({
		Name = name,
		Pos = { ARM_ROOT * side, y, 0.05 },
		Anim = { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = 0.35, Phase = phase },
	}, function()
		k:Part({ Name = "ArmBranch", Shape = "Cylinder", Size = { ARM_REACH, ARM_D, ARM_D }, Pos = { ARM_REACH * 0.5 * side, 0, 0 }, Color = CACTUS })
		k:Part({ Name = "ArmElbow", Shape = "Ball", Size = { ARM_D, ARM_D, ARM_D }, Pos = { ARM_REACH * side, 0, 0 }, Color = CACTUS })
		k:Part({ Name = "ArmUpright", Shape = "Cylinder", Size = { up, ARM_D, ARM_D }, Pos = { ARM_REACH * side, up * 0.5, 0 }, Rot = UP, Color = CACTUS })
		k:Part({ Name = "ArmTip", Shape = "Ball", Size = { ARM_D, ARM_D, ARM_D }, Pos = { ARM_REACH * side, up, 0 }, Color = CACTUS })
		-- spine rods: front/back + outer/inner of the upright, top/bottom of the branch
		spineRod(k, ARM_REACH * side, up * 0.55, 0, ARM_D * 0.5, 25 * side, 14, 0.22)
		k:Part({ Name = "Spines", Shape = "Cylinder", Size = { ARM_D + 0.44, 0.07, 0.07 }, Pos = { ARM_REACH * 0.5 * side, 0, -0.08 }, Rot = { 0, 0, 90 - 18 * side }, Color = SPINE })
		if extra then
			extra(up)
		end
	end)
end

-- Golden pocket watch hanging on a chain (built in the right arm's space, under the elbow).
local function pocketWatch(k)
	k:Group({
		Name = "PocketWatch",
		Pos = { ARM_REACH, -ARM_D * 0.5 + 0.02, -0.02 },
		Anim = { Type = "Wiggle", Axis = "Z", Amount = 9, Speed = 0.5 },
	}, function()
		local R = 0.72 -- case radius
		local cy = -0.46 - R -- watch centre
		k:Part({ Name = "WatchBow", Shape = "Cylinder", Size = { 0.09, 0.4, 0.4 }, Pos = { 0, -0.16, 0 }, Rot = FWD, Color = GOLD, Material = "Metal" })
		k:Part({ Name = "WatchCrown", Shape = "Cylinder", Size = { 0.18, 0.22, 0.22 }, Pos = { 0, cy + R + 0.06, 0 }, Rot = UP, Color = GOLD, Material = "Metal" })
		k:Part({ Name = "WatchCase", Shape = "Cylinder", Size = { 0.3, R * 2, R * 2 }, Pos = { 0, cy, 0 }, Rot = FWD, Color = GOLD, Material = "Foil" })
		k:Part({ Name = "WatchFace", Shape = "Cylinder", Size = { 0.05, R * 1.7, R * 1.7 }, Pos = { 0, cy, -0.15 }, Rot = FWD, Color = CLOCKFACE })
		-- 12 hour ticks from 6 bars through the centre; an inner disc hides their middles.
		-- 12/3/6/9 are longer and bolder.
		for i = 0, 5 do
			local major = i % 3 == 0
			k:Part({
				Name = "Ticks",
				Size = { if major then 0.09 else 0.06, if major then 1.1 else 0.98, 0.05 },
				Pos = { 0, cy, -0.18 },
				Rot = { 0, 0, i * 30 },
				Color = INK,
			})
		end
		k:Part({ Name = "WatchDial", Shape = "Cylinder", Size = { 0.05, 0.8, 0.8 }, Pos = { 0, cy, -0.2 }, Rot = FWD, Color = CLOCKFACE })
		-- the hands spin: time is bending
		k:Group({ Name = "MinuteHand", Pos = { 0, cy, -0.24 }, Anim = { Type = "Spin", Axis = "Z", Speed = 0.45 } }, function()
			k:Part({ Name = "MinuteHand", Size = { 0.06, 0.48, 0.05 }, Pos = { 0, 0.2, 0 }, Color = INK })
		end)
		k:Group({ Name = "HourHand", Pos = { 0, cy, -0.265 }, Anim = { Type = "Spin", Axis = "Z", Speed = 0.07, Phase = 0.3 } }, function()
			k:Part({ Name = "HourHand", Size = { 0.1, 0.32, 0.05 }, Pos = { 0, 0.11, 0 }, Color = INK })
		end)
		k:Part({ Name = "HandCap", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = { 0, cy, -0.29 }, Color = GOLD, Material = "Metal" })
	end)
end

-- A small pink saguaro blossom (on the left arm tip): two crossed petal discs + a heart.
local function blossom(k, x, y, z)
	for i = 0, 1 do
		k:Part({ Name = "Petals", Shape = "Ellipsoid", Size = { 0.62, 0.16, 0.28 }, Pos = { x, y, z }, Rot = { 0, 45 + i * 90, 0 }, Color = FLOWER })
	end
	k:Part({ Name = "FlowerHeart", Shape = "Ball", Size = { 0.2, 0.2, 0.2 }, Pos = { x, y + 0.07, z }, Color = FLOWER_C, Anim = { Type = "Pulse", Amount = 0.12, Speed = 0.6 } })
end

-- Trunk: a chain of nested segments. Each group rotates about X to curl the trunk forward.
-- It hangs long and straight, then curls forward and up at the end (a J).
local TRUNK = {
	{ len = 0.62, d = 0.86, rot = 8, ring = true },
	{ len = 0.62, d = 0.76, rot = 3 },
	{ len = 0.56, d = 0.67, rot = 5, ring = true },
	{ len = 0.48, d = 0.58, rot = 22 },
	{ len = 0.4, d = 0.5, rot = 55 },
}
local function trunkSegment(k, i, offset)
	local s = TRUNK[i]
	local anim = nil
	if i == 1 then
		anim = { Type = "Wiggle", Axis = "Z", Amount = 7, Speed = 0.4 }
	elseif i == 4 then
		anim = { Type = "Wiggle", Axis = "X", Amount = 10, Speed = 0.5, Phase = 0.25 }
	end
	k:Group({ Name = "Trunk" .. i, Pos = { 0, -offset, 0 }, Rot = { s.rot, 0, 0 }, Anim = anim }, function()
		k:Part({ Name = "TrunkSeg", Shape = "Ellipsoid", Size = { s.d, s.len * 1.9, s.d }, Pos = { 0, -s.len * 0.5, 0 }, Color = GREY })
		if s.ring then
			k:Part({ Name = "TrunkWrinkle", Shape = "Cylinder", Size = { 0.06, s.d + 0.02, s.d + 0.02 }, Pos = { 0, -s.len * 0.5, 0 }, Rot = UP, Color = GREY_W })
		end
		if i < #TRUNK then
			trunkSegment(k, i + 1, s.len)
		else
			-- pink tip with a nostril
			k:Part({ Name = "TrunkTip", Shape = "Ellipsoid", Size = { s.d + 0.06, 0.26, s.d + 0.06 }, Pos = { 0, -s.len - 0.02, 0 }, Color = PINK })
			k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.22, 0.06, 0.15 }, Pos = { 0, -s.len - 0.13, 0 }, Color = INK })
		end
	end)
end

return {
	Id = "LiriliLarila",
	Name = "Lirilì Larilà",
	Rarity = "Common",
	Emoji = "🌵",
	Color = "#58a844",
	Tagline = "Tick tock. Lirilì Larilà stopped your time.",
	Lore = "Half elephant, half cactus, fully in sandals. It wanders the desert with a golden pocket watch and can freeze time whenever it feels like a nap. Do not hug it.",

	Build = function(k)
		-------------------------------------------------------------------- legs + sandals
		k:Mirror(function()
			local x, z = 0.66, -0.05
			-- oversized leather sole: a rounded toe in front of a long heel slab
			k:Part({ Name = "SandalSole", Size = { 1.32, 0.28, 1.25 }, Pos = { x, 0.14, z + 0.27 }, Color = LEATHER_D, Material = "Leather" })
			k:Part({ Name = "SandalToe", Shape = "Cylinder", Size = { 0.28, 1.32, 1.32 }, Pos = { x, 0.14, z - 0.35 }, Rot = UP, Color = LEATHER_D, Material = "Leather" })
			-- round elephant foot (a dome that flows into the leg) and a stumpy leg column
			k:Part({ Name = "Foot", Shape = "Ellipsoid", Size = { 1.22, 1.0, 1.24 }, Pos = { x, 0.5, z - 0.02 }, Color = GREY })
			k:Part({ Name = "Leg", Shape = "Cylinder", Size = { 1.5, 1.05, 1.05 }, Pos = { x, 1.45, z + 0.02 }, Rot = UP, Color = GREY })
			-- three ivory toenails resting on the sole
			for _, th in { -40, 0, 40 } do
				local a = math.rad(th)
				k:Part({ Name = "Toenail", Shape = "Ellipsoid", Size = { 0.3, 0.26, 0.16 }, Pos = { x + math.sin(a) * 0.59, 0.42, z - math.cos(a) * 0.59 }, Rot = { 0, -th, 0 }, Color = IVORY })
			end
			-- straps: a slanted band over the foot (low over the toes, high at the heel),
			-- a thin ankle band and a heel strap joining it to the sole
			k:Part({ Name = "ToeStrap", Shape = "Cylinder", Size = { 0.24, 1.27, 1.27 }, Pos = { x, 0.72, z - 0.02 }, Rot = { -20, 0, 90 }, Color = LEATHER, Material = "Leather" })
			k:Part({ Name = "AnkleStrap", Shape = "Cylinder", Size = { 0.16, 1.11, 1.11 }, Pos = { x, 1.22, z + 0.02 }, Rot = UP, Color = LEATHER_M, Material = "Leather" })
			k:Part({ Name = "HeelStrap", Size = { 0.32, 1.0, 0.14 }, Pos = { x, 0.75, z + 0.58 }, Color = LEATHER_M, Material = "Leather" })
		end)

		-------------------------------------------------------------------- cactus body
		k:Group({ Name = "Body", Anim = { Type = "Bob", Axis = "Y", Amount = 0.05, Speed = 0.45 } }, function()
			-- rounded bottom (a little wider at the hips): the rib tips and leg tops hide inside it
			k:Part({ Name = "CactusBase", Shape = "Ellipsoid", Size = { 2.5, 1.0, 2.2 }, Pos = { 0, 2.1, 0 }, Color = CACTUS })
			k:Part({ Name = "CactusCore", Shape = "Cylinder", Size = { 4.4, 2.0, 2.0 }, Pos = { 0, 4.4, 0 }, Rot = UP, Color = CACTUS_D })
			for i = 0, RIBS - 1 do
				local a = math.rad(ribAngle(i))
				k:Part({ Name = "Rib", Shape = "Ellipsoid", Size = { RIB_W, RIB_H, RIB_W }, Pos = { math.sin(a) * RIB_R, RIB_Y, -math.cos(a) * RIB_R }, Color = CACTUS })
			end
			for _, s in BODY_SPINES do
				spineRod(k, 0, s[2], 0, ribSurface(s[2]), ribAngle(s[1]), s[3])
			end

			-------------------------------------------------------------- arms
			cactusArm(k, -1, "LeftArm", 3.7, 1.2, 0.5, function(up)
				blossom(k, -ARM_REACH, up + ARM_D * 0.5, 0)
			end)
			cactusArm(k, 1, "RightArm", 3.25, 1.2, 0, function()
				pocketWatch(k)
			end)

			-------------------------------------------------------------- elephant head
			k:Group({ Name = "Head", Pos = { 0, 5.85, -0.05 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = 0.3 } }, function()
				k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { 2.8, 2.6, 2.5 }, Pos = { 0, 1.28, 0 }, Color = GREY })
				k:Part({ Name = "Snout", Shape = "Ellipsoid", Size = { 1.35, 1.75, 1.1 }, Pos = { 0, 0.78, -1.0 }, Color = GREY })
				-- deadpan little mouth: a soft lower lip peeking out under the trunk
				k:Part({ Name = "LowerLip", Shape = "Ellipsoid", Size = { 1.2, 0.3, 0.62 }, Pos = { 0, 0.02, -1.0 }, Rot = { -8, 0, 0 }, Color = LIP })

				k:Mirror(function()
					-- droopy, deadpan eyes (white + pupil + highlight blink; heavy lid stays)
					local ex, ey, ez, yaw = 0.74, 1.36, -1.0, -29
					local blink = { Type = "Blink", Speed = 0.22 }
					k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.6, 0.55, 0.3 }, Pos = { ex, ey, ez }, Rot = { 0, yaw, 0 }, Color = EYE_W, Anim = blink })
					k:Part({ Name = "Pupil", Shape = "Ball", Size = { 0.28, 0.28, 0.28 }, Pos = { ex - 0.04, ey - 0.06, ez - 0.09 }, Color = INK, Anim = blink })
					k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.09, 0.09, 0.09 }, Pos = { ex - 0.08, ey - 0.0, ez - 0.22 }, Color = EYE_W, Anim = blink })
					k:Part({ Name = "EyeLid", Shape = "Ellipsoid", Size = { 0.68, 0.34, 0.36 }, Pos = { ex, ey + 0.16, ez - 0.01 }, Rot = { 0, yaw, -10 }, Color = GREY_D })
					k:Part({ Name = "Brow", Shape = "Ellipsoid", Size = { 0.64, 0.13, 0.16 }, Pos = { ex - 0.02, ey + 0.4, ez + 0.03 }, Rot = { 0, yaw, -7 }, Color = GREY_D })

					-- small ivory tusks beside the mouth
					k:Part({ Name = "Tusk", Shape = "Ellipsoid", Size = { 0.18, 0.62, 0.18 }, Pos = { 0.47, 0.06, -1.16 }, Rot = { 40, 0, 12 }, Color = IVORY })

					-- big floppy ears with pink insides and a droopy lower lobe (flap at the root)
					k:Group({ Name = "Ear", Pos = { 1.08, 1.4, 0.2 }, Rot = { 0, -22, -8 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 12, Speed = 0.5 } }, function()
						k:Part({ Name = "EarOuter", Shape = "Ellipsoid", Size = { 2.15, 2.75, 0.22 }, Pos = { 0.9, -0.45, 0 }, Rot = { 0, 0, 10 }, Color = GREY })
						k:Part({ Name = "EarInner", Shape = "Ellipsoid", Size = { 1.62, 2.2, 0.1 }, Pos = { 0.92, -0.5, -0.08 }, Rot = { 0, 0, 10 }, Color = PINK })
					end)
				end)

				-- the long curling trunk
				k:Group({ Name = "TrunkRoot", Pos = { 0, 0.42, -1.32 } }, function()
					trunkSegment(k, 1, 0)
				end)
			end)
		end)
	end,

	BuildMini = function(k)
		-- saguaro column standing in big sandals, elephant head on top
		k:Part({ Name = "Sandals", Size = { 1.12, 0.18, 0.9 }, Pos = { 0, -1.17, -0.14 }, Color = LEATHER_D })
		k:Part({ Name = "Body", Shape = "Cylinder", Size = { 1.5, 0.92, 0.92 }, Pos = { 0, -0.36, 0 }, Rot = UP, Color = CACTUS })
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 1.15, 1.02, 1.0 }, Pos = { 0, 0.64, 0 }, Color = GREY })
		k:Part({ Name = "Trunk", Shape = "Ellipsoid", Size = { 0.3, 0.86, 0.3 }, Pos = { 0, 0.18, -0.58 }, Rot = { 22, 0, 0 }, Color = GREY })
		k:Mirror(function()
			k:Part({ Name = "Ear", Shape = "Ellipsoid", Size = { 0.78, 1.0, 0.14 }, Pos = { 0.8, 0.58, 0.06 }, Rot = { 0, -15, -8 }, Color = GREY })
			k:Part({ Name = "Eye", Shape = "Ball", Size = { 0.16, 0.16, 0.16 }, Pos = { 0.27, 0.78, -0.45 }, Color = INK })
			-- L-shaped saguaro arm: a short branch out of the body, then a rounded upright
			k:Part({ Name = "ArmBranch", Shape = "Cylinder", Size = { 0.39, 0.28, 0.28 }, Pos = { 0.545, -0.52, 0 }, Color = CACTUS })
			k:Part({ Name = "ArmUpright", Shape = "Ellipsoid", Size = { 0.34, 0.82, 0.34 }, Pos = { 0.77, -0.28, 0 }, Color = CACTUS })
		end)
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">TralaleroTralala</string>
            <string name="Source"><![CDATA[--[[
	Tralalero Tralala (Mythic)
	The original Italian brainrot: a blue-grey great white shark with a white belly, gill
	slits, big dorsal + pectoral fins and a crescent tail, grinning with rows of sharp teeth,
	standing on THREE shark-skinned legs (two front, one rear) in blue sneakers with white
	soles, white laces and a plain side stripe (no brand logo).
	Mythic flair: glowing water splash ring at its feet, orbiting bubbles, two lights and
	three particle emitters - none of it changes the canonical shark-in-sneakers design.

	Faces -Z (snout points to -Z), feet on y = 0.
]]

-- Palette ------------------------------------------------------------------------------
local SHARK = "#5a83aa" -- blue-grey top
local SHARK_DARK = "#3e6085" -- fin tips, brows
local SHARK_DEEP = "#24364a" -- gill slits, nostrils
local SHARK_MID = "#83a3c2" -- highlights, gill lips
local BELLY = "#eef3f3" -- white underside
local BELLY_SHADE = "#d3dee5"
local LEG = "#6889ab"
local LEG_LIGHT = "#7b9aba"
local MOUTH = "#6e1a2a"
local GUM = "#e07a8a"
local TONGUE = "#c24a5e"
local TOOTH = "#fffaf0"
local EYE = "#14151c"
local SHINE = "#fdfdf7"
local SHOE = "#2f6fe8"
local SHOE_DARK = "#1c4bb0"
local SHOE_LIGHT = "#5d95ff"
local SOLE = "#f7f6f1"
local OUTSOLE = "#283a5e"
local LACE = "#fbfbf6"
local SOCK = "#f4f3ee"
local WATER = "#8fe6ff"
local WATER_DEEP = "#3aa8e0"
local WATER_GLOW = "#46d8ff"

local sin, cos, sqrt, rad, deg = math.sin, math.cos, math.sqrt, math.rad, math.deg

local RUN = 0.9 -- running-in-place cycles per second

local function norm(x, y, z)
	local l = sqrt(x * x + y * y + z * z)
	return x / l, y / l, z / l
end

-- Rotation that turns a part's -Z (front) face toward normal n, then spins it about n.
local function faceRot(nx, ny, nz, spin)
	nx, ny, nz = norm(nx, ny, nz)
	return { deg(math.atan2(ny, -nz)), deg(math.asin(-nx)), spin or 0 }
end

-- Point + outward normal on an ellipsoid (centre c, full size s) along direction d.
local function onEllipsoid(c, s, dx, dy, dz)
	local ax, ay, az = s[1] / 2, s[2] / 2, s[3] / 2
	local ux, uy, uz = norm(dx, dy, dz)
	local px, py, pz = ux * ax, uy * ay, uz * az
	local nx, ny, nz = norm(px / (ax * ax), py / (ay * ay), pz / (az * az))
	return { c[1] + px, c[2] + py, c[3] + pz }, { nx, ny, nz }
end

local function offset(p, n, d)
	return { p[1] + n[1] * d, p[2] + n[2] * d, p[3] + n[3] * d }
end

-- Main shark forms (shark-local coordinates; the Shark group origin sits at world y = 4.36)
local TORSO_C, TORSO_S = { 0, 0, -0.35 }, { 2.4, 2.65, 3.8 }
local CRANIUM_C, CRANIUM_S = { 0, 0.36, -1.6 }, { 2.15, 1.65, 2.75 } -- long cranium = smooth conical snout

-- Mouth layout
local MOUTH_Z = -1.85 -- centre of the mouth arcs
local UGUM_Y, LGUM_Y = -0.17, -0.5 -- gum centres (lower one is relative to shark, built in jaw frame)
local GUM_SX, GUM_SZ, GUM_SY = 1.56, 1.66, 0.28

return {
	Id = "TralaleroTralala",
	Name = "Tralalero Tralala",
	Rarity = "Mythic",
	Emoji = "🦈",
	Color = "#3f8fe8",
	Tagline = "Three legs, one shark, zero chill. Tralalero tralala!",
	Lore = "The original brainrot: a great white shark that traded its fins for three legs and a set of fresh blue sneakers. It sprints across the seabed faster than a jet ski and leaves a splash ring wherever it stands. Nobody has ever seen it tie its laces.",

	Build = function(k)
		----------------------------------------------------------------------------------
		-- helpers that need k
		----------------------------------------------------------------------------------
		-- A row of triangular teeth along the mouth arc (diamond blocks half-hidden in the gum)
		local function teethRow(name, count, y, cz, sx, sz, size, phiMax, inset)
			for i = 0, count - 1 do
				local t = if count == 1 then 0.5 else i / (count - 1)
				local phi = rad(-phiMax + 2 * phiMax * t)
				local ax, az = sx / 2 - inset, sz / 2 - inset
				local px, pz = ax * sin(phi), cz - az * cos(phi)
				local nx, nz = sin(phi) / ax, -cos(phi) / az
				local s = size * (1 - 0.35 * math.abs(sin(phi)))
				k:Part({
					Name = name,
					Size = { s, s, 0.05 },
					Pos = { px, y, pz },
					Rot = faceRot(nx, 0, nz, 45),
					Color = TOOTH,
				})
			end
		end

		-- A sneaker part in "shoe space" (y = 0 is the ground, toe points -Z), scaled by SHOE_S.
		local SHOE_S = 1.25
		local function shoePart(spec)
			local sz, ps = spec.Size, spec.Pos
			spec.Size = { sz[1] * SHOE_S, sz[2] * SHOE_S, sz[3] * SHOE_S }
			spec.Pos = { ps[1] * SHOE_S, ps[2] * SHOE_S, ps[3] * SHOE_S }
			k:Part(spec)
		end

		local function sneaker(name)
			-- rubber outsole + white midsole, rounded at toe and heel
			shoePart({ Name = name .. "Outsole", Size = { 0.62, 0.07, 0.92 }, Pos = { 0, 0.035, -0.12 }, Color = OUTSOLE, Material = "Rubber" })
			shoePart({ Name = name .. "OutsoleToe", Shape = "Cylinder", Size = { 0.07, 0.62, 0.62 }, Pos = { 0, 0.035, -0.58 }, Rot = { 0, 0, 90 }, Color = OUTSOLE, Material = "Rubber" })
			shoePart({ Name = name .. "OutsoleHeel", Shape = "Cylinder", Size = { 0.07, 0.62, 0.62 }, Pos = { 0, 0.035, 0.34 }, Rot = { 0, 0, 90 }, Color = OUTSOLE, Material = "Rubber" })
			shoePart({ Name = name .. "Midsole", Size = { 0.64, 0.17, 0.92 }, Pos = { 0, 0.15, -0.12 }, Color = SOLE })
			shoePart({ Name = name .. "MidsoleToe", Shape = "Cylinder", Size = { 0.17, 0.64, 0.64 }, Pos = { 0, 0.15, -0.58 }, Rot = { 0, 0, 90 }, Color = SOLE })
			shoePart({ Name = name .. "MidsoleHeel", Shape = "Cylinder", Size = { 0.17, 0.64, 0.64 }, Pos = { 0, 0.15, 0.34 }, Rot = { 0, 0, 90 }, Color = SOLE })
			-- blue upper
			shoePart({ Name = name .. "Upper", Shape = "Ellipsoid", Size = { 0.6, 0.56, 1.12 }, Pos = { 0, 0.32, -0.1 }, Color = SHOE, Material = "Fabric" })
			shoePart({ Name = name .. "ToeBox", Shape = "Ellipsoid", Size = { 0.6, 0.38, 0.62 }, Pos = { 0, 0.25, -0.55 }, Color = SHOE, Material = "Fabric" })
			shoePart({ Name = name .. "ToeBumper", Shape = "Ellipsoid", Size = { 0.62, 0.17, 0.32 }, Pos = { 0, 0.2, -0.79 }, Color = SOLE })
			shoePart({ Name = name .. "HeelCounter", Shape = "Ellipsoid", Size = { 0.6, 0.44, 0.38 }, Pos = { 0, 0.39, 0.3 }, Color = SHOE_DARK, Material = "Leather" })
			shoePart({ Name = name .. "Collar", Shape = "Cylinder", Size = { 0.12, 0.5, 0.5 }, Pos = { 0, 0.57, 0.06 }, Rot = { 0, 0, 90 }, Color = SHOE_DARK })
			shoePart({ Name = name .. "Tongue", Size = { 0.28, 0.36, 0.08 }, Pos = { 0, 0.55, -0.2 }, Rot = { -18, 0, 0 }, Color = SHOE_LIGHT, Material = "Fabric" })
			for i = 0, 2 do
				local ly, lz = 0.49 - i * 0.07, -0.3 - i * 0.12
				shoePart({ Name = name .. "Lace", Size = { 0.36, 0.05, 0.07 }, Pos = { 0, ly, lz }, Rot = { -28, 0, 0 }, Color = LACE })
				for _, ex in { -1, 1 } do
					shoePart({ Name = name .. "Eyelet", Shape = "Ball", Size = { 0.06, 0.06, 0.06 }, Pos = { ex * 0.19, ly - 0.015, lz }, Color = SHOE_DARK })
				end
			end
			shoePart({ Name = name .. "LaceBow", Shape = "Ellipsoid", Size = { 0.24, 0.06, 0.1 }, Pos = { 0, 0.54, -0.26 }, Rot = { -28, 0, 0 }, Color = LACE })
			for _, sx in { -1, 1 } do
				shoePart({ Name = name .. "SideStripe", Size = { 0.05, 0.09, 0.56 }, Pos = { sx * 0.29, 0.3, -0.1 }, Rot = { -16, 0, 0 }, Color = SOLE })
			end
			shoePart({ Name = name .. "HeelTab", Size = { 0.14, 0.15, 0.05 }, Pos = { 0, 0.5, 0.47 }, Rot = { 10, 0, 0 }, Color = SOLE })
		end

		-- One running leg. hip = joint position (Runner frame), phase = gait phase.
		-- Base pose is an athletic crouch (hip + knee + ankle = 0, so the foot is flat).
		-- Gait amplitudes/phases were tuned so the soles never sink into the ground.
		local L1, L2 = 1.4, 1.4
		local HIP_Y = 3.19
		local HB, KB = 15, -36
		local AB = -(HB + KB)
		local ANKLE_H = HIP_Y - L1 * cos(rad(HB)) - L2 * cos(rad(HB + KB)) -- ankle height in the base pose
		local function leg(name, hip, phase)
			k:Group({ Name = name .. "Hip", Pos = hip, Rot = { HB, 0, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 26, Speed = RUN, Phase = phase } }, function()
				k:Part({ Name = name .. "Haunch", Shape = "Ellipsoid", Size = { 0.95, 1.05, 0.98 }, Pos = { 0, 0.12, 0 }, Color = LEG })
				k:Part({ Name = name .. "Thigh", Shape = "Ellipsoid", Size = { 0.8, 2.15, 0.82 }, Pos = { 0, -0.76, 0 }, Color = LEG })
				k:Part({ Name = name .. "Quad", Shape = "Ellipsoid", Size = { 0.58, 1.15, 0.44 }, Pos = { 0, -0.62, -0.2 }, Color = LEG_LIGHT })
				k:Part({ Name = name .. "Hamstring", Shape = "Ellipsoid", Size = { 0.58, 1.05, 0.42 }, Pos = { 0, -0.7, 0.19 }, Color = LEG })
				k:Group({ Name = name .. "Knee", Pos = { 0, -L1, 0 }, Rot = { KB, 0, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 10, Speed = RUN, Phase = phase + 0.5 } }, function()
					k:Part({ Name = name .. "KneeJoint", Shape = "Ball", Size = { 0.58, 0.58, 0.58 }, Color = LEG })
					k:Part({ Name = name .. "Kneecap", Shape = "Ellipsoid", Size = { 0.36, 0.34, 0.18 }, Pos = { 0, 0.02, -0.25 }, Color = LEG_LIGHT })
					k:Part({ Name = name .. "Shin", Shape = "Ellipsoid", Size = { 0.56, 2.0, 0.6 }, Pos = { 0, -0.66, 0 }, Color = LEG })
					k:Part({ Name = name .. "Calf", Shape = "Ellipsoid", Size = { 0.54, 0.95, 0.48 }, Pos = { 0, -0.46, 0.15 }, Color = LEG })
					k:Group({ Name = name .. "Ankle", Pos = { 0, -L2, 0 }, Rot = { AB, 0, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 14, Speed = RUN, Phase = phase + 0.5 } }, function()
						k:Part({ Name = name .. "AnkleJoint", Shape = "Ball", Size = { 0.4, 0.4, 0.4 }, Pos = { 0, 0.08, 0 }, Color = LEG })
						k:Part({ Name = name .. "Sock", Shape = "Cylinder", Size = { 0.36, 0.44, 0.44 }, Pos = { 0, 0.26, 0.04 }, Rot = { 0, 0, 90 }, Color = SOCK, Material = "Fabric" })
						k:Part({ Name = name .. "SockStripe", Shape = "Cylinder", Size = { 0.05, 0.455, 0.455 }, Pos = { 0, 0.335, 0.04 }, Rot = { 0, 0, 90 }, Color = SHOE })
						k:Part({ Name = name .. "SockStripe2", Shape = "Cylinder", Size = { 0.05, 0.455, 0.455 }, Pos = { 0, 0.405, 0.04 }, Rot = { 0, 0, 90 }, Color = SHOE })
						k:Group({ Name = name .. "Shoe", Pos = { 0, -ANKLE_H, -0.06 } }, function()
							sneaker(name)
						end)
					end)
				end)
			end)
		end

		----------------------------------------------------------------------------------
		-- Mythic flair: glowing splash ring + puddle at the feet (slowly turning)
		----------------------------------------------------------------------------------
		k:Part({ Name = "Puddle", Shape = "Cylinder", Size = { 0.05, 4.9, 4.9 }, Pos = { 0, 0.03, 0 }, Rot = { 0, 0, 90 }, Color = WATER_DEEP, Material = "Glass", Transparency = 0.45 })
		k:Group({ Name = "SplashRing", Pos = { 0, 0, 0 }, Anim = { Type = "Spin", Axis = "Y", Speed = 0.1 } }, function()
			local R, N = 2.25, 12
			for i = 0, N - 1 do
				local a = 2 * math.pi * i / N
				local ad = deg(a)
				k:Part({ Name = "RingWater", Shape = "Ellipsoid", Size = { 1.3, 0.22, 0.4 }, Pos = { R * cos(a), 0.11, R * sin(a) }, Rot = { 0, 90 - ad, 0 }, Color = WATER, Material = "Glass", Transparency = 0.3 })
				k:Part({ Name = "RingGlow", Size = { 1.1, 0.06, 0.08 }, Pos = { R * cos(a), 0.22, R * sin(a) }, Rot = { 0, 90 - ad, 0 }, Color = WATER_GLOW, Material = "Neon" })
			end
			-- splash crowns: little sheets of water flicking outward, with droplets above
			for i = 0, 5 do
				local a = 2 * math.pi * (i + 0.5) / 6
				local ad = deg(a)
				local h = if i % 2 == 0 then 0.6 else 0.42
				local r = 2.3
				k:Part({ Name = "SplashSheet", Shape = "Ellipsoid", Size = { 0.12, h, 0.42 }, Pos = { r * cos(a), h * 0.5 + 0.03, r * sin(a) }, Rot = { 0, -ad, -28 }, Color = WATER, Material = "Glass", Transparency = 0.35 })
				k:Part({ Name = "SplashDrop", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = { (r + 0.28) * cos(a), h + 0.12, (r + 0.28) * sin(a) }, Color = WATER, Material = "Glass", Transparency = 0.2, Anim = { Type = "Bob", Axis = "Y", Amount = 0.12, Speed = 1.2, Phase = i / 6 } })
			end
		end)

		----------------------------------------------------------------------------------
		-- Orbiting bubbles
		----------------------------------------------------------------------------------
		k:Group({ Name = "BubbleOrbit", Pos = { 0, 4.5, 0 }, Anim = { Type = "Spin", Axis = "Y", Speed = 0.15 } }, function()
			local bubbles = {
				{ 0.4, -1.6, 0.34 }, { 1.45, 0.4, 0.22 }, { 2.4, 1.8, 0.3 },
				{ 3.3, -0.6, 0.2 }, { 4.3, 1.0, 0.26 }, { 5.3, -1.2, 0.18 },
			}
			for i, b in bubbles do
				k:Part({ Name = "Bubble", Shape = "Ball", Size = { b[3], b[3], b[3] }, Pos = { 2.75 * cos(b[1]), b[2], 2.75 * sin(b[1]) }, Color = WATER, Material = "Glass", Transparency = 0.35, Anim = { Type = "Bob", Axis = "Y", Amount = 0.18, Speed = 0.6, Phase = i / 6 } })
			end
		end)

		----------------------------------------------------------------------------------
		-- The runner: three legs running in place under a bobbing shark body
		----------------------------------------------------------------------------------
		k:Group({ Name = "Runner", Pos = { 0, 0, 0 } }, function()
			-- Three legs: two front (where the pectoral fins sit), one rear (anal fin position)
			leg("FrontRight", { 0.64, HIP_Y, -1.03 }, 0)
			leg("FrontLeft", { -0.64, HIP_Y, -1.03 }, 0.5)
			leg("Rear", { 0, HIP_Y, 0.87 }, 0.25)

			k:Group({ Name = "BodyBob", Pos = { 0, 4.36, -0.08 }, Anim = { Type = "Bob", Axis = "Y", Amount = 0.06, Speed = RUN * 2 } }, function()
			k:Group({ Name = "Shark", Rot = { 6, 0, 0 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 3, Speed = RUN / 2 } }, function()
				-- Big forms --------------------------------------------------------------
				k:Part({ Name = "Torso", Shape = "Ellipsoid", Size = TORSO_S, Pos = TORSO_C, Color = SHARK })
				k:Part({ Name = "Cranium", Shape = "Ellipsoid", Size = CRANIUM_S, Pos = CRANIUM_C, Color = SHARK })
				k:Part({ Name = "MidBody", Shape = "Ellipsoid", Size = { 2.1, 2.35, 2.4 }, Pos = { 0, 0.06, 0.5 }, Color = SHARK })
				k:Part({ Name = "RearBody", Shape = "Ellipsoid", Size = { 1.65, 1.85, 2.1 }, Pos = { 0, 0.14, 1.0 }, Color = SHARK })
				k:Part({ Name = "Belly", Shape = "Ellipsoid", Size = { 2.15, 2.15, 3.6 }, Pos = { 0, -0.5, -0.45 }, Color = BELLY })
				k:Part({ Name = "RearBelly", Shape = "Ellipsoid", Size = { 1.4, 1.35, 2.0 }, Pos = { 0, -0.34, 1.05 }, Color = BELLY })

				-- Dorsal fin ---------------------------------------------------------------
				k:Group({ Name = "Dorsal", Pos = { 0, 1.18, -0.3 }, Rot = { 10, 0, 0 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 3, Speed = RUN / 2, Phase = 0.3 } }, function()
					-- wedge = leading edge sloping up and back, vertical trailing edge
					k:Part({ Name = "DorsalFin", Shape = "Wedge", Size = { 0.2, 1.8, 1.55 }, Pos = { 0, 0.9, 0 }, Color = SHARK })
					k:Part({ Name = "DorsalCore", Shape = "Wedge", Size = { 0.3, 1.08, 0.93 }, Pos = { 0, 0.54, -0.31 }, Color = SHARK })
					k:Part({ Name = "DorsalTip", Shape = "Wedge", Size = { 0.22, 0.47, 0.41 }, Pos = { 0, 1.565, 0.57 }, Color = SHARK_DARK })
					k:Part({ Name = "DorsalTrail", Size = { 0.22, 1.35, 0.06 }, Pos = { 0, 0.68, 0.755 }, Color = SHARK_DARK })
					k:Part({ Name = "DorsalBase", Shape = "Ellipsoid", Size = { 0.66, 0.6, 1.85 }, Pos = { 0, 0.05, 0.05 }, Color = SHARK })
					-- battle notches on the trailing edge
					k:Part({ Name = "DorsalNotch", Size = { 0.24, 0.07, 0.15 }, Pos = { 0, 1.1, 0.74 }, Rot = { 20, 0, 0 }, Color = SHARK_DEEP })
					k:Part({ Name = "DorsalNotch", Size = { 0.24, 0.06, 0.11 }, Pos = { 0, 0.8, 0.75 }, Rot = { 20, 0, 0 }, Color = SHARK_DEEP })
				end)
				k:Part({ Name = "SecondDorsal", Shape = "Wedge", Size = { 0.12, 0.34, 0.36 }, Pos = { 0, 1.1, 1.45 }, Rot = { 12, 0, 0 }, Color = SHARK })
				k:Part({ Name = "AnalFin", Shape = "Wedge", Size = { 0.12, 0.32, 0.36 }, Pos = { 0, -1.0, 1.6 }, Rot = { 0, 0, 180 }, Color = SHARK })

				-- Pectoral + pelvic fins (mirrored) ---------------------------------------
				k:Mirror(function()
					k:Group({ Name = "Pectoral", Pos = { 0.97, -0.64, -1.05 }, Rot = { 0, -15, -30 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 10, Speed = RUN, Phase = 0.1 } }, function()
						k:Part({ Name = "PectoralFin", Shape = "Wedge", Size = { 0.16, 1.75, 1.3 }, Pos = { 0.82, 0, 0.32 }, Rot = { 0, 0, -90 }, Color = SHARK })
						k:Part({ Name = "PectoralUnder", Shape = "Wedge", Size = { 0.06, 1.55, 1.15 }, Pos = { 0.77, -0.08, 0.38 }, Rot = { 0, 0, -90 }, Color = BELLY_SHADE })
						k:Part({ Name = "PectoralTip", Shape = "Wedge", Size = { 0.18, 0.455, 0.338 }, Pos = { 1.4675, 0, 0.801 }, Rot = { 0, 0, -90 }, Color = SHARK_DARK })
						-- thicker inner half along the leading edge so the fin tapers like a real one
						k:Part({ Name = "PectoralCore", Shape = "Wedge", Size = { 0.26, 0.96, 0.72 }, Pos = { 0.426, 0, 0.027 }, Rot = { 0, 0, -90 }, Color = SHARK })
						k:Part({ Name = "PectoralRoot", Shape = "Ellipsoid", Size = { 0.32, 0.3, 1.2 }, Pos = { 0.02, 0, 0.3 }, Color = SHARK })
					end)
					k:Part({ Name = "PelvicFin", Shape = "Wedge", Size = { 0.1, 0.3, 0.4 }, Pos = { 0.44, -1.02, 1.35 }, Rot = { 0, 0, 160 }, Color = SHARK })
				end)

				-- Gill slits (5 per side, breathing) ---------------------------------------
				k:Mirror(function()
					for i = 0, 4 do
						local z = -1.25 + i * 0.17
						local h = 0.78 - i * 0.05
						local p, n = onEllipsoid(TORSO_C, TORSO_S, 1, 0.02 - i * 0.01, (z - TORSO_C[3]) / 1.6)
						k:Part({ Name = "GillSlit", Shape = "Ellipsoid", Size = { 0.07, h, 0.1 }, Pos = offset(p, n, -0.02), Rot = faceRot(n[1], n[2], n[3], 0), Color = SHARK_DEEP, Anim = { Type = "Pulse", Amount = 0.06, Speed = 0.6, Phase = i * 0.1 } })
						k:Part({ Name = "GillLip", Shape = "Ellipsoid", Size = { 0.06, h * 0.92, 0.07 }, Pos = offset({ p[1], p[2], p[3] + 0.06 }, n, -0.02), Rot = faceRot(n[1], n[2], n[3], 0), Color = SHARK_MID })
					end
				end)

				-- Old battle scars (asymmetric, light scratches on the upper flanks)
				for _, sc in { { 1, 0.42, 0.12, 22, 0.62 }, { 1, 0.3, 0.2, 18, 0.45 }, { -1, 0.5, -0.05, -25, 0.5 } } do
					local p, n = onEllipsoid(TORSO_C, TORSO_S, sc[1], sc[2], sc[3])
					k:Part({ Name = "Scar", Shape = "Ellipsoid", Size = { sc[5], 0.06, 0.06 }, Pos = offset(p, n, -0.012), Rot = faceRot(n[1], n[2], n[3], sc[4]), Color = SHARK_MID })
				end

				-- Eyes, brows, nostrils, snout pores --------------------------------------
				k:Mirror(function()
					local p, n = onEllipsoid(CRANIUM_C, CRANIUM_S, 0.81, 0.1, -0.62)
					local r = faceRot(n[1], n[2], n[3], 0)
					k:Part({ Name = "EyeSocket", Shape = "Ellipsoid", Size = { 0.6, 0.52, 0.2 }, Pos = offset(p, n, -0.03), Rot = r, Color = SHARK_DARK })
					k:Part({ Name = "Eye", Shape = "Ellipsoid", Size = { 0.46, 0.46, 0.24 }, Pos = offset(p, n, 0.02), Rot = r, Color = EYE, Reflectance = 0.15, Anim = { Type = "Blink", Speed = 0.22 } })
					k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.12, 0.12, 0.12 }, Pos = offset({ p[1] - 0.04, p[2] + 0.09, p[3] - 0.04 }, n, 0.12), Color = SHINE, Anim = { Type = "Blink", Speed = 0.22 } })
					k:Part({ Name = "EyeShineSmall", Shape = "Ball", Size = { 0.06, 0.06, 0.06 }, Pos = offset({ p[1] + 0.05, p[2] - 0.08, p[3] + 0.04 }, n, 0.11), Color = SHINE, Anim = { Type = "Blink", Speed = 0.22 } })
					k:Part({ Name = "Brow", Shape = "Ellipsoid", Size = { 0.6, 0.14, 0.24 }, Pos = offset({ p[1] - 0.03, p[2] + 0.3, p[3] }, n, 0.0), Rot = faceRot(n[1], n[2], n[3], -14), Color = SHARK_DARK })

					local np, nn = onEllipsoid(CRANIUM_C, CRANIUM_S, 0.25, -0.2, -1)
					k:Part({ Name = "Nostril", Shape = "Ellipsoid", Size = { 0.18, 0.06, 0.1 }, Pos = offset(np, nn, -0.01), Rot = faceRot(nn[1], nn[2], nn[3], 20), Color = SHARK_DEEP })
					local pores = { { 0.14, 0.22, -1 }, { 0.32, 0.08, -0.92 }, { 0.3, 0.36, -0.88 } }
					for _, d in pores do
						local pp, pn = onEllipsoid(CRANIUM_C, CRANIUM_S, d[1], d[2], d[3])
						k:Part({ Name = "Pore", Shape = "Ball", Size = { 0.05, 0.05, 0.05 }, Pos = offset(pp, pn, -0.012), Color = SHARK_DARK })
					end
				end)

				-- Mouth: dark cavity, pink gums, rows of teeth -----------------------------
				k:Part({ Name = "MouthCavity", Shape = "Ellipsoid", Size = { 1.5, 0.62, 1.6 }, Pos = { 0, -0.3, -1.8 }, Color = MOUTH })
				k:Part({ Name = "UpperGum", Shape = "Ellipsoid", Size = { GUM_SX, GUM_SY, GUM_SZ }, Pos = { 0, UGUM_Y, MOUTH_Z }, Color = GUM })
				do
					local f = sqrt(1 - (0.05 / (GUM_SY / 2)) ^ 2)
					teethRow("UpperTooth", 11, UGUM_Y - 0.05, MOUTH_Z, GUM_SX * f, GUM_SZ * f, 0.16, 74, -0.005)
					teethRow("UpperTooth2", 8, UGUM_Y - 0.03, MOUTH_Z, GUM_SX * f, GUM_SZ * f, 0.12, 62, 0.06)
				end

				-- Lower jaw chomps around its hinge
				k:Group({ Name = "Jaw", Pos = { 0, -0.3, -1.2 }, Rot = { -6, 0, 0 }, Anim = { Type = "Wiggle", Axis = "X", Amount = 6, Speed = 0.7 } }, function()
					local jy = LGUM_Y + 0.3 -- lower gum centre in jaw frame
					local jz = MOUTH_Z + 1.2
					k:Part({ Name = "LowerJaw", Shape = "Ellipsoid", Size = { 1.72, 0.6, 1.62 }, Pos = { 0, -0.42, -0.5 }, Color = BELLY })
					k:Part({ Name = "Tongue", Shape = "Ellipsoid", Size = { 0.9, 0.24, 1.1 }, Pos = { 0, -0.17, -0.55 }, Color = TONGUE })
					k:Part({ Name = "LowerGum", Shape = "Ellipsoid", Size = { GUM_SX * 0.94, GUM_SY, GUM_SZ * 0.94 }, Pos = { 0, jy, jz }, Color = GUM })
					local f = sqrt(1 - (0.05 / (GUM_SY / 2)) ^ 2)
					teethRow("LowerTooth", 10, jy + 0.05, jz, GUM_SX * 0.94 * f, GUM_SZ * 0.94 * f, 0.15, 70, -0.005)
					teethRow("LowerTooth2", 7, jy + 0.03, jz, GUM_SX * 0.94 * f, GUM_SZ * 0.94 * f, 0.11, 58, 0.06)
				end)

				-- Tail: peduncle swishes, the fin follows with a delay ---------------------
				k:Group({ Name = "Tail", Pos = { 0, 0.15, 1.65 }, Rot = { -8, 0, 0 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 14, Speed = RUN / 2, Phase = 0.5 } }, function()
					k:Part({ Name = "Peduncle", Shape = "Ellipsoid", Size = { 0.7, 0.85, 1.1 }, Pos = { 0, 0, 0.3 }, Color = SHARK })
					k:Part({ Name = "PeduncleBelly", Shape = "Ellipsoid", Size = { 0.52, 0.55, 0.95 }, Pos = { 0, -0.17, 0.22 }, Color = BELLY })
					k:Mirror(function()
						k:Part({ Name = "CaudalKeel", Shape = "Ellipsoid", Size = { 0.14, 0.09, 0.6 }, Pos = { 0.3, 0, 0.45 }, Color = SHARK_DARK })
					end)
					k:Group({ Name = "TailFin", Pos = { 0, 0.02, 0.55 }, Anim = { Type = "Wiggle", Axis = "Y", Amount = 12, Speed = RUN / 2, Phase = 0.62 } }, function()
						-- lunate tail: two swept blades meeting at a thick root
						local ua, la = 60, 60
						local function lobe(name, len, wid, ang, tipColor)
							local a = rad(ang)
							local dy, dz = sin(a), cos(a)
							k:Part({ Name = name, Shape = "Ellipsoid", Size = { 0.16, wid, len }, Pos = { 0, dy * len * 0.42, dz * len * 0.42 }, Rot = { -ang, 0, 0 }, Color = SHARK })
							k:Part({ Name = name .. "Tip", Shape = "Ellipsoid", Size = { 0.18, wid * 0.5, len * 0.26 }, Pos = { 0, dy * len * 0.8, dz * len * 0.8 }, Rot = { -ang, 0, 0 }, Color = tipColor })
						end
						lobe("UpperLobe", 1.8, 0.5, ua, SHARK_DARK)
						lobe("LowerLobe", 1.25, 0.46, -la, SHARK_DARK)
						k:Part({ Name = "TailRoot", Shape = "Ellipsoid", Size = { 0.24, 0.85, 0.55 }, Pos = { 0, 0.05, 0.05 }, Color = SHARK })
					end)
				end)
			end)
			end)
		end)

		----------------------------------------------------------------------------------
		-- Lights + particles
		----------------------------------------------------------------------------------
		k:Light({ Pos = { 0, 7.6, -1.2 }, Color = "#5fe3ff", Range = 12, Brightness = 1.2 })
		k:Light({ Pos = { 0, 0.8, 0 }, Color = "#3d8bff", Range = 9, Brightness = 1.5 })
		k:Particles({ Pos = { 0, 4.32, -2.85 }, Color = "#e8fbff", Color2 = "#7fdcff", Rate = 4, Size = 0.22, Speed = 1.2, Lifetime = 2, Spread = 25, Direction = "Top" })
		k:Particles({ Pos = { 0, 0.2, 0 }, Color = "#9fe8ff", Color2 = "#3d8bff", Rate = 8, Size = 0.35, Speed = 2.4, Lifetime = 0.8, Spread = 60, Direction = "Top" })
		k:Particles({ Pos = { 0, 5.4, 2.4 }, Color = "#bff6ff", Color2 = "#46d8ff", Rate = 3, Size = 0.2, Speed = 0.8, Lifetime = 1.6, Spread = 40, Direction = "Top" })
	end,

	BuildMini = function(k)
		-- body + white belly, dorsal fin, crescent tail, black eyes, open mouth, 3 legs in blue sneakers
		k:Part({ Name = "Body", Shape = "Ellipsoid", Size = { 1.3, 1.2, 2.45 }, Pos = { 0, 0.3, -0.05 }, Color = SHARK })
		k:Part({ Name = "Belly", Shape = "Ellipsoid", Size = { 1.14, 0.94, 2.25 }, Pos = { 0, 0.1, -0.1 }, Color = BELLY })
		k:Part({ Name = "Dorsal", Shape = "Wedge", Size = { 0.13, 0.62, 0.6 }, Pos = { 0, 0.98, 0.05 }, Rot = { 10, 0, 0 }, Color = SHARK })
		k:Part({ Name = "Tail", Shape = "Ellipsoid", Size = { 0.12, 0.95, 0.36 }, Pos = { 0, 0.55, 0.98 }, Rot = { -25, 0, 0 }, Color = SHARK })
		k:Part({ Name = "Eyes", Shape = "Cylinder", Size = { 1.1, 0.2, 0.2 }, Pos = { 0, 0.48, -0.74 }, Color = EYE })
		k:Part({ Name = "Mouth", Shape = "Ellipsoid", Size = { 0.7, 0.2, 0.3 }, Pos = { 0, 0.12, -1.1 }, Color = MOUTH })
		k:Mirror(function()
			k:Part({ Name = "FrontLeg", Shape = "Cylinder", Size = { 0.48, 0.25, 0.25 }, Pos = { 0.3, -0.44, -0.42 }, Rot = { 0, 0, 90 }, Color = LEG })
			k:Part({ Name = "FrontShoe", Shape = "Ellipsoid", Size = { 0.36, 0.27, 0.6 }, Pos = { 0.3, -0.75, -0.52 }, Color = SHOE })
		end)
		k:Part({ Name = "RearLeg", Shape = "Cylinder", Size = { 0.48, 0.25, 0.25 }, Pos = { 0, -0.44, 0.5 }, Rot = { 0, 0, 90 }, Color = LEG })
		k:Part({ Name = "RearShoe", Shape = "Ellipsoid", Size = { 0.36, 0.27, 0.6 }, Pos = { 0, -0.75, 0.4 }, Color = SHOE })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">TrippiTroppi</string>
            <string name="Source"><![CDATA[--[[
	Trippi Troppi (Uncommon)
	Canonical look: a cute/cursed orange tabby CAT head (pointed ears with pink insides,
	tabby "M" stripes, huge eyes, whiskers, little pink nose, open mouth) fused onto the
	pink-orange body of a cooked SHRIMP: curved segmented shell plates, a curled abdomen
	ending in a fan tail, little swimmerets and spindly walking legs underneath, and two
	long antennae.

	Pose: the shrimp body is shown in profile (head end at +X, curled tail at -X) while the
	cat face looks straight at the viewer (-Z), exactly like the meme picture, so the front
	view shows the whole shrimp silhouette AND the cat face.

	Coordinates: feet on y = 0, face toward -Z. Animated joints use a pivot group with an
	un-animated offset group inside, so most parts are written in world coordinates.
]]

-- Palette ------------------------------------------------------------------------------
-- cat
local FUR = "#f39d3c" -- dominant ginger fur
local FUR_LIGHT = "#f9bc6a"
local FUR_DARK = "#c1621d" -- tabby stripes
local CREAM = "#fff0db" -- muzzle, chin, ear tufts
local EAR_PINK = "#f4a0ab"
local NOSE = "#e5707f"
local MOUTH = "#5a1d2b"
local TONGUE = "#f07a8c"
local TOOTH = "#fff8ec"
local EYE_WHITE = "#fff8ec"
local IRIS = "#8fcd3e"
local PUPIL = "#1b1b24"
local SHINE = "#fff8ec"
local LINER = "#3b2318"
local WHISKER = "#fff6e6"
-- shrimp
local SHELL = "#f5765c" -- cooked shrimp coral
local SHELL_LIGHT = "#ffa98a"
local SHELL_DARK = "#d6493a" -- segment bands
local SHELL_PALE = "#ffcab2" -- pale lower plates / belly
local SHELL_RED = "#bf3a2e" -- tail tips
local LEG = "#f8906f"
local ANTENNA = "#e0533f"
local ANTENNA_DARK = "#c94433"

-- Layout (world studs) -------------------------------------------------------------------
local HC = { 1.4, 3.5, -0.4 } -- head centre
local NECK = { 1.3, 2.5, -0.2 } -- head tilt pivot
local AC = { -1.05, 2.06 } -- abdomen arc centre (x, y) in the profile plane
local AR = 1.2 -- abdomen arc radius

-- Head volumes in HEAD-LOCAL space {cx, cy, cz, semiX, semiY, semiZ}
local SKULL = { 0, 0, 0, 1.42, 1.22, 1.18 }
local CHEEK_R = { 0.74, -0.42, -0.28, 0.84, 0.76, 0.88 }
local CHEEK_L = { -0.74, -0.42, -0.28, 0.84, 0.76, 0.88 }
local HEAD_VOLS = { SKULL, CHEEK_R, CHEEK_L }

-- Math helpers ---------------------------------------------------------------------------
local function deg(r)
	return r * 180 / math.pi
end

local function norm(v)
	local l = math.sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3])
	return { v[1] / l, v[2] / l, v[3] / l }
end

local function cross(a, b)
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end

-- Distance along a ray (origin p, unit dir d) to where it leaves ellipsoid e (-1 = miss)
local function exitT(e, px, py, pz, dx, dy, dz)
	local ox, oy, oz = (px - e[1]) / e[4], (py - e[2]) / e[5], (pz - e[3]) / e[6]
	local vx, vy, vz = dx / e[4], dy / e[5], dz / e[6]
	local A = vx * vx + vy * vy + vz * vz
	local B = 2 * (ox * vx + oy * vy + oz * vz)
	local C = ox * ox + oy * oy + oz * oz - 1
	local disc = B * B - 4 * A * C
	if disc < 0 then
		return -1
	end
	return (-B + math.sqrt(disc)) / (2 * A)
end

-- Point on a union of ellipsoids seen from (o) along (d), pushed `out` along the normal.
local function surfaceOf(vols, o, dx, dy, dz, out)
	local d = norm({ dx, dy, dz })
	local best, bestT = vols[1], -1
	for _, e in vols do
		local t = exitT(e, o[1], o[2], o[3], d[1], d[2], d[3])
		if t > bestT then
			best, bestT = e, t
		end
	end
	local x, y, z = o[1] + d[1] * bestT, o[2] + d[2] * bestT, o[3] + d[3] * bestT
	local n = norm({
		(x - best[1]) / (best[4] * best[4]),
		(y - best[2]) / (best[5] * best[5]),
		(z - best[3]) / (best[6] * best[6]),
	})
	return { x + n[1] * out, y + n[2] * out, z + n[3] * out }, n
end

local function headSurface(dx, dy, dz, out)
	return surfaceOf(HEAD_VOLS, { 0, 0, 0 }, dx, dy, dz, out)
end

-- Rotation whose local -Z axis points along unit normal n (flat features on a surface),
-- with an optional in-plane roll.
local function faceRot(n, roll)
	return { deg(math.atan2(n[2], -n[3])), deg(math.asin(-n[1])), roll or 0 }
end

-- Rotation that points a Cylinder's axis (local X) along vector v
local function axisRot(vx, vy, vz)
	local l = math.sqrt(vx * vx + vy * vy + vz * vz)
	vx, vy, vz = vx / l, vy / l, vz / l
	return { 0, deg(math.atan2(-vz, vx)), deg(math.asin(vy)) }
end

-- Cylinder segment between two points
local function segment(k, name, a, b, diameter, color, material)
	local vx, vy, vz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local len = math.sqrt(vx * vx + vy * vy + vz * vz)
	k:Part({
		Name = name,
		Shape = "Cylinder",
		Size = { len + diameter * 0.6, diameter, diameter },
		Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
		Rot = axisRot(vx, vy, vz),
		Color = color,
		Material = material or "SmoothPlastic",
	})
end

-- Animated joint: rotates/bobs around `pivot` while the contents stay in world coordinates
local function joint(k, name, pivot, anim, fn)
	k:Group({ Name = name, Pos = pivot, Anim = anim }, function()
		k:Group({ Name = name .. "Offset", Pos = { -pivot[1], -pivot[2], -pivot[3] } }, fn)
	end)
end

-- Front-facing isosceles triangle (two wedges), apex up; pos = centre of its bounding box
local function triangle(k, name, w, h, thick, color, pos, material)
	k:Part({ Name = name, Shape = "Wedge", Size = { thick, h, w / 2 }, Pos = { pos[1] - w / 4, pos[2], pos[3] }, Rot = { 0, 90, 0 }, Color = color, Material = material })
	k:Part({ Name = name, Shape = "Wedge", Size = { thick, h, w / 2 }, Pos = { pos[1] + w / 4, pos[2], pos[3] }, Rot = { 0, -90, 0 }, Color = color, Material = material })
end

-- Abdomen arc: centre of a segment at angle th (degrees from straight up, toward -X)
local function arcPoint(th, r)
	local a = math.rad(th)
	return AC[1] - (r or AR) * math.sin(a), AC[2] + (r or AR) * math.cos(a)
end

--------------------------------------------------------------------------------------------
-- Cat head (HEAD-LOCAL coordinates, origin = head centre)
--------------------------------------------------------------------------------------------
local BLINK = { Type = "Blink", Speed = 0.22, Phase = 0.15 }

local function buildEye(k)
	local p, n0 = headSurface(0.5, 0.2, -1, 0)
	-- bias toward facing the viewer so the big eyes read from the front
	local n = norm({ n0[1] * 0.55, n0[2] * 0.55, n0[3] * 0.55 - 0.45 })
	local u = norm({ -n[1] * n[2], 1 - n[2] * n[2], -n[3] * n[2] })
	local r = cross(n, u)
	local function at(dx, dy, out)
		return {
			p[1] + r[1] * dx + u[1] * dy + n[1] * out,
			p[2] + r[2] * dx + u[2] * dy + n[2] * out,
			p[3] + r[3] * dx + u[3] * dy + n[3] * out,
		}
	end
	local rot = faceRot(n, 0)
	k:Part({ Name = "EyeLiner", Shape = "Ellipsoid", Size = { 1.04, 1.1, 0.3 }, Pos = at(0, 0.02, -0.1), Rot = rot, Color = LINER })
	k:Part({ Name = "EyeLid", Shape = "Ellipsoid", Size = { 0.9, 0.98, 0.28 }, Pos = at(0, 0, -0.08), Rot = rot, Color = FUR })
	k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.94, 1.02, 0.34 }, Pos = at(0, 0, -0.05), Rot = rot, Color = EYE_WHITE, Anim = BLINK })
	k:Part({ Name = "Iris", Shape = "Ellipsoid", Size = { 0.8, 0.88, 0.3 }, Pos = at(-0.03, -0.02, -0.01), Rot = rot, Color = IRIS, Anim = BLINK })
	k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.42, 0.66, 0.28 }, Pos = at(-0.04, -0.02, 0.03), Rot = rot, Color = PUPIL, Anim = BLINK })
	k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.22, 0.22, 0.22 }, Pos = at(0.13, 0.2, 0.08), Color = SHINE, Material = "Neon", Anim = BLINK })
end

local function buildEar(k, side, phase)
	local p = headSurface(0.6 * side, 1, -0.12, -0.18)
	k:Group({
		Name = if side > 0 then "RightEar" else "LeftEar",
		Pos = p,
		Rot = { 10, -14 * side, -16 * side },
		Anim = { Type = "Wiggle", Axis = "Z", Amount = 9, Speed = 0.5, Phase = phase },
	}, function()
		triangle(k, "Ear", 1.1, 1.35, 0.3, FUR, { 0, 0.675, 0 })
		triangle(k, "EarInner", 0.7, 0.95, 0.1, EAR_PINK, { 0, 0.52, -0.15 })
		k:Part({ Name = "EarTuft", Shape = "Wedge", Size = { 0.08, 0.5, 0.22 }, Pos = { 0, 0.32, -0.21 }, Rot = { 0, 90, 0 }, Color = CREAM })
	end)
end

-- flat stripe on the head surface
local function stripe(k, dir, size, roll, color)
	local p, n = headSurface(dir[1], dir[2], dir[3], -size[3] * 0.25)
	k:Part({ Name = "Stripe", Shape = "Ellipsoid", Size = size, Pos = p, Rot = faceRot(n, roll), Color = color or FUR_DARK })
end

local function buildHead(k)
	-- big forms
	k:Part({ Name = "Skull", Shape = "Ellipsoid", Size = { SKULL[4] * 2, SKULL[5] * 2, SKULL[6] * 2 }, Color = FUR })
	k:Mirror(function()
		k:Part({ Name = "Cheek", Shape = "Ellipsoid", Size = { CHEEK_R[4] * 2, CHEEK_R[5] * 2, CHEEK_R[6] * 2 }, Pos = { CHEEK_R[1], CHEEK_R[2], CHEEK_R[3] }, Color = FUR })
		-- cheek fluff tufts sticking out of the silhouette
		k:Group({ Name = "CheekFluff", Pos = { 1.22, -0.78, -0.5 }, Rot = { 0, -40, -118 } }, function()
			k:Part({ Name = "Fluff", Shape = "Wedge", Size = { 0.14, 0.6, 0.32 }, Pos = { 0, 0.3, 0 }, Rot = { 0, -90, 0 }, Color = FUR_LIGHT })
		end)

		-- eyes
		buildEye(k)

		-- muzzle pads (axis aligned so dots can be placed on them)
		local pp = headSurface(0.26, -0.42, -1, -0.14)
		local muzzle = { pp[1], pp[2], pp[3], 0.36, 0.28, 0.26 }
		k:Part({ Name = "MuzzlePad", Shape = "Ellipsoid", Size = { 0.72, 0.56, 0.52 }, Pos = pp, Color = CREAM })
		for _, d in { { 0.25, 0.25 }, { 0.45, -0.05 } } do
			local dp = surfaceOf({ muzzle }, { muzzle[1], muzzle[2], muzzle[3] }, d[1], d[2], -1, -0.02)
			k:Part({ Name = "WhiskerDot", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = dp, Color = FUR_DARK })
		end

		-- fangs hanging from the upper lip
		local fp = headSurface(0.15, -0.66, -1, 0.0)
		k:Part({ Name = "Fang", Shape = "Wedge", Size = { 0.08, 0.2, 0.12 }, Pos = fp, Rot = { 0, 90, 180 }, Color = TOOTH })

		-- whiskers twitch around their root on the pad
		local wr = headSurface(0.5, -0.4, -1, -0.05)
		k:Group({ Name = "Whiskers", Pos = wr, Anim = { Type = "Wiggle", Axis = "Y", Amount = 6, Speed = 1.1, Phase = 0.3 } }, function()
			for _, w in { { 1.05, 0.24, -0.45 }, { 1.12, 0.02, -0.4 }, { 1.03, -0.2, -0.32 } } do
				segment(k, "Whisker", { 0, 0, 0 }, w, 0.05, WHISKER)
			end
		end)

		-- tabby stripes: forehead "M", cheeks, back of the head
		stripe(k, { 0.2, 0.72, -0.72 }, { 0.11, 0.46, 0.16 }, -12)
		stripe(k, { 0.44, 0.62, -0.7 }, { 0.1, 0.38, 0.16 }, -26)
		stripe(k, { 1, -0.08, -0.5 }, { 0.52, 0.1, 0.16 }, 8)
		stripe(k, { 1, -0.34, -0.42 }, { 0.46, 0.1, 0.16 }, -6)
		stripe(k, { 0.42, 0.55, 0.8 }, { 0.16, 0.7, 0.18 }, -14)
	end)
	stripe(k, { 0, 0.78, -0.7 }, { 0.13, 0.55, 0.16 }, 0)
	stripe(k, { 0, 0.6, 0.82 }, { 0.18, 0.8, 0.18 }, 0)
	stripe(k, { 0, 1, 0.15 }, { 0.15, 0.7, 0.16 }, 0)

	-- nose, philtrum, open mouth, tongue, chin
	local np, nn = headSurface(0, -0.2, -1, 0.1)
	k:Part({ Name = "Nose", Shape = "Ellipsoid", Size = { 0.36, 0.22, 0.24 }, Pos = np, Rot = faceRot(nn, 0), Color = NOSE })
	local php = headSurface(0, -0.38, -1, 0.05)
	k:Part({ Name = "Philtrum", Size = { 0.05, 0.2, 0.06 }, Pos = php, Color = LINER })
	local mp, mn = headSurface(0, -0.7, -1, -0.12)
	k:Part({ Name = "Mouth", Shape = "Ellipsoid", Size = { 0.74, 0.5, 0.36 }, Pos = mp, Rot = faceRot(mn, 0), Color = MOUTH })
	local tp = headSurface(0, -0.8, -1, -0.07)
	k:Part({ Name = "Tongue", Shape = "Ellipsoid", Size = { 0.48, 0.22, 0.3 }, Pos = tp, Rot = faceRot(mn, 0), Color = TONGUE })
	local cp, cn = headSurface(0, -1, -0.75, -0.2)
	k:Part({ Name = "Chin", Shape = "Ellipsoid", Size = { 0.85, 0.5, 0.6 }, Pos = cp, Rot = faceRot(cn, 0), Color = CREAM })

	-- ears flick one at a time
	buildEar(k, 1, 0)
	buildEar(k, -1, 0.45)
end

-- Long antennae: a chain of nested groups so the wave travels down the whip
local function buildAntenna(k, name, pts, phase)
	k:Part({ Name = "AntennaSocket", Shape = "Ball", Size = { 0.26, 0.26, 0.26 }, Pos = pts[1], Color = SHELL_DARK })
	local function link(i)
		local a, b = pts[i], pts[i + 1]
		local d = 0.13 - (i - 1) * 0.013
		k:Group({
			Name = name .. i,
			Pos = if i == 1 then a else { a[1] - pts[i - 1][1], a[2] - pts[i - 1][2], a[3] - pts[i - 1][3] },
			Anim = { Type = "Wiggle", Axis = if i % 2 == 0 then "Z" else "X", Amount = 4, Speed = 0.55, Phase = phase + i * 0.07 },
		}, function()
			segment(k, "Antenna", { 0, 0, 0 }, { b[1] - a[1], b[2] - a[2], b[3] - a[3] }, d, if i % 2 == 0 then ANTENNA else ANTENNA_DARK)
			if i + 1 < #pts then
				link(i + 1)
			end
		end)
	end
	link(1)
end

--------------------------------------------------------------------------------------------
-- Shrimp body (world coordinates)
--------------------------------------------------------------------------------------------
local function buildThorax(k)
	k:Group({ Name = "Carapace", Pos = { 0.45, 2.3, 0.05 } }, function()
		-- laterally compressed like a real shrimp's head-shell
		k:Part({ Name = "Carapace", Shape = "Ellipsoid", Size = { 2.5, 1.7, 1.6 }, Color = SHELL, Reflectance = 0.05 })
		k:Part({ Name = "DorsalRidge", Shape = "Ellipsoid", Size = { 2.1, 0.24, 0.24 }, Pos = { -0.1, 0.84, 0 }, Color = SHELL_DARK })
		k:Part({ Name = "ShellGloss", Shape = "Ellipsoid", Size = { 1.5, 0.2, 0.62 }, Pos = { -0.15, 0.73, 0 }, Color = SHELL_LIGHT })
		for _, x in { -0.45, -0.85 } do
			k:Part({ Name = "Spine", Shape = "Wedge", Size = { 0.12, 0.26, 0.28 }, Pos = { x, 0.99, 0 }, Rot = { 0, 90, 0 }, Color = SHELL_DARK })
		end
		k:Part({ Name = "Sternum", Shape = "Ellipsoid", Size = { 1.8, 0.34, 0.86 }, Pos = { 0, -0.68, 0 }, Color = SHELL_PALE })
	end)
end

-- Shrimp abdomen: laterally compressed (taller than wide), long overlapping shell plates
local SEGMENTS = {
	{ th = -12, w = 1.5, h = 1.66, l = 1.2, swim = true },
	{ th = 17, w = 1.44, h = 1.58, l = 1.2, swim = true },
	{ th = 46, w = 1.36, h = 1.48, l = 1.16, swim = true },
	{ th = 75, w = 1.26, h = 1.34, l = 1.12 },
	{ th = 104, w = 1.12, h = 1.18, l = 1.08, bare = true },
	{ th = 132, w = 0.96, h = 1.02, l = 1.1, bare = true },
}
local FAN_TH = 166

local function buildSegment(k, i)
	local s = SEGMENTS[i]
	local cx, cy = arcPoint(s.th)
	-- local frame: +X = toward the head, +Y = back (dorsal), Z = sideways
	k:Group({ Name = "Segment" .. i, Pos = { cx, cy, 0 }, Rot = { 0, 0, s.th } }, function()
		k:Part({ Name = "Shell", Shape = "Ellipsoid", Size = { s.l, s.h, s.w }, Color = SHELL, Reflectance = 0.05 })
		-- the raised rear rim of each plate, where it overlaps the next one
		k:Part({ Name = "Band", Shape = "Ellipsoid", Size = { 0.16, s.h * 0.84, s.w * 0.84 }, Pos = { -s.l / 2 + 0.26, 0.02, 0 }, Color = SHELL_DARK })
		for side = -1, 1, 2 do
			if not s.bare then
				k:Part({ Name = "Pleuron", Shape = "Ellipsoid", Size = { s.l * 0.8, s.h * 0.42, 0.12 }, Pos = { 0.02, -s.h * 0.3, side * (s.w * 0.42 + (7 - i) * 0.01) }, Color = SHELL_LIGHT })
			end
			if s.swim then
				-- thin paddling swimmerets under the abdomen
				k:Group({ Name = "Swimmeret", Pos = { 0.05, -s.h / 2 + 0.1, side * 0.26 }, Rot = { side * 12, 0, -14 }, Anim = { Type = "Wiggle", Axis = "Z", Amount = 16, Speed = 1.0, Phase = i * 0.17 + (side + 1) * 0.1 } }, function()
					k:Part({ Name = "Paddle", Shape = "Ellipsoid", Size = { 0.13, 0.56, 0.07 }, Pos = { 0, -0.24, 0 }, Color = LEG })
				end)
			end
		end
	end)
end

local function buildTailFan(k)
	local px, py = arcPoint(FAN_TH)
	-- local frame: -X = toward the tail tip, fan spreads in the profile (XY) plane
	k:Group({ Name = "Fan", Pos = { px, py, 0 }, Rot = { 0, 0, FAN_TH } }, function()
		-- pointed central telson on top, two pairs of paddle uropods spread like a fan
		k:Part({ Name = "Telson", Shape = "Ellipsoid", Size = { 1.04, 0.28, 0.2 }, Pos = { -0.5, 0, -0.1 }, Color = SHELL_DARK })
		for _, u in { { 22, -0.02 }, { -18, -0.02 }, { 52, 0.08 }, { -40, 0.08 } } do
			k:Group({ Name = "Uropod", Rot = { 0, 0, u[1] } }, function()
				k:Part({ Name = "Blade", Shape = "Ellipsoid", Size = { 0.98, 0.42, 0.1 }, Pos = { -0.5, 0, u[2] }, Color = SHELL })
				k:Part({ Name = "BladeTip", Shape = "Ellipsoid", Size = { 0.3, 0.4, 0.12 }, Pos = { -0.9, 0, u[2] }, Color = SHELL_RED })
			end)
		end
	end)
end

-- Jointed walking leg: a short thigh flares out and up to a raised knee, then the slim
-- shin drops to a pointed tip. Legs fan forward (front pairs) and backward (rear pairs).
local function buildLeg(k, x, side, reach, phase)
	local hip = { x, 1.6, 0.4 * side }
	local knee = { x + reach * 0.35, 1.72, 1.02 * side }
	local foot = { x + reach, 0.06, 1.3 * side }
	joint(k, "Leg", hip, { Type = "Wiggle", Axis = "Z", Amount = 7, Speed = 0.8, Phase = phase }, function()
		segment(k, "Thigh", hip, knee, 0.2, SHELL)
		segment(k, "Shin", knee, foot, 0.13, LEG)
	end)
end

return {
	Id = "TrippiTroppi",
	Name = "Trippi Troppi",
	Rarity = "Uncommon",
	Emoji = "🦐",
	Color = FUR,
	Tagline = "Cat head. Shrimp body. Zero explanations.",
	Lore = "Half ginger cat, half cooked shrimp, fully confused. Trippi Troppi scuttles along the shore on eight tiny legs, meowing at seagulls and flicking its fan tail. Nobody knows if it wants the fish or is the fish.",

	Build = function(k)
		-- eight spindly walking legs (front pair reaches forward, back pair backward)
		local legs = { { 1.3, 0.85 }, { 0.8, 0.35 }, { 0.3, -0.2 }, { -0.2, -0.7 } }
		for i, l in legs do
			buildLeg(k, l[1], -1, l[2], i * 0.18)
			-- far-side legs sit a touch further forward so all eight read from the front
			buildLeg(k, l[1] + 0.16, 1, l[2], i * 0.18 + 0.5)
		end

		joint(k, "Body", { 0, 2.4, 0 }, { Type = "Bob", Axis = "Y", Amount = 0.05, Speed = 0.5 }, function()
			buildThorax(k)
			buildSegment(k, 1)
			buildSegment(k, 2)
			-- the abdomen curls and uncurls; the fan flicks at the very end
			local p3x, p3y = arcPoint(31)
			joint(k, "AbdomenCurl", { p3x, p3y, 0 }, { Type = "Wiggle", Axis = "Z", Amount = 2, Speed = 0.45 }, function()
				buildSegment(k, 3)
				buildSegment(k, 4)
				local p5x, p5y = arcPoint(90)
				joint(k, "TailCurl", { p5x, p5y, 0 }, { Type = "Wiggle", Axis = "Z", Amount = 3.5, Speed = 0.45, Phase = 0.12 }, function()
					buildSegment(k, 5)
					buildSegment(k, 6)
					local fx, fy = arcPoint(FAN_TH)
					joint(k, "TailFlick", { fx, fy, 0 }, { Type = "Wiggle", Axis = "Z", Amount = 9, Speed = 0.8, Phase = 0.3 }, function()
						buildTailFan(k)
					end)
				end)
			end)

			-- cat head tilts on the neck
			joint(k, "Head", NECK, { Type = "Wiggle", Axis = "Z", Amount = 5, Speed = 0.35 }, function()
				k:Group({ Name = "HeadFrame", Pos = HC }, function()
					buildHead(k)
					-- antennae sprout between the ears and arc back over the shrimp body
					local function rel(list)
						local out = {}
						for i, p in list do
							out[i] = { p[1] - HC[1], p[2] - HC[2], p[3] - HC[3] }
						end
						return out
					end
					buildAntenna(k, "AntennaA", rel({
						{ 1.64, 4.57, -0.9 },
						{ 1.74, 5.45, -1.12 },
						{ 1.45, 6.4, -1.18 },
						{ 0.75, 7.15, -1.0 },
						{ -0.3, 7.45, -0.82 },
						{ -1.45, 7.25, -0.62 },
						{ -2.4, 6.55, -0.45 },
					}), 0)
					buildAntenna(k, "AntennaB", rel({
						{ 1.16, 4.57, -0.9 },
						{ 1.08, 5.4, -0.92 },
						{ 0.7, 6.2, -0.7 },
						{ -0.1, 6.75, -0.35 },
						{ -1.05, 6.8, 0.0 },
						{ -1.95, 6.3, 0.35 },
					}), 0.35)
				end)
			end)
		end)

		-- rarity flair: a few bubbles drift up off the shell
		k:Particles({ Pos = { -1.4, 3.9, 0 }, Color = "#d8f3ff", Color2 = "#ffffff", Rate = 2, Size = 0.22, Speed = 0.9, Lifetime = 2.5, Spread = 35, Direction = "Top" })
	end,

	BuildMini = function(k)
		-- curled shrimp abdomen in profile (tail at -X), alternating shell bands
		k:Part({ Name = "Seg1", Shape = "Ellipsoid", Size = { 0.66, 0.78, 0.74 }, Pos = { -0.3, -0.05, 0.05 }, Rot = { 0, 0, -10 }, Color = SHELL })
		k:Part({ Name = "Seg2", Shape = "Ellipsoid", Size = { 0.58, 0.68, 0.66 }, Pos = { -0.78, -0.36, 0.05 }, Rot = { 0, 0, 40 }, Color = SHELL_DARK })
		k:Part({ Name = "Seg3", Shape = "Ellipsoid", Size = { 0.5, 0.58, 0.56 }, Pos = { -0.9, -0.8, 0.05 }, Rot = { 0, 0, 80 }, Color = SHELL })
		k:Part({ Name = "Fan", Shape = "Ellipsoid", Size = { 0.7, 0.4, 0.14 }, Pos = { -0.55, -1.0, 0.05 }, Rot = { 0, 0, -28 }, Color = SHELL_RED })
		-- ginger cat head facing front
		k:Part({ Name = "Head", Shape = "Ellipsoid", Size = { 1.3, 1.1, 1.05 }, Pos = { 0.42, 0.2, -0.15 }, Color = FUR })
		k:Part({ Name = "EarR", Shape = "Wedge", Size = { 0.16, 0.5, 0.36 }, Pos = { 0.8, 0.88, -0.1 }, Rot = { 0, -90, 0 }, Color = FUR })
		k:Part({ Name = "EarL", Shape = "Wedge", Size = { 0.16, 0.5, 0.36 }, Pos = { 0.04, 0.88, -0.1 }, Rot = { 0, 90, 0 }, Color = FUR })
		k:Part({ Name = "EyeR", Shape = "Ellipsoid", Size = { 0.34, 0.4, 0.2 }, Pos = { 0.67, 0.3, -0.6 }, Color = IRIS })
		k:Part({ Name = "EyeL", Shape = "Ellipsoid", Size = { 0.34, 0.4, 0.2 }, Pos = { 0.17, 0.3, -0.6 }, Color = IRIS })
		k:Part({ Name = "PupilR", Shape = "Ellipsoid", Size = { 0.16, 0.26, 0.1 }, Pos = { 0.66, 0.29, -0.69 }, Color = PUPIL })
		k:Part({ Name = "PupilL", Shape = "Ellipsoid", Size = { 0.16, 0.26, 0.1 }, Pos = { 0.18, 0.29, -0.69 }, Color = PUPIL })
		k:Part({ Name = "Muzzle", Shape = "Ellipsoid", Size = { 0.5, 0.3, 0.22 }, Pos = { 0.42, -0.02, -0.64 }, Color = CREAM })
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">TungTungTungSahur</string>
            <string name="Source"><![CDATA[--[[
	Tung Tung Tung Sahur (Rare)
	Canonical look: a tall, light-brown anthropomorphic wooden log (worn rounded base, grain
	lines, knots, cracks and a flat sawn top showing growth rings) with a simple, wide-eyed
	face: big round white eyes with tiny pupils, thin dark brows and a wide, unsettling
	grin. Stick-thin darker wooden arms and bare-footed legs; the right hand holds a plain
	wooden baseball bat raised beside the head, ready to knock "tung tung tung".

	Coordinates: feet on y = 0, faces -Z. Most parts are written in world coordinates by
	nesting an un-animated "offset" group inside each animated joint group.
]]

-- Palette ------------------------------------------------------------------------------
local WOOD = "#d6a56c" -- dominant: light-brown log
local WOOD_LIGHT = "#e2b980" -- sanded chamfer round the sawn top
local WOOD_SHADE = "#bd8850" -- worn base, eye sockets, peg holes, branch stub
local GRAIN = "#b47c45" -- grain lines
local GRAIN_SOFT = "#c4915a" -- softer grain on the beauty side
local END_LIGHT = "#efd3a2" -- sawn end grain
local END_DARK = "#c99460" -- growth rings
local PITH = "#8a5a30"
local KNOT = "#7a4a24"
local KNOT_RING = "#a06a37"
local CRACK = "#4a2c18"

local LIMB = "#a5713e" -- stick-thin darker wooden arms and legs
local LIMB_DARK = "#8a5a2f" -- joints
local BAT = "#b0682f" -- plain varnished baseball bat
local BAT_DARK = "#7a421c"
local BAT_LIGHT = "#cf8f52"
local BAT_END = "#e2b27a"

local EYE_WHITE = "#fff8ec"
local PUPIL = "#1b1b24"
local SHINE = "#fffdf6"
local BROW = "#3a2314"
local MOUTH = "#2a1610"
local TEETH = "#fff1d8"

local GLOW = "#ffbf73" -- Rare flair: warm glow + sawdust
local DUST = "#e9cc9c"

-- Layout (world studs) -------------------------------------------------------------------
local LOG_BOTTOM = 2.55
local LOG_TOP = 8.35
local RADIUS = 1.2 -- log radius
local EYE_Y = 7.08
local MOUTH_Y = 6.08 -- top edge of the grin at the centre
local SHOULDER_Y = 5.45

-- Log radius at height y (kept as a function so the surface helpers stay generic)
local function R(_y)
	return RADIUS
end

local function deg(r)
	return r * 180 / math.pi
end

local function norm(v)
	local l = math.sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3])
	return { v[1] / l, v[2] / l, v[3] / l }
end

local function add(a, b, s)
	s = s or 1
	return { a[1] + b[1] * s, a[2] + b[2] * s, a[3] + b[3] * s }
end

local function cross(a, b)
	return { a[2] * b[3] - a[3] * b[2], a[3] * b[1] - a[1] * b[3], a[1] * b[2] - a[2] * b[1] }
end

-- Rotation that points a Cylinder's (or Ellipsoid's) local X axis along vector v
local function axisRot(v)
	local n = norm(v)
	return { 0, deg(math.atan2(-n[3], n[1])), deg(math.asin(n[2])) }
end

-- Cylinder between two points (extra length lets joints overlap)
local function segment(k, name, a, b, d, color, material, extra)
	local v = { b[1] - a[1], b[2] - a[2], b[3] - a[3] }
	local len = math.sqrt(v[1] * v[1] + v[2] * v[2] + v[3] * v[3])
	k:Part({
		Name = name,
		Shape = "Cylinder",
		Size = { len + (extra or d * 0.5), d, d },
		Pos = { (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, (a[3] + b[3]) / 2 },
		Rot = axisRot(v),
		Color = color,
		Material = material or "Wood",
	})
end

-- Point on the log surface: theta in degrees measured from the front (-Z) toward +X
local function logPoint(theta, y, out)
	local t = math.rad(theta)
	local r = R(y) + (out or 0)
	return { r * math.sin(t), y, -r * math.cos(t) }
end

-- Part lying on the log surface. Its local -Z faces outward, local Y is up, and `tilt`
-- turns it inside the surface plane.
local function onLog(k, spec, theta, y, out, tilt)
	spec.Pos = logPoint(theta, y, out)
	spec.Rot = { 0, -theta, tilt or 0 }
	spec.Material = spec.Material or "Wood"
	k:Part(spec)
end

-- Group oriented to the log surface (local -Z = outward normal)
local function surfaceGroup(k, name, theta, y, out, anim, fn)
	k:Group({ Name = name, Pos = logPoint(theta, y, out), Rot = { 0, -theta, 0 }, Anim = anim }, fn)
end

local function thetaAt(x, y)
	return deg(math.asin(x / R(y)))
end

--------------------------------------------------------------------------------------------
-- The log (world coordinates)
--------------------------------------------------------------------------------------------
local function grainLine(k, theta, y0, y1, bend, color)
	local ym = (y0 + y1) / 2
	local halves = { { y0, ym, bend }, { ym, y1, -bend } }
	for _, h in halves do
		-- sunk into the surface so the lines never stand proud of the silhouette
		onLog(k, {
			Name = "Grain",
			Size = { 0.055, h[2] - h[1] + 0.03, 0.06 },
			Color = color or GRAIN,
		}, theta, (h[1] + h[2]) / 2, -0.02, h[3])
	end
end

local function knot(k, theta, y, s)
	onLog(k, { Name = "Knot", Shape = "Ellipsoid", Size = { 0.52 * s, 0.38 * s, 0.14 }, Color = KNOT_RING }, theta, y, -0.02)
	onLog(k, { Name = "KnotCore", Shape = "Ellipsoid", Size = { 0.34 * s, 0.24 * s, 0.14 }, Color = KNOT }, theta, y, 0.0)
	onLog(k, { Name = "KnotHeart", Shape = "Ellipsoid", Size = { 0.13 * s, 0.1 * s, 0.1 }, Color = CRACK }, theta, y, 0.03)
end

-- Zig-zag crack running down the surface from (theta, y)
local function crack(k, theta, y, tilts, len)
	local s, cy = 0, y -- s = tangential offset (studs)
	for _, tl in tilts do
		local a = math.rad(tl)
		local ns, ny = s + math.sin(a) * len, cy - math.cos(a) * len
		local my = (cy + ny) / 2
		onLog(k, {
			Name = "Crack",
			Size = { 0.05, len + 0.04, 0.06 },
			Color = CRACK,
		}, theta + deg(((s + ns) / 2) / R(my)), my, -0.02, tl)
		s, cy = ns, ny
	end
end

-- A sawn-off branch stub: breaks the "tin can" silhouette and says LOG instantly
local function branchStub(k, theta, y)
	local t = math.rad(theta)
	local dir = norm({ math.sin(t), 0.45, -math.cos(t) })
	local base = logPoint(theta, y, -0.08)
	k:Part({ Name = "BranchCollar", Shape = "Ellipsoid", Size = { 0.42, 0.66, 0.66 }, Pos = add(base, dir, 0.06), Rot = axisRot(dir), Color = WOOD, Material = "Wood" })
	segment(k, "BranchStub", base, add(base, dir, 0.46), 0.4, WOOD_SHADE, "Wood", 0)
	k:Part({ Name = "StubEnd", Shape = "Cylinder", Size = { 0.05, 0.32, 0.32 }, Pos = add(base, dir, 0.465), Rot = axisRot(dir), Color = END_LIGHT, Material = "Wood" })
	k:Part({ Name = "StubRing", Shape = "Cylinder", Size = { 0.05, 0.17, 0.17 }, Pos = add(base, dir, 0.48), Rot = axisRot(dir), Color = END_DARK, Material = "Wood" })
end

local function buildLog(k)
	-- big forms: the trunk, a worn rounded base and a sanded chamfer under the sawn top
	k:Part({ Name = "Trunk", Shape = "Cylinder", Size = { LOG_TOP - LOG_BOTTOM, RADIUS * 2, RADIUS * 2 }, Pos = { 0, (LOG_TOP + LOG_BOTTOM) / 2, 0 }, Rot = { 0, 0, 90 }, Color = WOOD, Material = "Wood" })
	k:Part({ Name = "BaseLip", Shape = "Ellipsoid", Size = { RADIUS * 2 + 0.08, 0.32, RADIUS * 2 + 0.08 }, Pos = { 0, LOG_BOTTOM + 0.04, 0 }, Color = WOOD_SHADE, Material = "Wood" })
	k:Part({ Name = "TopChamfer", Shape = "Cylinder", Size = { 0.12, RADIUS * 2 - 0.08, RADIUS * 2 - 0.08 }, Pos = { 0, LOG_TOP + 0.04, 0 }, Rot = { 0, 0, 90 }, Color = WOOD_LIGHT, Material = "Wood" })

	-- sawn top: concentric growth rings, flush with the chamfer (each disc slightly off-centre)
	local rings = {
		{ 2.2, END_LIGHT }, { 2.04, END_DARK }, { 1.9, END_LIGHT }, { 1.62, END_DARK },
		{ 1.5, END_LIGHT }, { 1.2, END_DARK }, { 1.08, END_LIGHT }, { 0.76, END_DARK },
		{ 0.64, END_LIGHT }, { 0.3, PITH },
	}
	for i, r in rings do
		local off = (i - 1) * 0.012
		k:Part({
			Name = "EndGrain",
			Shape = "Cylinder",
			Size = { 0.05, r[1], r[1] },
			Pos = { off, LOG_TOP + 0.09 + (i - 1) * 0.005, -off * 0.6 },
			Rot = { 0, 0, 90 },
			Color = r[2],
			Material = "Wood",
		})
	end
	-- radial checking cracks across the end grain
	local TOPY = LOG_TOP + 0.14
	k:Part({ Name = "TopCrack", Size = { 0.05, 0.05, 0.8 }, Pos = { 0.32, TOPY, 0.38 }, Rot = { 0, 34, 0 }, Color = CRACK })
	k:Part({ Name = "TopCrack", Size = { 0.05, 0.05, 0.46 }, Pos = { -0.55, TOPY, -0.08 }, Rot = { 0, -78, 0 }, Color = CRACK })

	-- medium: grain lines of varied length (soft and short on the front, all round elsewhere)
	local LB, LT = LOG_BOTTOM, LOG_TOP
	local grains = {
		{ -28, LB + 0.4, 4.85, 2.5, GRAIN_SOFT }, { 27, LB + 0.55, 4.6, -2.5, GRAIN_SOFT },
		{ 58, LB + 0.25, LT - 0.3, 2 }, { 80, LB + 0.2, 4.85, -2 },
		{ 120, LB + 0.3, LT - 0.25, 2 }, { 158, 4.3, LT - 0.2, -2 },
		{ -58, LB + 0.2, LT - 0.45, -2 }, { -82, LB + 0.6, LT - 0.2, 2 },
		{ -106, LB + 0.2, 5.9, -2 }, { -134, LB + 0.3, LT - 0.25, 2 },
		{ -156, 4.0, LT - 0.3, -2 },
	}
	for _, g in grains do
		grainLine(k, g[1], g[2], g[3], g[4], g[5])
	end

	-- knots (between grain lines)
	knot(k, -14, 3.45, 0.62)
	knot(k, -120, 6.7, 0.9)
	knot(k, 141, 7.0, 0.85)
	knot(k, -169, 3.15, 0.8)
	knot(k, 69, 4.25, 0.7)

	-- cracks
	crack(k, 166, LOG_TOP - 0.06, { 12, -20, 16 }, 0.34)
	crack(k, -70, LOG_TOP - 0.08, { -14, 18, -10 }, 0.28)
	crack(k, 44, LOG_BOTTOM + 0.95, { 18, -16, 14 }, 0.28)

	-- old nail holes / worm holes
	for _, h in { { 132, 5.5 }, { -94, 3.85 }, { -146, 7.3 }, { 104, 6.9 } } do
		onLog(k, { Name = "NailHole", Shape = "Ellipsoid", Size = { 0.09, 0.09, 0.06 }, Color = CRACK }, h[1], h[2], 0.0)
	end

	-- a sawn-off branch round the back of his right flank
	branchStub(k, 140, 3.45)

	-- open wood pores: tiny dark flecks that give the plain front some texture
	for _, f in { { -6, 3.0 }, { 13, 3.9 }, { 8, 2.95 }, { -20, 4.45 } } do
		onLog(k, { Name = "Pore", Shape = "Ellipsoid", Size = { 0.05, 0.12, 0.05 }, Color = GRAIN }, f[1], f[2], 0.0)
	end

	-- the kentongan slit drum on his back
	onLog(k, { Name = "SlitRim", Size = { 0.38, 1.7, 0.08 }, Color = WOOD_SHADE }, 180, 4.75, -0.02)
	onLog(k, { Name = "Slit", Size = { 0.2, 1.46, 0.08 }, Color = CRACK }, 180, 4.75, 0.0)
	onLog(k, { Name = "SlitEnd", Shape = "Ellipsoid", Size = { 0.26, 0.2, 0.1 }, Color = CRACK }, 180, 5.48, 0.0)
	onLog(k, { Name = "SlitEnd", Shape = "Ellipsoid", Size = { 0.26, 0.2, 0.1 }, Color = CRACK }, 180, 4.02, 0.0)

	-- peg holes where the stick limbs are plugged in
	k:Mirror(function()
		onLog(k, { Name = "ShoulderPeg", Shape = "Ellipsoid", Size = { 0.36, 0.36, 0.12 }, Color = WOOD_SHADE }, 90, SHOULDER_Y, 0.0)
		k:Part({ Name = "HipPeg", Shape = "Cylinder", Size = { 0.1, 0.36, 0.36 }, Pos = { 0.55, LOG_BOTTOM - 0.1, 0 }, Rot = { 0, 0, 90 }, Color = LIMB_DARK, Material = "Wood" })
	end)
end

--------------------------------------------------------------------------------------------
-- Face
--------------------------------------------------------------------------------------------
local BLINK = { Type = "Blink", Speed = 0.3, Phase = 0.2 }
local EYE_X = 0.52

local function buildFace(k)
	k:Mirror(function()
		-- big round bulging eye in a thin carved socket
		surfaceGroup(k, "Eye", thetaAt(EYE_X, EYE_Y), EYE_Y, 0.0, nil, function()
			k:Part({ Name = "EyeSocket", Shape = "Ellipsoid", Size = { 0.99, 1.05, 0.2 }, Pos = { 0, 0, 0.01 }, Color = WOOD_SHADE, Material = "Wood" })
			k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.92, 0.98, 0.3 }, Pos = { 0, 0, 0.0 }, Color = EYE_WHITE, Anim = BLINK })
			k:Group({ Name = "Look", Anim = { Type = "Bob", Axis = "X", Amount = 0.05, Speed = 0.25, Phase = 0.1 } }, function()
				k:Part({ Name = "Pupil", Shape = "Ellipsoid", Size = { 0.22, 0.24, 0.1 }, Pos = { -0.02, 0.0, -0.13 }, Color = PUPIL, Anim = BLINK })
				k:Part({ Name = "EyeShine", Shape = "Ball", Size = { 0.08, 0.08, 0.08 }, Pos = { 0.045, 0.07, -0.18 }, Color = SHINE, Material = "Neon", Anim = BLINK })
				k:Part({ Name = "EyeShineSmall", Shape = "Ball", Size = { 0.05, 0.05, 0.05 }, Pos = { -0.08, -0.06, -0.17 }, Color = SHINE, Anim = BLINK })
			end)
		end)
		-- thin arched brow, raised a little high (unsettling); two overlapping ellipsoids
		-- give a smooth arch that hugs the curve of the log
		surfaceGroup(k, "Brow", thetaAt(0.5, EYE_Y + 0.74), EYE_Y + 0.74, -0.01, { Type = "Bob", Axis = "Y", Amount = 0.035, Speed = 0.45 }, function()
			k:Part({ Name = "BrowInner", Shape = "Ellipsoid", Size = { 0.4, 0.12, 0.07 }, Pos = { -0.15, -0.03, 0.01 }, Rot = { 0, 7, 15 }, Color = BROW })
			k:Part({ Name = "BrowOuter", Shape = "Ellipsoid", Size = { 0.4, 0.12, 0.07 }, Pos = { 0.17, -0.02, 0.012 }, Rot = { 0, -8, -13 }, Color = BROW })
		end)
	end)

	-- wide grin: a smooth crescent of overlapping ellipsoids, thick in the middle and thin at
	-- the up-turned corners, with a row of rounded upper teeth
	local N = 9
	local HALF = 0.84
	local CURVE = 0.27
	for i = 0, N - 1 do
		local u = -1 + (2 * i + 1) / N
		local x = HALF * u
		local yTop = MOUTH_Y + CURVE * u * u
		local h = 0.075 + 0.2 * (1 - u * u)
		local yc = yTop - h / 2
		local slope = (2 * CURVE + 0.2) * u / HALF
		onLog(k, { Name = "Mouth", Shape = "Ellipsoid", Size = { (2 * HALF / N) * 1.75, h + 0.03, 0.08 }, Color = MOUTH }, thetaAt(x, yc), yc, -0.015, deg(math.atan(slope)))
	end
	for _, u in { -0.52, -0.26, 0, 0.26, 0.52 } do
		local x = HALF * u
		local yt = MOUTH_Y + CURVE * u * u - 0.065
		local slope = 2 * CURVE * u / HALF
		onLog(k, { Name = "Tooth", Shape = "Ellipsoid", Size = { 0.25, 0.12, 0.07 }, Color = TEETH }, thetaAt(x, yt), yt, 0.0, deg(math.atan(slope)))
	end
	k:Mirror(function()
		local cx = HALF + 0.06
		onLog(k, { Name = "SmileCrease", Shape = "Ellipsoid", Size = { 0.06, 0.2, 0.06 }, Color = MOUTH }, thetaAt(cx, MOUTH_Y + 0.31), MOUTH_Y + 0.31, -0.01, -28)
	end)
end

--------------------------------------------------------------------------------------------
-- Arms
--------------------------------------------------------------------------------------------
local S_R = { 1.15, SHOULDER_Y, 0 }
local E_R = { 1.96, 5.02, 0.06 }
local H_R = { 2.14, 5.95, -0.08 }
local BAT_DIR = norm({ 0.16, 1, 0.2 })

local S_L = { -1.15, SHOULDER_Y, 0 }
local E_L = { -1.68, 4.55, -0.06 }
local H_L = { -1.86, 3.7, -0.12 }

local function batPoint(t)
	return add(H_R, BAT_DIR, t)
end

local function buildBat(k)
	-- two axes perpendicular to the bat, for grain lines and scuffs
	local u = norm(cross(BAT_DIR, { 0, 0, 1 }))
	local w = norm(cross(BAT_DIR, u))
	local function around(t, a, r)
		local ar = math.rad(a)
		local off = add({ u[1] * math.cos(ar), u[2] * math.cos(ar), u[3] * math.cos(ar) }, w, math.sin(ar))
		return add(batPoint(t), off, r)
	end
	local rot = axisRot(BAT_DIR)

	-- flared knob, plain wooden handle with two grip grooves
	k:Part({ Name = "BatKnob", Shape = "Ellipsoid", Size = { 0.16, 0.32, 0.32 }, Pos = batPoint(-0.6), Rot = rot, Color = BAT, Material = "Wood" })
	segment(k, "KnobNeck", batPoint(-0.62), batPoint(-0.5), 0.27, BAT_DARK, "Wood", 0)
	segment(k, "Handle", batPoint(-0.55), batPoint(1.25), 0.17, BAT, "Wood", 0)
	for _, t in { -0.4, 0.3 } do
		segment(k, "GripGroove", batPoint(t - 0.025), batPoint(t + 0.025), 0.185, BAT_DARK, "Wood", 0)
	end
	-- smooth taper into a fat barrel (two overlapping ellipsoids + a cylinder)
	k:Part({ Name = "BatTaper", Shape = "Ellipsoid", Size = { 2.0, 0.36, 0.36 }, Pos = batPoint(1.9), Rot = rot, Color = BAT, Material = "Wood" })
	k:Part({ Name = "BatSwell", Shape = "Ellipsoid", Size = { 1.6, 0.58, 0.58 }, Pos = batPoint(2.6), Rot = rot, Color = BAT, Material = "Wood" })
	segment(k, "Barrel", batPoint(2.6), batPoint(3.12), 0.58, BAT, "Wood", 0)
	k:Part({ Name = "BatTip", Shape = "Ellipsoid", Size = { 0.2, 0.58, 0.58 }, Pos = batPoint(3.12), Rot = rot, Color = BAT, Material = "Wood" })
	segment(k, "BatEndGrain", batPoint(3.19), batPoint(3.24), 0.34, BAT_END, "Wood", 0)

	-- varnish highlight streak and grain lines along the barrel
	segment(k, "BatShine", around(2.2, 135, 0.23), around(3.05, 135, 0.275), 0.06, BAT_LIGHT, "Wood", 0)
	for _, a in { 20, 250 } do
		segment(k, "BatGrain", around(2.15, a, 0.22), around(3.05, a, 0.275), 0.05, BAT_DARK, "Wood", 0)
	end
	-- worn dents on the hitting face from all that knocking
	for _, s in { { 2.75, 200 }, { 2.95, 228 } } do
		k:Part({ Name = "BatDent", Shape = "Ellipsoid", Size = { 0.14, 0.14, 0.14 }, Pos = around(s[1], s[2], 0.26), Color = BAT_DARK, Material = "Wood" })
	end

	-- sawdust shaken off with every knock
	k:Particles({ Pos = batPoint(3.0), Color = "#d9a86a", Color2 = "#f3dcae", Rate = 3, Size = 0.1, Speed = 0.8, Lifetime = 1.2, Spread = 70, Direction = "Top" })
end

local function buildBatArm(k)
	k:Group({ Name = "BatArm", Pos = S_R, Anim = { Type = "Wiggle", Axis = "X", Amount = 20, Speed = 0.9 } }, function()
		k:Group({ Name = "BatArmOffset", Pos = { -S_R[1], -S_R[2], -S_R[3] } }, function()
			k:Part({ Name = "Shoulder", Shape = "Ball", Size = { 0.26, 0.26, 0.26 }, Pos = add(S_R, { 0.08, 0, 0 }), Color = LIMB_DARK, Material = "Wood" })
			segment(k, "UpperArm", S_R, E_R, 0.2, LIMB)
			k:Part({ Name = "Elbow", Shape = "Ball", Size = { 0.27, 0.27, 0.27 }, Pos = E_R, Color = LIMB_DARK, Material = "Wood" })
			segment(k, "Forearm", E_R, H_R, 0.19, LIMB)
			-- wrist snap lags the shoulder a little for a punchy knock
			k:Group({ Name = "Wrist", Pos = H_R, Anim = { Type = "Wiggle", Axis = "X", Amount = 10, Speed = 0.9, Phase = 0.12 } }, function()
				k:Group({ Name = "WristOffset", Pos = { -H_R[1], -H_R[2], -H_R[3] } }, function()
					-- fist wrapped around the handle
					local f = norm({ 0.3, -0.05, -1 })
					local q = cross(BAT_DIR, f)
					f = norm(cross(q, BAT_DIR))
					k:Part({ Name = "Fist", Shape = "Ellipsoid", Size = { 0.4, 0.42, 0.38 }, Pos = H_R, Rot = axisRot(BAT_DIR), Color = LIMB, Material = "Wood" })
					for i = 0, 3 do
						k:Part({ Name = "Knuckle", Shape = "Ball", Size = { 0.12, 0.12, 0.12 }, Pos = add(add(H_R, BAT_DIR, -0.15 + i * 0.1), f, 0.17), Color = LIMB, Material = "Wood" })
					end
					k:Part({ Name = "Thumb", Shape = "Ball", Size = { 0.13, 0.13, 0.13 }, Pos = add(add(H_R, BAT_DIR, 0.2), norm(q), -0.12), Color = LIMB, Material = "Wood" })
					buildBat(k)
				end)
			end)
		end)
	end)
end

local function buildSwayArm(k)
	k:Group({ Name = "SwayArm", Pos = S_L, Anim = { Type = "Wiggle", Axis = "X", Amount = 14, Speed = 0.45, Phase = 0.25 } }, function()
		k:Group({ Name = "SwayArmOffset", Pos = { -S_L[1], -S_L[2], -S_L[3] } }, function()
			k:Part({ Name = "Shoulder", Shape = "Ball", Size = { 0.26, 0.26, 0.26 }, Pos = add(S_L, { -0.08, 0, 0 }), Color = LIMB_DARK, Material = "Wood" })
			segment(k, "UpperArm", S_L, E_L, 0.2, LIMB)
			k:Part({ Name = "Elbow", Shape = "Ball", Size = { 0.27, 0.27, 0.27 }, Pos = E_L, Color = LIMB_DARK, Material = "Wood" })
			segment(k, "Forearm", E_L, H_L, 0.19, LIMB)
			k:Group({ Name = "Hand", Pos = H_L, Anim = { Type = "Wiggle", Axis = "Z", Amount = 8, Speed = 0.45, Phase = 0.4 } }, function()
				k:Group({ Name = "HandOffset", Pos = { -H_L[1], -H_L[2], -H_L[3] } }, function()
					local hx, hy, hz = H_L[1], H_L[2], H_L[3]
					k:Part({ Name = "Wrist", Shape = "Ball", Size = { 0.22, 0.22, 0.22 }, Pos = H_L, Color = LIMB_DARK, Material = "Wood" })
					k:Part({ Name = "Palm", Shape = "Ellipsoid", Size = { 0.18, 0.4, 0.34 }, Pos = { hx - 0.02, hy - 0.2, hz }, Color = LIMB, Material = "Wood" })
					-- relaxed fingers that drum along to the beat
					local knuck = { hx - 0.02, hy - 0.34, hz }
					k:Group({ Name = "Fingers", Pos = knuck, Anim = { Type = "Wiggle", Axis = "Z", Amount = 12, Speed = 0.9, Phase = 0.3 } }, function()
						for _, dz in { -0.11, -0.035, 0.04, 0.11 } do
							segment(k, "Finger", { 0, 0, dz }, { 0.02, -0.2, dz * 1.2 - 0.05 }, 0.07, LIMB)
						end
					end)
					segment(k, "Thumb", { hx - 0.01, hy - 0.14, hz - 0.13 }, { hx + 0.03, hy - 0.3, hz - 0.25 }, 0.08, LIMB)
				end)
			end)
		end)
	end)
end

--------------------------------------------------------------------------------------------
-- Legs (not in the bouncing body, so the feet stay planted)
--------------------------------------------------------------------------------------------
local function buildLeg(k, sx, tap)
	local hip = { sx * 0.55, LOG_BOTTOM - 0.02, 0 }
	local knee = { sx * 0.6, 1.34, -0.04 }
	local ankle = { sx * 0.6, 0.34, 0.04 }
	segment(k, "Thigh", hip, knee, 0.22, LIMB)
	k:Part({ Name = "Knee", Shape = "Ball", Size = { 0.28, 0.28, 0.28 }, Pos = knee, Color = LIMB_DARK, Material = "Wood" })
	segment(k, "Shin", knee, ankle, 0.2, LIMB)

	local pivot = { sx * 0.6, 0.0, 0.3 } -- heel
	k:Group({
		Name = "Foot",
		Pos = pivot,
		Rot = { tap and 5 or 0, 0, 0 },
		Anim = tap and { Type = "Wiggle", Axis = "X", Amount = 5, Speed = 0.9, Phase = 0.05 } or nil,
	}, function()
		k:Group({ Name = "FootOffset", Pos = { -pivot[1], 0, -pivot[3] } }, function()
			local fx = sx * 0.6
			k:Part({ Name = "Ankle", Shape = "Ball", Size = { 0.25, 0.25, 0.25 }, Pos = ankle, Color = LIMB_DARK, Material = "Wood" })
			-- bare wooden foot: flat sole with a heel, a raised instep and graded toes
			k:Part({ Name = "FootSole", Shape = "Ellipsoid", Size = { 0.46, 0.2, 0.92 }, Pos = { fx, 0.1, -0.14 }, Color = LIMB, Material = "Wood" })
			k:Part({ Name = "Instep", Shape = "Ellipsoid", Size = { 0.36, 0.26, 0.56 }, Pos = { fx, 0.19, -0.04 }, Color = LIMB, Material = "Wood" })
			-- big toe on the inside, smaller toes outward
			local toes = { { -0.13, 0.15, -0.56 }, { -0.01, 0.12, -0.58 }, { 0.1, 0.11, -0.55 }, { 0.19, 0.09, -0.49 } }
			-- toes of the planted foot wiggle gently about their own knuckle line
			k:Group({ Name = "Toes", Pos = { fx, 0.06, -0.5 }, Anim = (not tap) and { Type = "Wiggle", Axis = "X", Amount = 6, Speed = 0.6, Phase = 0.5 } or nil }, function()
				for _, t in toes do
					local d = t[2]
					k:Part({ Name = "Toe", Shape = "Ball", Size = { d, d, d }, Pos = { sx * t[1], d / 2 - 0.06, t[3] + 0.5 }, Color = LIMB, Material = "Wood" })
				end
			end)
		end)
	end)
end

return {
	Id = "TungTungTungSahur",
	Name = "Tung Tung Tung Sahur",
	Rarity = "Rare",
	Emoji = "🪵",
	Color = WOOD,
	Tagline = "Didn't answer the sahur call? Tung tung tung...",
	Lore = "A wooden log with a bat who walks the streets before dawn, knocking to wake everyone for sahur. Ignore his call three times and he comes to your door personally. Nobody has ever ignored it four times.",

	Build = function(k)
		buildLeg(k, 1, true)
		buildLeg(k, -1, false)

		-- body bounces in rhythm and sways a little around the base of the log
		k:Group({ Name = "Body", Pos = { 0, LOG_BOTTOM, 0 }, Anim = { Type = "Bob", Axis = "Y", Amount = 0.07, Speed = 1.8 } }, function()
			k:Group({ Name = "Sway", Anim = { Type = "Wiggle", Axis = "Z", Amount = 2.5, Speed = 0.45 } }, function()
				k:Group({ Name = "BodyOffset", Pos = { 0, -LOG_BOTTOM, 0 } }, function()
					buildLog(k)
					buildFace(k)
					buildBatArm(k)
					buildSwayArm(k)
				end)
			end)
		end)

		-- Rare flair: warm key glow on the face, a soft rim light behind, drifting wood dust
		k:Light({ Pos = { 0, 6.4, -2.1 }, Color = GLOW, Range = 10, Brightness = 0.9 })
		k:Light({ Pos = { 0, 9.0, 1.8 }, Color = "#ffd59a", Range = 8, Brightness = 0.6 })
		k:Particles({ Pos = { 0, 0.3, 0 }, Color = DUST, Color2 = "#fff1d6", Rate = 4, Size = 0.16, Speed = 0.5, Lifetime = 2.2, Spread = 180, Direction = "Top" })
	end,

	BuildMini = function(k)
		k:Part({ Name = "Log", Shape = "Cylinder", Size = { 1.6, 0.94, 0.94 }, Pos = { 0, 0.14, 0 }, Rot = { 0, 0, 90 }, Color = WOOD, Material = "Wood" })
		-- sawn end grain on top so it reads as a log, not a can
		k:Part({ Name = "EndGrain", Shape = "Cylinder", Size = { 0.05, 0.8, 0.8 }, Pos = { 0, 0.95, 0 }, Rot = { 0, 0, 90 }, Color = END_LIGHT, Material = "Wood" })
		k:Mirror(function()
			k:Part({ Name = "EyeWhite", Shape = "Ellipsoid", Size = { 0.32, 0.34, 0.2 }, Pos = { 0.19, 0.56, -0.41 }, Rot = { 0, -12, 0 }, Color = EYE_WHITE })
			k:Part({ Name = "Pupil", Shape = "Ball", Size = { 0.11, 0.11, 0.11 }, Pos = { 0.19, 0.56, -0.5 }, Color = PUPIL })
			k:Part({ Name = "Leg", Shape = "Cylinder", Size = { 0.62, 0.12, 0.12 }, Pos = { 0.22, -0.95, 0 }, Rot = { 0, 0, 90 }, Color = LIMB, Material = "Wood" })
		end)
		-- one dark ellipsoid tipped back into the log: only its lower half shows, so it
		-- reads as a wide D-shaped grin whose corners curl up round the log
		k:Part({ Name = "Grin", Shape = "Ellipsoid", Size = { 0.6, 0.3, 0.12 }, Pos = { 0, 0.33, -0.43 }, Rot = { 55, 0, 0 }, Color = MOUTH })
		segment(k, "Arm", { 0.42, 0.08, 0 }, { 0.68, 0.36, 0 }, 0.1, LIMB)
		-- bat: thin handle in the fist, long fat barrel on top
		local dir = norm({ 0.1, 1, 0 })
		local grip = { 0.68, 0.36, 0 }
		segment(k, "BatHandle", add(grip, dir, -0.06), add(grip, dir, 0.5), 0.09, BAT, "Wood", 0)
		segment(k, "BatBarrel", add(grip, dir, 0.42), add(grip, dir, 0.95), 0.19, BAT, "Wood", 0)
	end,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Brainrot Factory Tycoon - global configuration.

	This is the main file you edit to tune the game:
	  * Paste your Game Pass / Developer Product IDs into GamePasses / Products.
	  * Add or remove promo codes in Codes.
	  * Tweak economy numbers (run tools/economy_sim.py after big changes).
]]

local Config = {}

Config.GameName = "Brainrot Factory Tycoon"

-- Bump the version suffix to wipe everyone's progress (e.g. after a big economy change).
Config.DataStoreName = "BrainrotTycoon_v1"
Config.LeaderboardStoreName = "BrainrotTycoon_TotalEarned_v1"

-- When true, buying passes/products inside Roblox Studio grants them for free so you
-- can test everything before you create the real passes. Has no effect in live games.
Config.StudioFreePurchases = true

-- Optional: your Roblox group ID. Members get a cash bonus (great for growing a community).
Config.GroupId = 0
Config.GroupBonus = 0.10

-- Every friend in the same server gives +10% cash (max +40%). Encourages invites.
Config.FriendBonusPer = 0.10
Config.FriendBonusMax = 0.40

-- World layout. IMPORTANT: set your game's Max Players (Places > Settings) to MaxPlots.
Config.MaxPlots = 8
Config.PlotRingRadius = 190
Config.PlotSize = 100

-- Drops
Config.DropInterval = 2 -- seconds between drops for every dropper
Config.FastDropperMultiplier = 0.67 -- interval multiplier with the Fast Droppers pass
Config.DropLifetime = 30
Config.MaxDropsPerPlot = 90
Config.ConveyorSpeed = 11
Config.AutoCollectInterval = 1

Config.Rebirth = {
	BaseCost = 300_000_000,
	CostGrowth = 2.2,
	MultiplierPerRebirth = 1.0, -- each rebirth adds +100% cash permanently
}

-- Rare "mutations" a drop can roll when it spawns. Checked top to bottom.
Config.Mutations = {
	{ Name = "Rainbow", Chance = 0.002, Multiplier = 50, Color = Color3.fromRGB(255, 80, 200), Announce = true },
	{ Name = "Diamond", Chance = 0.01, Multiplier = 10, Color = Color3.fromRGB(120, 230, 255), Announce = true },
	{ Name = "Gold", Chance = 0.05, Multiplier = 3, Color = Color3.fromRGB(255, 205, 50), Announce = false },
}

-- Brainrot Index: every character x variant (Normal + each mutation) a player spawns is
-- recorded forever and adds a permanent cash bonus. 12 characters x 4 variants = 48.
Config.IndexBonusPerDiscovery = 0.005

--[[
	GAME PASSES - create them on create.roblox.com (Your game > Monetization > Passes),
	then paste each ID below. Id = 0 means "not set up yet".
]]
Config.GamePasses = {
	DoubleCash = {
		Id = 0,
		Name = "2x Cash",
		Emoji = "💸",
		Description = "Double ALL cash you earn, forever!",
		SuggestedPrice = 199,
	},
	AutoCollect = {
		Id = 0,
		Name = "Auto Collect",
		Emoji = "🧲",
		Description = "Cash flows straight into your wallet. No more walking to the collector!",
		SuggestedPrice = 149,
	},
	LuckyMutations = {
		Id = 0,
		Name = "Lucky Mutations",
		Emoji = "🍀",
		Description = "3x chance for Gold, Diamond and Rainbow brainrots!",
		SuggestedPrice = 249,
	},
	FastDroppers = {
		Id = 0,
		Name = "Fast Droppers",
		Emoji = "⚡",
		Description = "All your droppers spawn brainrots 50% faster!",
		SuggestedPrice = 299,
	},
	VIP = {
		Id = 0,
		Name = "VIP",
		Emoji = "👑",
		Description = "+50% cash, a golden [VIP] chat tag and VIP sparkles!",
		SuggestedPrice = 399,
	},
}

--[[
	DEVELOPER PRODUCTS - repeatable purchases (Monetization > Developer Products).
	Cash packs scale with the player's income so they stay valuable all game long.
]]
Config.Products = {
	CashSmall = {
		Id = 0,
		Name = "Pile of Cash",
		Emoji = "💵",
		Kind = "Cash",
		IncomeSeconds = 15 * 60,
		Minimum = 2_500,
		SuggestedPrice = 49,
	},
	CashMedium = {
		Id = 0,
		Name = "Bag of Cash",
		Emoji = "💰",
		Kind = "Cash",
		IncomeSeconds = 60 * 60,
		Minimum = 15_000,
		SuggestedPrice = 149,
	},
	CashLarge = {
		Id = 0,
		Name = "Vault of Cash",
		Emoji = "🏦",
		Kind = "Cash",
		IncomeSeconds = 6 * 60 * 60,
		Minimum = 100_000,
		SuggestedPrice = 499,
	},
	RainbowRain = {
		Id = 0,
		Name = "Rainbow Rain (Server Event)",
		Emoji = "🌈",
		Kind = "Event",
		Event = "RainbowRain",
		SuggestedPrice = 99,
	},
	CashFrenzy = {
		Id = 0,
		Name = "Cash Frenzy (Server Event)",
		Emoji = "🤑",
		Kind = "Event",
		Event = "CashFrenzy",
		SuggestedPrice = 79,
	},
}

-- Server-wide events. Random ones fire on their own; paid ones are bought by players
-- and boost EVERYONE in the server (people love being the hero, and it's very shareable).
Config.Events = {
	GoldRush = { Name = "GOLD RUSH", Emoji = "⛏️", Duration = 180, LuckMultiplier = 3, CashMultiplier = 1, Random = true },
	CashFrenzy = { Name = "CASH FRENZY", Emoji = "🤑", Duration = 300, LuckMultiplier = 1, CashMultiplier = 2, Random = true },
	RainbowRain = { Name = "RAINBOW RAIN", Emoji = "🌈", Duration = 300, LuckMultiplier = 10, CashMultiplier = 1, Random = false },
}
Config.RandomEventDelay = { Min = 8 * 60, Max = 14 * 60 }

-- Daily login rewards (streak of 7, then loops). Reward = max(Minimum, income * IncomeSeconds).
Config.DailyRewards = {
	{ IncomeSeconds = 2 * 60, Minimum = 500 },
	{ IncomeSeconds = 4 * 60, Minimum = 1_500 },
	{ IncomeSeconds = 6 * 60, Minimum = 4_000 },
	{ IncomeSeconds = 8 * 60, Minimum = 10_000 },
	{ IncomeSeconds = 10 * 60, Minimum = 25_000 },
	{ IncomeSeconds = 15 * 60, Minimum = 60_000 },
	{ IncomeSeconds = 30 * 60, Minimum = 150_000 },
}
Config.DailyCooldown = 20 * 60 * 60 -- can claim again after 20h
Config.DailyStreakWindow = 48 * 60 * 60 -- streak resets if you miss more than this

-- Free gift every few minutes of playtime (keeps sessions long, which the algorithm loves).
Config.PlaytimeGift = { Interval = 8 * 60, IncomeSeconds = 90, Minimum = 300 }

-- Money earned while offline.
Config.OfflineEarnings = { Rate = 0.25, MaxSeconds = 4 * 60 * 60, MinSeconds = 120 }

--[[
	PROMO CODES - post new ones on your social media / Discord to drive traffic.
	Codes are case-insensitive. Reward is Cash (flat) and/or IncomeSeconds (scales).
]]
Config.Codes = {
	RELEASE = { Cash = 1_000 },
	BRAINROT = { IncomeSeconds = 5 * 60, Minimum = 2_500 },
	THANKS = { IncomeSeconds = 10 * 60, Minimum = 5_000 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy formulas shared by server and client so both always agree.
]]

local Config = require(script.Parent.Config)
local Items = require(script.Parent.Items)

local Economy = {}

function Economy.RebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

function Economy.RebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.Rebirth.MultiplierPerRebirth
end

-- Cash per second a plot produces before player multipliers (ignores mutations).
function Economy.PlotIncome(owned: { [string]: boolean }, fastDroppers: boolean): number
	local perDrop = 0
	local multiplier = 1
	for id in owned do
		local item = Items.ById[id]
		if item then
			if item.Type == "Dropper" then
				perDrop += item.Value
			elseif item.Type == "Upgrader" or item.Type == "Collector" then
				multiplier *= item.Multiplier
			end
		end
	end
	local interval = Config.DropInterval * (if fastDroppers then Config.FastDropperMultiplier else 1)
	return perDrop / interval * multiplier
end

-- Variant names tracked by the Brainrot Index, rarest last.
function Economy.IndexVariants(): { string }
	local variants = { "Normal" }
	for i = #Config.Mutations, 1, -1 do
		table.insert(variants, Config.Mutations[i].Name)
	end
	return variants
end

function Economy.IndexBonus(discoveries: number): number
	return discoveries * Config.IndexBonusPerDiscovery
end

-- Reward that scales with how far along the player is, with a floor for new players.
function Economy.ScaledReward(incomePerSecond: number, seconds: number, minimum: number): number
	return math.floor(math.max(minimum, incomePerSecond * seconds))
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Number and time formatting shared by server and client.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15300000 -> "15.3M"
function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local text = if n == math.floor(n) then tostring(n) else string.format("%.1f", n)
		return (if negative then "-" else "") .. text
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		text = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	if text:find(".", 1, true) then
		text = text:gsub("0+$", ""):gsub("%.$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[tier + 1]
end

function Format.Cash(n: number): string
	return "$" .. Format.Short(n)
end

-- 3725 -> "1:02:05", 125 -> "2:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--[[
	Everything a player can buy on their plot, in progression order.

	Fields
	  Id        unique key (saved in player data - don't rename once the game is live)
	  Name      shown on the buy button
	  Price     cost in cash
	  Requires  Id that must be owned before this button appears (nil = always visible)
	  Type      "Dropper" | "Upgrader" | "Collector" | "Decor"

	  Dropper:   Value (cash per drop) and Character (Id of a file in Shared/Characters -
	             the brainrot shown on the dropper and riding the conveyor)
	  Upgrader:  Multiplier applied to every drop that passes through it, Color
	  Collector: Multiplier applied when drops are collected
	  Decor:     Build = name of a builder in server/Builders.luau

	Pacing was tuned with tools/economy_sim.py - keep the two in sync.
]]

local Items = {}

Items.List = {
	{
		Id = "D1",
		Name = "Lirilì Larilà Dropper",
		Price = 0,
		Type = "Dropper",
		Value = 2,
		Character = "LiriliLarila",
	},
	{
		Id = "D2",
		Name = "Boneca Ambalabu Dropper",
		Price = 60,
		Requires = "D1",
		Type = "Dropper",
		Value = 6,
		Character = "BonecaAmbalabu",
	},
	{ Id = "Walls", Name = "Factory Walls", Price = 200, Requires = "D2", Type = "Decor", Build = "Walls" },
	{
		Id = "D3",
		Name = "Brr Brr Patapim Dropper",
		Price = 350,
		Requires = "D2",
		Type = "Dropper",
		Value = 15,
		Character = "BrrBrrPatapim",
	},
	{
		Id = "Up1",
		Name = "Bubble Wash (x1.5)",
		Price = 1_000,
		Requires = "D3",
		Type = "Upgrader",
		Multiplier = 1.5,
		Color = Color3.fromRGB(90, 200, 255),
	},
	{
		Id = "D4",
		Name = "Trippi Troppi Dropper",
		Price = 2_000,
		Requires = "D3",
		Type = "Dropper",
		Value = 40,
		Character = "TrippiTroppi",
	},
	{ Id = "Lights", Name = "Disco Lamps", Price = 4_000, Requires = "D4", Type = "Decor", Build = "Lights" },
	{
		Id = "D5",
		Name = "Tung Tung Tung Sahur Dropper",
		Price = 9_000,
		Requires = "D4",
		Type = "Dropper",
		Value = 100,
		Character = "TungTungTungSahur",
	},
	{ Id = "Sign", Name = "Giant Neon Sign", Price = 18_000, Requires = "D5", Type = "Decor", Build = "Sign" },
	{
		Id = "D6",
		Name = "Cappuccino Assassino Dropper",
		Price = 35_000,
		Requires = "D5",
		Type = "Dropper",
		Value = 250,
		Character = "CappuccinoAssassino",
	},
	{
		Id = "Up2",
		Name = "Rizz Laser (x2)",
		Price = 60_000,
		Requires = "D6",
		Type = "Upgrader",
		Multiplier = 2,
		Color = Color3.fromRGB(255, 60, 160),
	},
	{
		Id = "D7",
		Name = "Chimpanzini Bananini Dropper",
		Price = 100_000,
		Requires = "D6",
		Type = "Dropper",
		Value = 650,
		Character = "ChimpanziniBananini",
	},
	{ Id = "Garden", Name = "Meme Garden", Price = 180_000, Requires = "D7", Type = "Decor", Build = "Garden" },
	{
		Id = "D8",
		Name = "Frigo Camelo Dropper",
		Price = 350_000,
		Requires = "D7",
		Type = "Dropper",
		Value = 1_600,
		Character = "FrigoCamelo",
	},
	{
		Id = "Collector",
		Name = "Golden Collector (x1.5)",
		Price = 700_000,
		Requires = "D8",
		Type = "Collector",
		Multiplier = 1.5,
	},
	{
		Id = "D9",
		Name = "Ballerina Cappuccina Dropper",
		Price = 1_400_000,
		Requires = "D8",
		Type = "Dropper",
		Value = 4_000,
		Character = "BallerinaCappuccina",
	},
	{ Id = "Fountain", Name = "Cash Fountain", Price = 2_800_000, Requires = "D9", Type = "Decor", Build = "Fountain" },
	{
		Id = "D10",
		Name = "Bombardiro Crocodilo Dropper",
		Price = 5_500_000,
		Requires = "D9",
		Type = "Dropper",
		Value = 10_000,
		Character = "BombardiroCrocodilo",
	},
	{
		Id = "Up3",
		Name = "Galaxy Portal (x3)",
		Price = 12_000_000,
		Requires = "D10",
		Type = "Upgrader",
		Multiplier = 3,
		Color = Color3.fromRGB(150, 90, 255),
	},
	{
		Id = "D11",
		Name = "Tralalero Tralala Dropper",
		Price = 25_000_000,
		Requires = "D10",
		Type = "Dropper",
		Value = 25_000,
		Character = "TralaleroTralala",
	},
	{ Id = "Statue", Name = "Golden Brainrot Statue", Price = 40_000_000, Requires = "D11", Type = "Decor", Build = "Statue" },
	{
		Id = "D12",
		Name = "La Vacca Saturno Dropper",
		Price = 70_000_000,
		Requires = "D11",
		Type = "Dropper",
		Value = 70_000,
		Character = "LaVaccaSaturnoSaturnita",
	},
	{ Id = "Throne", Name = "Brainrot Throne", Price = 120_000_000, Requires = "D12", Type = "Decor", Build = "Throne" },
	{ Id = "Rocket", Name = "Brainrot Rocket", Price = 220_000_000, Requires = "Throne", Type = "Decor", Build = "Rocket" },
}

Items.ById = {}
local dropperSlot, upgraderSlot = 0, 0
for index, item in Items.List do
	item.Index = index
	if item.Type == "Dropper" then
		dropperSlot += 1
		item.Slot = dropperSlot
	elseif item.Type == "Upgrader" then
		upgraderSlot += 1
		item.Slot = upgraderSlot
	end
	assert(Items.ById[item.Id] == nil, "Duplicate item id " .. item.Id)
	Items.ById[item.Id] = item
end

for _, item in Items.List do
	assert(item.Requires == nil or Items.ById[item.Requires], `Item {item.Id} requires unknown item {item.Requires}`)
end

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Rarity</string>
          <string name="Source"><![CDATA[--[[
	Rarity tiers for brainrot characters. Higher tiers get flashier pedestals,
	auras and nameplates (see server/RarityFX.luau) and more detailed models.
]]

local Rarity = {}

export type Tier = {
	Key: string,
	Name: string,
	Order: number,
	Color: Color3,
	Color2: Color3, -- gradient partner for nameplates
	Rainbow: boolean,
}

Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Rarity.Tiers = {
	Common = { Name = "Common", Color = Color3.fromRGB(190, 190, 205), Color2 = Color3.fromRGB(140, 140, 160) },
	Uncommon = { Name = "Uncommon", Color = Color3.fromRGB(90, 230, 110), Color2 = Color3.fromRGB(40, 170, 80) },
	Rare = { Name = "Rare", Color = Color3.fromRGB(70, 170, 255), Color2 = Color3.fromRGB(40, 100, 230) },
	Epic = { Name = "Epic", Color = Color3.fromRGB(185, 95, 255), Color2 = Color3.fromRGB(120, 50, 220) },
	Legendary = { Name = "Legendary", Color = Color3.fromRGB(255, 205, 60), Color2 = Color3.fromRGB(255, 130, 30) },
	Mythic = { Name = "Mythic", Color = Color3.fromRGB(255, 70, 140), Color2 = Color3.fromRGB(200, 30, 90) },
	Secret = { Name = "SECRET", Color = Color3.fromRGB(255, 255, 255), Color2 = Color3.fromRGB(20, 20, 30), Rainbow = true },
} :: { [string]: any }

for order, key in Rarity.Order do
	local tier = Rarity.Tiers[key]
	tier.Key = key
	tier.Order = order
	tier.Rainbow = tier.Rainbow == true
end

function Rarity.Get(key: string?): Tier
	return Rarity.Tiers[key or "Common"] or Rarity.Tiers.Common
end

return Rarity
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="23">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Brainrot Factory Tycoon - server entry point.

	Every service is a ModuleScript under this Script. Init() runs for all services in
	order (wiring, no yielding), then Start() runs for each in its own thread.
]]

local ORDER = {
	"Remotes",
	"WorldBuilder",
	"DataService",
	"EventService",
	"DropService",
	"PlotService",
	"PlayerService",
	"MonetizationService",
	"LeaderboardService",
}

local Services = {}
for _, name in ORDER do
	Services[name] = require(script:WaitForChild(name)) :: any
end
for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		service.Init(Services)
	end
end
for _, name in ORDER do
	local service = Services[name]
	if service.Start then
		task.spawn(service.Start)
	end
end

print("[BrainrotTycoon] Server started")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Builders</string>
          <string name="Source"><![CDATA[--[[
	Procedural model builders. Every model in the game is generated from code, so the
	place file needs no hand-built assets.

	All positions are in PLOT-LOCAL space: the plot centre is (0, 0, 0), the floor top
	is y = 1, the conveyor runs along +X at z = 0, and the front (buy buttons and the
	spawn point) faces +Z toward the lobby.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local CharacterKit = require(ReplicatedStorage.Shared.CharacterKit)
local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local Rarity = require(ReplicatedStorage.Shared.Rarity)
local RarityFX = require(script.Parent.RarityFX)

local Builders = {}

Builders.FLOOR_TOP = 1
Builders.CONVEYOR_TOP = 2
Builders.CONVEYOR_START_X = -36
Builders.CONVEYOR_END_X = 34
Builders.COLLECTOR_X = 37
Builders.COLLECT_PAD_POS = Vector3.new(37, 1.2, 11)
Builders.SPAWN_POS = Vector3.new(0, 4, 47)

local BUTTON_COLUMNS = 11

type PartProps = { [string]: any }

-- Create an anchored part positioned in plot-local space.
local function part(parent: Instance, plotCF: CFrame, size: Vector3, localPos: Vector3, props: PartProps?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = plotCF * CFrame.new(localPos)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end
Builders.Part = part

local function model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- A camera-facing label. Use for prices, names and emoji.
function Builders.Billboard(adornee: BasePart, text: string, sizeStuds: Vector2, offsetY: number, maxDistance: number?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(sizeStuds.X, sizeStuds.Y)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 90
	gui.Adornee = adornee
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = text
	label.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	return label
end

-- Model "rises" out of the floor when purchased.
function Builders.PlayBuildAnimation(m: Model)
	local finalPivot = m:GetPivot()
	local _, size = m:GetBoundingBox()
	local start = finalPivot * CFrame.new(0, -size.Y, 0)
	local value = Instance.new("CFrameValue")
	value.Value = start
	m:PivotTo(start)
	value.Changed:Connect(function(cf)
		if m.Parent then
			m:PivotTo(cf)
		end
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Value = finalPivot,
	})
	tween.Completed:Once(function()
		value:Destroy()
	end)
	tween:Play()
end

-- Confetti burst at a world position (used on purchases).
function Builders.Confetti(parent: Instance, position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	anchor.Parent = parent

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 200)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 220, 255)),
	})
	emitter.Size = NumberSequence.new(0.6, 0)
	emitter.Speed = NumberRange.new(18, 30)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Rate = 0
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = anchor
	emitter:Emit(60)
	task.delay(2, function()
		anchor:Destroy()
	end)
end

----------------------------------------------------------------------------------------
-- Plot base
----------------------------------------------------------------------------------------

export type PlotParts = {
	Model: Model,
	Conveyor: BasePart,
	Collector: BasePart,
	CollectPad: BasePart,
	BankLabel: TextLabel,
	OwnerLabel: TextLabel,
	ItemsFolder: Folder,
	ButtonsFolder: Folder,
	DropsFolder: Folder,
}

function Builders.PlotBase(plotCF: CFrame, plotId: number, parent: Instance): PlotParts
	local m = model("Plot" .. plotId, parent)
	m:SetAttribute("PlotId", plotId)
	local base = model("Base", m)

	local floor = part(base, plotCF, Vector3.new(100, 1, 100), Vector3.new(0, 0.5, 0), {
		Name = "Floor",
		Color = Color3.fromRGB(70, 75, 95),
		Material = Enum.Material.Concrete,
	})
	m.PrimaryPart = floor

	-- Neon border so plots look great from the lobby.
	for _, data in
		{
			{ Vector3.new(100, 0.3, 1), Vector3.new(0, 1.15, 49.5) },
			{ Vector3.new(100, 0.3, 1), Vector3.new(0, 1.15, -49.5) },
			{ Vector3.new(1, 0.3, 100), Vector3.new(49.5, 1.15, 0) },
			{ Vector3.new(1, 0.3, 100), Vector3.new(-49.5, 1.15, 0) },
		}
	do
		part(base, plotCF, data[1], data[2], {
			Name = "Border",
			Color = Color3.fromRGB(120, 90, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end

	-- Conveyor belt (anchored part with a velocity carries anything on top of it).
	local length = Builders.CONVEYOR_END_X - Builders.CONVEYOR_START_X
	local midX = (Builders.CONVEYOR_END_X + Builders.CONVEYOR_START_X) / 2
	local conveyor = part(base, plotCF, Vector3.new(length, 1, 6), Vector3.new(midX, 1.5, 0), {
		Name = "Conveyor",
		Color = Color3.fromRGB(35, 35, 45),
		Material = Enum.Material.DiamondPlate,
	})
	conveyor.AssemblyLinearVelocity = plotCF.RightVector * Config.ConveyorSpeed

	for _, z in { -3.25, 3.25 } do
		part(base, plotCF, Vector3.new(length + 6, 1.5, 0.5), Vector3.new(midX + 3, 2.75, z), {
			Name = "Rail",
			Color = Color3.fromRGB(255, 200, 40),
			Material = Enum.Material.Metal,
		})
		part(base, plotCF, Vector3.new(length, 0.2, 0.3), Vector3.new(midX, 3.6, z), {
			Name = "RailGlow",
			Color = Color3.fromRGB(80, 220, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
	part(base, plotCF, Vector3.new(0.5, 2, 7), Vector3.new(Builders.CONVEYOR_START_X - 0.25, 3, 0), {
		Name = "StartWall",
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Metal,
	})

	-- Collector: drops that touch it are turned into cash in the plot's bank.
	local collector = part(base, plotCF, Vector3.new(6, 1, 7), Vector3.new(Builders.COLLECTOR_X, 1.5, 0), {
		Name = "Collector",
		Color = Color3.fromRGB(60, 230, 120),
		Material = Enum.Material.Neon,
	})
	part(base, plotCF, Vector3.new(0.5, 6, 7), Vector3.new(Builders.COLLECTOR_X + 3.25, 4, 0), {
		Name = "CollectorWall",
		Color = Color3.fromRGB(40, 40, 50),
		Material = Enum.Material.Metal,
	})
	local sign = part(base, plotCF, Vector3.new(1, 1, 1), Vector3.new(Builders.COLLECTOR_X, 10, 0), {
		Name = "BankAnchor",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local bankLabel = Builders.Billboard(sign, "$0", Vector2.new(14, 4), 0, 150)
	bankLabel.TextColor3 = Color3.fromRGB(120, 255, 150)

	-- Collect pad: owner steps here to move the bank into their wallet.
	local collectPad = part(base, plotCF, Vector3.new(6, 0.4, 6), Builders.COLLECT_PAD_POS, {
		Name = "CollectPad",
		Color = Color3.fromRGB(60, 230, 120),
		Material = Enum.Material.Neon,
	})
	part(base, plotCF, Vector3.new(7, 0.3, 7), Builders.COLLECT_PAD_POS - Vector3.new(0, 0.2, 0), {
		Name = "CollectPadRim",
		Color = Color3.fromRGB(25, 25, 35),
	})
	Builders.Billboard(collectPad, "💰 COLLECT", Vector2.new(8, 2), 3, 80)

	-- Floating owner name above the front of the plot.
	local ownerAnchor = part(base, plotCF, Vector3.new(1, 1, 1), Vector3.new(0, 16, 46), {
		Name = "OwnerAnchor",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local ownerLabel = Builders.Billboard(ownerAnchor, "Empty Factory", Vector2.new(30, 5), 0, 400)

	local items = Instance.new("Folder")
	items.Name = "Items"
	items.Parent = m
	local buttons = Instance.new("Folder")
	buttons.Name = "Buttons"
	buttons.Parent = m
	local drops = Instance.new("Folder")
	drops.Name = "Drops"
	drops.Parent = m

	return {
		Model = m,
		Conveyor = conveyor,
		Collector = collector,
		CollectPad = collectPad,
		BankLabel = bankLabel,
		OwnerLabel = ownerLabel,
		ItemsFolder = items,
		ButtonsFolder = buttons,
		DropsFolder = drops,
	}
end

----------------------------------------------------------------------------------------
-- Buy buttons
----------------------------------------------------------------------------------------

function Builders.ButtonPosition(index: number): Vector3
	local row = (index - 1) // BUTTON_COLUMNS
	local column = (index - 1) % BUTTON_COLUMNS
	return Vector3.new(-40 + column * 8, 1.3, 20 + row * 7)
end

function Builders.Button(item: any, plotCF: CFrame, parent: Instance, priceText: string): (Model, BasePart)
	local m = model("Button_" .. item.Id, parent)
	local pos = Builders.ButtonPosition(item.Index)
	part(m, plotCF, Vector3.new(5.6, 0.4, 5.6), pos - Vector3.new(0, 0.25, 0), {
		Name = "Rim",
		Color = Color3.fromRGB(25, 25, 35),
	})
	local pad = part(m, plotCF, Vector3.new(5, 0.6, 5), pos, {
		Name = "Pad",
		Color = Color3.fromRGB(70, 220, 110),
		Material = Enum.Material.Neon,
	})
	m.PrimaryPart = pad
	m:SetAttribute("ItemId", item.Id)
	m:SetAttribute("Price", item.Price)

	local label = Builders.Billboard(pad, `{item.Name}\n{priceText}`, Vector2.new(9, 3.2), 3.2, 70)
	label.Name = "Label"
	return m, pad
end

----------------------------------------------------------------------------------------
-- Droppers, upgraders, collector upgrade
----------------------------------------------------------------------------------------

-- Droppers alternate sides of the conveyor. The back row is shifted half a slot and
-- raised so its showcase brainrots aren't hidden behind the front row.
function Builders.DropperLayout(slot: number): (number, number, number)
	local pair = (slot - 1) // 2
	local side = if slot % 2 == 1 then -1 else 1
	local x = -30 + pair * 8 + (if side == -1 then 4 else 0)
	local pillarTop = if side == -1 then 14 else 11
	return x, side, pillarTop
end

-- Returns the model and the world CFrame drops spawn at. The dropper is topped by the
-- full-size brainrot standing on its rarity pedestal.
function Builders.Dropper(item: any, plotCF: CFrame, parent: Instance): (Model, CFrame)
	local def = CharacterRegistry.Get(item.Character)
	local tier = Rarity.Get(def.Rarity)
	local x, side, pillarTop = Builders.DropperLayout(item.Slot)
	local accent = tier.Color

	local m = model(item.Id, parent)
	local baseBlock = part(m, plotCF, Vector3.new(4, 1, 4), Vector3.new(x, 1.5, 9 * side), {
		Name = "Base",
		Color = Color3.fromRGB(40, 40, 52),
		Material = Enum.Material.Metal,
	})
	m.PrimaryPart = baseBlock
	local pillarHeight = pillarTop - 2
	part(m, plotCF, Vector3.new(2, pillarHeight, 2), Vector3.new(x, 2 + pillarHeight / 2, 9 * side), {
		Name = "Pillar",
		Color = Color3.fromRGB(230, 230, 240),
	})
	for _, y in { 4.5, pillarTop - 1.5 } do
		part(m, plotCF, Vector3.new(2.2, 0.5, 2.2), Vector3.new(x, y, 9 * side), {
			Name = "Stripe",
			Color = accent,
			Material = Enum.Material.Neon,
		})
	end
	part(m, plotCF, Vector3.new(2, 2, 9), Vector3.new(x, 10, 4.5 * side), {
		Name = "Arm",
		Color = Color3.fromRGB(230, 230, 240),
	})
	part(m, plotCF, Vector3.new(3, 2.5, 3), Vector3.new(x, 8.25, 1.5 * side), {
		Name = "Hopper",
		Color = accent,
	})

	-- Pedestal + showcase character facing the front of the plot (+Z).
	local topCF = plotCF * CFrame.new(x, pillarTop + 0.7, 9 * side)
	RarityFX.Pedestal(def.Rarity, topCF, m)
	local character = CharacterKit.Build(def, "Full")
	character:PivotTo(topCF * CFrame.Angles(0, math.pi, 0))
	character.Parent = m
	local height = CharacterKit.Height(character)
	RarityFX.Nameplate(def, item.Value, topCF * CFrame.new(0, height + 2, 0), m)

	local spawnCF = plotCF * CFrame.new(x, 5.5, 1.5 * side)
	return m, spawnCF
end

-- Returns the model and the laser part that upgrades drops passing through it.
function Builders.Upgrader(item: any, plotCF: CFrame, parent: Instance): (Model, BasePart)
	local x = 11 + item.Slot * 6
	local m = model(item.Id, parent)
	for _, z in { -4.25, 4.25 } do
		part(m, plotCF, Vector3.new(1, 6, 1), Vector3.new(x, 4, z), {
			Name = "Post",
			Color = Color3.fromRGB(40, 40, 52),
			Material = Enum.Material.Metal,
		})
	end
	local top = part(m, plotCF, Vector3.new(1.4, 1.2, 9.5), Vector3.new(x, 7.6, 0), {
		Name = "Top",
		Color = item.Color,
		Material = Enum.Material.Neon,
	})
	m.PrimaryPart = top
	local laser = part(m, plotCF, Vector3.new(0.6, 4, 6.2), Vector3.new(x, 4.2, 0), {
		Name = "Laser",
		Color = item.Color,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
	})
	local label = Builders.Billboard(top, `x{item.Multiplier}`, Vector2.new(4, 2), 2.2, 80)
	label.TextColor3 = item.Color
	return m, laser
end

function Builders.CollectorUpgrade(item: any, plotCF: CFrame, parent: Instance): Model
	local m = model(item.Id, parent)
	local gold = Color3.fromRGB(255, 200, 40)
	for _, z in { -4.5, 4.5 } do
		part(m, plotCF, Vector3.new(1.2, 9, 1.2), Vector3.new(Builders.COLLECTOR_X, 5.5, z), {
			Name = "Post",
			Color = gold,
			Material = Enum.Material.Foil,
		})
	end
	local arch = part(m, plotCF, Vector3.new(2, 1.5, 10.2), Vector3.new(Builders.COLLECTOR_X, 10.5, 0), {
		Name = "Arch",
		Color = gold,
		Material = Enum.Material.Foil,
	})
	m.PrimaryPart = arch
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = gold
	sparkles.Parent = arch
	return m
end

----------------------------------------------------------------------------------------
-- Decorations (purely cosmetic, but they make the factory feel like it's growing)
----------------------------------------------------------------------------------------

local Decor = {}

function Decor.Walls(plotCF: CFrame, m: Model)
	local wallColor = Color3.fromRGB(150, 110, 230)
	local trim = Color3.fromRGB(255, 220, 80)
	m.PrimaryPart = part(m, plotCF, Vector3.new(100, 8, 1), Vector3.new(0, 5, -49.5), { Name = "BackWall", Color = wallColor })
	for _, x in { -49.5, 49.5 } do
		part(m, plotCF, Vector3.new(1, 8, 70), Vector3.new(x, 5, -15), { Name = "SideWall", Color = wallColor })
		part(m, plotCF, Vector3.new(1.4, 0.6, 70), Vector3.new(x, 9.2, -15), {
			Name = "Trim",
			Color = trim,
			Material = Enum.Material.Neon,
		})
	end
	part(m, plotCF, Vector3.new(100, 0.6, 1.4), Vector3.new(0, 9.2, -49.5), {
		Name = "Trim",
		Color = trim,
		Material = Enum.Material.Neon,
	})
end

function Decor.Lights(plotCF: CFrame, m: Model)
	local colors = {
		Color3.fromRGB(255, 80, 200),
		Color3.fromRGB(80, 220, 255),
		Color3.fromRGB(255, 230, 60),
		Color3.fromRGB(120, 255, 120),
	}
	for i, pos in { Vector3.new(-46, 0, 46), Vector3.new(46, 0, 46), Vector3.new(-46, 0, -46), Vector3.new(46, 0, -46) } do
		local pole = part(m, plotCF, Vector3.new(0.8, 14, 0.8), pos + Vector3.new(0, 8, 0), {
			Name = "Pole",
			Color = Color3.fromRGB(40, 40, 52),
			Material = Enum.Material.Metal,
		})
		if i == 1 then
			m.PrimaryPart = pole
		end
		local bulb = part(m, plotCF, Vector3.new(3, 3, 3), pos + Vector3.new(0, 16, 0), {
			Name = "Bulb",
			Shape = Enum.PartType.Ball,
			Color = colors[i],
			Material = Enum.Material.Neon,
		})
		local light = Instance.new("PointLight")
		light.Color = colors[i]
		light.Range = 30
		light.Brightness = 2
		light.Parent = bulb
	end
end

function Decor.Sign(plotCF: CFrame, m: Model)
	for _, x in { -16, 16 } do
		part(m, plotCF, Vector3.new(1.5, 22, 1.5), Vector3.new(x, 12, -46), {
			Name = "Pole",
			Color = Color3.fromRGB(40, 40, 52),
			Material = Enum.Material.Metal,
		})
	end
	local board = part(m, plotCF, Vector3.new(40, 10, 1), Vector3.new(0, 20, -46), {
		Name = "Board",
		Color = Color3.fromRGB(25, 15, 45),
	})
	m.PrimaryPart = board
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(800, 200)
	gui.LightInfluence = 0
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "🧠 BRAINROT FACTORY 🏭"
	label.TextColor3 = Color3.fromRGB(255, 120, 230)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(80, 220, 255)
	stroke.Thickness = 4
	stroke.Parent = label
end

local function tree(m: Model, plotCF: CFrame, pos: Vector3, leafColor: Color3)
	part(m, plotCF, Vector3.new(1.6, 8, 1.6), pos + Vector3.new(0, 5, 0), {
		Name = "Trunk",
		Color = Color3.fromRGB(110, 70, 40),
		Material = Enum.Material.Wood,
	})
	part(m, plotCF, Vector3.new(8, 8, 8), pos + Vector3.new(0, 11, 0), {
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Color = leafColor,
		Material = Enum.Material.Grass,
	})
end

function Decor.Garden(plotCF: CFrame, m: Model)
	m.PrimaryPart = part(m, plotCF, Vector3.new(12, 0.4, 20), Vector3.new(40, 1.2, -30), {
		Name = "Grass",
		Color = Color3.fromRGB(90, 200, 90),
		Material = Enum.Material.Grass,
	})
	tree(m, plotCF, Vector3.new(44, 0, -18), Color3.fromRGB(255, 150, 210))
	tree(m, plotCF, Vector3.new(36, 0, -44), Color3.fromRGB(90, 200, 90))
	tree(m, plotCF, Vector3.new(-44, 0, -18), Color3.fromRGB(255, 150, 210))
	local flowerColors = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 230, 60), Color3.fromRGB(180, 110, 255) }
	for i = 0, 8 do
		local x = 36 + (i % 3) * 4
		local z = -36 + (i // 3) * 5
		part(m, plotCF, Vector3.new(1.4, 1.4, 1.4), Vector3.new(x, 2, z), {
			Name = "Flower",
			Shape = Enum.PartType.Ball,
			Color = flowerColors[i % 3 + 1],
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
end

function Decor.Fountain(plotCF: CFrame, m: Model)
	local center = Vector3.new(-22, 0, -32)
	local basin = part(m, plotCF, Vector3.new(2, 12, 12), center + Vector3.new(0, 2, 0), {
		Name = "Basin",
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(220, 220, 235),
		Material = Enum.Material.Marble,
	})
	basin.CFrame = basin.CFrame * CFrame.Angles(0, 0, math.rad(90))
	m.PrimaryPart = basin
	local water = part(m, plotCF, Vector3.new(0.4, 10.5, 10.5), center + Vector3.new(0, 3.05, 0), {
		Name = "Water",
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(60, 230, 120),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		CanCollide = false,
	})
	water.CFrame = water.CFrame * CFrame.Angles(0, 0, math.rad(90))
	local spout = part(m, plotCF, Vector3.new(1.5, 7, 1.5), center + Vector3.new(0, 5.5, 0), {
		Name = "Spout",
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Foil,
	})
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(80, 255, 140))
	emitter.Size = NumberSequence.new(0.8, 0.2)
	emitter.Speed = NumberRange.new(12, 16)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Lifetime = NumberRange.new(1, 1.3)
	emitter.Rate = 40
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = spout
	Builders.Billboard(spout, "💵", Vector2.new(3, 3), 6, 100)
end

function Decor.Statue(plotCF: CFrame, m: Model)
	local center = Vector3.new(22, 0, -32)
	local gold = Color3.fromRGB(255, 200, 40)
	m.PrimaryPart = part(m, plotCF, Vector3.new(8, 3, 8), center + Vector3.new(0, 2.5, 0), {
		Name = "Pedestal",
		Color = Color3.fromRGB(60, 60, 75),
		Material = Enum.Material.Marble,
	})
	for _, x in { -1.2, 1.2 } do
		part(m, plotCF, Vector3.new(1.8, 4, 1.8), center + Vector3.new(x, 6, 0), { Name = "Leg", Color = gold, Material = Enum.Material.Foil })
	end
	part(m, plotCF, Vector3.new(5, 5, 3.5), center + Vector3.new(0, 10.5, 0), { Name = "Body", Color = gold, Material = Enum.Material.Foil })
	local head = part(m, plotCF, Vector3.new(5, 5, 5), center + Vector3.new(0, 15.5, 0), {
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Color = gold,
		Material = Enum.Material.Foil,
	})
	Builders.Billboard(head, "🧠", Vector2.new(3, 3), 4, 120)
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = gold
	sparkles.Parent = head
end

function Decor.Throne(plotCF: CFrame, m: Model)
	local center = Vector3.new(0, 0, -38)
	local purple = Color3.fromRGB(140, 60, 255)
	local gold = Color3.fromRGB(255, 200, 40)
	m.PrimaryPart = part(m, plotCF, Vector3.new(14, 1, 10), center + Vector3.new(0, 1.5, 0), { Name = "Step1", Color = gold, Material = Enum.Material.Foil })
	part(m, plotCF, Vector3.new(10, 1, 7), center + Vector3.new(0, 2.5, -0.5), { Name = "Step2", Color = purple })
	local seat = Instance.new("Seat")
	seat.Anchored = true
	seat.Size = Vector3.new(5, 1.5, 4)
	seat.CFrame = plotCF * CFrame.new(center + Vector3.new(0, 3.75, -1)) * CFrame.Angles(0, math.pi, 0)
	seat.Color = Color3.fromRGB(200, 40, 80)
	seat.Material = Enum.Material.Fabric
	seat.Parent = m
	part(m, plotCF, Vector3.new(6, 10, 1.2), center + Vector3.new(0, 8, -3.4), { Name = "Back", Color = purple, Material = Enum.Material.Neon })
	for _, x in { -2.5, 2.5 } do
		part(m, plotCF, Vector3.new(1, 2, 4), center + Vector3.new(x, 5, -1), { Name = "Arm", Color = gold, Material = Enum.Material.Foil })
	end
	local crown = part(m, plotCF, Vector3.new(3, 2, 3), center + Vector3.new(0, 14, -3.4), { Name = "Crown", Color = gold, Material = Enum.Material.Foil })
	Builders.Billboard(crown, "👑", Vector2.new(4, 4), 3, 150)
end

function Decor.Rocket(plotCF: CFrame, m: Model)
	local center = Vector3.new(-40, 0, -40)
	part(m, plotCF, Vector3.new(12, 1, 12), center + Vector3.new(0, 1.5, 0), {
		Name = "Pad",
		Color = Color3.fromRGB(50, 50, 60),
		Material = Enum.Material.DiamondPlate,
	})
	local body = part(m, plotCF, Vector3.new(20, 6, 6), center + Vector3.new(0, 13, 0), {
		Name = "Body",
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(240, 240, 250),
	})
	body.CFrame = body.CFrame * CFrame.Angles(0, 0, math.rad(90))
	m.PrimaryPart = body
	local nose = part(m, plotCF, Vector3.new(6, 6, 6), center + Vector3.new(0, 23, 0), {
		Name = "Nose",
		Shape = Enum.PartType.Ball,
		Color = Color3.fromRGB(255, 60, 120),
	})
	Builders.Billboard(nose, "🧠", Vector2.new(4, 4), 5, 200)
	for i = 0, 3 do
		local angle = math.rad(i * 90)
		local offset = Vector3.new(math.cos(angle) * 3.5, 5, math.sin(angle) * 3.5)
		local fin = part(m, plotCF, Vector3.new(1, 6, 3), center + offset, {
			Name = "Fin",
			Color = Color3.fromRGB(255, 60, 120),
		})
		fin.CFrame = plotCF * CFrame.new(center + offset) * CFrame.Angles(0, -angle, 0)
	end
	local flame = part(m, plotCF, Vector3.new(2, 2, 2), center + Vector3.new(0, 2.5, 0), {
		Name = "Flame",
		Transparency = 1,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 8
	fire.Heat = 15
	fire.Color = Color3.fromRGB(255, 120, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 230, 60)
	fire.Parent = flame
end

function Builders.Decor(item: any, plotCF: CFrame, parent: Instance): Model
	local builder = Decor[item.Build]
	assert(builder, `No decor builder named {item.Build}`)
	local m = model(item.Id, parent)
	builder(plotCF, m)
	return m
end

----------------------------------------------------------------------------------------
-- Drops (the brainrot creatures riding the conveyor)
----------------------------------------------------------------------------------------

-- A drop is an invisible physics box carrying a welded mini model of the brainrot.
function Builders.Drop(def: any, mutation: any?, spawnCF: CFrame, parent: Instance): BasePart
	local root = Instance.new("Part")
	root.Name = "Drop"
	root.Size = Vector3.new(2.2, 2.2, 2.2)
	root.Transparency = 1
	root.CFrame = spawnCF * CFrame.Angles(0, -math.pi / 2, 0) -- face the way the belt moves
	root.CollisionGroup = "Drops"
	root.CanQuery = false

	local mini = CharacterKit.Build(def, "Mini")
	CharacterKit.ApplyMutation(mini, if mutation then mutation.Name else nil)
	mini:PivotTo(root.CFrame)
	for _, descendant in mini:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			descendant.CollisionGroup = "Drops"
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	mini.Parent = root

	if mutation then
		root:SetAttribute("Mutation", mutation.Name)
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = mutation.Color
		sparkles.Parent = root
		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.fromScale(5, 1)
		tag.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
		tag.MaxDistance = 90
		tag.LightInfluence = 0
		tag.Parent = root
		local tagLabel = Instance.new("TextLabel")
		tagLabel.Size = UDim2.fromScale(1, 1)
		tagLabel.BackgroundTransparency = 1
		tagLabel.Font = Enum.Font.FredokaOne
		tagLabel.TextScaled = true
		tagLabel.Text = string.upper(mutation.Name)
		tagLabel.TextColor3 = mutation.Color
		tagLabel.Parent = tag
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = tagLabel
	end

	root.Parent = parent
	return root
end

return Builders
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	Player data persistence.

	* Session locking stops item/cash duplication when a player hops servers quickly.
	* UpdateAsync + retries so a DataStore hiccup never wipes progress.
	* If DataStores are unavailable (e.g. Studio without API access) the player still
	  plays, but saving is disabled for that session so nothing gets overwritten.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local LOCK_TIMEOUT = 5 * 60 -- a lock older than this is considered abandoned
local LOAD_ATTEMPTS = 5
local AUTOSAVE_INTERVAL = 90

export type PlayerData = {
	Cash: number,
	TotalEarned: number,
	Rebirths: number,
	Items: { [string]: boolean },
	Daily: { Streak: number, Last: number },
	Codes: { [string]: boolean },
	Index: { [string]: { [string]: boolean } },
	Receipts: { string },
	LastOnline: number,
	Playtime: number,
}

type Profile = {
	Data: PlayerData,
	CanSave: boolean,
	Saving: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil

local function defaultData(): PlayerData
	return {
		Cash = 0,
		TotalEarned = 0,
		Rebirths = 0,
		Items = {},
		Daily = { Streak = 0, Last = 0 },
		Codes = {},
		Index = {},
		Receipts = {},
		LastOnline = 0,
		Playtime = 0,
	}
end

-- Fill in any fields added after the player's data was first created.
local function reconcile(data: any, template: any)
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

function DataService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable, progress will not save:", result)
	end
end

-- Loads (yields). Always returns data; check DataService.CanSave to know if it persists.
function DataService.Load(player: Player): PlayerData
	local data: any = nil
	local canSave = false

	if store then
		-- Studio without API access fails instantly; don't make the developer wait on retries.
		local attempts = if RunService:IsStudio() then 1 else LOAD_ATTEMPTS
		for attempt = 1, attempts do
			local lockedByOther = false
			local ok, err = pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(saved)
					saved = saved or {}
					local lock = saved.Lock
					local now = os.time()
					if
						lock
						and lock.JobId ~= game.JobId
						and now - lock.Time < LOCK_TIMEOUT
						and attempt < attempts
					then
						lockedByOther = true
						return nil -- abort; another server still owns this session
					end
					saved.Lock = { JobId = game.JobId, Time = now }
					data = saved.Data
					return saved
				end)
			end)
			if ok and not lockedByOther then
				canSave = true
				break
			end
			if not ok then
				warn(`[DataService] Load attempt {attempt} failed for {player.Name}: {err}`)
			end
			if not player.Parent then
				break
			end
			task.wait(if lockedByOther then 4 else 2)
		end
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end

	if not canSave and not RunService:IsStudio() then
		warn(`[DataService] Saving disabled for {player.Name} this session`)
	end

	profiles[player] = { Data = data, CanSave = canSave, Saving = false }
	return data
end

function DataService.Get(player: Player): PlayerData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.CanSave(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.CanSave
end

function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end
	-- Wait for an in-flight save so the final release save always runs last.
	while profile.Saving do
		task.wait(0.1)
	end
	profile.Saving = true
	profile.Data.LastOnline = os.time()

	local success = false
	for _ = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(saved)
				saved = saved or {}
				if saved.Lock and saved.Lock.JobId ~= game.JobId then
					return nil -- another server took over; don't clobber its data
				end
				saved.Data = profile.Data
				saved.Lock = if release then nil else { JobId = game.JobId, Time = os.time() }
				return saved
			end)
		end)
		if ok then
			success = true
			break
		end
		warn(`[DataService] Save failed for {player.Name}: {err}`)
		task.wait(1)
	end
	profile.Saving = false
	return success
end

-- Final save when a player leaves.
function DataService.Release(player: Player)
	if profiles[player] then
		DataService.Save(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, player in Players:GetPlayers() do
			if profiles[player] then
				pending += 1
				task.spawn(function()
					-- PlayerService hooks this to bank uncollected cash first.
					if DataService.BeforeRelease then
						DataService.BeforeRelease(player)
					end
					DataService.Release(player)
					pending -= 1
				end)
			end
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

DataService.BeforeRelease = nil :: ((Player) -> ())?

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">DropService</string>
          <string name="Source"><![CDATA[--[[
	Drops: spawning brainrots from droppers, rolling mutations, upgraders and the
	collector that turns them into cash.
]]

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterRegistry = require(ReplicatedStorage.Shared.CharacterRegistry)
local Config = require(ReplicatedStorage.Shared.Config)
local Builders = require(script.Parent.Builders)

local DropService = {}

type DropInfo = { Plot: any, Value: number, Upgraded: { [string]: boolean } }

local drops: { [BasePart]: DropInfo } = {}
local lastGlobalAnnounce: { [Player]: number } = {}
local Services

local MAX_TOTAL_MUTATION_CHANCE = 0.6

local function removeDrop(part: BasePart)
	local info = drops[part]
	if info then
		drops[part] = nil
		info.Plot.DropCount = math.max(0, info.Plot.DropCount - 1)
	end
end

local function rollMutation(owner: Player): any?
	local luck = Services.EventService.LuckMultiplier()
	if owner:GetAttribute("Pass_LuckyMutations") then
		luck *= 3
	end
	local total = 0
	for _, mutation in Config.Mutations do
		total += mutation.Chance
	end
	-- Keep at least some normal drops even with every boost stacked.
	luck = math.min(luck, MAX_TOTAL_MUTATION_CHANCE / total)

	local roll = math.random()
	local cumulative = 0
	for _, mutation in Config.Mutations do
		cumulative += mutation.Chance * luck
		if roll < cumulative then
			return mutation
		end
	end
	return nil
end

local function announce(owner: Player, def: any, mutation: any)
	local text = `{mutation.Name:upper()} {def.Name} spawned! (x{mutation.Multiplier})`
	Services.Remotes.NotifyPlayer(owner, `✨ {text}`, "rare")
	if mutation.Name == "Rainbow" then
		local now = os.clock()
		if now - (lastGlobalAnnounce[owner] or 0) > 60 then
			lastGlobalAnnounce[owner] = now
			for _, other in game:GetService("Players"):GetPlayers() do
				if other ~= owner then
					Services.Remotes.NotifyPlayer(other, `🌈 {owner.DisplayName} got a {text}`, "rare")
				end
			end
		end
	end
end

local function spawnDrop(plot: any, dropper: any)
	local owner: Player = plot.Owner
	local item = dropper.Item
	local mutation = rollMutation(owner)
	local value = item.Value * (if mutation then mutation.Multiplier else 1)

	local def = CharacterRegistry.Get(item.Character)
	local part = Builders.Drop(def, mutation, dropper.SpawnCF, plot.Parts.DropsFolder)
	-- Server owns the physics so the collector can't be spoofed by clients.
	pcall(function()
		part:SetNetworkOwner(nil)
	end)
	drops[part] = { Plot = plot, Value = value, Upgraded = {} }
	plot.DropCount += 1
	part.Destroying:Connect(function()
		removeDrop(part)
	end)
	task.delay(Config.DropLifetime, function()
		if part.Parent then
			part:Destroy()
		end
	end)

	if mutation and mutation.Announce then
		announce(owner, def, mutation)
	end
	Services.PlayerService.Discover(owner, def, if mutation then mutation.Name else "Normal")
end

function DropService.HookUpgrader(plot: any, item: any, laser: BasePart)
	laser.Touched:Connect(function(hit)
		local info = drops[hit]
		if info and info.Plot == plot and not info.Upgraded[item.Id] then
			info.Upgraded[item.Id] = true
			info.Value *= item.Multiplier
		end
	end)
end

function DropService.HookCollector(plot: any)
	plot.Parts.Collector.Touched:Connect(function(hit)
		local info = drops[hit]
		if not info or info.Plot ~= plot then
			return
		end
		removeDrop(hit)
		hit:Destroy()
		local owner = plot.Owner
		if owner then
			local amount = info.Value
				* plot.CollectorMultiplier
				* Services.PlayerService.GetMultiplier(owner)
				* Services.EventService.CashMultiplier()
			Services.PlotService.AddToBank(plot, amount)
		end
	end)
end

-- Forget every drop belonging to a plot (called when a plot is cleared).
function DropService.ClearPlot(plot: any)
	for part, info in drops do
		if info.Plot == plot then
			drops[part] = nil
		end
	end
	plot.DropCount = 0
end

function DropService.Init(services)
	Services = services
	PhysicsService:RegisterCollisionGroup("Drops")
	PhysicsService:RegisterCollisionGroup("Players")
	-- Drops pass through each other and through players, so nobody can block a conveyor.
	PhysicsService:CollisionGroupSetCollidable("Drops", "Drops", false)
	PhysicsService:CollisionGroupSetCollidable("Drops", "Players", false)
end

function DropService.Start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		local now = os.clock()
		for _, plot in Services.PlotService.Plots do
			local owner = plot.Owner
			if owner then
				local interval = Config.DropInterval
				if owner:GetAttribute("Pass_FastDroppers") then
					interval *= Config.FastDropperMultiplier
				end
				for _, dropper in plot.Droppers do
					if now >= dropper.Next then
						dropper.Next = now + interval
						if plot.DropCount < Config.MaxDropsPerPlot then
							spawnDrop(plot, dropper)
						end
					end
				end
			end
		end
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastGlobalAnnounce[player] = nil
	end)
end

return DropService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--[[
	Server-wide boost events (Gold Rush, Cash Frenzy, Rainbow Rain).

	Active events are replicated as attributes on ReplicatedStorage named
	"Event_<Key>" holding the server time the event ends, so the client can show
	banners with live countdowns.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local EventService = {}

local active: { [string]: number } = {} -- key -> server time the event ends
local Remotes

function EventService.Init(services)
	Remotes = services.Remotes
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

function EventService.IsActive(key: string): boolean
	local endsAt = active[key]
	return endsAt ~= nil and endsAt > serverNow()
end

function EventService.LuckMultiplier(): number
	local multiplier = 1
	for key in active do
		if EventService.IsActive(key) then
			multiplier *= Config.Events[key].LuckMultiplier
		end
	end
	return multiplier
end

function EventService.CashMultiplier(): number
	local multiplier = 1
	for key in active do
		if EventService.IsActive(key) then
			multiplier *= Config.Events[key].CashMultiplier
		end
	end
	return multiplier
end

-- Starts (or extends) an event. `byPlayer` is credited in the announcement.
function EventService.StartEvent(key: string, byPlayer: Player?)
	local event = Config.Events[key]
	assert(event, "Unknown event " .. key)
	local now = serverNow()
	local endsAt = if EventService.IsActive(key) then active[key] + event.Duration else now + event.Duration
	active[key] = endsAt
	ReplicatedStorage:SetAttribute("Event_" .. key, endsAt)

	local who = if byPlayer then `{byPlayer.DisplayName} started ` else ""
	Remotes.NotifyAll(`{event.Emoji} {who}{event.Name}! {event.Emoji}`, "event")
end

function EventService.Start()
	-- Expire finished events.
	task.spawn(function()
		while true do
			task.wait(1)
			for key, endsAt in active do
				if endsAt <= serverNow() then
					active[key] = nil
					ReplicatedStorage:SetAttribute("Event_" .. key, nil)
					Remotes.NotifyAll(`{Config.Events[key].Name} has ended.`, "info")
				end
			end
		end
	end)

	-- Random free events keep the server feeling alive.
	task.spawn(function()
		local randomKeys = {}
		for key, event in Config.Events do
			if event.Random then
				table.insert(randomKeys, key)
			end
		end
		if #randomKeys == 0 then
			return
		end
		while true do
			task.wait(math.random(Config.RandomEventDelay.Min, Config.RandomEventDelay.Max))
			local key = randomKeys[math.random(1, #randomKeys)]
			if not EventService.IsActive(key) then
				EventService.StartEvent(key)
			end
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--[[
	Global "Top Earners" leaderboard shown on the lobby board.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)

local LeaderboardService = {}

local UPDATE_INTERVAL = 120
local MAX_ENTRIES = 10
local MAX_STORED_VALUE = 2 ^ 53

local Services
local store: OrderedDataStore? = nil
local nameCache: { [number]: string } = {}
local rows: { TextLabel } = {}

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok then name else "Player"
	nameCache[userId] = result
	return result
end

local function update()
	if not store then
		return
	end
	for _, player in Players:GetPlayers() do
		local data = Services.DataService.Get(player)
		if data and Services.DataService.CanSave(player) then
			pcall(function()
				(store :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(math.min(data.TotalEarned, MAX_STORED_VALUE)))
			end)
		end
	end

	local ok, page = pcall(function()
		return (store :: OrderedDataStore):GetSortedAsync(false, MAX_ENTRIES):GetCurrentPage()
	end)
	if not ok then
		return
	end
	for i = 1, MAX_ENTRIES do
		local entry = page[i]
		local row = rows[i]
		if entry then
			local medal = if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else `{i}.`
			row.Text = `{medal} {nameFor(tonumber(entry.key) or 0)}  {Format.Cash(entry.value)}`
		else
			row.Text = ""
		end
	end
end

function LeaderboardService.Init(services)
	Services = services
	local frame = services.WorldBuilder.LeaderboardFrame
	for i = 1, MAX_ENTRIES do
		rows[i] = services.WorldBuilder.BoardLine(frame, if i == 1 then "Loading..." else "", 52, nil, i)
	end
	local ok, result = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.LeaderboardStoreName)
	if ok then
		store = result
	end
end

function LeaderboardService.Start()
	task.spawn(function()
		task.wait(15)
		while true do
			local ok, err = pcall(update)
			if not ok then
				warn("[Leaderboard]", err)
			end
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--[[
	Game passes and developer products.

	* Pass ownership is mirrored to the player attribute "Pass_<Key>".
	* ProcessReceipt is idempotent: purchase IDs are remembered in saved data so a
	  product is never granted twice, and nothing is granted before data has loaded.
	* In Studio (Config.StudioFreePurchases) the client can request free test grants.
	  These are session-only and never saved, so they can't leak into the live game.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)

local MonetizationService = {}

local MAX_STORED_RECEIPTS = 50

local Services
local passKeyById: { [number]: string } = {}
local productKeyById: { [number]: string } = {}

local function applyPass(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and not root:FindFirstChildOfClass("Sparkles") then
			local sparkles = Instance.new("Sparkles")
			sparkles.SparkleColor = Color3.fromRGB(255, 200, 40)
			sparkles.Parent = root
		end
	end
	Services.PlayerService.RefreshStats(player)
end

function MonetizationService.LoadPasses(player: Player, _data: any)
	for key, pass in Config.GamePasses do
		if pass.Id > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
			if ok and owns then
				applyPass(player, key)
			end
		end
	end
end

local function grantPass(player: Player, key: string)
	if player:GetAttribute("Pass_" .. key) then
		return
	end
	applyPass(player, key)
	local pass = Config.GamePasses[key]
	Services.Remotes.Celebrate:FireClient(player, `{pass.Emoji} {pass.Name:upper()} UNLOCKED!`, pass.Description)
	Services.Remotes.NotifyAll(`💎 {player.DisplayName} bought {pass.Name}!`, "event")
end

local function grantProduct(player: Player, key: string)
	local product = Config.Products[key]
	if product.Kind == "Cash" then
		local income = player:GetAttribute("IncomePerSec") or 0
		local amount = Economy.ScaledReward(income, product.IncomeSeconds, product.Minimum)
		Services.PlayerService.AddCash(player, amount)
		Services.Remotes.CashPopup:FireClient(player, amount)
		Services.Remotes.NotifyPlayer(player, `{product.Emoji} +{Format.Cash(amount)}! Thanks for the support!`, "success")
	elseif product.Kind == "Event" then
		Services.EventService.StartEvent(product.Event, player)
	end
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Services.DataService.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productKeyById[receipt.ProductId]
	if not key then
		warn("[Monetization] Unknown product id", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(grantProduct, player, key)
	if not ok then
		warn("[Monetization] Failed to grant", key, err)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(data.Receipts, receipt.PurchaseId)
	while #data.Receipts > MAX_STORED_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
	Services.DataService.Save(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function testPurchase(player: Player, payload: any): (boolean, string?)
	if not (RunService:IsStudio() and Config.StudioFreePurchases) then
		return false, "Not available"
	end
	if type(payload) ~= "table" or type(payload.Key) ~= "string" then
		return false, "Invalid"
	end
	if payload.Kind == "Pass" and Config.GamePasses[payload.Key] then
		grantPass(player, payload.Key)
		return true, "Studio test: pass granted for this session"
	elseif payload.Kind == "Product" and Config.Products[payload.Key] then
		grantProduct(player, payload.Key)
		return true, "Studio test: product granted"
	end
	return false, "Invalid"
end

function MonetizationService.Init(services)
	Services = services
	for key, pass in Config.GamePasses do
		if pass.Id > 0 then
			passKeyById[pass.Id] = key
		end
	end
	for key, product in Config.Products do
		if product.Id > 0 then
			productKeyById[product.Id] = key
		end
	end
	Services.PlayerService.RegisterRequest("TestPurchase", testPurchase)
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passKeyById[passId]
		if purchased and key then
			grantPass(player, key)
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--[[
	Player lifecycle, cash, multipliers, rebirths and free rewards
	(daily login streak, playtime gifts, promo codes, offline earnings).

	State the client needs is mirrored onto player attributes:
	  Cash, Multiplier, IncomePerSec, Rebirths, RebirthCost, DailyReadyAt, DailyStreak,
	  NextGiftAt, PlotId, FriendBonus, Pass_<Key>, VIP, Loaded
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Economy = require(ReplicatedStorage.Shared.Economy)
local Format = require(ReplicatedStorage.Shared.Format)

local PlayerService = {}

local Services
local requestHandlers: { [string]: (Player, any) -> (boolean, string?) } = {}
local lastRequest: { [Player]: number } = {}
local joinTime: { [Player]: number } = {}
local friendCache: { [Player]: { [number]: boolean } } = {}

----------------------------------------------------------------------------------------
-- Cash
----------------------------------------------------------------------------------------

local function syncCash(player: Player, data: any)
	player:SetAttribute("Cash", data.Cash)
	local leaderstats = player:FindFirstChild("leaderstats")
	local cashValue = leaderstats and leaderstats:FindFirstChild("Cash")
	if cashValue then
		(cashValue :: StringValue).Value = Format.Cash(data.Cash)
	end
end

function PlayerService.GetCash(player: Player): number
	local data = Services.DataService.Get(player)
	return if data then data.Cash else 0
end

function PlayerService.AddCash(player: Player, amount: number)
	local data = Services.DataService.Get(player)
	if not data or amount <= 0 or amount ~= amount then
		return
	end
	data.Cash += amount
	data.TotalEarned += amount
	syncCash(player, data)
end

function PlayerService.SpendCash(player: Player, amount: number): boolean
	local data = Services.DataService.Get(player)
	if not data or data.Cash < amount then
		return false
	end
	data.Cash -= amount
	syncCash(player, data)
	return true
end

----------------------------------------------------------------------------------------
-- Multipliers & stats
----------------------------------------------------------------------------------------

function PlayerService.GetMultiplier(player: Player): number
	return (player:GetAttribute("Multiplier") or 1) :: number
end

function PlayerService.RefreshStats(player: Player)
	local data = Services.DataService.Get(player)
	if not data then
		return
	end

	local multiplier = Economy.RebirthMultiplier(data.Rebirths)
	if player:GetAttribute("Pass_DoubleCash") then
		multiplier *= 2
	end
	if player:GetAttribute("Pass_VIP") then
		multiplier *= 1.5
	end
	local bonus = (player:GetAttribute("FriendBonus") or 0) + (if player:GetAttribute("InGroup") then Config.GroupBonus else 0)
	multiplier *= 1 + bonus
	multiplier *= 1 + Economy.IndexBonus((player:GetAttribute("IndexCount") or 0) :: number)

	local plot = Services.PlotService.GetPlot(player)
	local owned = if plot then plot.Owned else data.Items
	local income = Economy.PlotIncome(owned, player:GetAttribute("Pass_FastDroppers") == true) * multiplier

	player:SetAttribute("Multiplier", multiplier)
	player:SetAttribute("IncomePerSec", income)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("RebirthCost", Economy.RebirthCost(data.Rebirths))

	local leaderstats = player:FindFirstChild("leaderstats")
	local rebirthValue = leaderstats and leaderstats:FindFirstChild("Rebirths")
	if rebirthValue then
		(rebirthValue :: IntValue).Value = data.Rebirths
	end
end

local function incomeOf(player: Player): number
	return (player:GetAttribute("IncomePerSec") or 0) :: number
end

-- Friends in the same server boost each other's cash.
local function refreshFriendBonuses()
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			local cache = friendCache[player]
			if not cache then
				return
			end
			local friends = 0
			for _, other in Players:GetPlayers() do
				if other ~= player then
					if cache[other.UserId] == nil then
						local ok, isFriend = pcall(player.IsFriendsWith, player, other.UserId)
						cache[other.UserId] = ok and isFriend
					end
					if cache[other.UserId] then
						friends += 1
					end
				end
			end
			local bonus = math.min(friends * Config.FriendBonusPer, Config.FriendBonusMax)
			if player.Parent and player:GetAttribute("FriendBonus") ~= bonus then
				player:SetAttribute("FriendBonus", bonus)
				PlayerService.RefreshStats(player)
				if bonus > 0 then
					Services.Remotes.NotifyPlayer(player, `👯 Friend boost active: +{math.floor(bonus * 100)}% cash!`, "success")
				end
			end
		end)
	end
end

----------------------------------------------------------------------------------------
-- Brainrot Index
----------------------------------------------------------------------------------------

local VALID_VARIANTS = {}
for _, variant in Economy.IndexVariants() do
	VALID_VARIANTS[variant] = true
end

local function countIndex(index: { [string]: { [string]: boolean } }): number
	local count = 0
	for _, variants in index do
		for _ in variants do
			count += 1
		end
	end
	return count
end

-- Mirrors the saved Index onto attributes ("Idx_<CharacterId>_<Variant>") for the client.
local function syncIndex(player: Player, data: any)
	for characterId, variants in data.Index do
		for variant in variants do
			player:SetAttribute(`Idx_{characterId}_{variant}`, true)
		end
	end
	player:SetAttribute("IndexCount", countIndex(data.Index))
end

-- Called whenever a brainrot spawns on a player's plot.
function PlayerService.Discover(player: Player, def: any, variant: string)
	local data = Services.DataService.Get(player)
	if not data or not VALID_VARIANTS[variant] then
		return
	end
	local entry = data.Index[def.Id]
	if entry and entry[variant] then
		return
	end
	if not entry then
		entry = {}
		data.Index[def.Id] = entry
	end
	entry[variant] = true
	player:SetAttribute(`Idx_{def.Id}_{variant}`, true)
	player:SetAttribute("IndexCount", countIndex(data.Index))
	PlayerService.RefreshStats(player)

	local label = if variant == "Normal" then def.Name else `{variant} {def.Name}`
	local percent = Config.IndexBonusPerDiscovery * 100
	Services.Remotes.NotifyPlayer(player, `📖 NEW in your Index: {label}! (+{percent}% cash forever)`, "rare")
end

----------------------------------------------------------------------------------------
-- Rebirth & rewards
----------------------------------------------------------------------------------------

function PlayerService.Rebirth(player: Player): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Still loading"
	end
	local cost = Economy.RebirthCost(data.Rebirths)
	if data.Cash < cost then
		return false, `You need {Format.Cash(cost - data.Cash)} more to rebirth!`
	end

	data.Rebirths += 1
	data.Cash = 0
	data.Items = {}
	Services.PlotService.ResetForRebirth(player)
	syncCash(player, data)
	PlayerService.RefreshStats(player)

	local multiplier = Economy.RebirthMultiplier(data.Rebirths)
	Services.Remotes.Celebrate:FireClient(player, `REBIRTH {data.Rebirths}!`, `Permanent x{multiplier} cash multiplier`)
	Services.Remotes.NotifyAll(`🔁 {player.DisplayName} just reached Rebirth {data.Rebirths}!`, "event")
	task.spawn(Services.DataService.Save, player)
	return true, "Rebirthed!"
end

local function claimDaily(player: Player): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data then
		return false, "Still loading"
	end
	local now = os.time()
	local elapsed = now - data.Daily.Last
	if elapsed < Config.DailyCooldown then
		return false, `Next daily reward in {Format.Time(Config.DailyCooldown - elapsed)}`
	end
	local streak = if elapsed <= Config.DailyStreakWindow then data.Daily.Streak + 1 else 1
	local day = (streak - 1) % #Config.DailyRewards + 1
	local reward = Config.DailyRewards[day]
	local amount = Economy.ScaledReward(incomeOf(player), reward.IncomeSeconds, reward.Minimum)

	data.Daily.Streak = streak
	data.Daily.Last = now
	PlayerService.AddCash(player, amount)
	player:SetAttribute("DailyStreak", streak)
	player:SetAttribute("DailyReadyAt", now + Config.DailyCooldown)
	Services.Remotes.CashPopup:FireClient(player, amount)
	return true, `Day {day} reward: {Format.Cash(amount)}! Come back tomorrow for more.`
end

local function claimGift(player: Player): (boolean, string?)
	local now = os.time()
	local readyAt = player:GetAttribute("NextGiftAt") or math.huge
	if now < readyAt then
		return false, `Gift ready in {Format.Time(readyAt - now)}`
	end
	local gift = Config.PlaytimeGift
	local amount = Economy.ScaledReward(incomeOf(player), gift.IncomeSeconds, gift.Minimum)
	PlayerService.AddCash(player, amount)
	player:SetAttribute("NextGiftAt", now + gift.Interval)
	Services.Remotes.CashPopup:FireClient(player, amount)
	return true, `🎁 Free gift: {Format.Cash(amount)}!`
end

local function redeemCode(player: Player, code: any): (boolean, string?)
	local data = Services.DataService.Get(player)
	if not data or type(code) ~= "string" or #code > 40 then
		return false, "Invalid code"
	end
	code = string.upper((code:gsub("%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		return false, "That code doesn't exist (yet 👀)"
	end
	if data.Codes[code] then
		return false, "You already redeemed that code!"
	end
	local amount = (reward.Cash or 0)
	if reward.IncomeSeconds then
		amount += Economy.ScaledReward(incomeOf(player), reward.IncomeSeconds, reward.Minimum or 0)
	end
	data.Codes[code] = true
	PlayerService.AddCash(player, amount)
	Services.Remotes.CashPopup:FireClient(player, amount)
	return true, `Code redeemed: {Format.Cash(amount)}!`
end

local function giveOfflineEarnings(player: Player, data: any)
	if data.LastOnline <= 0 then
		return
	end
	local offline = os.time() - data.LastOnline
	local cfg = Config.OfflineEarnings
	if offline < cfg.MinSeconds then
		return
	end
	local amount = math.floor(incomeOf(player) * math.min(offline, cfg.MaxSeconds) * cfg.Rate)
	if amount > 0 then
		PlayerService.AddCash(player, amount)
		Services.Remotes.Celebrate:FireClient(
			player,
			"WELCOME BACK!",
			`Your factory made {Format.Cash(amount)} while you were away`
		)
	end
end

----------------------------------------------------------------------------------------
-- Requests from the client
----------------------------------------------------------------------------------------

function PlayerService.RegisterRequest(action: string, handler: (Player, any) -> (boolean, string?))
	requestHandlers[action] = handler
end

local function onRequest(player: Player, action: any, payload: any)
	if type(action) ~= "string" then
		return { Ok = false }
	end
	local now = os.clock()
	if (lastRequest[player] or 0) + 0.3 > now then
		return { Ok = false, Message = "Slow down!" }
	end
	lastRequest[player] = now
	local handler = requestHandlers[action]
	if not handler then
		return { Ok = false }
	end
	if not Services.DataService.Get(player) then
		return { Ok = false, Message = "Still loading your factory..." }
	end
	local ok, ok2, message = pcall(handler, player, payload)
	if not ok then
		warn(`[Request] {action} failed: {ok2}`)
		return { Ok = false, Message = "Something went wrong" }
	end
	return { Ok = ok2, Message = message }
end

----------------------------------------------------------------------------------------
-- Characters
----------------------------------------------------------------------------------------

local function setCollisionGroup(instance: Instance)
	if instance:IsA("BasePart") then
		instance.CollisionGroup = "Players"
	end
end

local function onCharacterAdded(player: Player, character: Model)
	for _, descendant in character:GetDescendants() do
		setCollisionGroup(descendant)
	end
	character.DescendantAdded:Connect(setCollisionGroup)

	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root then
		return
	end
	if player:GetAttribute("VIP") then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 200, 40)
		sparkles.Parent = root
	end
	task.wait() -- let the default spawn finish first
	PlayerService.TeleportToPlot(player)
end

function PlayerService.TeleportToPlot(player: Player)
	local plot = Services.PlotService.GetPlot(player)
	local character = player.Character
	if plot and character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(Services.PlotService.SpawnCFrame(plot))
	end
end

----------------------------------------------------------------------------------------
-- Join / leave
----------------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	joinTime[player] = os.time()
	friendCache[player] = {}

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cashValue = Instance.new("StringValue")
	cashValue.Name = "Cash"
	cashValue.Value = "$0"
	cashValue.Parent = leaderstats
	local rebirthValue = Instance.new("IntValue")
	rebirthValue.Name = "Rebirths"
	rebirthValue.Parent = leaderstats
	leaderstats.Parent = player

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	local data = Services.DataService.Load(player)
	if not player.Parent then
		Services.DataService.Release(player)
		return
	end

	Services.MonetizationService.LoadPasses(player, data)
	if Config.GroupId > 0 then
		local ok, inGroup = pcall(player.IsInGroupAsync, player, Config.GroupId)
		player:SetAttribute("InGroup", ok and inGroup)
	end

	local plot = Services.PlotService.Claim(player, data.Items)
	if not plot then
		player:Kick("This server is full - please join another one!")
		return
	end

	syncCash(player, data)
	syncIndex(player, data)
	PlayerService.RefreshStats(player)
	giveOfflineEarnings(player, data)

	player:SetAttribute("DailyStreak", data.Daily.Streak)
	player:SetAttribute("DailyReadyAt", data.Daily.Last + Config.DailyCooldown)
	player:SetAttribute("NextGiftAt", os.time() + Config.PlaytimeGift.Interval)
	player:SetAttribute("Loaded", true)

	PlayerService.TeleportToPlot(player)
	refreshFriendBonuses()

	if not data.Items.D1 then
		Services.Remotes.NotifyPlayer(player, "Welcome! Step on the green FREE button to build your first dropper 👇", "info")
	end
	if not Services.DataService.CanSave(player) then
		Services.Remotes.NotifyPlayer(player, "⚠️ Saving is unavailable right now - progress may not save.", "error")
	end
end

local function beforeRelease(player: Player)
	local data = Services.DataService.Get(player)
	if data then
		Services.PlotService.Collect(player, true)
		if joinTime[player] then
			data.Playtime += os.time() - joinTime[player]
			joinTime[player] = nil
		end
	end
end

local function onPlayerRemoving(player: Player)
	beforeRelease(player)
	Services.PlotService.Release(player)
	Services.DataService.Release(player)
	lastRequest[player] = nil
	friendCache[player] = nil
	joinTime[player] = nil
	refreshFriendBonuses()
end

function PlayerService.Init(services)
	Services = services
	Services.DataService.BeforeRelease = beforeRelease

	PlayerService.RegisterRequest("Rebirth", PlayerService.Rebirth)
	PlayerService.RegisterRequest("ClaimDaily", claimDaily)
	PlayerService.RegisterRequest("ClaimGift", claimGift)
	PlayerService.RegisterRequest("RedeemCode", redeemCode)
	Services.Remotes.Request.OnServerInvoke = onRequest
end

function PlayerService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Auto Collect game pass, plus collecting while standing still on the pad
	-- (Touched only fires when you move onto it).
	task.spawn(function()
		while true do
			task.wait(Config.AutoCollectInterval)
			for _, player in Players:GetPlayers() do
				if player:GetAttribute("Pass_AutoCollect") then
					Services.PlotService.Collect(player, true)
				elseif Services.PlotService.IsOnCollectPad(player) then
					Services.PlotService.Collect(player)
				end
			end
		end
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[--[[
	Plots: creation, claiming, buy buttons, purchases, the cash bank and collecting.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local Format = require(ReplicatedStorage.Shared.Format)
local Builders = require(script.Parent.Builders)

local PlotService = {}

export type Dropper = { Item: any, SpawnCF: CFrame, Next: number }

export type Plot = {
	Id: number,
	CFrame: CFrame,
	Parts: Builders.PlotParts,
	Owner: Player?,
	Owned: { [string]: boolean },
	Bank: number,
	Droppers: { Dropper },
	CollectorMultiplier: number,
	DropCount: number,
	ButtonCooldown: { [string]: number },
}

PlotService.Plots = {} :: { Plot }

local plotByPlayer: { [Player]: Plot } = {}
local Services

local function playerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if character and character:FindFirstChildOfClass("Humanoid") then
		return Players:GetPlayerFromCharacter(character)
	end
	return nil
end

function PlotService.GetPlot(player: Player): Plot?
	return plotByPlayer[player]
end

function PlotService.SpawnCFrame(plot: Plot): CFrame
	-- Stand at the front of the plot looking toward the conveyor.
	local position = plot.CFrame * Builders.SPAWN_POS
	local lookAt = plot.CFrame * Vector3.new(0, Builders.SPAWN_POS.Y, 0)
	return CFrame.lookAt(position, lookAt)
end

----------------------------------------------------------------------------------------
-- Bank
----------------------------------------------------------------------------------------

local function updateBankLabel(plot: Plot)
	plot.Parts.BankLabel.Text = Format.Cash(plot.Bank)
	plot.Parts.Model:SetAttribute("Bank", plot.Bank)
end

function PlotService.AddToBank(plot: Plot, amount: number)
	plot.Bank += amount
	updateBankLabel(plot)
end

-- Moves banked cash into the owner's wallet. Returns the amount collected.
function PlotService.Collect(player: Player, silent: boolean?): number
	local plot = plotByPlayer[player]
	if not plot or plot.Bank <= 0 then
		return 0
	end
	local amount = plot.Bank
	plot.Bank = 0
	updateBankLabel(plot)
	Services.PlayerService.AddCash(player, amount)
	if not silent then
		Services.Remotes.CashPopup:FireClient(player, amount, plot.Parts.CollectPad.Position)
	end
	return amount
end

-- True while the player's character is standing on their own collect pad.
function PlotService.IsOnCollectPad(player: Player): boolean
	local plot = plotByPlayer[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not plot or not root then
		return false
	end
	local offset = plot.Parts.CollectPad.CFrame:PointToObjectSpace(root.Position)
	return math.abs(offset.X) < 3.5 and math.abs(offset.Z) < 3.5 and offset.Y > 0 and offset.Y < 6
end

----------------------------------------------------------------------------------------
-- Building items
----------------------------------------------------------------------------------------

local function buildItem(plot: Plot, item: any, animate: boolean)
	local folder = plot.Parts.ItemsFolder
	local m: Model
	if item.Type == "Dropper" then
		local spawnCF
		m, spawnCF = Builders.Dropper(item, plot.CFrame, folder)
		table.insert(plot.Droppers, { Item = item, SpawnCF = spawnCF, Next = os.clock() + 0.5 })
	elseif item.Type == "Upgrader" then
		local laser
		m, laser = Builders.Upgrader(item, plot.CFrame, folder)
		Services.DropService.HookUpgrader(plot, item, laser)
	elseif item.Type == "Collector" then
		m = Builders.CollectorUpgrade(item, plot.CFrame, folder)
		plot.CollectorMultiplier *= item.Multiplier
		plot.Parts.Collector.Color = Color3.fromRGB(255, 200, 40)
	else
		m = Builders.Decor(item, plot.CFrame, folder)
	end
	if animate then
		Builders.PlayBuildAnimation(m)
		Builders.Confetti(plot.Parts.Model, m:GetPivot().Position + Vector3.new(0, 4, 0))
	end
end

----------------------------------------------------------------------------------------
-- Buttons
----------------------------------------------------------------------------------------

local function isVisible(plot: Plot, item: any): boolean
	if plot.Owned[item.Id] then
		return false
	end
	return item.Requires == nil or plot.Owned[item.Requires] == true
end

local function onButtonTouched(plot: Plot, item: any, hit: BasePart)
	local player = playerFromHit(hit)
	if not player or player ~= plot.Owner then
		return
	end
	local now = os.clock()
	if (plot.ButtonCooldown[item.Id] or 0) > now then
		return
	end
	plot.ButtonCooldown[item.Id] = now + 1
	PlotService.TryBuy(player, item.Id)
end

function PlotService.RefreshButtons(plot: Plot)
	local folder = plot.Parts.ButtonsFolder
	for _, button in folder:GetChildren() do
		local item = Items.ById[button:GetAttribute("ItemId")]
		if not plot.Owner or not item or not isVisible(plot, item) then
			button:Destroy()
		end
	end
	if not plot.Owner then
		return
	end
	for _, item in Items.List do
		if isVisible(plot, item) and not folder:FindFirstChild("Button_" .. item.Id) then
			local priceText = if item.Price == 0 then "FREE" else Format.Cash(item.Price)
			local _, pad = Builders.Button(item, plot.CFrame, folder, priceText)
			pad.Touched:Connect(function(hit)
				onButtonTouched(plot, item, hit)
			end)
		end
	end
end

function PlotService.TryBuy(player: Player, itemId: string): (boolean, string?)
	local plot = plotByPlayer[player]
	local item = Items.ById[itemId]
	if not plot or not item then
		return false, "Invalid item"
	end
	if not isVisible(plot, item) then
		return false, "Not available yet"
	end
	if not Services.PlayerService.SpendCash(player, item.Price) then
		local cash = Services.PlayerService.GetCash(player)
		Services.Remotes.NotifyPlayer(player, `Need {Format.Cash(item.Price - cash)} more for {item.Name}!`, "error")
		return false, "Not enough cash"
	end

	plot.Owned[item.Id] = true
	local data = Services.DataService.Get(player)
	if data then
		data.Items[item.Id] = true
	end
	buildItem(plot, item, true)
	PlotService.RefreshButtons(plot)
	Services.PlayerService.RefreshStats(player)
	Services.Remotes.NotifyPlayer(player, `Built {item.Name}!`, "success")

	if item.Id == Items.List[#Items.List].Id then
		Services.Remotes.Celebrate:FireClient(player, "FACTORY COMPLETE!", "Rebirth for a permanent cash multiplier!")
	end
	return true
end

----------------------------------------------------------------------------------------
-- Ownership
----------------------------------------------------------------------------------------

local function clearPlot(plot: Plot)
	plot.Parts.ItemsFolder:ClearAllChildren()
	plot.Parts.DropsFolder:ClearAllChildren()
	plot.Owned = {}
	plot.Droppers = {}
	plot.CollectorMultiplier = 1
	plot.Bank = 0
	plot.DropCount = 0
	plot.ButtonCooldown = {}
	plot.Parts.Collector.Color = Color3.fromRGB(60, 230, 120)
	Services.DropService.ClearPlot(plot)
	updateBankLabel(plot)
end

function PlotService.Claim(player: Player, ownedItems: { [string]: boolean }): Plot?
	for _, plot in PlotService.Plots do
		if plot.Owner == nil then
			clearPlot(plot)
			plot.Owner = player
			plotByPlayer[player] = plot
			plot.Parts.OwnerLabel.Text = `{player.DisplayName}'s Factory`
			plot.Parts.Model:SetAttribute("OwnerUserId", player.UserId)
			player:SetAttribute("PlotId", plot.Id)

			for _, item in Items.List do
				if ownedItems[item.Id] then
					plot.Owned[item.Id] = true
					buildItem(plot, item, false)
				end
			end
			PlotService.RefreshButtons(plot)
			return plot
		end
	end
	return nil
end

function PlotService.Release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	clearPlot(plot)
	PlotService.RefreshButtons(plot)
	plot.Parts.OwnerLabel.Text = "Empty Factory"
	plot.Parts.Model:SetAttribute("OwnerUserId", nil)
end

function PlotService.ResetForRebirth(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	clearPlot(plot)
	PlotService.RefreshButtons(plot)
end

----------------------------------------------------------------------------------------
-- Setup
----------------------------------------------------------------------------------------

function PlotService.Init(services)
	Services = services

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace

	for i = 1, Config.MaxPlots do
		local angle = (i - 1) / Config.MaxPlots * math.pi * 2
		local position = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Config.PlotRingRadius
		-- Rotate so the plot's front (+Z) faces the lobby at the origin.
		local plotCF = CFrame.lookAt(position, Vector3.zero) * CFrame.Angles(0, math.pi, 0)

		local parts = Builders.PlotBase(plotCF, i, plotsFolder)
		local plot: Plot = {
			Id = i,
			CFrame = plotCF,
			Parts = parts,
			Owner = nil,
			Owned = {},
			Bank = 0,
			Droppers = {},
			CollectorMultiplier = 1,
			DropCount = 0,
			ButtonCooldown = {},
		}
		table.insert(PlotService.Plots, plot)

		parts.CollectPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and player == plot.Owner then
				PlotService.Collect(player)
			end
		end)
		Services.DropService.HookCollector(plot)
	end
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">RarityFX</string>
          <string name="Source"><![CDATA[--[[
	Rarity pedestals and nameplates for the showcase brainrot on top of every dropper.

	Each tier stacks more effects on the one below it:
	  Common     marble pedestal with a coloured trim ring
	  Uncommon   + floating sparkle aura
	  Rare       + glow light and a glass top
	  Epic       + orbiting ring of gems
	  Legendary  + light beam and sparkles
	  Mythic     + counter-rotating second ring and stardust
	  Secret     + rainbow-cycling everything
	Orbit rings use the same Anim* attributes as characters, so the client Animator
	spins them locally.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterKit = require(ReplicatedStorage.Shared.CharacterKit)
local Format = require(ReplicatedStorage.Shared.Format)
local Rarity = require(ReplicatedStorage.Shared.Rarity)

local RarityFX = {}

local function part(parent: Instance, props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

-- Upright cylinder (Roblox cylinders run along X, so rotate onto Y).
local function disc(parent: Instance, cf: CFrame, diameter: number, height: number, props: { [string]: any }): Part
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	return part(parent, props)
end

local function orbitRing(parent: Model, center: CFrame, radius: number, count: number, color: Color3, speed: number, tilt: number, rainbow: boolean)
	local ring = Instance.new("Model")
	ring.Name = "OrbitRing"
	ring:SetAttribute("AnimType", "Spin")
	ring:SetAttribute("AnimAxis", "Y")
	ring:SetAttribute("AnimSpeed", speed)
	ring.Parent = parent
	local ringCF = center * CFrame.Angles(math.rad(tilt), 0, 0)
	ring.WorldPivot = ringCF
	for i = 1, count do
		local angle = (i - 1) / count * math.pi * 2
		local gem = part(ring, {
			Name = "Gem",
			Size = Vector3.new(0.35, 0.35, 0.35),
			CFrame = ringCF * CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius) * CFrame.Angles(math.rad(45), math.rad(45), 0),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		if rainbow then
			CollectionService:AddTag(gem, CharacterKit.RainbowTag)
		end
	end
end

-- Builds the pedestal. `topCF` is the centre of the pedestal's top surface.
function RarityFX.Pedestal(rarityKey: string, topCF: CFrame, parent: Instance): Model
	local tier = Rarity.Get(rarityKey)
	local order = tier.Order
	local model = Instance.new("Model")
	model.Name = "Pedestal"
	model.Parent = parent

	local base = disc(model, topCF * CFrame.new(0, -0.35, 0), 6, 0.7, {
		Name = "Base",
		Color = if tier.Rainbow then Color3.fromRGB(20, 20, 30) else Color3.fromRGB(235, 235, 245),
		Material = Enum.Material.Marble,
	})
	model.PrimaryPart = base
	local trim = disc(model, topCF * CFrame.new(0, -0.35, 0), 6.3, 0.25, {
		Name = "Trim",
		Color = tier.Color,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	if tier.Rainbow then
		CollectionService:AddTag(trim, CharacterKit.RainbowTag)
	end

	if order >= 3 then
		disc(model, topCF * CFrame.new(0, 0.03, 0), 5.4, 0.06, {
			Name = "GlassTop",
			Color = tier.Color,
			Material = Enum.Material.Glass,
			Transparency = 0.5,
			CanCollide = false,
		})
		local light = Instance.new("PointLight")
		light.Color = tier.Color
		light.Range = 8 + order
		light.Brightness = 0.6 + order * 0.15
		light.Parent = trim
	end

	if order >= 2 then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(tier.Color, tier.Color2)
		emitter.Size = NumberSequence.new(0.25 + order * 0.03, 0)
		emitter.Lifetime = NumberRange.new(1.2, 2)
		emitter.Speed = NumberRange.new(1, 2.5)
		emitter.Rate = 2 + order * 1.5
		emitter.SpreadAngle = Vector2.new(15, 15)
		emitter.LightEmission = 0.8
		-- The disc is rotated so its local +X points up; emit from that face.
		emitter.EmissionDirection = Enum.NormalId.Right
		emitter.Shape = Enum.ParticleEmitterShape.Disc
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		emitter.Parent = trim
		emitter.Transparency = NumberSequence.new(0.2, 1)
	end

	if order >= 4 then
		orbitRing(model, topCF * CFrame.new(0, 1.2, 0), 3.4, 10, tier.Color, 0.25, 0, tier.Rainbow)
	end

	if order >= 5 then
		disc(model, topCF * CFrame.new(0, 8, 0), 2.2, 16, {
			Name = "Beam",
			Color = tier.Color,
			Material = Enum.Material.Neon,
			Transparency = 0.88,
			CanCollide = false,
			CastShadow = false,
		})
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = tier.Color
		sparkles.Parent = base
	end

	if order >= 6 then
		orbitRing(model, topCF * CFrame.new(0, 4.5, 0), 3.6, 14, tier.Color2, -0.18, 18, tier.Rainbow)
		local stars = Instance.new("ParticleEmitter")
		stars.Color = ColorSequence.new(Color3.new(1, 1, 1), tier.Color)
		stars.Size = NumberSequence.new(0.18, 0)
		stars.Lifetime = NumberRange.new(2, 3)
		stars.Speed = NumberRange.new(0.2, 0.6)
		stars.Rate = 6
		stars.SpreadAngle = Vector2.new(180, 180)
		stars.LightEmission = 1
		stars.Parent = base
	end

	if model:FindFirstChild("OrbitRing") then
		CollectionService:AddTag(model, CharacterKit.AnimatedTag)
	end
	return model
end

-- Floating name / rarity / value label above the character.
function RarityFX.Nameplate(def: any, valuePerDrop: number, anchorCF: CFrame, parent: Instance): BillboardGui
	local tier = Rarity.Get(def.Rarity)
	local anchor = part(parent, {
		Name = "NameplateAnchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = anchorCF,
		Transparency = 1,
		CanCollide = false,
	})

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(9, 3)
	gui.LightInfluence = 0
	gui.MaxDistance = 110
	gui.Adornee = anchor
	gui.Parent = anchor

	local function line(text: string, y: number, height: number, color: Color3): TextLabel
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.fromScale(0, y)
		label.Size = UDim2.fromScale(1, height)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = color
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = Color3.fromRGB(15, 10, 25)
		stroke.Parent = label
		return label
	end

	line(def.Name, 0, 0.42, Color3.new(1, 1, 1))
	local rarityLabel = line(tier.Name:upper(), 0.42, 0.3, Color3.new(1, 1, 1))
	local gradient = Instance.new("UIGradient")
	if tier.Rainbow then
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 230, 110)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 170, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(185, 95, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 200)),
		})
	else
		gradient.Color = ColorSequence.new(tier.Color, tier.Color2)
		gradient.Rotation = 90
	end
	gradient.Parent = rarityLabel
	line(`{Format.Cash(valuePerDrop)} / drop`, 0.74, 0.26, Color3.fromRGB(120, 255, 150))
	return gui
end

return RarityFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Creates the RemoteEvents/RemoteFunctions the client talks to.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function make(className: string, name: string): any
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

Remotes.Notify = make("RemoteEvent", "Notify") :: RemoteEvent -- (text, style)
Remotes.CashPopup = make("RemoteEvent", "CashPopup") :: RemoteEvent -- (amount, worldPosition?)
Remotes.Celebrate = make("RemoteEvent", "Celebrate") :: RemoteEvent -- (title, subtitle)
Remotes.Request = make("RemoteFunction", "Request") :: RemoteFunction -- (action, payload) -> result

folder.Parent = ReplicatedStorage

function Remotes.NotifyPlayer(player: Player, text: string, style: string?)
	Remotes.Notify:FireClient(player, text, style or "info")
end

function Remotes.NotifyAll(text: string, style: string?)
	Remotes.Notify:FireAllClients(text, style or "info")
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--[[
	Builds the lobby, lighting, ground, paths and scenery.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Builders = require(script.Parent.Builders)

local WorldBuilder = {}

local ORIGIN = CFrame.new()

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.Ambient = Color3.fromRGB(80, 70, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 140, 180)

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Color = Color3.fromRGB(200, 190, 255)
	atmosphere.Decay = Color3.fromRGB(120, 100, 200)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.2
	color.Contrast = 0.08
	color.Parent = Lighting

	local sunRays = Instance.new("SunRaysEffect")
	sunRays.Intensity = 0.06
	sunRays.Parent = Lighting
end

local function setupGround(parent: Instance)
	local ground = workspace:FindFirstChild("Baseplate") :: BasePart?
	if not ground then
		ground = Builders.Part(parent, ORIGIN, Vector3.new(2048, 16, 2048), Vector3.new(0, -8, 0), { Name = "Baseplate" })
	end
	local g = ground :: BasePart
	g.Color = Color3.fromRGB(100, 200, 110)
	g.Material = Enum.Material.Grass
	g.Locked = true
	local texture = g:FindFirstChildOfClass("Texture")
	if texture then
		texture:Destroy()
	end
end

local function cylinder(parent: Instance, diameter: number, height: number, centre: Vector3, props): Part
	local p = Builders.Part(parent, ORIGIN, Vector3.new(height, diameter, diameter), centre, props)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = CFrame.new(centre) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

local function makeBoard(parent: Instance, angleDegrees: number, radius: number, size: Vector2): (Part, Frame)
	local angle = math.rad(angleDegrees)
	local position = Vector3.new(math.cos(angle) * radius, 1 + size.Y / 2 + 1, math.sin(angle) * radius)
	local board = Builders.Part(parent, ORIGIN, Vector3.new(size.X, size.Y, 1), position, {
		Name = "Board",
		Color = Color3.fromRGB(25, 15, 45),
	})
	board.CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, 0))

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.PixelsPerStud = 40
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.LightInfluence = 0
	gui.Parent = board

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundTransparency = 1
	frame.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 20)
	padding.PaddingLeft = UDim.new(0, 30)
	padding.PaddingRight = UDim.new(0, 30)
	padding.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = frame

	local trim = Builders.Part(parent, ORIGIN, Vector3.new(size.X + 1, size.Y + 1, 0.6), position, {
		Name = "Trim",
		Color = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Neon,
	})
	trim.CFrame = board.CFrame * CFrame.new(0, 0, 0.6)
	return board, frame
end

local function boardLine(frame: Frame, text: string, height: number, color: Color3?, order: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, height)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Text = text
	label.LayoutOrder = order
	label.Parent = frame
	return label
end

function WorldBuilder.Init()
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace
	setupGround(world)

	-- Lobby platform + spawn.
	cylinder(world, 64, 1, Vector3.new(0, 0.5, 0), {
		Name = "Lobby",
		Color = Color3.fromRGB(60, 50, 90),
		Material = Enum.Material.Marble,
	})
	cylinder(world, 66, 0.8, Vector3.new(0, 0.4, 0), {
		Name = "LobbyRing",
		Color = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Neon,
	})
	for _, existing in workspace:GetDescendants() do
		if existing:IsA("SpawnLocation") then
			existing:Destroy()
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(0, 1.5, 0)
	spawn.Color = Color3.fromRGB(80, 220, 255)
	spawn.Material = Enum.Material.Neon
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = world

	local titleAnchor = Builders.Part(world, ORIGIN, Vector3.one, Vector3.new(0, 28, 0), {
		Name = "TitleAnchor",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local title = Builders.Billboard(titleAnchor, `🧠 {Config.GameName:upper()} 🏭`, Vector2.new(60, 8), 0, 600)
	title.TextColor3 = Color3.fromRGB(255, 220, 80)

	-- Paths from the lobby to each plot's front edge.
	for i = 1, Config.MaxPlots do
		local angle = (i - 1) / Config.MaxPlots * math.pi * 2
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local startRadius, endRadius = 31, Config.PlotRingRadius - Config.PlotSize / 2
		local centre = direction * (startRadius + endRadius) / 2 + Vector3.new(0, 0.3, 0)
		local path = Builders.Part(world, ORIGIN, Vector3.new(10, 0.6, endRadius - startRadius), centre, {
			Name = "Path",
			Color = Color3.fromRGB(230, 220, 200),
			Material = Enum.Material.Cobblestone,
		})
		path.CFrame = CFrame.lookAt(centre, centre + direction)
	end

	-- Scenery trees outside the plot ring (seeded so every server looks the same).
	local rng = Random.new(1337)
	local outer = Config.PlotRingRadius + Config.PlotSize * 0.75
	for _ = 1, 70 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(outer, outer + 220)
		local base = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local height = rng:NextNumber(8, 16)
		Builders.Part(world, ORIGIN, Vector3.new(2, height, 2), base + Vector3.new(0, height / 2, 0), {
			Name = "Trunk",
			Color = Color3.fromRGB(110, 70, 40),
			Material = Enum.Material.Wood,
		})
		local leaves = rng:NextNumber(9, 16)
		local colors = { Color3.fromRGB(80, 180, 90), Color3.fromRGB(255, 150, 210), Color3.fromRGB(120, 210, 100) }
		Builders.Part(world, ORIGIN, Vector3.new(leaves, leaves, leaves), base + Vector3.new(0, height + leaves / 3, 0), {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Color = colors[rng:NextInteger(1, #colors)],
			Material = Enum.Material.Grass,
		})
	end

	-- Leaderboard board (filled in by LeaderboardService) between two paths.
	local _, leaderFrame = makeBoard(world, 22.5, 28, Vector2.new(14, 18))
	WorldBuilder.LeaderboardFrame = leaderFrame
	boardLine(leaderFrame, "🏆 TOP EARNERS", 70, Color3.fromRGB(255, 220, 80), 0)

	-- How-to-play board.
	local _, tips = makeBoard(world, 202.5, 28, Vector2.new(14, 18))
	boardLine(tips, "📖 HOW TO PLAY", 70, Color3.fromRGB(80, 220, 255), 0)
	local lines = {
		"1. Step on green buttons to build",
		"2. Brainrots ride the conveyor",
		"3. Walk on COLLECT to grab cash",
		"4. Rare GOLD / DIAMOND / RAINBOW",
		"   brainrots are worth way more!",
		"5. Finish your factory & REBIRTH",
		"   for a permanent multiplier",
		"",
		"👯 Play with friends: +10% each!",
		"🎁 Free gift every 8 minutes",
		"📅 Daily rewards - keep your streak!",
	}
	for i, line in lines do
		boardLine(tips, line, 48, nil, i)
	end
end

WorldBuilder.LeaderboardFrame = nil :: Frame?
WorldBuilder.BoardLine = boardLine

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="36">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="37">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Brainrot Factory Tycoon - client entry point.
	Builds the HUD and keeps it in sync with the player's attributes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Ui = require(script:WaitForChild("Ui"))
local Effects = require(script:WaitForChild("Effects"))
local Panels = require(script:WaitForChild("Panels"))
local Animator = require(script:WaitForChild("Animator"))

local player = Players.LocalPlayer
local Theme = Ui.Theme

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function request(action: string, payload: any?): boolean
	local ok, result = pcall(function()
		return (Remotes:WaitForChild("Request") :: RemoteFunction):InvokeServer(action, payload)
	end)
	if not ok or type(result) ~= "table" then
		return false
	end
	if result.Message then
		Effects.Notify(result.Message, if result.Ok then "success" else "error")
	end
	return result.Ok == true
end

----------------------------------------------------------------------------------------
-- Screen
----------------------------------------------------------------------------------------

local screen = Ui.new("ScreenGui", {
	Name = "TycoonUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
local uiScale = Ui.new("UIScale", { Parent = screen })
local function updateScale()
	local viewport = workspace.CurrentCamera.ViewportSize
	uiScale.Scale = math.clamp(math.min(viewport.X / 1150, viewport.Y / 680), 0.5, 1.2)
end
updateScale()
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

Effects.Init(screen)
Panels.Init(screen, request)
Animator.Start()

-- Cash display
local cashPill = Ui.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 6),
	Size = UDim2.fromOffset(360, 88),
	BackgroundColor3 = Theme.Panel,
	Parent = screen,
}, { Ui.corner(22), Ui.stroke(Theme.Green, 3.5) })
local cashLabel = Ui.label({
	Position = UDim2.fromOffset(16, 4),
	Size = UDim2.new(1, -32, 0, 52),
	Text = "$0",
	TextColor3 = Theme.Green,
	Parent = cashPill,
})
local incomeLabel = Ui.label({
	Position = UDim2.fromOffset(16, 56),
	Size = UDim2.new(1, -32, 0, 26),
	Text = "",
	TextColor3 = Theme.SubText,
	Parent = cashPill,
})
local cashScale = Ui.new("UIScale", { Parent = cashPill })

-- Event banners under the cash display
local bannerHolder = Ui.new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 100),
	Size = UDim2.fromOffset(460, 140),
	BackgroundTransparency = 1,
	Parent = screen,
}, { Ui.new("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }) })

-- Left menu
local menu = Ui.new("Frame", {
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 12, 0.5, 0),
	Size = UDim2.fromOffset(90, 480),
	BackgroundTransparency = 1,
	Parent = screen,
}, { Ui.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })

local menuButtons = {}
for i, entry in
	{
		{ Panel = "Shop", Emoji = "🛒", Label = "Shop", Color = Theme.Accent },
		{ Panel = "Index", Emoji = "📖", Label = "Index", Color = Color3.fromRGB(70, 170, 255) },
		{ Panel = "Rebirth", Emoji = "🔁", Label = "Rebirth", Color = Theme.Gold },
		{ Panel = "Daily", Emoji = "📅", Label = "Daily", Color = Theme.Cyan },
		{ Panel = "Codes", Emoji = "🎟️", Label = "Codes", Color = Theme.Green },
	}
do
	local button = Ui.button({
		Size = UDim2.fromOffset(84, 84),
		Text = "",
		BackgroundColor3 = entry.Color,
		LayoutOrder = i,
		Parent = menu,
	}, function()
		Panels.Toggle(entry.Panel)
	end)
	Ui.label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 4), Text = entry.Emoji, Parent = button })
	Ui.label({ Size = UDim2.new(1, -8, 0, 24), Position = UDim2.fromOffset(4, 56), Text = entry.Label, Parent = button })
	local dot = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = Theme.Red,
		Visible = false,
		Parent = button,
	}, { Ui.corner(11), Ui.stroke(Theme.Outline, 2) })
	Ui.label({ Size = UDim2.fromScale(1, 1), Text = "!", Parent = dot })
	menuButtons[entry.Panel] = { Button = button, Dot = dot }
end

-- Free gift (right side)
local giftButton = Ui.button({
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -12, 0.5, 0),
	Size = UDim2.fromOffset(100, 110),
	Text = "",
	BackgroundColor3 = Theme.Accent,
	Parent = screen,
}, function()
	request("ClaimGift")
end)
Ui.label({ Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 6), Text = "🎁", Parent = giftButton })
local giftLabel = Ui.label({ Size = UDim2.new(1, -10, 0, 34), Position = UDim2.fromOffset(5, 66), Text = "", Parent = giftButton })

-- Loading message until the server has set the player up.
local loading = Ui.label({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(600, 60),
	Text = "Loading your factory... 🏭",
	Visible = not attr("Loaded", false),
	Parent = screen,
})
player:GetAttributeChangedSignal("Loaded"):Connect(function()
	loading.Visible = not attr("Loaded", false)
end)

----------------------------------------------------------------------------------------
-- Cash counter (smoothly counts up)
----------------------------------------------------------------------------------------

local shownCash = attr("Cash", 0)
local lastCash = shownCash
RunService.RenderStepped:Connect(function(dt)
	local target = attr("Cash", 0)
	if target > lastCash then
		cashScale.Scale = 1.08
		Ui.tween(cashScale, 0.25, { Scale = 1 })
	end
	lastCash = target
	shownCash += (target - shownCash) * math.min(1, dt * 10)
	if math.abs(target - shownCash) < 1 then
		shownCash = target
	end
	cashLabel.Text = Format.Cash(math.floor(shownCash))
end)

local function updateIncome()
	incomeLabel.Text = `+{Format.Cash(attr("IncomePerSec", 0))}/s   •   x{Format.Short(attr("Multiplier", 1))} cash`
end
player:GetAttributeChangedSignal("IncomePerSec"):Connect(updateIncome)
player:GetAttributeChangedSignal("Multiplier"):Connect(updateIncome)
updateIncome()

----------------------------------------------------------------------------------------
-- Own plot: button colours, guide arrow, bank popups
----------------------------------------------------------------------------------------

local AFFORDABLE = Color3.fromRGB(70, 220, 110)
local TOO_EXPENSIVE = Color3.fromRGB(230, 70, 90)

local guideBeam = Ui.new("Beam", {
	Color = ColorSequence.new(Theme.Gold),
	Width0 = 0.5,
	Width1 = 0.5,
	FaceCamera = true,
	LightEmission = 1,
	Transparency = NumberSequence.new(0.2),
	Enabled = false,
	Parent = workspace,
})
local guideTarget = Ui.new("Attachment", { Name = "GuideTarget" })
local guideArrow = Ui.new("BillboardGui", {
	Size = UDim2.fromOffset(70, 70),
	StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
	AlwaysOnTop = true,
	Enabled = false,
	ResetOnSpawn = false,
	Parent = player:WaitForChild("PlayerGui"),
})
Ui.label({ Size = UDim2.fromScale(1, 1), Text = "⬇️", Parent = guideArrow })

local function myPlot(): Model?
	local plotId = attr("PlotId", nil)
	local plots = workspace:FindFirstChild("Plots")
	if not plotId or not plots then
		return nil
	end
	return plots:FindFirstChild("Plot" .. plotId) :: Model?
end

local function updateButtons()
	local plot = myPlot()
	local buttons = plot and plot:FindFirstChild("Buttons")
	local cash = attr("Cash", 0)
	local cheapest: BasePart? = nil
	local cheapestPrice = math.huge
	if buttons then
		for _, button in buttons:GetChildren() do
			local pad = button:FindFirstChild("Pad") :: BasePart?
			local price = button:GetAttribute("Price")
			if pad and price then
				pad.Color = if cash >= price then AFFORDABLE else TOO_EXPENSIVE
				if price < cheapestPrice then
					cheapestPrice = price
					cheapest = pad
				end
			end
		end
	end

	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if cheapest and root then
		guideTarget.Parent = cheapest
		guideArrow.Adornee = cheapest
		guideArrow.Enabled = true
		local rootAttachment = root:FindFirstChild("GuideAttachment") :: Attachment?
		if not rootAttachment then
			rootAttachment = Ui.new("Attachment", { Name = "GuideAttachment", Parent = root })
		end
		guideBeam.Attachment0 = rootAttachment
		guideBeam.Attachment1 = guideTarget
		local close = (root.Position - cheapest.Position).Magnitude < 8
		guideBeam.Enabled = cash >= cheapestPrice and not close
	else
		guideArrow.Enabled = false
		guideBeam.Enabled = false
	end
end

-- Bouncing guide arrow
task.spawn(function()
	while true do
		Ui.tween(guideArrow, 0.5, { StudsOffsetWorldSpace = Vector3.new(0, 8.5, 0) }, Enum.EasingStyle.Sine).Completed:Wait()
		Ui.tween(guideArrow, 0.5, { StudsOffsetWorldSpace = Vector3.new(0, 7, 0) }, Enum.EasingStyle.Sine).Completed:Wait()
	end
end)

-- "+$X" popups over the collector as the bank fills.
local bankConnection: RBXScriptConnection? = nil
local pendingBank = 0
local lastBank = 0
local function watchBank()
	if bankConnection then
		bankConnection:Disconnect()
		bankConnection = nil
	end
	local plot = myPlot()
	if not plot then
		return
	end
	lastBank = plot:GetAttribute("Bank") or 0
	bankConnection = plot:GetAttributeChangedSignal("Bank"):Connect(function()
		local bank = plot:GetAttribute("Bank") or 0
		if bank > lastBank then
			pendingBank += bank - lastBank
		end
		lastBank = bank
	end)
end
player:GetAttributeChangedSignal("PlotId"):Connect(watchBank)
watchBank()

task.spawn(function()
	while true do
		task.wait(0.7)
		if pendingBank > 0 then
			local plot = myPlot()
			local anchor = plot and plot:FindFirstChild("BankAnchor", true) :: BasePart?
			if anchor then
				Effects.CashPopup(pendingBank, anchor.Position - Vector3.new(0, 4, 0))
			end
			pendingBank = 0
		end
	end
end)

----------------------------------------------------------------------------------------
-- Event banners
----------------------------------------------------------------------------------------

local banners: { [string]: TextLabel } = {}
local function updateBanners()
	for key, event in Config.Events do
		local endsAt = ReplicatedStorage:GetAttribute("Event_" .. key)
		local active = endsAt and endsAt > serverNow()
		local banner = banners[key]
		if active and not banner then
			local frame = Ui.new("Frame", {
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundColor3 = Theme.Panel,
				Parent = bannerHolder,
			}, { Ui.corner(20), Ui.stroke(Theme.Gold, 3) })
			banner = Ui.label({
				Size = UDim2.new(1, -20, 1, -8),
				Position = UDim2.fromOffset(10, 4),
				TextColor3 = Theme.Gold,
				Parent = frame,
			})
			banners[key] = banner
		elseif not active and banner then
			(banner.Parent :: Instance):Destroy()
			banners[key] = nil
			banner = nil
		end
		if banner then
			local effect = if event.CashMultiplier > 1
				then `{event.CashMultiplier}x CASH`
				else `{event.LuckMultiplier}x LUCK`
			banner.Text = `{event.Emoji} {event.Name} - {effect} - {Format.Time(endsAt - serverNow())}`
		end
	end
end

----------------------------------------------------------------------------------------
-- Periodic refresh (countdowns, dots, panels)
----------------------------------------------------------------------------------------

task.spawn(function()
	while true do
		local now = serverNow()
		local giftAt = attr("NextGiftAt", math.huge)
		if now >= giftAt then
			giftLabel.Text = "CLAIM!"
			giftButton.BackgroundColor3 = Theme.Green
		else
			giftLabel.Text = if giftAt == math.huge then "..." else Format.Time(giftAt - now)
			giftButton.BackgroundColor3 = Theme.Accent
		end
		menuButtons.Daily.Dot.Visible = attr("Loaded", false) and now >= attr("DailyReadyAt", math.huge)
		menuButtons.Rebirth.Dot.Visible = attr("Cash", 0) >= attr("RebirthCost", math.huge)

		updateBanners()
		updateButtons()
		Panels.Refresh()
		task.wait(0.5)
	end
end)

----------------------------------------------------------------------------------------
-- Server messages
----------------------------------------------------------------------------------------

Remotes:WaitForChild("Notify").OnClientEvent:Connect(Effects.Notify)
Remotes:WaitForChild("CashPopup").OnClientEvent:Connect(Effects.CashPopup)
Remotes:WaitForChild("Celebrate").OnClientEvent:Connect(Effects.Celebrate)

----------------------------------------------------------------------------------------
-- Chat tags: [VIP] and rebirth count
----------------------------------------------------------------------------------------

TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local properties = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	local speaker = source and Players:GetPlayerByUserId(source.UserId)
	if speaker then
		local prefix = ""
		if speaker:GetAttribute("VIP") then
			prefix ..= "<font color='#FFC832'>[VIP]</font> "
		end
		local rebirths = speaker:GetAttribute("Rebirths") or 0
		if rebirths > 0 then
			prefix ..= `<font color='#FF50C8'>[R{rebirths}]</font> `
		end
		properties.PrefixText = prefix .. message.PrefixText
	end
	return properties
end

print("[BrainrotTycoon] Client ready")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--[[
	Plays the idle animations of brainrot characters (and rarity orbit rings) locally.

	Models tagged CharacterKit.AnimatedTag carry Anim* attributes on animated parts and
	animated group Models (whose WorldPivot is the joint). Every frame each animated
	part is placed at:
	    Root * (O1 * A1(t) * O1^-1) * (O2 * A2(t) * O2^-1) * ... * Base * Apart(t)
	where O = a group's pivot relative to the root, A = its animation transform, and
	Base = the part's rest pose relative to the root. Groups nest naturally (a hand
	wiggling inside a waving arm inside a bobbing body).

	Only models near the camera (or inside a visible ViewportFrame) are animated.
	Rainbow-tagged parts/models cycle through hues.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterKit = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CharacterKit"))

local Animator = {}

local ACTIVE_DISTANCE = 170
local CULL_INTERVAL = 0.5

type Node = { Origin: CFrame, OriginInverse: CFrame, Anim: CharacterKit.AnimParams }
type Entry = {
	Part: BasePart,
	Base: CFrame,
	BaseSize: Vector3,
	Chain: { Node },
	Own: CharacterKit.AnimParams?,
}
type Rig = {
	Model: Model,
	Root: BasePart,
	Entries: { Entry },
	Nodes: { Node },
	Active: boolean,
	InViewport: boolean,
}

local rigs: { [Model]: Rig } = {}

local function buildRig(model: Model): Rig?
	local root = model.PrimaryPart
	if not root then
		return nil
	end
	local rootInverse = root.CFrame:Inverse()
	local nodeCache: { [Instance]: Node } = {}
	local nodes: { Node } = {}

	local function nodeFor(group: Model): Node?
		local cached = nodeCache[group]
		if cached then
			return cached
		end
		local anim = CharacterKit.ReadAnim(group)
		if not anim then
			return nil
		end
		local origin = rootInverse * group.WorldPivot
		local node = { Origin = origin, OriginInverse = origin:Inverse(), Anim = anim }
		nodeCache[group] = node
		table.insert(nodes, node)
		return node
	end

	local entries: { Entry } = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			-- Collect animated ancestor groups, outermost first.
			local chain: { Node } = {}
			local ancestor = part.Parent
			while ancestor and ancestor ~= model do
				if ancestor:IsA("Model") then
					local node = nodeFor(ancestor)
					if node then
						table.insert(chain, 1, node)
					end
				end
				ancestor = ancestor.Parent
			end
			local own = CharacterKit.ReadAnim(part)
			if #chain > 0 or own then
				table.insert(entries, {
					Part = part,
					Base = rootInverse * part.CFrame,
					BaseSize = part.Size,
					Chain = chain,
					Own = own,
				})
			end
		end
	end
	if #entries == 0 then
		return nil
	end
	return {
		Model = model,
		Root = root,
		Entries = entries,
		Nodes = nodes,
		Active = false,
		InViewport = model:FindFirstAncestorOfClass("ViewportFrame") ~= nil,
	}
end

local function addModel(instance: Instance)
	if not instance:IsA("Model") or rigs[instance] then
		return
	end
	-- Wait a frame so every descendant has replicated / been parented.
	task.defer(function()
		if instance.Parent and not rigs[instance] then
			local rig = buildRig(instance)
			if rig then
				rigs[instance] = rig
			end
		end
	end)
end

local function removeModel(instance: Instance)
	rigs[instance :: Model] = nil
end

-- True only if the GUI object and every GUI ancestor are visible and its ScreenGui is
-- enabled (GuiObject.Visible alone ignores hidden parents).
local function guiShown(gui: Instance): boolean
	local node: Instance? = gui
	while node and not node:IsA("LayerCollector") do
		if node:IsA("GuiObject") and not (node :: GuiObject).Visible then
			return false
		end
		node = node.Parent
	end
	return node ~= nil and (node :: LayerCollector).Enabled and node:IsDescendantOf(game)
end

local function updateCulling()
	local camera = workspace.CurrentCamera
	local cameraPos = if camera then camera.CFrame.Position else Vector3.zero
	for model, rig in rigs do
		if not model.Parent or not rig.Root.Parent then
			rigs[model] = nil
		elseif rig.InViewport then
			local viewport = model:FindFirstAncestorOfClass("ViewportFrame")
			rig.Active = viewport ~= nil and guiShown(viewport)
		else
			rig.Active = (rig.Root.Position - cameraPos).Magnitude < ACTIVE_DISTANCE
		end
	end
end

local partsBuffer: { BasePart } = {}
local cframesBuffer: { CFrame } = {}

local function step()
	local t = os.clock()
	table.clear(partsBuffer)
	table.clear(cframesBuffer)
	for _, rig in rigs do
		if rig.Active then
			local rootCF = rig.Root.CFrame
			-- Each group's world-independent delta for this frame.
			local deltas: { [Node]: CFrame } = {}
			for _, node in rig.Nodes do
				deltas[node] = node.Origin * CharacterKit.AnimTransform(node.Anim, t) * node.OriginInverse
			end
			for _, entry in rig.Entries do
				local cf = rootCF
				for _, node in entry.Chain do
					cf *= deltas[node]
				end
				cf *= entry.Base
				local own = entry.Own
				if own then
					cf *= CharacterKit.AnimTransform(own, t)
					if own.Type == "Pulse" or own.Type == "Blink" then
						local size = entry.BaseSize * CharacterKit.AnimScale(own, t)
						if entry.Part.Size ~= size then
							entry.Part.Size = size
						end
					end
				end
				table.insert(partsBuffer, entry.Part)
				table.insert(cframesBuffer, cf)
			end
		end
	end
	if #partsBuffer > 0 then
		workspace:BulkMoveTo(partsBuffer, cframesBuffer, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

----------------------------------------------------------------------------------------
-- Rainbow colour cycling (Rainbow mutation drops, Secret rarity pedestals)
----------------------------------------------------------------------------------------

local rainbowParts: { [BasePart]: number } = {}

local function addRainbow(instance: Instance)
	local function add(part: Instance)
		if part:IsA("BasePart") and part.Transparency < 1 then
			rainbowParts[part] = math.random()
		end
	end
	if instance:IsA("BasePart") then
		add(instance)
	end
	for _, descendant in instance:GetDescendants() do
		add(descendant)
	end
end

local function stepRainbow()
	local t = os.clock()
	for part, offset in rainbowParts do
		if part.Parent then
			part.Color = Color3.fromHSV((t * 0.25 + offset) % 1, 0.75, 1)
		else
			rainbowParts[part] = nil
		end
	end
end

----------------------------------------------------------------------------------------

function Animator.Start()
	for _, instance in CollectionService:GetTagged(CharacterKit.AnimatedTag) do
		addModel(instance)
	end
	CollectionService:GetInstanceAddedSignal(CharacterKit.AnimatedTag):Connect(addModel)
	CollectionService:GetInstanceRemovedSignal(CharacterKit.AnimatedTag):Connect(removeModel)

	for _, instance in CollectionService:GetTagged(CharacterKit.RainbowTag) do
		addRainbow(instance)
	end
	CollectionService:GetInstanceAddedSignal(CharacterKit.RainbowTag):Connect(function(instance)
		task.defer(addRainbow, instance)
	end)

	local sinceCull = math.huge
	local sinceRainbow = 0
	RunService.RenderStepped:Connect(function(dt)
		sinceCull += dt
		if sinceCull >= CULL_INTERVAL then
			sinceCull = 0
			updateCulling()
		end
		step()
		sinceRainbow += dt
		if sinceRainbow >= 0.1 then
			sinceRainbow = 0
			stepRainbow()
		end
	end)
end

-- For models created on the client (Index viewports), register immediately.
function Animator.Track(model: Model)
	local rig = buildRig(model)
	if rig then
		rigs[model] = rig
	end
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Visual feedback: toast notifications, floating cash popups and big celebrations.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Format"))
local Ui = require(script.Parent.Ui)

local Effects = {}

local MAX_TOASTS = 4
local STYLE_COLORS = {
	info = Ui.Theme.Cyan,
	success = Ui.Theme.Green,
	error = Ui.Theme.Red,
	rare = Ui.Theme.Accent,
	event = Ui.Theme.Gold,
}

local toastHolder: Frame
local celebrateHolder: Frame
local screen: ScreenGui

function Effects.Init(gui: ScreenGui)
	screen = gui
	toastHolder = Ui.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.new(0, 520, 0, 230),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Ui.new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}),
	})
	celebrateHolder = Ui.new("Frame", {
		Name = "Celebrate",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	})
end

local toastOrder = 0
function Effects.Notify(text: string, style: string?)
	local color = STYLE_COLORS[style or "info"] or Ui.Theme.Cyan
	toastOrder += 1

	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts >= MAX_TOASTS do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end

	local toast = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = Ui.Theme.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = toastOrder,
		Parent = toastHolder,
	}, { Ui.corner(12), Ui.stroke(color, 2.5) })
	local label = Ui.label({
		Size = UDim2.new(1, -20, 1, -10),
		Position = UDim2.fromOffset(10, 5),
		Text = text,
		TextColor3 = color,
		Parent = toast,
	})
	local scale = Ui.new("UIScale", { Scale = 0.6, Parent = toast })
	Ui.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)

	task.delay(4, function()
		if toast.Parent then
			Ui.tween(toast, 0.4, { BackgroundTransparency = 1 })
			Ui.fadeText(label, 0.4)
			Debris:AddItem(toast, 0.45)
		end
	end)
end

-- Floating "+$123" text. With a world position it floats in 3D, otherwise on screen.
function Effects.CashPopup(amount: number, worldPosition: Vector3?)
	local text = "+" .. Format.Cash(amount)
	if worldPosition then
		local anchor = Ui.new("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Transparency = 1,
			Size = Vector3.one,
			Position = worldPosition + Vector3.new(math.random(-15, 15) / 10, 3, math.random(-15, 15) / 10),
			Parent = workspace,
		})
		local gui = Ui.new("BillboardGui", {
			Size = UDim2.fromOffset(220, 60),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = 120,
			Parent = anchor,
		})
		local label = Ui.label({ Size = UDim2.fromScale(1, 1), Text = text, TextColor3 = Ui.Theme.Green, Parent = gui })
		Ui.tween(anchor, 1.2, { Position = anchor.Position + Vector3.new(0, 6, 0) })
		Ui.fadeText(label, 1.2)
		Debris:AddItem(anchor, 1.3)
		return
	end

	local label = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5 + math.random(-8, 8) / 100, 0.45),
		Size = UDim2.fromOffset(360, 70),
		Text = text,
		TextColor3 = Ui.Theme.Green,
		ZIndex = 40,
		Parent = screen,
	})
	local scale = Ui.new("UIScale", { Scale = 0.3, Parent = label })
	Ui.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Ui.tween(label, 1.4, { Position = label.Position - UDim2.fromScale(0, 0.12) })
	task.delay(0.9, function()
		Ui.fadeText(label, 0.5)
	end)
	Debris:AddItem(label, 1.5)
end

-- Big centred title for milestones (rebirths, passes, welcome back).
function Effects.Celebrate(title: string, subtitle: string?)
	celebrateHolder:ClearAllChildren()
	local titleLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.36),
		Size = UDim2.fromScale(0.8, 0.13),
		Text = title,
		TextColor3 = Ui.Theme.Gold,
		ZIndex = 51,
		Parent = celebrateHolder,
	})
	Ui.gradient(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 120, 40)).Parent = titleLabel
	local subLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.46),
		Size = UDim2.fromScale(0.7, 0.06),
		Text = subtitle or "",
		ZIndex = 51,
		Parent = celebrateHolder,
	})
	local scale = Ui.new("UIScale", { Scale = 0.2, Parent = titleLabel })
	Ui.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)

	-- Confetti
	local colors = { Ui.Theme.Accent, Ui.Theme.Gold, Ui.Theme.Cyan, Ui.Theme.Green }
	for _ = 1, 40 do
		local size = math.random(8, 16)
		local piece = Ui.new("Frame", {
			Position = UDim2.new(math.random(), 0, -0.05, 0),
			Size = UDim2.fromOffset(size, size * 1.6),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = celebrateHolder,
		})
		Ui.tween(piece, math.random(18, 30) / 10, {
			Position = UDim2.new(piece.Position.X.Scale + math.random(-10, 10) / 100, 0, 1.05, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	task.delay(3.2, function()
		if titleLabel.Parent then
			Ui.fadeText(titleLabel, 0.4)
			Ui.fadeText(subLabel, 0.4)
		end
	end)
	task.delay(3.7, function()
		if titleLabel.Parent then
			celebrateHolder:ClearAllChildren()
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--[[
	Pop-up panels: Shop, Rebirth, Daily rewards, Codes.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CharacterKit = require(Shared:WaitForChild("CharacterKit"))
local CharacterRegistry = require(Shared:WaitForChild("CharacterRegistry"))
local Config = require(Shared:WaitForChild("Config"))
local Economy = require(Shared:WaitForChild("Economy"))
local Format = require(Shared:WaitForChild("Format"))
local Items = require(Shared:WaitForChild("Items"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local Ui = require(script.Parent.Ui)
local Effects = require(script.Parent.Effects)
local Animator = require(script.Parent.Animator)

local Panels = {}

local player = Players.LocalPlayer
local PASS_ORDER = { "DoubleCash", "AutoCollect", "LuckyMutations", "FastDroppers", "VIP" }
local PRODUCT_ORDER = { "CashSmall", "CashMedium", "CashLarge", "RainbowRain", "CashFrenzy" }
local TEST_MODE = RunService:IsStudio() and Config.StudioFreePurchases

type Request = (action: string, payload: any?) -> boolean

local request: Request
local panels: { [string]: Frame } = {}
local refreshers: { () -> () } = {}
local openName: string? = nil

local function attr(name: string, default: any): any
	local value = player:GetAttribute(name)
	if value == nil then
		return default
	end
	return value
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

----------------------------------------------------------------------------------------
-- Panel frame
----------------------------------------------------------------------------------------

local function makePanel(screen: ScreenGui, name: string, title: string, color: Color3): Frame
	local panel = Ui.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(580, 430),
		BackgroundColor3 = Ui.Theme.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	}, {
		Ui.corner(18),
		Ui.stroke(color, 4),
		Ui.new("UIScale", { Name = "PopScale" }),
	})
	local header = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundColor3 = color,
		ZIndex = 21,
		Parent = panel,
	}, { Ui.corner(18), Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)) })
	Ui.label({
		Size = UDim2.new(1, -140, 0, 44),
		Position = UDim2.fromOffset(20, 8),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = header,
	})
	Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(44, 44),
		Text = "X",
		BackgroundColor3 = Ui.Theme.Red,
		ZIndex = 23,
		Parent = header,
	}, function()
		Panels.Close()
	end)

	local body = Ui.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 72),
		Size = UDim2.new(1, -32, 1, -86),
		BackgroundTransparency = 1,
		ZIndex = 21,
		Parent = panel,
	})
	panels[name] = panel
	return body
end

function Panels.Close()
	if openName then
		panels[openName].Visible = false
		openName = nil
	end
end

function Panels.Open(name: string)
	Panels.Close()
	local panel = panels[name]
	panel.Visible = true
	openName = name
	local scale = panel:FindFirstChild("PopScale") :: UIScale
	scale.Scale = 0.7
	Ui.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	Panels.Refresh()
end

function Panels.Toggle(name: string)
	if openName == name then
		Panels.Close()
	else
		Panels.Open(name)
	end
end

function Panels.Refresh()
	for _, refresh in refreshers do
		refresh()
	end
end

