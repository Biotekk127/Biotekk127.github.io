      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--[[
	Economy formulas shared by server and client so both always agree.
]]

local Config = require(script.Parent.Config)
local Items = require(script.Parent.Items)

local Economy = {}

function Economy.RebirthCost(rebirths: number): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.CostGrowth ^ rebirths)
end

function Economy.RebirthMultiplier(rebirths: number): number
	return 1 + rebirths * Config.Rebirth.MultiplierPerRebirth
end

-- Cash per second a plot produces before player multipliers (ignores mutations).
function Economy.PlotIncome(owned: { [string]: boolean }, fastDroppers: boolean): number
	local perDrop = 0
	local multiplier = 1
	for id in owned do
		local item = Items.ById[id]
		if item then
			if item.Type == "Dropper" then
				perDrop += item.Value
			elseif item.Type == "Upgrader" or item.Type == "Collector" then
				multiplier *= item.Multiplier
			end
		end
	end
	local interval = Config.DropInterval * (if fastDroppers then Config.FastDropperMultiplier else 1)
	return perDrop / interval * multiplier
end

-- Reward that scales with how far along the player is, with a floor for new players.
function Economy.ScaledReward(incomePerSecond: number, seconds: number, minimum: number): number
	return math.floor(math.max(minimum, incomePerSecond * seconds))
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Number and time formatting shared by server and client.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 15300000 -> "15.3M"
function Format.Short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local text = if n == math.floor(n) then tostring(n) else string.format("%.1f", n)
		return (if negative then "-" else "") .. text
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		text = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	if text:find(".", 1, true) then
		text = text:gsub("0+$", ""):gsub("%.$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[tier + 1]
end

function Format.Cash(n: number): string
	return "$" .. Format.Short(n)
end

-- 3725 -> "1:02:05", 125 -> "2:05"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--[[
	Everything a player can buy on their plot, in progression order.

	Fields
	  Id        unique key (saved in player data - don't rename once the game is live)
	  Name      shown on the buy button
	  Price     cost in cash
	  Requires  Id that must be owned before this button appears (nil = always visible)
	  Type      "Dropper" | "Upgrader" | "Collector" | "Decor"

	  Dropper:   Value (cash per drop) and Creature (what falls out)
	  Upgrader:  Multiplier applied to every drop that passes through it, Color
	  Collector: Multiplier applied when drops are collected
	  Decor:     Build = name of a builder in server/Builders.luau

	Pacing was tuned with tools/economy_sim.py - keep the two in sync.
]]

local Items = {}

Items.List = {
	{
		Id = "D1",
		Name = "Noodle Goblin Dropper",
		Price = 0,
		Type = "Dropper",
		Value = 2,
